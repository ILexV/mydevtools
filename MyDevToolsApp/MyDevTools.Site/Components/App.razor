@using Microsoft.AspNetCore.Http
@using MyDevTools.Site.Resources
@* Removed IHttpContextAccessor injection in favor of CascadingParameter *@

<!DOCTYPE html>
<html lang="en" @attributes="HtmlAttributes">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@AppStrings.Home_Subtitle" />
    <base href="/" />
    <script>
        (function () {
            try {
                // 1. Check LocalStorage
                var theme = localStorage.getItem('theme');
                // 2. Check Cookie if LS is missing
                if (!theme) {
                    var value = "; " + document.cookie;
                    var parts = value.split("; theme=");
                    if (parts.length === 2) theme = parts.pop().split(";").shift();
                }
                // 3. Check System Preference if both missing
                if (!theme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    theme = 'dark';
                }
                
                // Apply
                if (theme === 'dark' || theme === 'light') {
                    document.documentElement.setAttribute('data-theme', theme);
                }
            } catch (e) {
                console.error('Theme init error', e);
            }
        })();
        
        // Disable Blazor Enhanced Navigation
        window.Blazor = window.Blazor || {};
        window.Blazor.enhancedNavigationEnabled = false;
    </script>
    <ResourcePreloader />
    
    @* Preload critical resources *@
    <link rel="preload" href="@Assets["app.css"]" as="style" />
    
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MyDevTools.Site.styles.css"]" />
    
    @* CodeMirror CSS - only for pages that need it *@
    @if (NeedsCodeMirror)
    {
        <link rel="stylesheet" href="@Assets["lib/codemirror/codemirror.min.css"]" />
        <link rel="stylesheet" href="@Assets["lib/codemirror/addon/fold/foldgutter.min.css"]" />
    }
    @if (IsJsonBeautifier)
    {
        <link rel="stylesheet" href="@Assets["tools/json-beautifier.css"]" />
    }
    @if (IsXmlBeautifier)
    {
        <link rel="stylesheet" href="@Assets["tools/xml-beautifier.css"]" />
    }
    @if (IsYamlBeautifierValidator)
    {
        <script src="@Assets["lib/codemirror/mode/yaml/yaml.min.js"]"></script>
    }
    @if (IsTextCaseConverter)
    {
        <link rel="stylesheet" href="@Assets["tools/text-case-converter.css"]" />
    }
    
    <ImportMap />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <HeadOutlet />
</head>

<body data-enhance-nav="false">
    <Routes />
    
    @* Core scripts - always loaded *@
    <script src="@Assets["file-drop.js"]"></script>
    <script src="@Assets["tools/file-processing.js"]"></script>
    <script src="@Assets["theme.js"]"></script>
    <script src="@Assets["favorites.js"]"></script>
    
    @* CodeMirror - only for JSON/XML beautifiers *@
    @if (NeedsCodeMirror)
    {
        <script src="@Assets["lib/codemirror/codemirror.min.js"]"></script>
        <script src="@Assets["lib/codemirror/mode/javascript/javascript.min.js"]"></script>
        <script src="@Assets["lib/codemirror/addon/fold/foldcode.min.js"]"></script>
        <script src="@Assets["lib/codemirror/addon/fold/foldgutter.min.js"]"></script>
        <script src="@Assets["lib/codemirror/addon/fold/brace-fold.min.js"]"></script>
        <script src="@Assets["lib/codemirror/addon/edit/closebrackets.min.js"]"></script>
        <script src="@Assets["lib/codemirror/addon/edit/matchbrackets.min.js"]"></script>
    }
    
    @* Tool-specific scripts *@
    @if (IsJsonBeautifier)
    {
        <script src="@Assets["tools/json-beautifier.js"]"></script>
    }
    @if (IsXmlBeautifier)
    {
        <script src="@Assets["tools/xml-beautifier.js"]"></script>
    }
    @if (IsHashCalculator)
    {
        <script src="@Assets["tools/hash-calculator.js"]"></script>
    }
    @if (IsPasswordGenerator)
    {
        <script src="@Assets["tools/password-generator.js"]"></script>
    }
    @if (IsTextCaseConverter)
    {
        <script src="@Assets["tools/text-case-converter.js"]"></script>
    }
    @if (IsUrlEncoder)
    {
        <script src="@Assets["tools/url-encoder.js"]"></script>
    }
    @if (IsHexEncoder)
    {
        <script src="@Assets["tools/hex-encoder.js"]"></script>
    }
    @if (IsBase64Encoder)
    {
        <script src="@Assets["tools/base64-encoder.js"]"></script>
    }
    @if (IsBase32Encoder)
    {
        <script src="@Assets["tools/base32-encoder.js"]"></script>
    }
    @if (IsBase58Encoder)
    {
        <script src="@Assets["tools/base58-encoder.js"]"></script>
    }
    @if (IsOpenSshKeys)
    {
        <script src="@Assets["tools/openssh-keys.js"]"></script>
    }
    @if (IsX509Tool)
    {
        <script src="@Assets["tools/x509-tool.js"]"></script>
    }
    @if (IsAeadFile)
    {
        <script src="@Assets["tools/aead-file.js"]"></script>
    }
    @if (IsDateConverter)
    {
        <script src="@Assets["tools/date-converter.js"]"></script>
    }
    @if (IsJwtDecoder)
    {
        <script src="@Assets["tools/jwt-decoder.js"]"></script>
    }
    @if (IsJwtEncoder)
    {
        <script src="@Assets["tools/jwt-encoder.js"]"></script>
    }
    @if (IsImageConverter)
    {
        <script src="@Assets["tools/image-converter.js"]"></script>
    }
    @if (IsRegexTester)
    {
        <script type="module" src="@Assets["tools/regex-tester.js"]"></script>
    }

    <script type="module" src="tools/image-compressor.js"></script>
    <script type="module" src="tools/image-resizer.js"></script>
    @if (IsQrCodeGenerator)
    {
        <script type="module" src="@Assets["tools/qr-code-generator.js"]"></script>
    }
    @if (IsHmacCalculator)
    {
        <script src="@Assets["tools/hmac-calculator.js"]"></script>
    }
    @if (IsYamlBeautifierValidator)
    {
        <script src="@Assets["tools/yaml-beautifier-validator.js"]"></script>
    }
</body>

</html>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private string CurrentPath => HttpContext?.Request.Path.Value ?? "";
    
    // Tool page checks
    private bool IsImageConverter => CurrentPath.Contains("/image-converter", StringComparison.OrdinalIgnoreCase);
    private bool IsJsonBeautifier => CurrentPath.Contains("/json-beautifier", StringComparison.OrdinalIgnoreCase);
    private bool IsXmlBeautifier => CurrentPath.Contains("/xml-beautifier", StringComparison.OrdinalIgnoreCase);
    private bool IsHashCalculator => CurrentPath.Contains("/hash-calculator", StringComparison.OrdinalIgnoreCase);
    private bool IsPasswordGenerator => CurrentPath.Contains("/password-generator", StringComparison.OrdinalIgnoreCase);
    private bool IsTextCaseConverter => CurrentPath.Contains("/text-case-converter", StringComparison.OrdinalIgnoreCase);
    private bool IsUrlEncoder => CurrentPath.Contains("/url-encoder", StringComparison.OrdinalIgnoreCase);
    private bool IsHexEncoder => CurrentPath.Contains("/hex-encoder", StringComparison.OrdinalIgnoreCase);
    private bool IsBase64Encoder => CurrentPath.Contains("/base64-encoder", StringComparison.OrdinalIgnoreCase);
    private bool IsBase32Encoder => CurrentPath.Contains("/base32-encoder", StringComparison.OrdinalIgnoreCase);
    private bool IsBase58Encoder => CurrentPath.Contains("/base58-encoder", StringComparison.OrdinalIgnoreCase);
    private bool IsOpenSshKeys => CurrentPath.Contains("/openssh-keys", StringComparison.OrdinalIgnoreCase);
    private bool IsX509Tool => CurrentPath.Contains("/x509", StringComparison.OrdinalIgnoreCase);
    private bool IsAeadFile => CurrentPath.Contains("/aead", StringComparison.OrdinalIgnoreCase);
    private bool IsDateConverter => CurrentPath.Contains("/date-converter", StringComparison.OrdinalIgnoreCase);
    private bool IsJwtDecoder => CurrentPath.Contains("/jwt-decoder", StringComparison.OrdinalIgnoreCase);
    private bool IsJwtEncoder => CurrentPath.Contains("/jwt-encoder", StringComparison.OrdinalIgnoreCase);
    private bool IsRegexTester => CurrentPath.Contains("/regex-tester", StringComparison.OrdinalIgnoreCase);
    private bool IsQrCodeGenerator => CurrentPath.Contains("/qr-code-generator", StringComparison.OrdinalIgnoreCase);
    private bool IsHmacCalculator => CurrentPath.Contains("/hmac-calculator", StringComparison.OrdinalIgnoreCase);
    private bool IsYamlBeautifierValidator => CurrentPath.Contains("/yaml-beautifier-validator", StringComparison.OrdinalIgnoreCase);
    
    // CodeMirror is needed for JSON, XML, and YAML beautifiers
    private bool NeedsCodeMirror => IsJsonBeautifier || IsXmlBeautifier || IsYamlBeautifierValidator;
    
    private string? InitialTheme
    {
        get
        {
            var theme = HttpContext?.Request.Cookies["theme"];
            return theme is "dark" or "light" ? theme : null;
        }
    }

    private IReadOnlyDictionary<string, object>? HtmlAttributes
        => InitialTheme is null
            ? null
            : new Dictionary<string, object> { ["data-theme"] = InitialTheme };
}

