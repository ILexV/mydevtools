@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en" @attributes="HtmlAttributes">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('theme');
                if (theme === 'dark' || theme === 'light') {
                    document.documentElement.setAttribute('data-theme', theme);
                }
            } catch {
                // ignore
            }
        })();
    </script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MyDevTools.Site.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="@Assets["file-drop.js"]"></script>
    <script src="@Assets["tools/file-processing.js"]"></script>
    <script src="@Assets["theme.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["tools/hash-calculator.js"]"></script>
    <script src="@Assets["tools/url-encoder.js"]"></script>
    <script src="@Assets["tools/hex-encoder.js"]"></script>
    <script src="@Assets["tools/base64-encoder.js"]"></script>
    <script src="@Assets["tools/base32-encoder.js"]"></script>
    <script src="@Assets["tools/base58-encoder.js"]"></script>
    <script src="@Assets["tools/openssh-keys.js"]"></script>
    <script src="@Assets["tools/x509-tool.js"]"></script>
    <script src="@Assets["tools/aead-file.js"]"></script>
</body>

</html>

@code {
    private string? InitialTheme
    {
        get
        {
            var theme = HttpContextAccessor.HttpContext?.Request.Cookies["theme"];
            return theme is "dark" or "light" ? theme : null;
        }
    }

    private IReadOnlyDictionary<string, object>? HtmlAttributes
        => InitialTheme is null
            ? null
            : new Dictionary<string, object> { ["data-theme"] = InitialTheme };
}
