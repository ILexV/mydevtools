@using MyDevTools.Site.Resources

<div class="form-control w-full" data-file-upload>
    <label class="label" for="@InputId">
        <span class="label-text font-semibold">@Label</span>
    </label>
    <div class="file-dropzone" data-file-drop>
        <input id="@InputId" type="file" class="file-drop-input" accept="@Accept" />

        <div class="file-drop-empty">
            <div class="text-lg font-semibold mb-2">@DropTitle</div>
            <div class="text-sm opacity-70 mb-4">@DropSubtitle</div>
            <button type="button" class="btn btn-secondary file-drop-button">@ButtonLabel</button>
        </div>

        <div class="file-drop-selected" hidden>
            <div class="file-drop-selected-name font-semibold mb-1"></div>
            <div class="file-drop-selected-size text-sm opacity-70 mb-4"></div>
            <button type="button" class="btn btn-secondary btn-sm file-drop-change">@ChangeButtonLabel</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <label class="label">
            <span class="label-text-alt opacity-70">@Hint</span>
        </label>
    }
</div>

@code {
    [Parameter]
    public string InputId { get; set; } = string.Empty;

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Hint { get; set; } = string.Empty;

    [Parameter]
    public string DropTitle { get; set; } = AppStrings.Common_FileDropTitle;

    [Parameter]
    public string DropSubtitle { get; set; } = AppStrings.Common_FileDropSubtitle;

    [Parameter]
    public string ButtonLabel { get; set; } = AppStrings.Common_FileChooseButton;

    [Parameter]
    public string ChangeButtonLabel { get; set; } = AppStrings.Common_FileChangeButton;

    [Parameter]
    public string Accept { get; set; } = string.Empty;
}
