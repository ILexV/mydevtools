@using MyDevTools.Site.Resources

@* 
FileDropZone Component - Reusable file drop zone with customizable icon and description

Features:
- Drag & drop file upload
- Click to select files
- Optional file info display (name, size)
- Optional image preview
- Optional clear button
- Customizable icon and text
- Localization support

Usage Example 1 (Simple):
<FileDropZone 
    Id="drop-zone" 
    InputId="file-input"
    Description="Drag & drop an image here"
    Accept="image/*" />

Usage Example 2 (With file info):
<FileDropZone 
    Id="drop-zone" 
    InputId="file-input"
    Description="Drag & drop an image here"
    Accept="image/*"
    ShowFileInfo="true" />

Usage Example 3 (With preview and clear button):
<FileDropZone 
    Id="drop-zone" 
    InputId="file-input"
    IconSvg='<span style="font-size: 3rem;">🖼️</span>'
    Description="@AppStrings.ImageConverter_DragDrop"
    Accept="image/*"
    ShowFileInfo="true"
    ShowPreview="true"
    ShowClearButton="true" />
*@

<div id="@Id" class="border-2 border-dashed border-gray-300 rounded-xl p-10 text-center transition-colors cursor-pointer hover:border-blue-500 hover:bg-blue-50/50 dark:hover:bg-blue-900/20 relative" data-has-file="false">
    <input type="file" id="@InputId" class="hidden" accept="@Accept" multiple="@AllowMultiple" />
    
    @if (ShowClearButton)
    {
        <button type="button" 
                class="file-drop-clear-btn btn btn-ghost btn-circle btn-sm absolute top-2 right-2 opacity-0 pointer-events-none transition-opacity"
                aria-label="@AppStrings.Common_ClearFile"
                title="@AppStrings.Common_ClearFile">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    }
    
    <div class="file-drop-empty flex flex-col items-center justify-center space-y-4">
        @if (!string.IsNullOrWhiteSpace(IconSvg))
        {
            @((MarkupString)IconSvg)
        }
        
        <div class="text-lg font-medium text-gray-700 dark:text-gray-200">
            @Description
        </div>
        
        <button type="button" class="file-drop-choose-btn px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
            @ButtonText
        </button>
    </div>
    
    @if (ShowFileInfo || ShowPreview)
    {
        <div class="file-drop-selected hidden">
            <div class="flex flex-col items-center justify-center space-y-4">
                @if (ShowPreview)
                {
                    <div class="file-drop-preview-container">
                        <img class="file-drop-preview rounded-lg shadow-md max-w-xs max-h-48 object-contain" alt="File preview" style="display: none;" />
                    </div>
                }
                
                @if (ShowFileInfo)
                {
                    <div class="file-drop-info space-y-2">
                        <div class="flex items-center gap-2 text-gray-700 dark:text-gray-200">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                                <polyline points="13 2 13 9 20 9"></polyline>
                            </svg>
                            <span class="file-drop-name font-medium"></span>
                        </div>
                        <div class="text-sm text-gray-500 dark:text-gray-400 file-drop-size"></div>
                    </div>
                }
                
                <button type="button" class="file-drop-change-btn px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                    @ChangeButtonText
                </button>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Unique identifier for the drop zone container
    /// </summary>
    [Parameter]
    public string Id { get; set; } = "drop-zone";

    /// <summary>
    /// Unique identifier for the file input element
    /// </summary>
    [Parameter]
    public string InputId { get; set; } = "file-input";

    /// <summary>
    /// SVG icon markup to display in the center (use raw SVG string with proper classes)
    /// Default: Upload cloud icon
    /// </summary>
    [Parameter]
    public string IconSvg { get; set; } = @"<svg class=""w-12 h-12 text-gray-400"" fill=""none"" stroke=""currentColor"" viewBox=""0 0 24 24"">
    <path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"" />
</svg>";

    /// <summary>
    /// Description text displayed in the center
    /// </summary>
    [Parameter]
    public string Description { get; set; } = "Drag & drop a file here";

    /// <summary>
    /// Button text (localized by default to "Choose file")
    /// </summary>
    [Parameter]
    public string ButtonText { get; set; } = AppStrings.Common_FileChooseButton;

    /// <summary>
    /// Button text when file is selected (localized by default to "Choose another file")
    /// </summary>
    [Parameter]
    public string ChangeButtonText { get; set; } = AppStrings.Common_FileChangeButton;

    /// <summary>
    /// Accepted file types (e.g., "image/*", ".pdf", ".csv", etc.)
    /// Default: Accept all file types
    /// </summary>
    [Parameter]
    public string Accept { get; set; } = "*/*";

    /// <summary>
    /// Allow selecting multiple files
    /// Default: false (single file selection)
    /// </summary>
    [Parameter]
    public bool AllowMultiple { get; set; } = false;

    /// <summary>
    /// Show file name and size after selection
    /// Default: false
    /// </summary>
    [Parameter]
    public bool ShowFileInfo { get; set; } = false;

    /// <summary>
    /// Show image preview after selection (only works for image files)
    /// Default: false
    /// </summary>
    [Parameter]
    public bool ShowPreview { get; set; } = false;

    /// <summary>
    /// Show clear button in the top-right corner
    /// Default: false
    /// </summary>
    [Parameter]
    public bool ShowClearButton { get; set; } = false;
}
