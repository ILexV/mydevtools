<select class="select select-bordered select-sm" onchange="location.href=this.value" aria-label="Select language">
    @foreach (var lang in SupportedLanguages)
    {
        <option value="@GetLanguageUrl(lang)" selected="@(lang == CurrentLanguage)">@GetLanguageName(lang)</option>
    }
</select>

@code {
    [Parameter]
    public string CurrentLanguage { get; set; } = "en";

    [Inject]
    public NavigationManager Navigation { get; set; } = default!;

    private string[] SupportedLanguages = ["en", "ru", "es", "de", "pt", "zh", "fr", "ja", "ko", "hi"];

    private string GetLanguageUrl(string lang)
    {
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;
        var pathSegments = currentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (pathSegments.Length > 0 && SupportedLanguages.Contains(pathSegments[0]))
        {
            pathSegments[0] = lang;
        }
        else
        {
            pathSegments = [lang, .. pathSegments];
        }

        return "/" + string.Join("/", pathSegments);
    }

    private string GetLanguageName(string lang) => lang.ToUpperInvariant();
}
