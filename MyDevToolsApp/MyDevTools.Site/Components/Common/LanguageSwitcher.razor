<div class="language-switcher">
    <select @onchange="OnLanguageChanged" value="@CurrentLanguage">
        @foreach (var lang in SupportedLanguages)
        {
            <option value="@lang">@GetLanguageName(lang)</option>
        }
    </select>
</div>

@code {
    [Parameter]
    public string CurrentLanguage { get; set; } = "en";

    [Inject]
    public NavigationManager Navigation { get; set; } = default!;

    private string[] SupportedLanguages = ["en", "ru", "es"];

    private void OnLanguageChanged(ChangeEventArgs e)
    {
        var newLang = e.Value?.ToString() ?? "en";
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;
        
        // Remove current language from path
        var pathSegments = currentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (pathSegments.Length > 0 && SupportedLanguages.Contains(pathSegments[0]))
        {
            pathSegments[0] = newLang;
        }
        else
        {
            pathSegments = [newLang, .. pathSegments];
        }
        
        var newPath = "/" + string.Join("/", pathSegments);
        Navigation.NavigateTo(newPath, forceLoad: true);
    }

    private string GetLanguageName(string lang) => lang.ToUpperInvariant();
}
