@inject Microsoft.Extensions.Localization.IStringLocalizer<MyDevTools.Site.Resources.AppStrings> L

<button class="theme-toggle" @onclick="ToggleTheme" aria-label="@L["Theme_Toggle"]" title="@L["Theme_Toggle"]">
    @if (IsDarkMode)
    {
        <span class="icon">??</span>
    }
    else
    {
        <span class="icon">??</span>
    }
</button>

@code {
    [Parameter]
    public EventCallback<bool> OnThemeChanged { get; set; }

    private bool IsDarkMode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Load theme preference from localStorage via JS interop
        // For now, default to light mode
        IsDarkMode = false;
    }

    private async Task ToggleTheme()
    {
        IsDarkMode = !IsDarkMode;
        await OnThemeChanged.InvokeAsync(IsDarkMode);
        
        // TODO: Save to localStorage via JS interop
        // await JS.InvokeVoidAsync("localStorage.setItem", "theme", IsDarkMode ? "dark" : "light");
    }
}
