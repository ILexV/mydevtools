@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

@* Search Button - triggers JS modal *@
<button class="btn btn-ghost btn-sm gap-2 normal-case hidden md:flex" onclick="toolSearchModal.open()" title="@AppStrings.Search_Tooltip">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <span class="opacity-70">@AppStrings.Search_Placeholder</span>
    <kbd class="kbd kbd-sm opacity-70">Ctrl K</kbd>
</button>

@* Mobile Search Button *@
<button class="btn btn-ghost btn-circle md:hidden" onclick="toolSearchModal.open()" title="@AppStrings.Search_Tooltip">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
</button>

