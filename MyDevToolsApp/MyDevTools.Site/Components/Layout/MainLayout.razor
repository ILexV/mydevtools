    private string GetCommonString(string key) => JsonLocalization.Get(CurrentLanguage, "common", key);
    private string GetToolTitle(string slug) => JsonLocalization.Get(CurrentLanguage, $"tools/{slug}", "Title");
    private string GetToolDescription(string slug) => JsonLocalization.Get(CurrentLanguage, $"tools/{slug}", "Description");

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var segments = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);

