@inherits LayoutComponentBase
@using MyDevTools.Site.Resources
@using MyDevTools.Site.Services

<div class="min-h-screen flex flex-col bg-base-100">
    <!-- Navbar -->
    <div class="navbar bg-base-200 shadow-lg sticky top-0 z-50 border-b border-base-300">
        <div class="navbar-start">
            <a href="/@CurrentLanguage" class="btn btn-ghost text-xl font-bold" tabindex="-1">
                @AppStrings.AppName
            </a>
        </div>
        <div class="navbar-center hidden md:flex">
            <ul class="menu menu-horizontal px-1">
                <li><a href="/@CurrentLanguage/#tools" class="font-medium">@AppStrings.Nav_Utilities</a></li>
            </ul>
        </div>
        <div class="navbar-end gap-2">
            <LanguageSwitcher CurrentLanguage="@CurrentLanguage" />
            <ThemeToggle />
        </div>
    </div>

    <!-- Main Content -->
    <main class="flex-1 container mx-auto px-4 py-8 max-w-7xl">
        @Body
    </main>

    <!-- Footer -->
    <footer class="footer footer-center p-10 bg-base-200 text-base-content border-t border-base-300 mt-16">
        <div>
            <p class="font-semibold">@AppStrings.AppTagline</p>
            <p class="text-sm opacity-70">&copy; @DateTime.UtcNow.Year MyDevTools.app</p>
        </div>
    </footer>
</div>

@code {
    [Inject]
    public NavigationManager Navigation { get; set; } = default!;
    
    [Inject]
    public ILocalizationService LocalizationService { get; set; } = default!;

    private string CurrentLanguage { get; set; } = "en";

    protected override void OnInitialized()
    {
        // Extract language from URL
        var uri = new Uri(Navigation.Uri);
        var segments = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        
        if (segments.Length > 0 && LocalizationService.IsCultureSupported(segments[0]))
        {
            CurrentLanguage = segments[0];
        }
    }

}
