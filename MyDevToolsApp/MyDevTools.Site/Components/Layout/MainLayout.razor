@inherits LayoutComponentBase
@using MyDevTools.Site.Resources

<div class="page">
    <header class="main-header">
        <div class="header-content">
            <div class="logo">
                <a href="/@CurrentLanguage">
                    <h1>@AppStrings.AppName</h1>
                </a>
            </div>
            <nav class="main-nav">
                <a href="/@CurrentLanguage">@AppStrings.Nav_Home</a>
                <a href="/@CurrentLanguage/hash-calculator">Hash Calculator</a>
                <a href="/@CurrentLanguage/url-encoder">@AppStrings.Nav_UrlEncoder</a>
                <a href="/@CurrentLanguage/hex-encoder">@AppStrings.Nav_HexEncoder</a>
                <a href="/@CurrentLanguage/base64-encoder">@AppStrings.Nav_Base64Encoder</a>
                <a href="/@CurrentLanguage/base32-encoder">@AppStrings.Nav_Base32Encoder</a>
            </nav>
            <div class="header-actions">
                <LanguageSwitcher CurrentLanguage="@CurrentLanguage" />
                <ThemeToggle />
            </div>
        </div>
    </header>

    <main class="main-content">
        @Body
    </main>

    <footer class="main-footer">
        <div class="footer-content">
            <p>@AppStrings.AppTagline</p>
            <p>&copy; @DateTime.UtcNow.Year MyDevTools.app</p>
        </div>
    </footer>
</div>

@code {
    [Inject]
    public NavigationManager Navigation { get; set; } = default!;
    private string CurrentLanguage { get; set; } = "en";

    protected override void OnInitialized()
    {
        // Extract language from URL
        var uri = new Uri(Navigation.Uri);
        var segments = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length > 0 && (segments[0] == "en" || segments[0] == "ru" || segments[0] == "es"))
        {
            CurrentLanguage = segments[0];
        }
    }

}
