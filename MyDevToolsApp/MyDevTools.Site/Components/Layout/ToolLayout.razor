@using MyDevTools.Site.Resources

<div class="w-full">
    <div class="card bg-base-100 shadow-xl border border-base-300">
        <div class="card-body">
            <!-- Tool Header -->
            <div class="text-center mb-6">
                <h1 class="text-4xl font-bold mb-3">@Title</h1>
                @if (!string.IsNullOrEmpty(Description))
                {
                    <p class="text-lg opacity-70">@Description</p>
                }
            </div>

            <!-- Tool Content -->
            <div class="w-full">
                @ChildContent
            </div>

            <!-- Privacy Notice -->
            @if (ShowPrivacyNotice)
            {
                <div class="alert alert-info mt-6">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                    </svg>
                    <span>@AppStrings.Home_NoDataSent</span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Universal SSR-compatible layout for all developer tools.
    /// All data processing happens client-side via WASM.
    /// </summary>
    
    /// <summary>
    /// The title of the tool.
    /// </summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = default!;

    /// <summary>
    /// The description of the tool.
    /// </summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>
    /// The content of the tool (input/output areas, actions).
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Whether to show the privacy notice.
    /// </summary>
    [Parameter]
    public bool ShowPrivacyNotice { get; set; } = true;
}
