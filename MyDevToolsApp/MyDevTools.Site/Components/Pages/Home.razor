@page "/"
@page "/{lang}"
@using MyDevTools.Site.Components.Sections
@inject NavigationManager Navigation
@inherits ToolComponentBase

@* Type aliases for section components *@
@using ToolCategory = MyDevTools.Site.Components.Sections.ToolsSection.ToolCategory
@using ToolInfo = MyDevTools.Site.Components.Sections.ToolsSection.ToolInfo

<MetaTags Title="@T("Title")"
          Description="@T("Subtitle")"
          CurrentUrl="@Navigation.Uri"
          IsHomePage="true"
          Lang="@Lang"
          SiteName="@T("AppName")"/>

<div id="home-page-root">
    
    <HeroSection Lang="@Lang" />

    
    <FavoritesSection Lang="@Lang" />

    
    <ToolsSection Lang="@Lang" Categories="@GetToolsByCategoryForSections()" />

    
    <FeaturesSection Lang="@Lang" />
</div>

@code {
    protected override string LocalizationNamespace { get; set; } = "home";

    private string GetToolTitle(string slug) => JsonLocalization.Get(Lang, $"tools/{slug}", "Title");
    private string GetToolDescription(string slug) => JsonLocalization.Get(Lang, $"tools/{slug}", "Description");

    private List<ToolInfo> GetTools()
    {
        return new List<ToolInfo>
        {
            new("image-converter", "🖼️", GetToolTitle("image-converter"), GetToolDescription("image-converter")),
            new("image-compressor", "📉", GetToolTitle("image-compressor"), GetToolDescription("image-compressor")),
            new("image-resizer", "📏", GetToolTitle("image-resizer"), GetToolDescription("image-resizer")),
            new("color-converter", "🎨", GetToolTitle("color-converter"), GetToolDescription("color-converter")),
            new("markdown-preview", "📄", GetToolTitle("markdown-preview"), GetToolDescription("markdown-preview")),
            new("hash-calculator", "🔐", GetToolTitle("hash-calculator"), GetToolDescription("hash-calculator")),
            new("password-generator", "🎲", GetToolTitle("password-generator"), GetToolDescription("password-generator")),
            new("uuid-generator", "🆔", GetToolTitle("uuid-generator"), GetToolDescription("uuid-generator")),
            new("lorem-ipsum-generator", "📝", GetToolTitle("lorem-ipsum-generator"), GetToolDescription("lorem-ipsum-generator")),
            new("base64-encoder", "🧬", GetToolTitle("base64-encoder"), GetToolDescription("base64-encoder")),
            new("json-beautifier", "✨", GetToolTitle("json-beautifier"), GetToolDescription("json-beautifier")),
            new("text-case-converter", "🔠", GetToolTitle("text-case-converter"), GetToolDescription("text-case-converter")),
            new("text-diff-viewer", "📊", GetToolTitle("text-diff-viewer"), GetToolDescription("text-diff-viewer")),
            new("aead-file", "🛡️", GetToolTitle("aead-file"), GetToolDescription("aead-file")),
            new("openssh-keys", "🔑", GetToolTitle("openssh-keys"), GetToolDescription("openssh-keys")),
            new("x509", "📜", GetToolTitle("x509"), GetToolDescription("x509")),
            new("url-encoder", "🔗", GetToolTitle("url-encoder"), GetToolDescription("url-encoder")),
            new("xml-beautifier", "🧷", GetToolTitle("xml-beautifier"), GetToolDescription("xml-beautifier")),
            new("hex-encoder", "🧱", GetToolTitle("hex-encoder"), GetToolDescription("hex-encoder")),
            new("base32-encoder", "🧪", GetToolTitle("base32-encoder"), GetToolDescription("base32-encoder")),
            new("base58-encoder", "🧿", GetToolTitle("base58-encoder"), GetToolDescription("base58-encoder")),
            new("date-converter", "📅", GetToolTitle("date-converter"), GetToolDescription("date-converter")),
            new("jwt-decoder", "🔓", GetToolTitle("jwt-decoder"), GetToolDescription("jwt-decoder")),
            new("jwt-encoder", "🔐", GetToolTitle("jwt-encoder"), GetToolDescription("jwt-encoder")),
            new("regex-tester", "🔍", GetToolTitle("regex-tester"), GetToolDescription("regex-tester")),
            new("qr-code-generator", "📱", GetToolTitle("qr-code-generator"), GetToolDescription("qr-code-generator")),
            new("hmac-calculator", "🔐", GetToolTitle("hmac-calculator"), GetToolDescription("hmac-calculator")),
            new("yaml-beautifier-validator", "📄", GetToolTitle("yaml-beautifier-validator"), GetToolDescription("yaml-beautifier-validator")),
            new("qr-scanner", "📷", GetToolTitle("qr-scanner"), GetToolDescription("qr-scanner")),
            new("pdf-merger", "📑", GetToolTitle("pdf-merger"), GetToolDescription("pdf-merger")),
            new("pdf-compressor", "📉", GetToolTitle("pdf-compressor"), GetToolDescription("pdf-compressor")),
            new("html-entity-encoder", "</>", GetToolTitle("html-entity-encoder"), GetToolDescription("html-entity-encoder")),
            new("unit-converter", "📏", GetToolTitle("unit-converter"), GetToolDescription("unit-converter")),
            new("ip-subnet-calculator", "🌐", GetToolTitle("ip-subnet-calculator"), GetToolDescription("ip-subnet-calculator")),
            new("cron-parser", "📅", GetToolTitle("cron-parser"), GetToolDescription("cron-parser")),
            new("cron-generator", "📅", GetToolTitle("cron-generator"), GetToolDescription("cron-generator")),
            new("word-counter", "📊", GetToolTitle("word-counter"), GetToolDescription("word-counter"))
        };
    }

    private List<ToolCategory> GetToolsByCategoryForSections()
    {
        var tools = GetTools();

        return new List<ToolCategory>
        {
            new()
            {
                Slug = "images",
                Name = T("Category_Images"),
                Icon = GetCategoryIcon("images"),
                Tools = tools.Where(t => new[] { "image-converter", "image-compressor", "image-resizer" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "design",
                Name = T("Category_ColorsAndDesign"),
                Icon = GetCategoryIcon("design"),
                Tools = tools.Where(t => new[] { "color-converter", "markdown-preview" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "hashing",
                Name = T("Category_HashingAndSecurity"),
                Icon = GetCategoryIcon("hashing"),
                Tools = tools.Where(t => new[] { "hash-calculator", "password-generator" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "encoding",
                Name = T("Category_Encoding"),
                Icon = GetCategoryIcon("encoding"),
                Tools = tools.Where(t => new[] { "base64-encoder", "base32-encoder", "base58-encoder", "hex-encoder", "url-encoder", "html-entity-encoder" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "structured-data",
                Name = T("Category_StructuredData"),
                Icon = GetCategoryIcon("structured-data"),
                Tools = tools.Where(t => new[] { "json-beautifier", "xml-beautifier", "yaml-beautifier-validator", "cron-parser", "cron-generator" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "text",
                Name = T("Category_TextTools"),
                Icon = GetCategoryIcon("text"),
                Tools = tools.Where(t => new[] { "text-case-converter", "text-diff-viewer", "word-counter" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "cryptography",
                Name = T("Category_Cryptography"),
                Icon = GetCategoryIcon("cryptography"),
                Tools = tools.Where(t => new[] { "hmac-calculator", "aead-file", "openssh-keys", "x509" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "jwt",
                Name = T("Category_JwtAndTokens"),
                Icon = GetCategoryIcon("jwt"),
                Tools = tools.Where(t => new[] { "jwt-decoder", "jwt-encoder" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "regex",
                Name = T("Category_Regex"),
                Icon = GetCategoryIcon("regex"),
                Tools = tools.Where(t => t.Slug == "regex-tester")
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "qrcode",
                Name = T("Category_QrCodes"),
                Icon = GetCategoryIcon("qrcode"),
                Tools = tools.Where(t => new[] { "qr-code-generator", "qr-scanner" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "pdf",
                Name = T("Category_PdfTools"),
                Icon = GetCategoryIcon("pdf"),
                Tools = tools.Where(t => new[] { "pdf-merger", "pdf-compressor" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "converters",
                Name = T("Category_Converters"),
                Icon = GetCategoryIcon("converters"),
                Tools = tools.Where(t => new[] { "unit-converter", "ip-subnet-calculator" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            }
        }.Where(c => c.Tools.Any()).ToList();
    }

