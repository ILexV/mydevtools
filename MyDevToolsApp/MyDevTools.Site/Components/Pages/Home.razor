    private List<ToolCategory> GetToolsByCategoryForSections()
    {
        var tools = GetTools();

        return new List<ToolCategory>
        {
            new()
            {
                Slug = "images",
                Name = AppStrings.Category_Images,
                Icon = GetCategoryIcon("images"),
                Tools = tools.Where(t => new[] { "image-converter", "image-compressor", "image-resizer" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "design",
                Name = AppStrings.Category_ColorsAndDesign,
                Icon = GetCategoryIcon("design"),
                Tools = tools.Where(t => new[] { "color-converter", "markdown-preview" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "hashing",
                Name = AppStrings.Category_HashingAndSecurity,
                Icon = GetCategoryIcon("hashing"),
                Tools = tools.Where(t => new[] { "hash-calculator", "password-generator" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "encoding",
                Name = AppStrings.Category_Encoding,
                Icon = GetCategoryIcon("encoding"),
                Tools = tools.Where(t => new[] { "base64-encoder", "base32-encoder", "base58-encoder", "hex-encoder", "url-encoder", "html-entity-encoder" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "structured-data",
                Name = AppStrings.Category_StructuredData,
                Icon = GetCategoryIcon("structured-data"),
                Tools = tools.Where(t => new[] { "json-beautifier", "xml-beautifier", "yaml-beautifier-validator" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "text",
                Name = AppStrings.Category_TextTools,
                Icon = GetCategoryIcon("text"),
                Tools = tools.Where(t => new[] { "text-case-converter", "text-diff-viewer" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "cryptography",
                Name = AppStrings.Category_Cryptography,
                Icon = GetCategoryIcon("cryptography"),
                Tools = tools.Where(t => new[] { "hmac-calculator", "aead-file", "openssh-keys", "x509" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "jwt",
                Name = AppStrings.Category_JwtAndTokens,
                Icon = GetCategoryIcon("jwt"),
                Tools = tools.Where(t => new[] { "jwt-decoder", "jwt-encoder" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "regex",
                Name = AppStrings.Category_Regex,
                Icon = GetCategoryIcon("regex"),
                Tools = tools.Where(t => t.Slug == "regex-tester")
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "qrcode",
                Name = AppStrings.Category_QrCodes,
                Icon = GetCategoryIcon("qrcode"),
                Tools = tools.Where(t => new[] { "qr-code-generator", "qr-scanner" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "pdf",
                Name = AppStrings.Category_PdfTools,
                Icon = GetCategoryIcon("pdf"),
                Tools = tools.Where(t => new[] { "pdf-merger", "pdf-compressor" }.Contains(t.Slug))
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            },
            new()
            {
                Slug = "converters",
                Name = AppStrings.Category_Converters,
                Icon = GetCategoryIcon("converters"),
                Tools = tools.Where(t => t.Slug == "unit-converter")
                          .Select(t => new ToolInfo 
                          { 
                              Slug = t.Slug, 
                              Icon = t.Icon, 
                              Title = t.Title, 
                              Description = t.Description 
                          }).ToList()
            }
        }.Where(c => c.Tools.Any()).ToList();
    }

