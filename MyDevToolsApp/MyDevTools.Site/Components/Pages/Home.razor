@page "/{lang}"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.Home_Title" 
          Description="@AppStrings.Home_Subtitle" 
          CurrentUrl="@Navigation.Uri" />

<JsonLdSite SiteName="@AppStrings.AppName"
           Description="@AppStrings.Home_Subtitle"
           CurrentUrl="@Navigation.Uri" />

<HreflangLinks />
    
<div class="alert alert-warning shadow-lg mb-6">
    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
    <span>🚧 @AppStrings.Home_DevelopmentNotice</span>
</div>

<div id="home-page-root">
    <div class="hero bg-base-200 rounded-box mb-8">
        <div class="hero-content flex-col lg:flex-row-reverse gap-8 py-12">
            <img src="/hero_logo.webp" alt="@AppStrings.AppName Hero" class="max-w-sm rounded-lg shadow-2xl" width="400" height="297" />
            <div>
                <h1 class="text-5xl font-bold">@AppStrings.AppName</h1>
                <p class="py-6 text-lg">@AppStrings.Home_Subtitle</p>
            </div>
        </div>
    </div>

    @* Favorites Section *@
    <div id="favorites-section" class="mb-8">
        <h2 class="text-2xl font-bold mb-4">⭐ @AppStrings.Home_Favorites</h2>
        <div class="favorites-scroll mb-4">
            @foreach (var tool in GetTools())
            {
                <a href="/@Lang/@tool.Slug" class="favorite-tool-compact card card-compact bg-base-200 shadow-xl hover:shadow-2xl transition-shadow" data-tool-slug="@tool.Slug" style="display: none;">
                    <div class="card-body flex-row items-center gap-3">
                        <div class="text-3xl">@tool.Icon</div>
                        <div class="text-sm font-semibold">@tool.Title</div>
                    </div>
                </a>
            }
        </div>
        <div class="favorites-empty alert alert-info shadow-lg" style="display: none;">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>@AppStrings.Home_NoFavorites</span>
        </div>
    </div>

    @* All Tools Section *@
    <div id="tools">
        <h2 class="text-2xl font-bold mb-4">@AppStrings.Home_FeaturedTools</h2>
        <div class="space-y-2">
            @foreach (var tool in GetTools())
            {
                <div class="relative">
                    <a href="/@Lang/@tool.Slug" class="card card-compact bg-base-100 shadow-xl hover:shadow-2xl transition-shadow w-full">
                        <div class="card-body flex-row items-center gap-4">
                            <div class="text-4xl">@tool.Icon</div>
                            <div class="flex-1">
                                <h3 class="card-title text-base">@tool.Title</h3>
                                <p class="text-sm opacity-70">@tool.Description</p>
                            </div>
                            <div class="badge badge-primary badge-outline">@AppStrings.Home_Launch</div>
                        </div>
                    </a>
                    <button class="favorite-btn btn btn-ghost btn-circle btn-sm absolute top-2 right-2" 
                            data-tool-slug="@tool.Slug" 
                            aria-label="@AppStrings.Home_AddToFavorites"
                            aria-pressed="false"
                            title="@AppStrings.Home_AddToFavorites">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";

    private List<ToolInfo> GetTools()
    {
        return new List<ToolInfo>
        {
            new("image-converter", "🖼️", AppStrings.ImageConverter_Title, AppStrings.ImageConverter_Description),
            new("image-compressor", "📉", AppStrings.ImageCompressor_Title, AppStrings.ImageCompressor_Description),
            new("image-resizer", "📏", AppStrings.ImageResizer_Title, AppStrings.ImageResizer_Description),
            new("color-converter", "🎨", AppStrings.ColorConverter_Title, AppStrings.ColorConverter_Description),
            new("markdown-preview", "📄", AppStrings.MarkdownPreview_Title, AppStrings.MarkdownPreview_Description),
            new("hash-calculator", "🔐", AppStrings.HashCalculator_Title, AppStrings.HashCalculator_Description),
            new("password-generator", "🎲", AppStrings.PasswordGenerator_Title, AppStrings.PasswordGenerator_Description),
            new("uuid-generator", "🆔", AppStrings.UuidGenerator_Title, AppStrings.UuidGenerator_Description),
            new("lorem-ipsum-generator", "📝", AppStrings.LoremIpsumGenerator_Title, AppStrings.LoremIpsumGenerator_Description),
            new("base64-encoder", "🧬", AppStrings.Base64Encoder_Title, AppStrings.Base64Encoder_Description),
            new("json-beautifier", "✨", AppStrings.JsonBeautifier_Title, AppStrings.JsonBeautifier_Description),
            new("text-case-converter", "🔠", AppStrings.TextCaseConverter_Title, AppStrings.TextCaseConverter_Description),
            new("text-diff-viewer", "📊", AppStrings.TextDiffViewer_Title, AppStrings.TextDiffViewer_Description),
            new("aead-file", "🛡️", AppStrings.Aead_Title, AppStrings.Aead_Description),
            new("openssh-keys", "🔑", AppStrings.OpenSsh_Title, AppStrings.OpenSsh_Description),
            new("x509", "📜", AppStrings.X509_Title, AppStrings.X509_Description),
            new("url-encoder", "🔗", AppStrings.UrlEncoder_Title, AppStrings.UrlEncoder_Description),
            new("xml-beautifier", "🧷", AppStrings.XmlBeautifier_Title, AppStrings.XmlBeautifier_Description),
            new("hex-encoder", "🧱", AppStrings.HexEncoder_Title, AppStrings.HexEncoder_Description),
            new("base32-encoder", "🧪", AppStrings.Base32Encoder_Title, AppStrings.Base32Encoder_Description),
            new("base58-encoder", "🧿", AppStrings.Base58Encoder_Title, AppStrings.Base58Encoder_Description),
            new("date-converter", "📅", AppStrings.DateConverter_Title, AppStrings.DateConverter_Description),
            new("jwt-debugger", "🛂", AppStrings.JwtDebugger_Title, AppStrings.JwtDebugger_Description),
            new("regex-tester", "🔍", AppStrings.RegexTester_Title, AppStrings.RegexTester_Description),
            new("qr-code-generator", "📱", AppStrings.QrCodeGenerator_Title, AppStrings.QrCodeGenerator_Description),
            new("qr-scanner", "📷", AppStrings.QrScanner_Title, AppStrings.QrScanner_Description)
        };
    }

    private record ToolInfo(string Slug, string Icon, string Title, string Description);
}