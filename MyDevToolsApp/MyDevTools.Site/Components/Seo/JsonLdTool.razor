@using System.Text.Encodings.Web
@using System.Text.Json

<HeadContent>
    <script type="application/ld+json">@((MarkupString)GenerateJsonLd())</script>
</HeadContent>

@code {
    [Parameter, EditorRequired]
    public string ToolName { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Description { get; set; } = default!;

    [Parameter]
    public string? CurrentUrl { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, string>? SupportedAlgorithms { get; set; }

    private string GenerateJsonLd()
    {
        var jsonLd = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "SoftwareApplication",
            ["name"] = ToolName,
            ["description"] = Description,
            ["applicationCategory"] = "DeveloperApplication",
            ["operatingSystem"] = "Web",
            ["isAccessibleForFree"] = true,
            ["offers"] = new Dictionary<string, object?>
            {
                ["@type"] = "Offer",
                ["price"] = "0",
                ["priceCurrency"] = "USD"
            }
        };

        if (!string.IsNullOrWhiteSpace(CurrentUrl))
        {
            jsonLd["url"] = CurrentUrl;
        }

        if (SupportedAlgorithms is { Count: > 0 })
        {
            jsonLd["additionalProperty"] = SupportedAlgorithms
                .Select(kvp => new Dictionary<string, object?>
                {
                    ["@type"] = "PropertyValue",
                    ["name"] = kvp.Key,
                    ["value"] = kvp.Value
                })
                .ToArray();
        }

        return JsonSerializer.Serialize(jsonLd, new JsonSerializerOptions
        {
            WriteIndented = true,
            Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }
}
