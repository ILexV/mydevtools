@using Microsoft.AspNetCore.Components.Web
@using System.Net
@using System.Text.Encodings.Web
@using System.Text.Json
@inject MyDevTools.Site.Services.ILocalizationService LocalizationService
@inject NavigationManager Navigation

<HeadContent>
    @* --- Basic Meta Tags --- *@
    <title>@Title</title>
    @((MarkupString)$"<meta name=\"description\" content=\"{WebUtility.HtmlEncode(Description)}\" />")
    @((MarkupString)$"<meta name=\"keywords\" content=\"{WebUtility.HtmlEncode(Keywords)}\" />")
    
    @* --- Open Graph --- *@
    @((MarkupString)$"<meta property=\"og:title\" content=\"{WebUtility.HtmlEncode(Title)}\" />")
    @((MarkupString)$"<meta property=\"og:description\" content=\"{WebUtility.HtmlEncode(Description)}\" />")
    <meta property="og:type" content="website" />
    @if (!string.IsNullOrEmpty(CurrentUrl))
    {
        <meta property="og:url" content="@CurrentUrl" />
    }
    
    @* --- Twitter Card --- *@
    <meta name="twitter:card" content="summary" />
    @((MarkupString)$"<meta name=\"twitter:title\" content=\"{WebUtility.HtmlEncode(Title)}\" />")
    @((MarkupString)$"<meta name=\"twitter:description\" content=\"{WebUtility.HtmlEncode(Description)}\" />")
    
    @* --- Robots --- *@
    <meta name="robots" content="index, follow" />
    
    @if (!string.IsNullOrEmpty(CurrentUrl))
    {
        <link rel="canonical" href="@GetCanonicalUrl()" />
    }

    @* --- Hreflang Links --- *@
    @foreach (var culture in LocalizationService.SupportedCultures)
    {
        <link rel="alternate" hreflang="@culture" href="@GetAlternateUrl(culture)" />
    }
    <link rel="alternate" hreflang="x-default" href="@GetDefaultUrl()" />

    @* --- JSON-LD --- *@
    @((MarkupString)$"<script type=\"application/ld+json\">{GenerateJsonLd()}</script>")
</HeadContent>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter, EditorRequired] public string Description { get; set; } = default!;
    [Parameter] public string Keywords { get; set; } = "developer tools, privacy, hash, json, xml, base64";
    [Parameter] public string? CurrentUrl { get; set; }
    [Parameter] public bool IsHomePage { get; set; } = false;
    [Parameter] public string? Lang { get; set; }
    
    /// <summary>
    /// Optional tool path (e.g., "hash-calculator") for Hreflang generation.
    /// If null/empty and IsHomePage is false, assumes root or manual handling needed.
    /// </summary>
    [Parameter] public string? ToolPath { get; set; }

    /// <summary>
    /// Optional supported algorithms for Hash/HMAC tools JSON-LD.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, string>? SupportedAlgorithms { get; set; }

    /// <summary>
    /// Site Name for Home Page JSON-LD.
    /// </summary>
    [Parameter] public string? SiteName { get; set; }

    private string GetCanonicalUrl()
    {
        if (string.IsNullOrEmpty(CurrentUrl)) return CurrentUrl!;
        
        if (IsHomePage && !string.IsNullOrEmpty(Lang))
        {
            var baseUri = new Uri(CurrentUrl);
            return $"{baseUri.Scheme}://{baseUri.Authority}/";
        }
        return CurrentUrl;
    }

    private string GetAlternateUrl(string culture)
    {
        var baseUri = new Uri(Navigation.BaseUri);
        var path = string.IsNullOrEmpty(ToolPath) ? "" : $"/{ToolPath}";
        
        // If it's home page (IsHomePage=true), ToolPath should be empty, so we get /en, /ru etc.
        // If ToolPath is present, we get /en/tool
        
        return $"{baseUri.Scheme}://{baseUri.Authority}/{culture}{path}";
    }

    private string GetDefaultUrl()
    {
        var baseUri = new Uri(Navigation.BaseUri);
        
        // For home page: x-default points to root /
        if (IsHomePage || string.IsNullOrEmpty(ToolPath))
        {
            return $"{baseUri.Scheme}://{baseUri.Authority}/";
        }
        
        // For tool pages: x-default points to /en/{tool}
        return $"{baseUri.Scheme}://{baseUri.Authority}/en/{ToolPath}";
    }

    private string GenerateJsonLd()
    {
        if (IsHomePage)
        {
             var siteJson = new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "WebSite",
                ["name"] = SiteName ?? "MyDevTools",
                ["url"] = CurrentUrl ?? Navigation.BaseUri,
                ["description"] = Description
            };
             return JsonSerializer.Serialize(siteJson, JsonOptions);
        }

        var jsonLd = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "SoftwareApplication",
            ["name"] = Title,
            ["description"] = Description,
            ["applicationCategory"] = "DeveloperApplication",
            ["isAccessibleForFree"] = true,
            ["offers"] = new Dictionary<string, object?>
            {
                ["@type"] = "Offer",
                ["price"] = "0",
                ["priceCurrency"] = "USD"
            }
        };

        if (!string.IsNullOrWhiteSpace(CurrentUrl))
        {
            jsonLd["url"] = CurrentUrl;
        }

        if (SupportedAlgorithms is { Count: > 0 })
        {
            jsonLd["additionalProperty"] = SupportedAlgorithms
                .Select(kvp => new Dictionary<string, object?>
                {
                    ["@type"] = "PropertyValue",
                    ["name"] = kvp.Key,
                    ["value"] = kvp.Value
                })
                .ToArray();
        }

        return JsonSerializer.Serialize(jsonLd, JsonOptions);
    }

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        WriteIndented = true,
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };
}
