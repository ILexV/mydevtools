@using Microsoft.AspNetCore.Components.Web

<PageTitle>@Title</PageTitle>
<HeadContent>
    <meta name="description" content="@Description" />
    <meta name="keywords" content="@Keywords" />
    
    @* Open Graph *@
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@Description" />
    <meta property="og:type" content="website" />
    @if (!string.IsNullOrEmpty(CurrentUrl))
    {
        <meta property="og:url" content="@CurrentUrl" />
    }
    
    @* Twitter Card *@
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@Title" />
    <meta name="twitter:description" content="@Description" />
    
    @* Robots *@
    <meta name="robots" content="index, follow" />
    
    @if (!string.IsNullOrEmpty(CurrentUrl))
    {
        <link rel="canonical" href="@GetCanonicalUrl()" />
    }
</HeadContent>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Description { get; set; } = default!;

    [Parameter]
    public string Keywords { get; set; } = "developer tools, privacy, hash, json, xml, base64";

    [Parameter]
    public string? CurrentUrl { get; set; }

    /// <summary>
    /// Indicates if this is the home page (/en/, /ru/, /es/).
    /// </summary>
    [Parameter]
    public bool IsHomePage { get; set; } = false;

    /// <summary>
    /// Current language code (e.g., "en", "ru", "es").
    /// Used to determine canonical URL for home page.
    /// </summary>
    [Parameter]
    public string? Lang { get; set; }

    private string GetCanonicalUrl()
    {
        if (string.IsNullOrEmpty(CurrentUrl))
        {
            return CurrentUrl!;
        }
        
        // For home page language versions (/en/, /ru/, /es/): canonical points to root /
        if (IsHomePage && !string.IsNullOrEmpty(Lang))
        {
            var baseUri = new Uri(CurrentUrl);
            return $"{baseUri.Scheme}://{baseUri.Host}/";
        }
        
        // For all other pages: self-referencing canonical
        return CurrentUrl;
    }
}
