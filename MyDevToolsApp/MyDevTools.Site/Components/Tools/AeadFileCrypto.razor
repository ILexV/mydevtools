@page "/{lang}/aead-file"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.Aead_Title"
          Description="@AppStrings.Aead_Description"
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="aead-file" />

<JsonLdTool ToolName="@AppStrings.Aead_Title"
            Description="@AppStrings.Aead_Description"
            CurrentUrl="@Navigation.Uri" />

<ToolLayout Title="@AppStrings.Aead_Title" Description="@AppStrings.Aead_Description">
    <div id="aead-root"
         data-loading="@AppStrings.Common_Loading"
         data-error="@AppStrings.Common_Error"
         data-file-progress-title="@AppStrings.Aead_FileProgressTitle"
         data-cancel="@AppStrings.Aead_Cancel"
         data-copy="@AppStrings.Aead_Copy"
         data-copied="@AppStrings.Aead_Copied"
         data-download="@AppStrings.Aead_Download"
         data-warnings-title="@AppStrings.Aead_WarningsTitle">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="space-y-4">
                <h3 class="text-lg font-semibold">@AppStrings.Aead_EncryptSectionTitle</h3>
                <div class="form-control w-full">
                    <label class="label" for="aead-input-file">
                        <span class="label-text font-semibold">@AppStrings.Aead_FileLabel</span>
                    </label>
                    <FileDropZone
                        Id="aead-encrypt-drop-zone"
                        InputId="aead-input-file"
                        IconSvg='<svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>'
                        Description="@AppStrings.Common_FileDropTitle"
                        Accept="*/*"
                        ShowFileInfo="true"
                        ShowClearButton="true" />
                    @if (!string.IsNullOrWhiteSpace(AppStrings.Aead_FileHint))
                    {
                        <label class="label">
                            <span class="label-text-alt opacity-70">@AppStrings.Aead_FileHint</span>
                        </label>
                    }
                </div>

                <div class="form-control w-full">
                    <label class="label" for="aead-algorithm">
                        <span class="label-text font-semibold">@AppStrings.Aead_AlgorithmLabel</span>
                    </label>
                    <select id="aead-algorithm" class="select select-bordered w-full">
                        <option value="aes-256-gcm">AES-256-GCM</option>
                        <option value="chacha20-poly1305">ChaCha20-Poly1305</option>
                        <option value="xchacha20-poly1305">XChaCha20-Poly1305</option>
                    </select>
                </div>

                <div class="form-control w-full">
                    <label class="label" for="aead-password">
                        <span class="label-text font-semibold">@AppStrings.Aead_PasswordLabel</span>
                    </label>
                    <input id="aead-password" type="password" autocomplete="new-password" class="input input-bordered w-full" />
                </div>

                <div class="flex flex-wrap gap-2">
                    <button class="btn btn-primary" id="aead-encrypt-btn" type="button">@AppStrings.Aead_EncryptButton</button>
                </div>

                <h3 class="text-lg font-semibold mt-6">@AppStrings.Aead_DecryptSectionTitle</h3>
                <div class="form-control w-full">
                    <label class="label" for="aead-decrypt-file">
                        <span class="label-text font-semibold">@AppStrings.Aead_FileLabel</span>
                    </label>
                    <FileDropZone
                        Id="aead-decrypt-drop-zone"
                        InputId="aead-decrypt-file"
                        IconSvg='<svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"></path></svg>'
                        Description="@AppStrings.Common_FileDropTitle"
                        Accept="*/*"
                        ShowFileInfo="true"
                        ShowClearButton="true" />
                    @if (!string.IsNullOrWhiteSpace(AppStrings.Aead_FileHint))
                    {
                        <label class="label">
                            <span class="label-text-alt opacity-70">@AppStrings.Aead_FileHint</span>
                        </label>
                    }
                </div>

                <div class="flex flex-wrap gap-2">
                    <button class="btn btn-secondary" id="aead-decrypt-btn" type="button">@AppStrings.Aead_DecryptButton</button>
                </div>
            </div>

            <div class="space-y-4">
                <div class="form-control w-full">
                    <label class="label" for="aead-header">
                        <span class="label-text font-semibold">@AppStrings.Aead_HeaderLabel</span>
                    </label>
                    <textarea id="aead-header" rows="6" readonly class="textarea textarea-bordered w-full font-mono"></textarea>
                </div>

                <div class="form-control w-full">
                    <label class="label" for="aead-output">
                        <span class="label-text font-semibold">@AppStrings.Aead_OutputLabel</span>
                    </label>
                    <textarea id="aead-output" rows="8" readonly class="textarea textarea-bordered w-full font-mono"></textarea>
                </div>

                <div class="flex flex-wrap gap-2">
                    <button class="btn btn-secondary" id="aead-copy" type="button">@AppStrings.Aead_Copy</button>
                    <button class="btn btn-secondary" id="aead-download" type="button">@AppStrings.Aead_Download</button>
                </div>

                <div class="alert alert-error" id="aead-warnings" style="display: none;"></div>
            </div>
        </div>
    </div>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
