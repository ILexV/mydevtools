@page "/{lang}/base32-encoder"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.Base32Encoder_Title"
          Description="@AppStrings.Base32Encoder_Description"
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="base32-encoder" />

<JsonLdTool ToolName="@AppStrings.Base32Encoder_Title"
            Description="@AppStrings.Base32Encoder_Description"
            CurrentUrl="@Navigation.Uri" />

<ToolLayout Title="@AppStrings.Base32Encoder_Title" Description="@AppStrings.Base32Encoder_Description">
    <div id="base32-encoder-root"
         data-loading="@AppStrings.Common_Loading"
         data-error="@AppStrings.Common_Error"
         data-file-progress-title="@AppStrings.Base32Encoder_FileProgressTitle"
         data-cancel="@AppStrings.Base32Encoder_Cancel"
         data-copy="@AppStrings.Base32Encoder_Copy"
         data-copied="@AppStrings.Base32Encoder_Copied">

        <div class="flex flex-wrap gap-2 items-center mb-4" aria-label="@AppStrings.Base32Encoder_OtherFormats">
            <span class="font-semibold">@AppStrings.Base32Encoder_OtherFormats</span>
            <a class="link link-primary" href="/@Lang/hex-encoder">@AppStrings.Base32Encoder_LinkHex</a>
            <a class="link link-primary" href="/@Lang/base64-encoder">@AppStrings.Base32Encoder_LinkBase64</a>
            <a class="link link-primary" href="/@Lang/base58-encoder">@AppStrings.Base32Encoder_LinkBase58</a>
            <a class="link link-primary" href="/@Lang/url-encoder">@AppStrings.Base32Encoder_LinkUrl</a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="space-y-4">
                <div class="form-control w-full">
                    <label class="label" for="b32-input-text">
                        <span class="label-text font-semibold">@AppStrings.Base32Encoder_InputTextLabel</span>
                    </label>
                    <textarea id="b32-input-text" rows="10" class="textarea textarea-bordered w-full font-mono" placeholder="@AppStrings.Base32Encoder_InputTextPlaceholder"></textarea>
                </div>

                <FileDropInput InputId="b32-input-file"
                               Label="@AppStrings.Base32Encoder_InputFileLabel"
                               Hint="@AppStrings.Base32Encoder_FileHint" />

                <div class="collapse collapse-arrow bg-base-200">
                    <input type="checkbox" />
                    <div class="collapse-title font-semibold">Settings</div>
                    <div class="collapse-content space-y-4">
                        <div class="form-control w-full">
                            <label class="label" for="b32-charset">
                                <span class="label-text font-semibold">@AppStrings.Base32Encoder_CharsetLabel</span>
                            </label>
                            <select id="b32-charset" class="select select-bordered w-full">
                                <option value="utf-8">UTF-8</option>
                                <option value="utf-16le">UTF-16LE</option>
                                <option value="utf-16be">UTF-16BE</option>
                                <option value="ascii">ASCII</option>
                                <option value="latin1">ISO-8859-1 (Latin-1)</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label" for="b32-alphabet">
                                <span class="label-text font-semibold">@AppStrings.Base32Encoder_AlphabetLabel</span>
                            </label>
                            <select id="b32-alphabet" class="select select-bordered w-full">
                                <option value="rfc4648">@AppStrings.Base32Encoder_AlphabetRfc4648</option>
                                <option value="crockford">@AppStrings.Base32Encoder_AlphabetCrockford</option>
                                <option value="zbase32">@AppStrings.Base32Encoder_AlphabetZBase32</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label" for="b32-padding">
                                <span class="label-text font-semibold">@AppStrings.Base32Encoder_PaddingLabel</span>
                            </label>
                            <select id="b32-padding" class="select select-bordered w-full">
                                <option value="required">@AppStrings.Base32Encoder_PaddingRequired</option>
                                <option value="optional">@AppStrings.Base32Encoder_PaddingOptional</option>
                                <option value="none">@AppStrings.Base32Encoder_PaddingNone</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label" for="b32-case">
                                <span class="label-text font-semibold">@AppStrings.Base32Encoder_CaseLabel</span>
                            </label>
                            <select id="b32-case" class="select select-bordered w-full">
                                <option value="auto">@AppStrings.Base32Encoder_CaseAuto</option>
                                <option value="upper">@AppStrings.Base32Encoder_CaseUpper</option>
                                <option value="lower">@AppStrings.Base32Encoder_CaseLower</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label">
                                <span class="label-text font-semibold">@AppStrings.Base32Encoder_DecodeOptionsLabel</span>
                            </label>
                            <label class="label cursor-pointer justify-start gap-2">
                                <input id="b32-allow-whitespace" type="checkbox" checked class="checkbox" />
                                <span class="label-text">@AppStrings.Base32Encoder_AllowWhitespace</span>
                            </label>
                        </div>

                        <div class="form-control w-full">
                            <label class="label" for="b32-output-mode">
                                <span class="label-text font-semibold">@AppStrings.Base32Encoder_OutputModeLabel</span>
                            </label>
                            <select id="b32-output-mode" class="select select-bordered w-full">
                                <option value="preview">@AppStrings.Base32Encoder_OutputModePreview</option>
                                <option value="full">@AppStrings.Base32Encoder_OutputModeFull</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap gap-2">
                    <button class="btn btn-primary" id="b32-encode-btn" type="button">@AppStrings.Base32Encoder_ActionEncode</button>
                    <button class="btn btn-secondary" id="b32-decode-btn" type="button">@AppStrings.Base32Encoder_ActionDecode</button>
                    <button class="btn btn-secondary" id="b32-swap-btn" type="button">@AppStrings.Base32Encoder_ActionSwap</button>
                    <button class="btn btn-secondary" id="b32-clear-btn" type="button">@AppStrings.Base32Encoder_ActionClear</button>
                </div>

                <div class="alert alert-error" id="b32-error" hidden></div>
            </div>

            <div class="space-y-4" id="b32-output-section">
                <div class="form-control w-full">
                    <label class="label" for="b32-output">
                        <span class="label-text font-semibold">@AppStrings.Base32Encoder_OutputLabel</span>
                    </label>
                    <textarea id="b32-output" rows="10" readonly class="textarea textarea-bordered w-full font-mono"></textarea>
                </div>

                <div class="flex flex-wrap gap-2">
                    <button class="btn btn-secondary" id="b32-copy-btn" type="button">@AppStrings.Base32Encoder_Copy</button>
                    <button class="btn btn-secondary" id="b32-download-btn" type="button">@AppStrings.Base32Encoder_Download</button>
                </div>
            </div>
        </div>
    </div>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
