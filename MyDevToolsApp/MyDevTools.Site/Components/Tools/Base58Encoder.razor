@page "/{lang}/base58-encoder"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.Base58Encoder_Title"
          Description="@AppStrings.Base58Encoder_Description"
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="base58-encoder" />

<JsonLdTool ToolName="@AppStrings.Base58Encoder_Title"
            Description="@AppStrings.Base58Encoder_Description"
            CurrentUrl="@Navigation.Uri" />

<ToolLayout Title="@AppStrings.Base58Encoder_Title" Description="@AppStrings.Base58Encoder_Description">
    <div id="base58-encoder-root"
         data-loading="@AppStrings.Common_Loading"
         data-error="@AppStrings.Common_Error"
         data-file-progress-title="@AppStrings.Base58Encoder_FileProgressTitle"
         data-cancel="@AppStrings.Base58Encoder_Cancel"
         data-copy="@AppStrings.Base58Encoder_Copy"
         data-copied="@AppStrings.Base58Encoder_Copied"
         data-file-size-limit-encode="@AppStrings.Base58Encoder_FileSizeLimitEncode"
         data-file-size-limit-decode="@AppStrings.Base58Encoder_FileSizeLimitDecode">

        <div class="tool-links" aria-label="@AppStrings.Base58Encoder_OtherFormats">
            <span class="tool-links-title">@AppStrings.Base58Encoder_OtherFormats</span>
            <a class="tool-link" href="/@Lang/hex-encoder">@AppStrings.Base58Encoder_LinkHex</a>
            <a class="tool-link" href="/@Lang/base32-encoder">@AppStrings.Base58Encoder_LinkBase32</a>
            <a class="tool-link" href="/@Lang/base64-encoder">@AppStrings.Base58Encoder_LinkBase64</a>
            <a class="tool-link" href="/@Lang/url-encoder">@AppStrings.Base58Encoder_LinkUrl</a>
        </div>

        <div class="tool-grid">
            <div class="input-section">
                <label for="b58-input-text">@AppStrings.Base58Encoder_InputTextLabel</label>
                <textarea id="b58-input-text" rows="10" placeholder="@AppStrings.Base58Encoder_InputTextPlaceholder"></textarea>

                <label for="b58-input-file">@AppStrings.Base58Encoder_InputFileLabel</label>
                <input id="b58-input-file" type="file" />
                <div class="file-hint">@AppStrings.Base58Encoder_FileHint</div>

                <div class="tool-settings">
                    <div class="tool-setting">
                        <label for="b58-charset">@AppStrings.Base58Encoder_CharsetLabel</label>
                        <select id="b58-charset">
                            <option value="utf-8">UTF-8</option>
                            <option value="utf-16le">UTF-16LE</option>
                            <option value="utf-16be">UTF-16BE</option>
                            <option value="ascii">ASCII</option>
                            <option value="latin1">ISO-8859-1 (Latin-1)</option>
                        </select>
                    </div>

                    <div class="tool-setting">
                        <label for="b58-alphabet">@AppStrings.Base58Encoder_AlphabetLabel</label>
                        <select id="b58-alphabet">
                            <option value="bitcoin">@AppStrings.Base58Encoder_AlphabetBitcoin</option>
                            <option value="flickr">@AppStrings.Base58Encoder_AlphabetFlickr</option>
                            <option value="ripple">@AppStrings.Base58Encoder_AlphabetRipple</option>
                        </select>
                    </div>

                    <div class="tool-setting">
                        <label>@AppStrings.Base58Encoder_DecodeOptionsLabel</label>
                        <div class="tool-checkboxes">
                            <label class="tool-checkbox"><input id="b58-allow-whitespace" type="checkbox" checked /> @AppStrings.Base58Encoder_AllowWhitespace</label>
                        </div>
                    </div>

                    <div class="tool-setting">
                        <label for="b58-output-mode">@AppStrings.Base58Encoder_OutputModeLabel</label>
                        <select id="b58-output-mode">
                            <option value="preview">@AppStrings.Base58Encoder_OutputModePreview</option>
                            <option value="full">@AppStrings.Base58Encoder_OutputModeFull</option>
                        </select>
                    </div>
                </div>

                <div class="action-buttons">
                    <button class="btn btn-primary" id="b58-encode-btn" type="button">@AppStrings.Base58Encoder_ActionEncode</button>
                    <button class="btn btn-secondary" id="b58-decode-btn" type="button">@AppStrings.Base58Encoder_ActionDecode</button>
                    <button class="btn btn-secondary" id="b58-swap-btn" type="button">@AppStrings.Base58Encoder_ActionSwap</button>
                    <button class="btn btn-secondary" id="b58-clear-btn" type="button">@AppStrings.Base58Encoder_ActionClear</button>
                </div>

                <div class="tool-error" id="b58-error" hidden></div>
            </div>

            <div class="output-section" id="b58-output-section">
                <label for="b58-output">@AppStrings.Base58Encoder_OutputLabel</label>
                <textarea id="b58-output" rows="10" readonly></textarea>

                <div class="action-buttons">
                    <button class="btn btn-secondary" id="b58-copy-btn" type="button">@AppStrings.Base58Encoder_Copy</button>
                    <button class="btn btn-secondary" id="b58-download-btn" type="button">@AppStrings.Base58Encoder_Download</button>
                </div>
            </div>
        </div>
    </div>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
