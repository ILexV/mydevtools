@page "/{lang}/base58-encoder"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.Base58Encoder_Title"
          Description="@AppStrings.Base58Encoder_Description"
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="base58-encoder" />

<JsonLdTool ToolName="@AppStrings.Base58Encoder_Title"
            Description="@AppStrings.Base58Encoder_Description"
            CurrentUrl="@Navigation.Uri" />

<ToolLayout Title="@AppStrings.Base58Encoder_Title" Description="@AppStrings.Base58Encoder_Description">
    <div id="base58-encoder-root"
         data-loading="@AppStrings.Common_Loading"
         data-error="@AppStrings.Common_Error"
         data-file-progress-title="@AppStrings.Base58Encoder_FileProgressTitle"
         data-cancel="@AppStrings.Base58Encoder_Cancel"
         data-copy="@AppStrings.Base58Encoder_Copy"
         data-copied="@AppStrings.Base58Encoder_Copied"
         data-file-size-limit-encode="@AppStrings.Base58Encoder_FileSizeLimitEncode"
         data-file-size-limit-decode="@AppStrings.Base58Encoder_FileSizeLimitDecode">

        <div class="flex flex-wrap gap-2 items-center mb-4" aria-label="@AppStrings.Base58Encoder_OtherFormats">
            <span class="font-semibold">@AppStrings.Base58Encoder_OtherFormats</span>
            <a class="link link-primary" href="/@Lang/hex-encoder">@AppStrings.Base58Encoder_LinkHex</a>
            <a class="link link-primary" href="/@Lang/base32-encoder">@AppStrings.Base58Encoder_LinkBase32</a>
            <a class="link link-primary" href="/@Lang/base64-encoder">@AppStrings.Base58Encoder_LinkBase64</a>
            <a class="link link-primary" href="/@Lang/url-encoder">@AppStrings.Base58Encoder_LinkUrl</a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="space-y-4">
                <div class="form-control w-full">
                    <label class="label" for="b58-input-text">
                        <span class="label-text font-semibold">@AppStrings.Base58Encoder_InputTextLabel</span>
                    </label>
                    <textarea id="b58-input-text" rows="10" class="textarea textarea-bordered w-full font-mono" placeholder="@AppStrings.Base58Encoder_InputTextPlaceholder"></textarea>
                </div>

                <FileDropInput InputId="b58-input-file"
                               Label="@AppStrings.Base58Encoder_InputFileLabel"
                               Hint="@AppStrings.Base58Encoder_FileHint" />

                <div class="collapse collapse-arrow bg-base-200">
                    <input type="checkbox" />
                    <div class="collapse-title font-semibold">Settings</div>
                    <div class="collapse-content space-y-4">
                        <div class="form-control w-full">
                            <label class="label" for="b58-charset">
                                <span class="label-text font-semibold">@AppStrings.Base58Encoder_CharsetLabel</span>
                            </label>
                            <select id="b58-charset" class="select select-bordered w-full">
                                <option value="utf-8">UTF-8</option>
                                <option value="utf-16le">UTF-16LE</option>
                                <option value="utf-16be">UTF-16BE</option>
                                <option value="ascii">ASCII</option>
                                <option value="latin1">ISO-8859-1 (Latin-1)</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label" for="b58-alphabet">
                                <span class="label-text font-semibold">@AppStrings.Base58Encoder_AlphabetLabel</span>
                            </label>
                            <select id="b58-alphabet" class="select select-bordered w-full">
                                <option value="bitcoin">@AppStrings.Base58Encoder_AlphabetBitcoin</option>
                                <option value="flickr">@AppStrings.Base58Encoder_AlphabetFlickr</option>
                                <option value="ripple">@AppStrings.Base58Encoder_AlphabetRipple</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label">
                                <span class="label-text font-semibold">@AppStrings.Base58Encoder_DecodeOptionsLabel</span>
                            </label>
                            <label class="label cursor-pointer justify-start gap-2">
                                <input id="b58-allow-whitespace" type="checkbox" checked class="checkbox" />
                                <span class="label-text">@AppStrings.Base58Encoder_AllowWhitespace</span>
                            </label>
                        </div>

                        <div class="form-control w-full">
                            <label class="label" for="b58-output-mode">
                                <span class="label-text font-semibold">@AppStrings.Base58Encoder_OutputModeLabel</span>
                            </label>
                            <select id="b58-output-mode" class="select select-bordered w-full">
                                <option value="preview">@AppStrings.Base58Encoder_OutputModePreview</option>
                                <option value="full">@AppStrings.Base58Encoder_OutputModeFull</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap gap-2">
                    <button class="btn btn-primary" id="b58-encode-btn" type="button">@AppStrings.Base58Encoder_ActionEncode</button>
                    <button class="btn btn-secondary" id="b58-decode-btn" type="button">@AppStrings.Base58Encoder_ActionDecode</button>
                    <button class="btn btn-secondary" id="b58-swap-btn" type="button">@AppStrings.Base58Encoder_ActionSwap</button>
                    <button class="btn btn-secondary" id="b58-clear-btn" type="button">@AppStrings.Base58Encoder_ActionClear</button>
                </div>

                <div class="alert alert-error" id="b58-error" style="display: none;"></div>
            </div>

            <div class="space-y-4" id="b58-output-section">
                <div class="form-control w-full">
                    <label class="label" for="b58-output">
                        <span class="label-text font-semibold">@AppStrings.Base58Encoder_OutputLabel</span>
                    </label>
                    <textarea id="b58-output" rows="10" readonly class="textarea textarea-bordered w-full font-mono"></textarea>
                </div>

                <div class="flex flex-wrap gap-2">
                    <button class="btn btn-secondary" id="b58-copy-btn" type="button">@AppStrings.Base58Encoder_Copy</button>
                    <button class="btn btn-secondary" id="b58-download-btn" type="button">@AppStrings.Base58Encoder_Download</button>
                </div>
            </div>
        </div>
    </div>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
