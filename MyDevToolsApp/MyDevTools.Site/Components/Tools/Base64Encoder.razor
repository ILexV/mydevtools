@page "/{lang}/base64-encoder"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.Base64Encoder_Title"
          Description="@AppStrings.Base64Encoder_Description"
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="base64-encoder" />

<JsonLdTool ToolName="@AppStrings.Base64Encoder_Title"
            Description="@AppStrings.Base64Encoder_Description"
            CurrentUrl="@Navigation.Uri" />

<ToolLayout Title="@AppStrings.Base64Encoder_Title" Description="@AppStrings.Base64Encoder_Description">
    <div id="base64-encoder-root"
         data-loading="@AppStrings.Common_Loading"
         data-error="@AppStrings.Common_Error"
         data-file-progress-title="@AppStrings.Base64Encoder_FileProgressTitle"
         data-cancel="@AppStrings.Base64Encoder_Cancel"
         data-copy="@AppStrings.Base64Encoder_Copy"
         data-copied="@AppStrings.Base64Encoder_Copied">

        <div class="flex flex-wrap gap-2 items-center mb-4" aria-label="@AppStrings.Base64Encoder_OtherFormats">
            <span class="font-semibold opacity-70">@AppStrings.Base64Encoder_OtherFormats</span>
            <a class="link link-primary" href="/@Lang/hex-encoder">@AppStrings.Base64Encoder_LinkHex</a>
            <a class="link link-primary" href="/@Lang/base32-encoder">@AppStrings.Base64Encoder_LinkBase32</a>
            <a class="link link-primary" href="/@Lang/base58-encoder">@AppStrings.Base64Encoder_LinkBase58</a>
            <a class="link link-primary" href="/@Lang/url-encoder">@AppStrings.Base64Encoder_LinkUrl</a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="space-y-4">
                <div class="form-control w-full">
                    <label class="label" for="b64-input-text">
                        <span class="label-text font-semibold">@AppStrings.Base64Encoder_InputTextLabel</span>
                    </label>
                    <textarea id="b64-input-text" rows="10" class="textarea textarea-bordered w-full font-mono" placeholder="@AppStrings.Base64Encoder_InputTextPlaceholder"></textarea>
                </div>

                <div class="form-control w-full">
                    <label class="label" for="b64-input-file">
                        <span class="label-text font-semibold">@AppStrings.Base64Encoder_InputFileLabel</span>
                    </label>
                    <FileDropZone
                        Id="b64-drop-zone"
                        InputId="b64-input-file"
                        IconSvg='<svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>'
                        Description="@AppStrings.Common_FileDropTitle"
                        Accept="*/*"
                        ShowFileInfo="true"
                        ShowClearButton="true" />
                    @if (!string.IsNullOrWhiteSpace(AppStrings.Base64Encoder_FileHint))
                    {
                        <label class="label">
                            <span class="label-text-alt opacity-70">@AppStrings.Base64Encoder_FileHint</span>
                        </label>
                    }
                </div>

                <div class="collapse collapse-arrow bg-base-200">
                    <input type="checkbox" />
                    <div class="collapse-title text-lg font-semibold">@AppStrings.Base64Encoder_CharsetLabel</div>
                    <div class="collapse-content space-y-4">
                        <div class="form-control w-full">
                            <label class="label" for="b64-charset">
                                <span class="label-text">@AppStrings.Base64Encoder_CharsetLabel</span>
                            </label>
                            <select id="b64-charset" class="select select-bordered w-full">
                                <option value="utf-8">UTF-8</option>
                                <option value="utf-16le">UTF-16LE</option>
                                <option value="utf-16be">UTF-16BE</option>
                                <option value="ascii">ASCII</option>
                                <option value="latin1">ISO-8859-1 (Latin-1)</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label" for="b64-alphabet">
                                <span class="label-text">@AppStrings.Base64Encoder_AlphabetLabel</span>
                            </label>
                            <select id="b64-alphabet" class="select select-bordered w-full">
                                <option value="standard">@AppStrings.Base64Encoder_AlphabetStandard</option>
                                <option value="urlsafe">@AppStrings.Base64Encoder_AlphabetUrlSafe</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label" for="b64-padding">
                                <span class="label-text">@AppStrings.Base64Encoder_PaddingLabel</span>
                            </label>
                            <select id="b64-padding" class="select select-bordered w-full">
                                <option value="required">@AppStrings.Base64Encoder_PaddingRequired</option>
                                <option value="optional">@AppStrings.Base64Encoder_PaddingOptional</option>
                                <option value="none">@AppStrings.Base64Encoder_PaddingNone</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label" for="b64-wrap">
                                <span class="label-text">@AppStrings.Base64Encoder_LineWrapLabel</span>
                            </label>
                            <select id="b64-wrap" class="select select-bordered w-full">
                                <option value="none">@AppStrings.Base64Encoder_LineWrapNone</option>
                                <option value="76">@AppStrings.Base64Encoder_LineWrap76</option>
                            </select>
                        </div>

                        <div class="form-control">
                            <label class="label">
                                <span class="label-text">@AppStrings.Base64Encoder_DecodeOptionsLabel</span>
                            </label>
                            <label class="label cursor-pointer justify-start gap-3">
                                <input id="b64-allow-whitespace" type="checkbox" class="checkbox" checked />
                                <span class="label-text">@AppStrings.Base64Encoder_AllowWhitespace</span>
                            </label>
                        </div>

                        <div class="form-control w-full">
                            <label class="label" for="b64-output-mode">
                                <span class="label-text">@AppStrings.Base64Encoder_OutputModeLabel</span>
                            </label>
                            <select id="b64-output-mode" class="select select-bordered w-full">
                                <option value="preview">@AppStrings.Base64Encoder_OutputModePreview</option>
                                <option value="full">@AppStrings.Base64Encoder_OutputModeFull</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap gap-2">
                    <button class="btn btn-primary" id="b64-encode-btn" type="button">@AppStrings.Base64Encoder_ActionEncode</button>
                    <button class="btn btn-secondary" id="b64-decode-btn" type="button">@AppStrings.Base64Encoder_ActionDecode</button>
                    <button class="btn btn-secondary" id="b64-swap-btn" type="button">@AppStrings.Base64Encoder_ActionSwap</button>
                    <button class="btn btn-secondary" id="b64-clear-btn" type="button">@AppStrings.Base64Encoder_ActionClear</button>
                </div>

                <div class="alert alert-error" id="b64-error" style="display: none;"></div>
            </div>

            <div class="space-y-4" id="b64-output-section">
                <div class="form-control w-full">
                    <label class="label" for="b64-output">
                        <span class="label-text font-semibold">@AppStrings.Base64Encoder_OutputLabel</span>
                    </label>
                    <textarea id="b64-output" rows="10" class="textarea textarea-bordered w-full font-mono" readonly></textarea>
                </div>

                <div class="flex flex-wrap gap-2">
                    <button class="btn btn-secondary" id="b64-copy-btn" type="button">@AppStrings.Base64Encoder_Copy</button>
                    <button class="btn btn-secondary" id="b64-download-btn" type="button">@AppStrings.Base64Encoder_Download</button>
                </div>
            </div>
        </div>
    </div>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
