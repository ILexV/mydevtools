@page "/{lang}/cron-parser"
@inject NavigationManager Navigation
@inherits ToolComponentBase

<ToolLayout Title="@T("Title")" Description="@T("Description")">
    <MetaTags Title="@T("Title")"
              Description="@T("Description")"
              CurrentUrl="@Navigation.Uri"
              ToolPath="cron-parser" />

    <div id="cron-parser-root"
         data-loading="@TCommon("Common_Loading")"
         data-error="@TCommon("Common_Error")"
         data-tab-parser="@T("TabParser")"
         data-tab-generator="@T("TabGenerator")"
         data-copy="@T("Copy")"
         data-copied="@T("Copied")"
         data-schedule-reboot="@T("ScheduleReboot")"
         data-schedule-yearly="@T("ScheduleYearly")"
         data-schedule-monthly="@T("ScheduleMonthly")"
         data-schedule-weekly="@T("ScheduleWeekly")"
         data-schedule-daily="@T("ScheduleDaily")"
         data-schedule-hourly="@T("ScheduleHourly")"
         data-schedule-every-minute="@T("ScheduleEveryMinute")"
         data-schedule-every-n-minutes="@T("ScheduleEveryNMinutes")"
         data-schedule-at-minute="@T("ScheduleAtMinute")"
         data-schedule-at-minutes="@T("ScheduleAtMinutes")"
         data-schedule-every-hour="@T("ScheduleEveryHour")"
         data-schedule-every-n-hours="@T("ScheduleEveryNHours")"
         data-schedule-at-hour="@T("ScheduleAtHour")"
         data-schedule-at-hours="@T("ScheduleAtHours")"
         data-schedule-every-day="@T("ScheduleEveryDay")"
         data-schedule-on-day="@T("ScheduleOnDay")"
         data-schedule-on-days="@T("ScheduleOnDays")"
         data-schedule-last-day="@T("ScheduleLastDay")"
         data-schedule-on-weekday="@T("ScheduleOnWeekday")"
         data-schedule-on-weekdays="@T("ScheduleOnWeekdays")"
         data-schedule-in-month="@T("ScheduleInMonth")"
         data-schedule-in-months="@T("ScheduleInMonths")"
          data-months="@T("MonthNames")"
          data-weekdays="@T("WeekdayNames")">

        <!-- Tabs -->
        <div class="tabs tabs-boxed justify-center mb-6">
            <button class="tab tab-active" id="cron-tab-parser" data-tab="parser">@T("TabParser")</button>
            <button class="tab" id="cron-tab-generator" data-tab="generator">@T("TabGenerator")</button>
        </div>

        <!-- Parser Tab Content -->
        <div id="cron-parser-panel" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Input Section -->
            <div class="card bg-base-200 shadow-xl h-fit">
                <div class="card-body">
                    <h2 class="card-title text-base opacity-70 mb-4">@T("InputLabel")</h2>

                    <!-- Cron Input -->
                    <div class="form-control">
                        <input id="cron-input" type="text" class="input input-bordered font-mono text-lg" 
                               placeholder="@T("InputPlaceholder")" value="* * * * *" />
                    </div>

                    <!-- Presets -->
                    <div class="mt-4">
                        <label class="label py-1">
                            <span class="label-text font-semibold text-sm">@T("PresetsLabel")</span>
                        </label>
                        <div class="flex flex-wrap gap-2">
                            <button class="btn btn-xs btn-ghost" data-preset="0 * * * *" title="@T("PresetHourAt0Title")">@T("PresetEveryHour")</button>
                            <button class="btn btn-xs btn-ghost" data-preset="0 */6 * * *" title="@T("PresetEvery6HoursTitle")">@T("PresetEvery6Hours")</button>
                            <button class="btn btn-xs btn-ghost" data-preset="0 2 * * *" title="@T("PresetDaily2AMTitle")">@T("PresetDaily2AM")</button>
                            <button class="btn btn-xs btn-ghost" data-preset="0 9 * * 1-5" title="@T("PresetWeekdays9AMTitle")">@T("PresetWeekdays9AM")</button>
                            <button class="btn btn-xs btn-ghost" data-preset="@@weekly">@T("PresetWeekly")</button>
                            <button class="btn btn-xs btn-ghost" data-preset="@@daily">@T("PresetDaily")</button>
                            <button class="btn btn-xs btn-ghost" data-preset="@@hourly">@T("PresetHourly")</button>
                            <button class="btn btn-xs btn-ghost" data-preset="@@reboot">@T("PresetReboot")</button>
                            <button class="btn btn-xs btn-ghost" data-preset="@@monthly">@T("PresetMonthly")</button>
                            <button class="btn btn-xs btn-ghost" data-preset="@@yearly">@T("PresetYearly")</button>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="card-actions mt-6 flex gap-2">
                        <button class="btn btn-primary flex-1" id="cron-parse-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                            </svg>
                            @T("ActionParse")
                        </button>
                        <button class="btn btn-ghost btn-square" id="cron-clear-btn" title="@T("ActionClear")">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                        </button>
                    </div>

                    <!-- Error -->
                    <div class="alert alert-error mt-4 hidden" id="cron-error"></div>
                </div>
            </div>

            <!-- Results Section -->
            <div class="card bg-base-200 shadow-xl h-fit">
                <div class="card-body">
                    <h2 class="card-title text-base opacity-70 mb-4">@T("ResultsLabel")</h2>

                    <!-- Human Readable -->
                    <div class="form-control">
                        <label class="label py-1">
                            <span class="label-text font-semibold">@T("HumanReadableLabel")</span>
                        </label>
                        <div id="cron-human-readable" class="p-4 bg-base-100 rounded-lg min-h-[3rem] text-base-content/80">
                            @T("ParseToSeeResult")
                        </div>
                    </div>

                    <!-- Next Executions -->
                    <div class="form-control mt-4">
                        <label class="label py-1">
                            <span class="label-text font-semibold">@T("NextExecutionsLabel")</span>
                        </label>
                        <div id="cron-next-executions" class="space-y-2">
                            <!-- Dynamically populated -->
                        </div>
                    </div>

                    <!-- Parts Breakdown -->
                    <div class="mt-4">
                        <label class="label py-1">
                            <span class="label-text font-semibold">@T("PartsLabel")</span>
                        </label>
                        <div class="grid grid-cols-5 gap-2 text-center text-xs" id="cron-parts">
                            <div class="bg-base-100 p-2 rounded">
                                <div class="font-mono font-bold text-primary" id="cron-part-minute">*</div>
                                <div class="opacity-60 mt-1">@T("PartMinute")</div>
                            </div>
                            <div class="bg-base-100 p-2 rounded">
                                <div class="font-mono font-bold text-primary" id="cron-part-hour">*</div>
                                <div class="opacity-60 mt-1">@T("PartHour")</div>
                            </div>
                            <div class="bg-base-100 p-2 rounded">
                                <div class="font-mono font-bold text-primary" id="cron-part-day">*</div>
                                <div class="opacity-60 mt-1">@T("PartDay")</div>
                            </div>
                            <div class="bg-base-100 p-2 rounded">
                                <div class="font-mono font-bold text-primary" id="cron-part-month">*</div>
                                <div class="opacity-60 mt-1">@T("PartMonth")</div>
                            </div>
                            <div class="bg-base-100 p-2 rounded">
                                <div class="font-mono font-bold text-primary" id="cron-part-weekday">*</div>
                                <div class="opacity-60 mt-1">@T("PartWeekday")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Generator Tab Content (Hidden by default) -->
        <div id="cron-generator-panel" class="hidden grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Generator Input -->
            <div class="card bg-base-200 shadow-xl h-fit">
                <div class="card-body">
                    <h2 class="card-title text-base opacity-70 mb-4">@T("GeneratorTitle")</h2>

                    <!-- Minute -->
                    <div class="form-control">
                        <label class="label py-1" for="cron-gen-minute">
                            <span class="label-text font-semibold">@T("MinuteLabel")</span>
                        </label>
                        <input id="cron-gen-minute" type="text" class="input input-bordered font-mono" value="0" placeholder="0-59, *, */5, 1,2,3" />
                        <label class="label py-0">
                            <span class="label-text-alt text-xs opacity-60">@T("FieldHintExamples")</span>
                        </label>
                    </div>

                    <!-- Hour -->
                    <div class="form-control mt-3">
                        <label class="label py-1" for="cron-gen-hour">
                            <span class="label-text font-semibold">@T("HourLabel")</span>
                        </label>
                        <input id="cron-gen-hour" type="text" class="input input-bordered font-mono" value="*" placeholder="0-23, *, */2" />
                    </div>

                    <!-- Day of Month -->
                    <div class="form-control mt-3">
                        <label class="label py-1" for="cron-gen-day">
                            <span class="label-text font-semibold">@T("DayLabel")</span>
                        </label>
                        <input id="cron-gen-day" type="text" class="input input-bordered font-mono" value="*" placeholder="1-31, *, L, 1-15" />
                    </div>

                    <!-- Month -->
                    <div class="form-control mt-3">
                        <label class="label py-1" for="cron-gen-month">
                            <span class="label-text font-semibold">@T("MonthLabel")</span>
                        </label>
                        <input id="cron-gen-month" type="text" class="input input-bordered font-mono" value="*" placeholder="1-12, *, JAN-DEC" />
                    </div>

                    <!-- Day of Week -->
                    <div class="form-control mt-3">
                        <label class="label py-1" for="cron-gen-weekday">
                            <span class="label-text font-semibold">@T("WeekdayLabel")</span>
                        </label>
                        <input id="cron-gen-weekday" type="text" class="input input-bordered font-mono" value="*" placeholder="0-6, *, 1-5, MON-FRI" />
                    </div>

                    <!-- Actions -->
                    <div class="card-actions mt-6">
                        <button class="btn btn-primary w-full" id="cron-generate-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                            </svg>
                            @T("ActionGenerate")
                        </button>
                    </div>

                    <!-- Error -->
                    <div class="alert alert-error mt-4 hidden" id="cron-gen-error"></div>
                </div>
            </div>

            <!-- Generator Output -->
            <div class="card bg-base-200 shadow-xl h-fit">
                <div class="card-body">
                    <h2 class="card-title text-base opacity-70 mb-4">@T("GeneratedExpressionLabel")</h2>

                    <!-- Generated Expression -->
                    <div class="form-control">
                        <div class="relative">
                            <input id="cron-generated" type="text" class="input input-bordered font-mono text-lg w-full pr-12" readonly />
                            <button class="btn btn-ghost btn-sm absolute right-2 top-1/2 -translate-y-1/2" id="cron-copy-generated-btn" title="@T("Copy")">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="form-control mt-4">
                        <label class="label py-1">
                            <span class="label-text font-semibold">@T("DescriptionLabel")</span>
                        </label>
                        <div id="cron-gen-description" class="p-4 bg-base-100 rounded-lg min-h-[3rem] text-base-content/80">
                            @T("GenerateToSeeResult")
                        </div>
                    </div>

                    <!-- Next Executions Preview -->
                    <div class="form-control mt-4">
                        <label class="label py-1">
                            <span class="label-text font-semibold">@T("NextExecutionsPreviewLabel")</span>
                        </label>
                        <div id="cron-gen-next-executions" class="space-y-2">
                            <!-- Dynamically populated -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <ToolSeoContent 
        Introduction="@T("Seo_Introduction")"
        DetailedDescription="@T("Seo_DetailedDescription")"
        DetailedDescriptionTitle="@TCommon("Seo_DetailedDescriptionTitle")"
        Examples="@T("Seo_Examples")"
        ExamplesTitle="@TCommon("Seo_ExamplesTitle")"
        HowToSteps="@T("Seo_HowToSteps")"
        HowToTitle="@TCommon("Seo_HowToTitle")"
        Tips="@T("Seo_Tips")"
        TipsTitle="@TCommon("Seo_TipsTitle")" />
</ToolLayout>

<script src="/tools/cron-parser.js"></script>

@code {
    protected override string LocalizationNamespace { get; set; } = "tools/cron-parser";
}
