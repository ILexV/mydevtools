@page "/{lang}/date-converter"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<ToolLayout Title="@AppStrings.DateConverter_Title" Description="@AppStrings.DateConverter_Description">
    <MetaTags Title="@AppStrings.DateConverter_Title"
              Description="@AppStrings.DateConverter_Description"
              CurrentUrl="@Navigation.Uri" />

    <HreflangLinks ToolPath="date-converter" />

    <JsonLdTool ToolName="@AppStrings.DateConverter_Title"
            Description="@AppStrings.DateConverter_Description"
            CurrentUrl="@Navigation.Uri" />

    <div id="date-converter-root"
         data-error-invalid="@AppStrings.DateConverter_Error_Invalid"
         data-copied="@AppStrings.DateConverter_Copied"
         class="max-w-5xl mx-auto">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            
            <!-- Input Card -->
            <div class="card bg-base-100 shadow-xl h-fit">
                <div class="card-body p-4 sm:p-6">
                    <h2 class="card-title text-primary flex items-center gap-2 mb-2">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                        @AppStrings.DateConverter_InputLabel
                    </h2>

                    <div class="form-control w-full">
                        <label class="label font-semibold" for="date-input-type">
                            @AppStrings.DateConverter_InputTypeLabel
                        </label>
                        <select id="date-input-type" class="select select-bordered w-full">
                            <option value="auto">@AppStrings.DateConverter_InputType_Auto</option>
                            <option value="unix-sec">@AppStrings.DateConverter_InputType_UnixSec</option>
                            <option value="unix-ms">@AppStrings.DateConverter_InputType_UnixMs</option>
                            <option value="iso">@AppStrings.DateConverter_InputType_ISO</option>
                        </select>
                    </div>

                    <div class="form-control w-full mt-4">
                        <label class="label font-semibold" for="date-input">
                            @AppStrings.DateConverter_InputLabel
                        </label>
                        <textarea id="date-input" rows="4" class="textarea textarea-bordered w-full font-mono text-lg" placeholder="1735689600 or 2025-01-01T00:00:00Z"></textarea>
                    </div>

                    <div class="card-actions justify-end mt-6 gap-2">
                        <button class="btn btn-secondary" id="date-now-btn" type="button">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-1">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            @AppStrings.DateConverter_ActionCurrentTime
                        </button>
                        <button class="btn btn-primary" id="date-convert-btn" type="button">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-1">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                            </svg>
                            @AppStrings.DateConverter_ActionConvert
                        </button>
                    </div>
                    
                    <div class="alert alert-error mt-4 hidden" id="date-error">
                        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span id="date-error-text"></span>
                    </div>
                </div>
            </div>

            <!-- Output Card -->
            <div class="card bg-base-100 shadow-xl h-fit">
                <div class="card-body p-4 sm:p-6">
                    <h2 class="card-title text-secondary flex items-center gap-2 mb-2">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                        @AppStrings.DateConverter_OutputLabel
                    </h2>

                    <div class="form-control w-full">
                        <label class="label font-semibold" for="date-output-format">
                            @AppStrings.DateConverter_OutputFormatLabel
                        </label>
                        <select id="date-output-format" class="select select-bordered w-full">
                            <option value="iso">@AppStrings.DateConverter_Format_ISO</option>
                            <option value="euro">@AppStrings.DateConverter_Format_European</option>
                            <option value="utc">@AppStrings.DateConverter_Format_UTC</option>
                            <option value="local">@AppStrings.DateConverter_Format_Local</option>
                            <option value="rfc">@AppStrings.DateConverter_Format_RFC</option>
                            <option value="unix-sec">@AppStrings.DateConverter_Format_UnixSec</option>
                            <option value="unix-ms">@AppStrings.DateConverter_Format_UnixMs</option>
                            <option value="custom">@AppStrings.DateConverter_Format_Custom</option>
                        </select>
                    </div>

                    <div id="date-custom-fmt-container" class="form-control w-full mt-4 hidden">
                        <label class="label font-semibold" for="date-output-custom-fmt">Custom Format</label>
                        <input id="date-output-custom-fmt" type="text" class="input input-bordered w-full font-mono" placeholder="@AppStrings.DateConverter_CustomFormatPlaceholder" value="dd.MM.yyyy HH:mm:ss" />
                        <label class="label">
                            <span class="label-text-alt opacity-70">Use: yyyy, MM, dd, HH, mm, ss, SSS</span>
                        </label>
                    </div>

                    <div class="form-control w-full mt-4">
                        <label class="label font-semibold" for="date-output">
                            Result
                        </label>
                        <div class="relative">
                            <textarea id="date-output" rows="4" readonly class="textarea textarea-bordered w-full font-mono text-lg pr-12 bg-base-200 text-base-content/70"></textarea>
                            <button class="btn btn-sm btn-ghost absolute right-2 top-2" id="date-copy-btn" title="@AppStrings.DateConverter_Copy">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="/tools/date-converter.js"></script>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
