@page "/{lang}/hash-calculator"
@using MyDevTools.Site.Resources
@using System.Text.Json
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.HashCalculator_Title" 
          Description="@AppStrings.HashCalculator_Description" 
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="hash-calculator" />

<JsonLdTool ToolName="@AppStrings.HashCalculator_Title" 
            Description="@AppStrings.HashCalculator_Description" 
            CurrentUrl="@Navigation.Uri"
            SupportedAlgorithms="@SupportedHashAlgorithms" />

<ToolLayout Title="@AppStrings.HashCalculator_Title" Description="@AppStrings.HashCalculator_Description">
    <div id="hash-calculator-root"
         data-loading="@AppStrings.Common_Loading"
         data-error="@AppStrings.Common_Error"
         data-calculate="@AppStrings.HashCalculator_Calculate"
         data-file-progress-title="@AppStrings.HashCalculator_FileProgressTitle"
         data-cancel="@AppStrings.HashCalculator_Cancel"
         data-copy="@AppStrings.HashCalculator_Copy"
         data-copied="@AppStrings.HashCalculator_Copied"
         data-algorithms-title="@AppStrings.HashCalculator_AlgorithmsTitle"
         data-algorithms-selected="@AppStrings.HashCalculator_AlgorithmsSelected"
         data-algorithms-available="@AppStrings.HashCalculator_AlgorithmsAvailable"
         data-algorithms-search="@AppStrings.HashCalculator_AlgorithmsSearchPlaceholder"
         data-algorithms-reset="@AppStrings.HashCalculator_AlgorithmsReset"
         data-algorithms-select-one="@AppStrings.HashCalculator_SelectAtLeastOneAlgorithm"
         data-canceled="Canceled">

        <div class="hash-grid">
            <div class="input-section hash-inputs">
                <label for="input-text">@AppStrings.HashCalculator_InputLabel</label>
                <textarea id="input-text" 
                          placeholder="@AppStrings.HashCalculator_InputPlaceholder"
                          rows="10"></textarea>

                <FileDropInput InputId="input-file"
                               Label="@AppStrings.HashCalculator_FileLabel"
                               Hint="@AppStrings.HashCalculator_FileHint" />
                
                <div class="action-buttons">
                    <button class="btn btn-primary" id="calculate-btn">
                        @AppStrings.HashCalculator_Calculate
                    </button>
                    <button class="btn btn-secondary" id="clear-btn">
                        @AppStrings.HashCalculator_Clear
                    </button>
                </div>
            </div>

            <div class="output-section hash-results" id="output-section">
                <!-- Results will be rendered here by JavaScript -->
            </div>

            <div class="hash-algos">
                <div class="algo-picker" id="hash-algo-picker">
                    <div class="algo-picker-header">
                        <div class="algo-picker-title" id="hash-algo-title"></div>
                        <div class="algo-picker-actions">
                            <div class="algo-selected-count" id="hash-algo-selected-count"></div>
                            <button class="btn btn-secondary btn-small" id="hash-algo-reset-btn" type="button"></button>
                        </div>
                    </div>
                    <input class="algo-search" id="hash-algo-search" type="search" />

                    <div class="algo-groups">
                        <div class="algo-group">
                            <div class="algo-group-title" id="hash-algo-selected-title"></div>
                            <div class="algo-list" id="hash-algo-selected-list"></div>
                        </div>

                        <div class="algo-group">
                            <div class="algo-group-title" id="hash-algo-available-title"></div>
                            <div class="algo-list" id="hash-algo-available-list"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="application/json" id="hash-algorithms-data">
        @((MarkupString)JsonSerializer.Serialize(SupportedHashAlgorithms.Select(x => new { label = x.Key, id = x.Value })))
    </script>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";

    private static readonly IReadOnlyDictionary<string, string> SupportedHashAlgorithms =
        new Dictionary<string, string>
        {
            ["MD5"] = "md5",
            ["SHA-1"] = "sha1",
            ["SHA-224"] = "sha224",
            ["SHA-256"] = "sha256",
            ["SHA-384"] = "sha384",
            ["SHA-512"] = "sha512",
            ["SHA-512/224"] = "sha512-224",
            ["SHA-512/256"] = "sha512-256",
            ["Streebog-256 (ГОСТ Р 34.11-2012)"] = "streebog-256",
            ["Streebog-512 (ГОСТ Р 34.11-2012)"] = "streebog-512",
            ["SHA-3-224"] = "sha3-224",
            ["SHA-3-256"] = "sha3-256",
            ["SHA-3-384"] = "sha3-384",
            ["SHA-3-512"] = "sha3-512",
            ["Keccak-224"] = "keccak-224",
            ["Keccak-256"] = "keccak-256",
            ["Keccak-384"] = "keccak-384",
            ["Keccak-512"] = "keccak-512",
            ["SHAKE128-256"] = "shake128-256",
            ["SHAKE256-256"] = "shake256-256",
            ["BLAKE3"] = "blake3",
            ["BLAKE2b-512"] = "blake2b-512",
            ["BLAKE2s-256"] = "blake2s-256",
            ["RIPEMD-160"] = "ripemd-160",
            ["RIPEMD-128"] = "ripemd-128",
            ["RIPEMD-256"] = "ripemd-256",
            ["RIPEMD-320"] = "ripemd-320",
            ["CRC32"] = "crc32",
            ["Adler-32"] = "adler32",
            ["xxh32"] = "xxh32",
            ["xxh64"] = "xxh64",
            ["xxh3-64"] = "xxh3-64",
            ["SipHash-1-3"] = "siphash-1-3",
            ["SipHash-2-4"] = "siphash-2-4",
            ["HighwayHash64"] = "highwayhash64",
            ["MetroHash64"] = "metrohash64",
            ["FxHash64"] = "fxhash64",
            ["FNV-1a 64"] = "fnv1a64",
            ["SeaHash64"] = "seahash64",
        };
}