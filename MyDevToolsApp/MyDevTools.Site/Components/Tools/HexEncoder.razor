@page "/{lang}/hex-encoder"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.HexEncoder_Title"
          Description="@AppStrings.HexEncoder_Description"
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="hex-encoder" />

<JsonLdTool ToolName="@AppStrings.HexEncoder_Title"
            Description="@AppStrings.HexEncoder_Description"
            CurrentUrl="@Navigation.Uri" />

<ToolLayout Title="@AppStrings.HexEncoder_Title" Description="@AppStrings.HexEncoder_Description">
    <div id="hex-encoder-root"
         data-loading="@AppStrings.Common_Loading"
         data-error="@AppStrings.Common_Error"
         data-file-progress-title="@AppStrings.HexEncoder_FileProgressTitle"
         data-cancel="@AppStrings.HexEncoder_Cancel"
         data-copy="@AppStrings.HexEncoder_Copy"
         data-copied="@AppStrings.HexEncoder_Copied">

        <div class="tool-links" aria-label="@AppStrings.HexEncoder_OtherFormats">
            <span class="tool-links-title">@AppStrings.HexEncoder_OtherFormats</span>
            <a class="tool-link" href="/@Lang/url-encoder">@AppStrings.HexEncoder_LinkUrl</a>
            <a class="tool-link" href="/@Lang/base32-encoder">@AppStrings.HexEncoder_LinkBase32</a>
            <a class="tool-link" href="/@Lang/base58-encoder">@AppStrings.HexEncoder_LinkBase58</a>
            <a class="tool-link" href="/@Lang/base64-encoder">@AppStrings.HexEncoder_LinkBase64</a>
        </div>

        <div class="tool-grid">
            <div class="input-section">
                <label for="hex-input-text">@AppStrings.HexEncoder_InputTextLabel</label>
                <textarea id="hex-input-text" rows="10" placeholder="@AppStrings.HexEncoder_InputTextPlaceholder"></textarea>

                <label for="hex-input-file">@AppStrings.HexEncoder_InputFileLabel</label>
                <input id="hex-input-file" type="file" />
                <div class="file-hint">@AppStrings.HexEncoder_FileHint</div>

                <div class="tool-settings">
                    <div class="tool-setting">
                        <label for="hex-charset">@AppStrings.HexEncoder_CharsetLabel</label>
                        <select id="hex-charset">
                            <option value="utf-8">UTF-8</option>
                            <option value="utf-16le">UTF-16LE</option>
                            <option value="utf-16be">UTF-16BE</option>
                            <option value="ascii">ASCII</option>
                            <option value="latin1">ISO-8859-1 (Latin-1)</option>
                        </select>
                    </div>

                    <div class="tool-setting">
                        <label for="hex-case">@AppStrings.HexEncoder_CaseLabel</label>
                        <select id="hex-case">
                            <option value="lower">@AppStrings.HexEncoder_CaseLower</option>
                            <option value="upper">@AppStrings.HexEncoder_CaseUpper</option>
                        </select>
                    </div>

                    <div class="tool-setting">
                        <label>@AppStrings.HexEncoder_DecodeOptionsLabel</label>
                        <div class="tool-checkboxes">
                            <label class="tool-checkbox"><input id="hex-ignore-whitespace" type="checkbox" checked /> @AppStrings.HexEncoder_IgnoreWhitespace</label>
                            <label class="tool-checkbox"><input id="hex-allow-separators" type="checkbox" checked /> @AppStrings.HexEncoder_AllowSeparators</label>
                            <label class="tool-checkbox"><input id="hex-allow-0x" type="checkbox" checked /> @AppStrings.HexEncoder_Allow0x</label>
                        </div>
                    </div>

                    <div class="tool-setting">
                        <label for="hex-output-mode">@AppStrings.HexEncoder_OutputModeLabel</label>
                        <select id="hex-output-mode">
                            <option value="preview">@AppStrings.HexEncoder_OutputModePreview</option>
                            <option value="full">@AppStrings.HexEncoder_OutputModeFull</option>
                        </select>
                    </div>
                </div>

                <div class="action-buttons">
                    <button class="btn btn-primary" id="hex-encode-btn" type="button">@AppStrings.HexEncoder_ActionEncode</button>
                    <button class="btn btn-secondary" id="hex-decode-btn" type="button">@AppStrings.HexEncoder_ActionDecode</button>
                    <button class="btn btn-secondary" id="hex-swap-btn" type="button">@AppStrings.HexEncoder_ActionSwap</button>
                    <button class="btn btn-secondary" id="hex-clear-btn" type="button">@AppStrings.HexEncoder_ActionClear</button>
                </div>

                <div class="tool-error" id="hex-error" hidden></div>
            </div>

            <div class="output-section" id="hex-output-section">
                <label for="hex-output">@AppStrings.HexEncoder_OutputLabel</label>
                <textarea id="hex-output" rows="10" readonly></textarea>

                <div class="action-buttons">
                    <button class="btn btn-secondary" id="hex-copy-btn" type="button">@AppStrings.HexEncoder_Copy</button>
                    <button class="btn btn-secondary" id="hex-download-btn" type="button">@AppStrings.HexEncoder_Download</button>
                </div>
            </div>
        </div>
    </div>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
