@page "/{lang}/hex-encoder"
@inject NavigationManager Navigation
@inherits ToolComponentBase

<ToolLayout Title="@T("Title")" Description="@T("Description")">
    <MetaTags Title="@T("Title")"
              Description="@T("Description")"
              CurrentUrl="@Navigation.Uri"
              ToolPath="hex-encoder"
              Keywords="@T("Keywords")"
              Category="Encoding"
              HowToSteps="@T("Seo_HowToSteps")" />

    <div id="hex-encoder-root"
         class="grid grid-cols-1 lg:grid-cols-2 gap-6"
         data-loading="@TCommon("Common_Loading")"
         data-error="@TCommon("Common_Error")"
         data-file-progress-title="@T("FileProgressTitle")"
         data-cancel="@T("Cancel")"
         data-copy="@T("Copy")"
         data-copied="@T("Copied")">

        <!-- Input & Settings Card -->
        <div class="card bg-base-200 shadow-xl h-fit">
            <div class="card-body">
                <h2 class="card-title text-base opacity-70 mb-4">Input & Settings</h2>

                <!-- Text Input -->
                <div class="form-control">
                    <label class="label" for="hex-input-text">
                        <span class="label-text font-semibold">@T("InputTextLabel")</span>
                    </label>
                    <textarea id="hex-input-text" class="textarea textarea-bordered h-48 font-mono text-sm" placeholder="@T("InputTextPlaceholder")"></textarea>
                </div>

                <!-- File Input -->
                <div class="divider text-xs opacity-50 font-bold">OR FILE</div>
                
                <div class="form-control w-full">
                    <FileDropZone
                        Id="hex-drop-zone"
                        InputId="hex-input-file"
                        IconSvg='<svg class="w-10 h-10 text-base-content/30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>'
                        Description="@TCommon("Common_FileDropTitle")"
                        Accept="*/*"
                        ShowFileInfo="true"
                        ShowClearButton="true" />
                    @if (!string.IsNullOrWhiteSpace(T("FileHint")))
                    {
                        <label class="label pb-0">
                            <span class="label-text-alt opacity-70">@T("FileHint")</span>
                        </label>
                    }
                </div>

                <!-- Advanced Settings -->
                <div class="collapse collapse-arrow bg-base-100 border border-base-300 rounded-box mt-4">
                    <input type="checkbox" /> 
                    <div class="collapse-title font-medium text-sm">
                        Advanced Settings
                    </div>
                    <div class="collapse-content">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                            <!-- Charset -->
                            <div class="form-control w-full">
                                <label class="label py-1" for="hex-charset">
                                    <span class="label-text text-xs">@T("CharsetLabel")</span>
                                </label>
                                <select id="hex-charset" class="select select-bordered select-sm w-full">
                                    <option value="utf-8">UTF-8</option>
                                    <option value="utf-16le">UTF-16LE</option>
                                    <option value="utf-16be">UTF-16BE</option>
                                    <option value="ascii">ASCII</option>
                                    <option value="latin1">ISO-8859-1 (Latin-1)</option>
                                </select>
                            </div>

                            <!-- Case -->
                            <div class="form-control w-full">
                                <label class="label py-1" for="hex-case">
                                    <span class="label-text text-xs">@T("CaseLabel")</span>
                                </label>
                                <select id="hex-case" class="select select-bordered select-sm w-full">
                                    <option value="lower">@T("CaseLower")</option>
                                    <option value="upper">@T("CaseUpper")</option>
                                </select>
                            </div>
                            
                            <!-- Output Mode -->
                            <div class="form-control w-full md:col-span-2">
                                <label class="label py-1" for="hex-output-mode">
                                    <span class="label-text text-xs">@T("OutputModeLabel")</span>
                                </label>
                                <select id="hex-output-mode" class="select select-bordered select-sm w-full">
                                    <option value="preview">@T("OutputModePreview")</option>
                                    <option value="full">@T("OutputModeFull")</option>
                                </select>
                            </div>

                            <!-- Options -->
                            <div class="form-control md:col-span-2 space-y-1">
                                <label class="label cursor-pointer justify-start gap-3 py-1">
                                    <input id="hex-ignore-whitespace" type="checkbox" class="checkbox checkbox-sm checkbox-primary" checked />
                                    <span class="label-text text-sm">@T("IgnoreWhitespace")</span>
                                </label>
                                <label class="label cursor-pointer justify-start gap-3 py-1">
                                    <input id="hex-allow-separators" type="checkbox" class="checkbox checkbox-sm checkbox-primary" checked />
                                    <span class="label-text text-sm">@T("AllowSeparators")</span>
                                </label>
                                <label class="label cursor-pointer justify-start gap-3 py-1">
                                    <input id="hex-allow-0x" type="checkbox" class="checkbox checkbox-sm checkbox-primary" checked />
                                    <span class="label-text text-sm">@T("Allow0x")</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="card-actions mt-6 grid grid-cols-2 gap-4">
                    <button class="btn btn-primary" id="hex-encode-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                        @T("ActionEncode")
                    </button>
                    <button class="btn btn-secondary" id="hex-decode-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
                        @T("ActionDecode")
                    </button>
                </div>
                
                <div class="flex justify-between mt-2">
                     <button class="btn btn-ghost btn-sm text-error" id="hex-clear-btn">
                         <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                         @T("ActionClear")
                     </button>
                     <button class="btn btn-ghost btn-sm" id="hex-swap-btn">
                         <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" /></svg>
                         @T("ActionSwap")
                     </button>
                </div>
                
                <div class="alert alert-error shadow-lg mt-4 hidden" id="hex-error"></div>
            </div>
        </div>

        <!-- Output Card -->
        <div class="card bg-base-200 shadow-xl h-fit">
            <div class="card-body" id="hex-output-section">
                <h2 class="card-title text-base opacity-70 mb-4">Output</h2>
                
                <div class="form-control h-full">
                    <textarea id="hex-output" class="textarea textarea-bordered h-[500px] font-mono text-sm leading-relaxed" readonly></textarea>
                </div>
                
                <div class="card-actions justify-between items-center mt-4">
                    <div class="text-xs opacity-50">
                        <!-- Stats could go here -->
                    </div>
                    <div class="flex gap-2">
                        <button class="btn btn-ghost btn-sm" id="hex-copy-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>
                            @T("Copy")
                        </button>
                        <button class="btn btn-ghost btn-sm" id="hex-download-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                            @T("Download")
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Related Links -->
        <div class="col-span-1 lg:col-span-2 mt-4">
            <div class="flex flex-wrap gap-3 justify-center items-center opacity-70 text-sm">
                <span class="font-bold">@T("OtherFormats")</span>
                <a class="link link-hover" href="/@Lang/url-encoder">@T("LinkUrl")</a>
                <span class="opacity-30">|</span>
                <a class="link link-hover" href="/@Lang/base32-encoder">@T("LinkBase32")</a>
                <span class="opacity-30">|</span>
                <a class="link link-hover" href="/@Lang/base58-encoder">@T("LinkBase58")</a>
                <span class="opacity-30">|</span>
                <a class="link link-hover" href="/@Lang/base64-encoder">@T("LinkBase64")</a>
            </div>
        </div>

    </div>

    <ToolSeoContent 
        Introduction="@T("Seo_Introduction")"
        DetailedDescription="@T("Seo_DetailedDescription")"
        DetailedDescriptionTitle="@TCommon("Seo_DetailedDescriptionTitle")"
        Examples="@T("Seo_Examples")"
        ExamplesTitle="@TCommon("Seo_ExamplesTitle")"
        HowToSteps="@T("Seo_HowToSteps")"
        HowToTitle="@TCommon("Seo_HowToTitle")"
        Tips="@T("Seo_Tips")"
        TipsTitle="@TCommon("Seo_TipsTitle")" />
</ToolLayout>

@code {
    protected override string LocalizationNamespace { get; set; } = "tools/hex-encoder";
}
