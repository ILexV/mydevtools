@page "/{lang}/hmac-calculator"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.HmacCalculator_Title"
          Description="@AppStrings.HmacCalculator_Description"
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="hmac-calculator" />

<JsonLdTool ToolName="@AppStrings.HmacCalculator_Title"
            Description="@AppStrings.HmacCalculator_Description"
            CurrentUrl="@Navigation.Uri" />

<ToolLayout Title="@AppStrings.HmacCalculator_Title" Description="@AppStrings.HmacCalculator_Description">
    <div id="hmac-calculator-root"
         data-loading="@AppStrings.Common_Loading"
         data-error="@AppStrings.Common_Error"
         data-copy="@AppStrings.HmacCalculator_Copy"
         data-copied="@AppStrings.HmacCalculator_Copied"
         class="max-w-4xl mx-auto">

        <div class="card bg-base-100 shadow-xl">
            <div class="card-body p-4 sm:p-6">
                
                <!-- Inputs Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <!-- Key Input -->
                    <div class="form-control w-full">
                        <label class="label" for="hmac-key-input">
                            <span class="label-text font-bold text-lg">@AppStrings.HmacCalculator_KeyLabel</span>
                        </label>
                        <textarea id="hmac-key-input" 
                                  class="textarea textarea-bordered w-full font-mono text-base leading-relaxed min-h-[150px] bg-base-200 focus:bg-base-100 transition-colors" 
                                  placeholder="@AppStrings.HmacCalculator_KeyPlaceholder" 
                                  spellcheck="false"></textarea>
                    </div>

                    <!-- Message Input -->
                    <div class="form-control w-full">
                        <label class="label" for="hmac-message-input">
                            <span class="label-text font-bold text-lg">@AppStrings.HmacCalculator_MessageLabel</span>
                        </label>
                        <textarea id="hmac-message-input" 
                                  class="textarea textarea-bordered w-full font-mono text-base leading-relaxed min-h-[150px] bg-base-200 focus:bg-base-100 transition-colors" 
                                  placeholder="@AppStrings.HmacCalculator_MessagePlaceholder" 
                                  spellcheck="false"></textarea>
                    </div>
                </div>

                <!-- Controls -->
                <div class="flex flex-wrap items-end gap-4 mb-8">
                    <div class="form-control w-full max-w-xs">
                        <label class="label" for="hmac-algorithm-select">
                            <span class="label-text font-semibold">@AppStrings.HmacCalculator_AlgorithmLabel</span>
                        </label>
                        <select id="hmac-algorithm-select" class="select select-bordered w-full">
                            <option value="sha256" selected>SHA-256</option>
                            <option value="sha512">SHA-512</option>
                        </select>
                    </div>

                    <div class="flex gap-2 flex-grow justify-end">
                        <button class="btn btn-primary" id="calculate-hmac-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-1">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
                            </svg>
                            @AppStrings.HmacCalculator_Calculate
                        </button>
                        <button class="btn btn-ghost text-error" id="clear-hmac-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-1">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                            @AppStrings.HmacCalculator_Clear
                        </button>
                    </div>
                </div>

                <!-- Output Section -->
                <div class="form-control w-full relative">
                    <label class="label" for="hmac-output">
                        <span class="label-text font-bold text-lg">@AppStrings.HmacCalculator_OutputLabel</span>
                    </label>
                    <div class="relative group">
                         <textarea id="hmac-output" 
                                   class="textarea textarea-bordered w-full font-mono text-lg min-h-[100px] pr-12 bg-neutral text-neutral-content placeholder:text-neutral-content/30" 
                                   readonly 
                                   spellcheck="false"
                                   placeholder="..."></textarea>
                        
                        <div class="absolute right-2 top-2">
                             <button class="btn btn-square btn-sm btn-ghost text-neutral-content/70 hover:text-white" 
                                     id="copy-hmac-btn"
                                     aria-label="@AppStrings.HmacCalculator_Copy"
                                     style="display: none;">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                                </svg>
                             </button>
                        </div>
                    </div>
                </div>

                <div class="alert alert-error mt-4 shadow-lg hidden" id="hmac-error">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span id="hmac-error-text"></span>
                </div>
            </div>
        </div>
    </div>
    
    <script src="/tools/hmac-calculator.js"></script>
</ToolLayout>

@code {
    /// <summary>
    /// Language parameter from URL route
    /// </summary>
    [Parameter]
    public string Lang { get; set; } = "en";
}
