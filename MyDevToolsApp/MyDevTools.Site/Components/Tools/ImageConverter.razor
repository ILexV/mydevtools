@page "/{lang}/image-converter"
@using MyDevTools.Site.Components.Layout
@using MyDevTools.Site.Components.Common
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.ImageConverter_Title"
          Description="@AppStrings.ImageConverter_Description"
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="image-converter" />

<JsonLdTool ToolName="@AppStrings.ImageConverter_Title"
            Description="@AppStrings.ImageConverter_Description"
            CurrentUrl="@Navigation.Uri" />

<ToolLayout Title="@AppStrings.ImageConverter_Title" Description="@AppStrings.ImageConverter_Description">
    <div id="image-converter-root"
         data-loading="@AppStrings.ImageConverter_Processing"
         data-error="@AppStrings.Common_Error">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="space-y-4">
                <FileDropZone InputId="ic-input-file"
                              IconSvg='<span style="font-size: 3rem;">🖼️</span>'
                              Description="@AppStrings.ImageConverter_DragDrop"
                              Accept="image/*"
                              ShowFileInfo="true"
                              ShowPreview="true"
                              ShowClearButton="true" />

                <div class="collapse collapse-arrow bg-base-200 mt-4">
                    <input type="checkbox" checked /> 
                    <div class="collapse-title text-xl font-medium">
                        Settings
                    </div>
                    <div class="collapse-content space-y-4">
                        <div class="form-control w-full">
                            <label class="label" for="ic-format-select"><span class="label-text">@AppStrings.ImageConverter_SelectFormat</span></label>
                            <select id="ic-format-select" class="select select-bordered w-full">
                                <option value="png">PNG</option>
                                <option value="jpeg">JPEG</option>
                                <option value="webp">WebP</option>
                                <option value="gif">GIF</option>
                                <option value="bmp">BMP</option>
                                <option value="ico">ICO</option>
                                <option value="tiff">TIFF</option>
                                <option value="tga">TGA</option>
                            </select>
                        </div>

                        <div class="form-control w-full" id="ic-quality-container" hidden>
                            <label class="label" for="ic-quality"><span class="label-text">@AppStrings.ImageConverter_Quality: <span id="ic-quality-value">90</span></span></label>
                            <input type="range" id="ic-quality" min="1" max="100" value="90" class="range range-primary" />
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap gap-2 mt-4">
                    <button class="btn btn-primary" id="ic-convert-btn" type="button" disabled>@AppStrings.ImageConverter_Convert</button>
                </div>

                <div class="alert alert-error" id="ic-error" style="display: none;"></div>
            </div>

            <div class="space-y-4" id="ic-output-section" hidden>
                <div id="ic-preview-container" class="image-preview" style="text-align: center; margin-bottom: 1rem;">
                    <!-- Preview image will be inserted here -->
                </div>
                
                <div class="text-center font-bold mb-2">
                    @AppStrings.ImageConverter_OutputSize <span id="ic-output-size"></span>
                </div>

                <div class="flex flex-wrap gap-2 mt-4" style="justify-content: center;">
                     <button class="btn btn-primary" id="ic-download-btn" type="button">@AppStrings.ImageConverter_Download</button>
                </div>
            </div>
        </div>
    </div>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
