@page "/{lang}/image-resizer"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<ToolLayout Title="@AppStrings.ImageResizer_Title" Description="@AppStrings.ImageResizer_Description">
    <MetaTags Title="@AppStrings.ImageResizer_Title" 
              Description="@AppStrings.ImageResizer_Description" 
              CurrentUrl="@Navigation.Uri" />

    <HreflangLinks ToolPath="image-resizer" />

    <JsonLdTool ToolName="@AppStrings.ImageResizer_Title" 
                Description="@AppStrings.ImageResizer_Description" 
                CurrentUrl="@Navigation.Uri" />

    <div id="image-resizer-root" class="max-w-4xl mx-auto">
        
        <div id="ir-error" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" style="display: none;" role="alert"></div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
            
            <!-- Left Column: Input -->
            <div class="card bg-base-200 shadow-xl h-fit">
                <div class="card-body">
                    <h2 class="card-title text-base opacity-70 mb-4">Input & Settings</h2>

                    <!-- Drop Zone -->
                    <FileDropZone 
                        Id="ir-drop-zone"
                        InputId="ir-input-file"
                        IconSvg='<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>'
                        Description="@AppStrings.Common_FileDropTitle"
                        Accept="image/*"
                        ShowFileInfo="true"
                        ShowPreview="true"
                        ShowClearButton="true" />

                    <!-- Settings Panel -->
                    <div id="ir-settings-panel" class="mt-4 space-y-4" hidden>
                        <div class="divider">Settings</div>

                        <div class="flex items-center justify-between text-sm opacity-70">
                             <span class="font-bold uppercase">@AppStrings.ImageResizer_OriginalInfo</span>
                             <span id="ir-original-info" class="font-mono">-</span>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div class="form-control">
                                <label for="ir-width" class="label">
                                    <span class="label-text">@AppStrings.ImageResizer_Width</span>
                                </label>
                                <input type="number" id="ir-width" class="input input-bordered w-full" placeholder="Width" />
                            </div>
                            <div class="form-control">
                                <label for="ir-height" class="label">
                                    <span class="label-text">@AppStrings.ImageResizer_Height</span>
                                </label>
                                <input type="number" id="ir-height" class="input input-bordered w-full" placeholder="Height" />
                            </div>
                        </div>

                        <div class="form-control">
                            <label class="label cursor-pointer justify-start gap-4">
                                <input type="checkbox" id="ir-lock-ratio" class="checkbox checkbox-primary" checked>
                                <span class="label-text">@AppStrings.ImageResizer_LockAspectRatio</span>
                            </label>
                        </div>

                        <div class="form-control w-full">
                            <label for="ir-format-select" class="label">
                                <span class="label-text">@AppStrings.ImageConverter_TargetFormatLabel</span>
                            </label>
                            <select id="ir-format-select" class="select select-bordered w-full">
                                <option value="jpeg">JPEG</option>
                                <option value="png">PNG</option>
                                <option value="webp">WebP</option>
                            </select>
                        </div>

                        <button id="ir-resize-btn" 
                                class="btn btn-primary w-full mt-4" 
                                disabled
                                data-processing="@AppStrings.ImageResizer_Resizing" 
                                data-original="@AppStrings.ImageResizer_Resize">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
                            @AppStrings.ImageResizer_Resize
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Column: Output -->
            <div class="card bg-base-200 shadow-xl h-fit" id="ir-output-section" hidden>
                <div class="card-body">
                    <h2 class="card-title text-base opacity-70 mb-4">@AppStrings.Common_Output</h2>
                    
                    <div class="rounded-box border border-base-300 bg-base-100 p-4 flex items-center justify-center min-h-[200px] relative overflow-hidden bg-[url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAMUlEQVQ4T2NkYGAQYcAP3uCTZhw1gGGYhAGBZIA/nYDCgBDAm9BGDWAAJyRCgLaBCAAgXwixzAS0pgAAAABJRU5ErkJggg==')]">
                        <div id="ir-preview-container" class="relative z-10 max-h-[400px]">
                            <!-- Preview injected here -->
                        </div>
                    </div>
                    
                    <div class="stats shadow mt-4 w-full">
                        <div class="stat place-items-center p-2">
                            <div class="stat-title text-xs">Info</div>
                            <div id="ir-output-info" class="stat-value text-sm font-mono">-</div>
                        </div>
                    </div>

                    <a id="ir-download-btn" class="btn btn-success w-full text-white mt-6">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                        @AppStrings.Common_Download
                    </a>
                </div>
            </div>

        </div>

    </div>
</ToolLayout>

<style>
    .drag-over {
        background-color: var(--bg-tertiary) !important;
        border-color: var(--accent-color) !important;
        transform: scale(1.01);
    }
</style>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
