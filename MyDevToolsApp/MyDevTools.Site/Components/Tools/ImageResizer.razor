@page "/{lang}/image-resizer"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<ToolLayout Title="@AppStrings.ImageResizer_Title" Description="@AppStrings.ImageResizer_Description">
    <MetaTags Title="@AppStrings.ImageResizer_Title" 
              Description="@AppStrings.ImageResizer_Description" 
              CurrentUrl="@Navigation.Uri"
              ToolPath="image-resizer" />

    <div id="image-resizer-root" class="max-w-5xl mx-auto">
        
        <div id="ir-error" class="alert alert-error mb-6 hidden" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span id="ir-error-text"></span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
            
            <!-- Left Column: Input -->
            <div class="card bg-base-100 shadow-xl h-fit">
                <div class="card-body p-4 sm:p-6">
                    <h2 class="card-title text-primary flex items-center gap-2 mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                        </svg>
                        Input & Settings
                    </h2>

                    <!-- Drop Zone -->
                    <FileDropZone 
                        Id="ir-drop-zone"
                        InputId="ir-input-file"
                        IconSvg='<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>'
                        Description="@AppStrings.Common_FileDropTitle"
                        Accept="image/*"
                        ShowFileInfo="true"
                        ShowPreview="true"
                        ShowClearButton="true" />

                    <!-- Settings Panel -->
                    <div id="ir-settings-panel" class="mt-6 space-y-4 hidden">
                        <div class="divider text-sm font-semibold opacity-50">SETTINGS</div>

                        <div class="flex items-center justify-between text-sm bg-base-200 p-3 rounded-lg">
                             <span class="font-bold opacity-70 uppercase text-xs">@AppStrings.ImageResizer_OriginalInfo</span>
                             <span id="ir-original-info" class="font-mono font-semibold"></span>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div class="form-control">
                                <label for="ir-width" class="label">
                                    <span class="label-text font-semibold">@AppStrings.ImageResizer_Width</span>
                                </label>
                                <input type="number" id="ir-width" class="input input-bordered w-full" placeholder="px" />
                            </div>
                            <div class="form-control">
                                <label for="ir-height" class="label">
                                    <span class="label-text font-semibold">@AppStrings.ImageResizer_Height</span>
                                </label>
                                <input type="number" id="ir-height" class="input input-bordered w-full" placeholder="px" />
                            </div>
                        </div>

                        <div class="form-control">
                            <label class="label cursor-pointer justify-start gap-3 bg-base-200/50 p-2 rounded hover:bg-base-200 transition-colors">
                                <input type="checkbox" id="ir-lock-ratio" class="checkbox checkbox-primary checkbox-sm" checked>
                                <span class="label-text">@AppStrings.ImageResizer_LockAspectRatio</span>
                            </label>
                        </div>

                        <div class="form-control w-full">
                            <label for="ir-format-select" class="label">
                                <span class="label-text font-semibold">@AppStrings.ImageConverter_TargetFormatLabel</span>
                            </label>
                            <select id="ir-format-select" class="select select-bordered w-full">
                                <option value="jpeg">JPEG</option>
                                <option value="png">PNG</option>
                                <option value="webp">WebP</option>
                            </select>
                        </div>

                        <button id="ir-resize-btn" 
                                class="btn btn-primary w-full mt-4 shadow-md" 
                                disabled
                                data-processing="@AppStrings.ImageResizer_Resizing" 
                                data-original="@AppStrings.ImageResizer_Resize">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
                            @AppStrings.ImageResizer_Resize
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Column: Output -->
            <div class="card bg-base-100 shadow-xl h-fit hidden" id="ir-output-section">
                <div class="card-body p-4 sm:p-6">
                    <h2 class="card-title text-secondary flex items-center gap-2 mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                        @AppStrings.Common_Output
                    </h2>
                    
                    <div class="rounded-xl border border-base-300 bg-base-200/30 p-4 flex items-center justify-center min-h-[200px] relative overflow-hidden">
                        <div class="absolute inset-0 pattern-bg opacity-10"></div>
                        <div id="ir-preview-container" class="relative z-10 max-h-[400px]">
                            <!-- Preview injected here -->
                        </div>
                    </div>
                    
                    <div class="stats shadow mt-4 w-full bg-base-200">
                        <div class="stat place-items-center p-2">
                            <div class="stat-title text-xs uppercase font-bold opacity-60">Result Info</div>
                            <div id="ir-output-info" class="stat-value text-base font-mono"></div>
                        </div>
                    </div>

                    <a id="ir-download-btn" class="btn btn-success w-full text-white mt-6 shadow-md">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                        @AppStrings.Common_Download
                    </a>
                </div>
            </div>

        </div>

    </div>
    
    <script src="/tools/image-resizer.js"></script>

    <ToolSeoContent 
        Introduction="@AppStrings.ImageResizer_Seo_Introduction"
        DetailedDescription="@AppStrings.ImageResizer_Seo_DetailedDescription"
        DetailedDescriptionTitle="@AppStrings.Seo_DetailedDescriptionTitle"
        Examples="@AppStrings.ImageResizer_Seo_Examples"
        ExamplesTitle="@AppStrings.Seo_ExamplesTitle"
        HowToSteps="@AppStrings.ImageResizer_Seo_HowToSteps"
        HowToTitle="@AppStrings.Seo_HowToTitle"
        Tips="@AppStrings.ImageResizer_Seo_Tips"
        TipsTitle="@AppStrings.Seo_TipsTitle" />
</ToolLayout>

<style>
    .pattern-bg {
        background-image: radial-gradient(#000 1px, transparent 1px);
        background-size: 10px 10px;
    }
    [data-theme="dark"] .pattern-bg {
        background-image: radial-gradient(#fff 1px, transparent 1px);
    }
</style>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
