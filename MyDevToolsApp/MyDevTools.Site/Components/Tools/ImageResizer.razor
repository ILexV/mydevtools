@page "/{lang}/image-resizer"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.ImageResizer_Title" 
          Description="@AppStrings.ImageResizer_Description" 
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="image-resizer" />

<JsonLdTool ToolName="@AppStrings.ImageResizer_Title" 
            Description="@AppStrings.ImageResizer_Description" 
            CurrentUrl="@Navigation.Uri" />

<ToolLayout Title="@AppStrings.ImageResizer_Title" Description="@AppStrings.ImageResizer_Description">
    <div id="image-resizer-root" class="max-w-4xl mx-auto">
        
        <div id="ir-error" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" style="display: none;" role="alert"></div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
            
            <!-- Left Column: Input -->
            <div class="space-y-6">
                
                <!-- Drop Zone -->
                <FileDropZone 
                    Id="ir-drop-zone"
                    InputId="ir-input-file"
                    IconSvg='<span style="font-size: 3rem;">🖼️</span>'
                    Description="@AppStrings.Common_FileDropTitle"
                    Accept="image/*"
                    ShowFileInfo="true"
                    ShowPreview="true"
                    ShowClearButton="true" />

                <!-- Settings Panel (Hidden until file selected) -->
                <div id="ir-settings-panel" class="p-6 rounded-xl shadow-sm transition-all" 
                     style="background-color: var(--bg-secondary); border: 1px solid var(--border-color);" hidden>
                    
                    <div class="mb-4 pb-4 border-b" style="border-color: var(--border-color);">
                         <label class="block text-xs font-bold uppercase tracking-wide mb-1" style="color: var(--text-secondary);">
                             @AppStrings.ImageResizer_OriginalInfo
                         </label>
                         <div id="ir-original-info" class="font-mono text-sm break-all" style="color: var(--text-primary);">
                             -
                         </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <label for="ir-width" class="block text-sm font-medium mb-1" style="color: var(--text-primary);">
                                @AppStrings.ImageResizer_Width
                            </label>
                            <input type="number" id="ir-width" class="w-full px-3 py-2 rounded-md border focus:ring-2 focus:ring-blue-500 focus:outline-none transition-shadow" 
                                   placeholder="Width"
                                   style="background-color: var(--bg-primary); color: var(--text-primary); border-color: var(--border-color);" />
                        </div>
                        <div>
                            <label for="ir-height" class="block text-sm font-medium mb-1" style="color: var(--text-primary);">
                                @AppStrings.ImageResizer_Height
                            </label>
                            <input type="number" id="ir-height" class="w-full px-3 py-2 rounded-md border focus:ring-2 focus:ring-blue-500 focus:outline-none transition-shadow" 
                                   placeholder="Height"
                                   style="background-color: var(--bg-primary); color: var(--text-primary); border-color: var(--border-color);" />
                        </div>
                    </div>

                    <div class="flex items-center mb-6">
                        <input type="checkbox" id="ir-lock-ratio" class="w-4 h-4 text-blue-600 rounded focus:ring-blue-500 border-gray-300" checked>
                        <label for="ir-lock-ratio" class="ml-2 block text-sm select-none" style="color: var(--text-primary);">
                            @AppStrings.ImageResizer_LockAspectRatio
                        </label>
                    </div>

                    <div class="mb-6">
                        <label for="ir-format-select" class="block text-sm font-medium mb-1" style="color: var(--text-primary);">
                            @AppStrings.ImageConverter_TargetFormatLabel
                        </label>
                        <select id="ir-format-select" class="w-full px-3 py-2 rounded-md border focus:ring-2 focus:ring-blue-500 focus:outline-none"
                                style="background-color: var(--bg-primary); color: var(--text-primary); border-color: var(--border-color); appearance: none; background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%239CA3AF%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E'); background-repeat: no-repeat; background-position: right 0.7rem top 50%; background-size: 0.65rem auto; padding-right: 2.5rem;">
                            <option value="jpeg">JPEG</option>
                            <option value="png">PNG</option>
                            <option value="webp">WebP</option>
                        </select>
                    </div>

                    <button id="ir-resize-btn" 
                            class="w-full btn btn-primary py-3 rounded-lg font-semibold text-white shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed" 
                            disabled
                            data-processing="@AppStrings.ImageResizer_Resizing" 
                            data-original="@AppStrings.ImageResizer_Resize">
                        @AppStrings.ImageResizer_Resize
                    </button>
                </div>
            </div>

            <!-- Right Column: Output -->
            <div id="ir-output-section" hidden>
                <div class="p-6 rounded-xl shadow-sm h-full flex flex-col items-center justify-center" 
                     style="background-color: var(--bg-secondary); border: 1px solid var(--border-color);">
                    <h3 class="text-lg font-semibold mb-4 w-full text-left border-b pb-2" style="color: var(--text-primary); border-color: var(--border-color);">
                        @AppStrings.Common_Output
                    </h3>
                    
                    <div id="ir-preview-container" class="mb-4 w-full flex justify-center items-center bg-gray-100 dark:bg-gray-800 rounded-lg p-2 min-h-[200px]"
                         style="border: 2px dashed var(--border-color);">
                        <!-- Preview injected here -->
                    </div>
                    
                    <div id="ir-output-info" class="mb-6 font-mono text-sm text-center" style="color: var(--text-secondary);"></div>

                    <a id="ir-download-btn" class="btn w-full btn-success py-3 rounded-lg flex items-center justify-center gap-2 font-semibold text-white shadow-md hover:shadow-lg transition-all"
                       style="background-color: var(--success-color);">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                        @AppStrings.Common_Download
                    </a>
                </div>
            </div>

        </div>

    </div>
</ToolLayout>

<style>
    .drag-over {
        background-color: var(--bg-tertiary) !important;
        border-color: var(--accent-color) !important;
        transform: scale(1.01);
    }
</style>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
