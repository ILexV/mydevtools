@page "/{lang}/json-beautifier"
@using MyDevTools.Site.Resources
@using System.Text.Json
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.JsonBeautifier_Title" 
          Description="@AppStrings.JsonBeautifier_Description" 
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="json-beautifier" />

<JsonLdTool ToolName="@AppStrings.JsonBeautifier_Title" 
            Description="@AppStrings.JsonBeautifier_Description" 
            CurrentUrl="@Navigation.Uri" />

<ToolLayout Title="@AppStrings.JsonBeautifier_Title" Description="@AppStrings.JsonBeautifier_Description">
    <div id="json-beautifier-root"
         data-error-invalid-json="@AppStrings.JsonBeautifier_ErrorInvalidJson"
         data-copied="@AppStrings.JsonBeautifier_Copied"
         data-copy-button="@AppStrings.JsonBeautifier_CopyButton"
         data-input-placeholder="@AppStrings.JsonBeautifier_InputPlaceholder">
        
        <div class="space-y-4">
            <div class="card bg-base-200 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex flex-wrap gap-4 items-center">
                        <div class="join">
                            <button class="btn btn-secondary join-item" id="open-file-btn" type="button" title="Open JSON file">
                                📁
                            </button>
                            <button class="btn btn-secondary join-item" id="save-file-btn" type="button" title="Save JSON file">
                                💾
                            </button>
                        </div>

                        <div class="form-control">
                            <label class="label py-0">
                                <span class="label-text text-xs">@AppStrings.JsonBeautifier_IndentSizeLabel</span>
                            </label>
                            <select id="indent-select" class="select select-bordered select-sm">
                                <option value="2">@AppStrings.JsonBeautifier_Indent2Spaces</option>
                                <option value="4" selected>@AppStrings.JsonBeautifier_Indent4Spaces</option>
                                <option value="tab">@AppStrings.JsonBeautifier_IndentTab</option>
                            </select>
                        </div>

                        <label class="label cursor-pointer gap-2">
                            <input type="checkbox" id="sort-keys" class="checkbox checkbox-sm" />
                            <span class="label-text">@AppStrings.JsonBeautifier_SortKeys</span>
                        </label>

                        <label class="label cursor-pointer gap-2">
                            <input type="checkbox" id="compact-mode" class="checkbox checkbox-sm" />
                            <span class="label-text">@AppStrings.JsonBeautifier_CompactMode</span>
                        </label>

                        <div class="ml-auto join">
                            <button class="btn btn-primary join-item" id="format-btn" type="button" title="@AppStrings.JsonBeautifier_FormatButton">
                                ⚙️
                            </button>
                            <button class="btn btn-secondary join-item" id="copy-btn" type="button" title="@AppStrings.JsonBeautifier_CopyButton">
                                📋
                            </button>
                            <button class="btn btn-secondary join-item" id="clear-btn" type="button" title="@AppStrings.JsonBeautifier_ClearButton">
                                🗑️
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-xl">
                <div class="card-body p-0">
                    <div id="json-editor"></div>
                </div>
            </div>
            <input type="file" id="file-input" accept=".json" style="display: none;" />
        </div>
    </div>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
