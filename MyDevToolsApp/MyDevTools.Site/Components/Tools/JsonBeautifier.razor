@page "/{lang}/json-beautifier"
@using MyDevTools.Site.Resources
@using System.Text.Json
@inject NavigationManager Navigation

<ToolLayout Title="@AppStrings.JsonBeautifier_Title" Description="@AppStrings.JsonBeautifier_Description">
    <MetaTags Title="@AppStrings.JsonBeautifier_Title" 
              Description="@AppStrings.JsonBeautifier_Description" 
              CurrentUrl="@Navigation.Uri"
              ToolPath="json-beautifier" />

    <div id="json-beautifier-root"
         data-error-invalid-json="@AppStrings.JsonBeautifier_ErrorInvalidJson"
         data-copied="@AppStrings.JsonBeautifier_Copied"
         data-copy-button="@AppStrings.JsonBeautifier_CopyButton"
         data-input-placeholder="@AppStrings.JsonBeautifier_InputPlaceholder">
        
        <div class="card bg-base-200 shadow-xl">
            <div class="card-body p-4">
                
                <!-- Toolbar -->
                <div class="flex flex-wrap gap-4 items-center justify-between mb-4">
                    <div class="flex flex-wrap gap-2 items-center">
                        <!-- File Actions -->
                        <div class="join">
                            <button class="btn btn-sm btn-secondary join-item" id="open-file-btn" title="Open JSON file">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                                Open
                            </button>
                            <button class="btn btn-sm btn-secondary join-item" id="save-file-btn" title="Save JSON file">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg>
                                Save
                            </button>
                        </div>

                        <!-- Settings -->
                        <select id="indent-select" class="select select-bordered select-sm">
                            <option value="2">@AppStrings.JsonBeautifier_Indent2Spaces</option>
                            <option value="4" selected>@AppStrings.JsonBeautifier_Indent4Spaces</option>
                            <option value="tab">@AppStrings.JsonBeautifier_IndentTab</option>
                        </select>
                        
                        <div class="flex items-center gap-4 px-2">
                            <label class="cursor-pointer label p-0 gap-2">
                                <input type="checkbox" id="sort-keys" class="checkbox checkbox-sm checkbox-primary" />
                                <span class="label-text text-sm">@AppStrings.JsonBeautifier_SortKeys</span>
                            </label>

                            <label class="cursor-pointer label p-0 gap-2">
                                <input type="checkbox" id="compact-mode" class="checkbox checkbox-sm checkbox-primary" />
                                <span class="label-text text-sm">@AppStrings.JsonBeautifier_CompactMode</span>
                            </label>
                        </div>
                    </div>

                    <!-- Main Actions -->
                    <div class="flex flex-wrap gap-2">
                        <button class="btn btn-sm btn-primary" id="format-btn" title="@AppStrings.JsonBeautifier_FormatButton">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                            Format
                        </button>
                        <button class="btn btn-sm btn-ghost" id="copy-btn" title="@AppStrings.JsonBeautifier_CopyButton">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>
                            Copy
                        </button>
                        <button class="btn btn-sm btn-ghost text-error" id="clear-btn" title="@AppStrings.JsonBeautifier_ClearButton">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                        </button>
                    </div>
                </div>

                <!-- Editor Container -->
                <div id="json-editor" class="rounded-box border border-base-300 overflow-hidden bg-base-100"></div>
            </div>
            
            <input type="file" id="file-input" accept=".json" class="hidden" />
        </div>
    </div>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
