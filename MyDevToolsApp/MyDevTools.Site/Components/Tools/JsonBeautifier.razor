@page "/{lang}/json-beautifier"
@using MyDevTools.Site.Resources
@using System.Text.Json
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.JsonBeautifier_Title" 
          Description="@AppStrings.JsonBeautifier_Description" 
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="json-beautifier" />

<JsonLdTool ToolName="@AppStrings.JsonBeautifier_Title" 
            Description="@AppStrings.JsonBeautifier_Description" 
            CurrentUrl="@Navigation.Uri" />

<ToolLayout Title="@AppStrings.JsonBeautifier_Title" Description="@AppStrings.JsonBeautifier_Description">
    <div id="json-beautifier-root"
         data-error-invalid-json="@AppStrings.JsonBeautifier_ErrorInvalidJson"
         data-copied="@AppStrings.JsonBeautifier_Copied"
         data-copy-button="@AppStrings.JsonBeautifier_CopyButton"
         data-input-placeholder="@AppStrings.JsonBeautifier_InputPlaceholder">
        
        <div class="editor-container">
            <div class="settings-bar">
                <div class="settings-group">
                    <div class="setting-item">
                        <label for="indent-select">@AppStrings.JsonBeautifier_IndentSizeLabel</label>
                        <select id="indent-select">
                            <option value="2">@AppStrings.JsonBeautifier_Indent2Spaces</option>
                            <option value="4" selected>@AppStrings.JsonBeautifier_Indent4Spaces</option>
                            <option value="\t">@AppStrings.JsonBeautifier_IndentTab</option>
                        </select>
                    </div>
                    <div class="setting-item">
                        <label>
                            <input type="checkbox" id="sort-keys" /> @AppStrings.JsonBeautifier_SortKeys
                        </label>
                    </div>
                    <div class="setting-item">
                        <label>
                            <input type="checkbox" id="compact-mode" /> @AppStrings.JsonBeautifier_CompactMode
                        </label>
                    </div>
                </div>

                <div class="action-buttons">
                    <button class="btn btn-primary" id="format-btn" type="button">
                        @AppStrings.JsonBeautifier_FormatButton
                    </button>
                    <button class="btn btn-secondary" id="copy-btn" type="button">
                        @AppStrings.JsonBeautifier_CopyButton
                    </button>
                    <button class="btn btn-secondary" id="clear-btn" type="button">
                        @AppStrings.JsonBeautifier_ClearButton
                    </button>
                </div>
            </div>

            <div id="json-editor"></div>
        </div>
    </div>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
