@page "/{lang}/jwt-decoder"
@inject NavigationManager Navigation
@inherits ToolComponentBase

<ToolLayout Title="@T("Title")" Description="@T("Description")">
    <MetaTags Title="@T("Title")"
              Description="@T("Description")"
              CurrentUrl="@Navigation.Uri"
              ToolPath="jwt-decoder" />

    <div class="alert alert-info mb-6 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>@T("LinkToEncoder") → <a href="/@Lang/jwt-encoder" class="link link-hover font-bold">@T("EncoderTitle")</a></span>
    </div>

    <div id="jwt-decoder-root" class="flex flex-col gap-6"
         data-loading="@TCommon("Common_Loading")"
         data-error="@TCommon("Common_Error")"
         data-copy="@T("Copy")"
         data-copied="@T("Copied")"
         data-signature-verified="@T("SignatureVerified")"
         data-signature-invalid="@T("SignatureInvalid")">

        <!-- Input Section -->
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body p-4 sm:p-6">
                <h2 class="card-title text-primary flex items-center gap-2 mb-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
                    </svg>
                    @T("EncodedLabel")
                </h2>
                <textarea id="jwt-encoded" class="textarea textarea-bordered w-full font-mono min-h-[150px] text-lg leading-relaxed break-all bg-base-200 focus:bg-base-100 transition-colors" placeholder="@T("EncodedPlaceholder")" spellcheck="false"></textarea>
                <div class="alert alert-error mt-4 hidden" id="jwt-encoded-error">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span id="jwt-encoded-error-text"></span>
                </div>
            </div>
        </div>

        <!-- Decoded Section -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Header -->
            <div class="card bg-base-100 shadow-xl">
                <div class="card-body p-4 sm:p-6">
                    <h3 class="card-title text-secondary text-base mb-2">@T("DecodedHeaderLabel")</h3>
                    <textarea id="jwt-header" class="textarea textarea-bordered w-full font-mono min-h-[200px] text-sm bg-base-200 text-base-content/80" spellcheck="false" readonly></textarea>
                </div>
            </div>

            <!-- Payload -->
            <div class="card bg-base-100 shadow-xl">
                <div class="card-body p-4 sm:p-6">
                    <h3 class="card-title text-accent text-base mb-2">@T("DecodedPayloadLabel")</h3>
                    <textarea id="jwt-payload" class="textarea textarea-bordered w-full font-mono min-h-[200px] text-sm bg-base-200 text-base-content/80" spellcheck="false" readonly></textarea>
                </div>
            </div>
        </div>

        <!-- Signature Verification -->
        <div class="card bg-base-100 shadow-xl border-t-4 border-primary">
            <div class="card-body p-4 sm:p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="card-title text-base flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
                        </svg>
                        @T("SignatureLabel")
                    </h3>
                    <div class="badge badge-lg badge-ghost font-mono" id="jwt-algorithm-value">ALG</div>
                </div>

                <div class="form-control w-full">
                    <label class="label font-semibold" for="jwt-secret">
                        @T("SecretLabel")
                    </label>
                    <textarea id="jwt-secret" class="textarea textarea-bordered w-full font-mono min-h-[80px]" placeholder="@T("SecretPlaceholder")" spellcheck="false"></textarea>
                </div>

                <div id="jwt-signature-status" class="mt-4 p-4 rounded-lg font-bold text-center hidden transition-all duration-300">
                    <!-- JS injects content here -->
                </div>
            </div>
        </div>

    </div>
    
    <script src="/tools/jwt-decoder.js"></script>

    <ToolSeoContent 
        Introduction="@T("Seo_Introduction")"
        DetailedDescription="@T("Seo_DetailedDescription")"
        DetailedDescriptionTitle="@TCommon("Seo_DetailedDescriptionTitle")"
        Examples="@T("Seo_Examples")"
        ExamplesTitle="@TCommon("Seo_ExamplesTitle")"
        HowToSteps="@T("Seo_HowToSteps")"
        HowToTitle="@TCommon("Seo_HowToTitle")"
        Tips="@T("Seo_Tips")"
        TipsTitle="@TCommon("Seo_TipsTitle")" />
</ToolLayout>

@code {
    protected override string LocalizationNamespace { get; set; } = "tools/jwt-decoder";
}
