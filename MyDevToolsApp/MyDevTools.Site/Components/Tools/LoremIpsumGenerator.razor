@page "/{lang}/lorem-ipsum-generator"
@inject NavigationManager Navigation
@inherits ToolComponentBase

<MetaTags Title="@T("Title")"
          Description="@T("Description")"
          CurrentUrl="@Navigation.Uri"
          ToolPath="lorem-ipsum-generator" />

<ToolLayout Title="@T("Title")" Description="@T("Description")">
    <div id="lorem-ipsum-root" class="grid grid-cols-1 lg:grid-cols-3 gap-6" data-copied="@T("Copied")">
        
        <!-- Controls -->
        <div class="card bg-base-100 shadow-xl h-fit lg:col-span-1">
            <div class="card-body p-4 sm:p-6">
                <h2 class="card-title text-base opacity-70 mb-4 flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
                    </svg>
                    Settings
                </h2>
                
                <!-- Count & Type -->
                <div class="form-control">
                    <label class="label text-sm font-semibold">
                        @T("GenerateTypeLabel")
                    </label>
                    <div class="join w-full">
                        <input class="input input-bordered join-item w-20 text-center" type="number" id="count" min="1" max="500" value="5" />
                        <select id="generate-type" class="select select-bordered join-item flex-1">
                            <option value="paragraphs">@T("Paragraphs")</option>
                            <option value="sentences">@T("Sentences")</option>
                            <option value="words">@T("Words")</option>
                            <option value="list-items">List Items</option>
                        </select>
                    </div>
                </div>

                <!-- Format -->
                <div class="form-control w-full mt-4">
                    <label class="label text-sm font-semibold">
                        Format
                    </label>
                    <select id="output-format" class="select select-bordered w-full">
                        <option value="plain">Plain Text</option>
                        <option value="html">HTML</option>
                        <option value="markdown">Markdown</option>
                    </select>
                </div>

                <div class="divider my-4 text-xs opacity-50">OPTIONS</div>

                <!-- Checkboxes -->
                <div class="form-control">
                    <label class="label cursor-pointer justify-start gap-3 py-1 hover:bg-base-200 rounded transition-colors px-2">
                        <input type="checkbox" id="start-classic" checked class="checkbox checkbox-sm checkbox-primary" />
                        <span class="label-text">@T("StartWithClassic")</span>
                    </label>
                </div>

                <!-- Rich Options -->
                <div id="rich-options" class="space-y-1">
                    <div class="form-control">
                        <label class="label cursor-pointer justify-start gap-3 py-1 hover:bg-base-200 rounded transition-colors px-2">
                            <input type="checkbox" id="include-headers" class="checkbox checkbox-sm" />
                            <span class="label-text">Include Headers</span>
                        </label>
                    </div>
                    <div class="form-control">
                        <label class="label cursor-pointer justify-start gap-3 py-1 hover:bg-base-200 rounded transition-colors px-2">
                            <input type="checkbox" id="include-lists" class="checkbox checkbox-sm" />
                            <span class="label-text">Include Lists</span>
                        </label>
                    </div>
                    <div class="form-control">
                        <label class="label cursor-pointer justify-start gap-3 py-1 hover:bg-base-200 rounded transition-colors px-2">
                            <input type="checkbox" id="include-formatting" class="checkbox checkbox-sm" />
                            <span class="label-text">Bold & Italic</span>
                        </label>
                    </div>
                    <div class="form-control">
                        <label class="label cursor-pointer justify-start gap-3 py-1 hover:bg-base-200 rounded transition-colors px-2">
                            <input type="checkbox" id="include-links" class="checkbox checkbox-sm" />
                            <span class="label-text">Include Links</span>
                        </label>
                    </div>
                    <div class="form-control">
                        <label class="label cursor-pointer justify-start gap-3 py-1 hover:bg-base-200 rounded transition-colors px-2">
                            <input type="checkbox" id="include-code" class="checkbox checkbox-sm" />
                            <span class="label-text">Code Blocks</span>
                        </label>
                    </div>
                </div>

                <div class="card-actions mt-6">
                    <button id="generate-btn" class="btn btn-primary w-full shadow-md">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
                        @T("GenerateButton")
                    </button>
                </div>
            </div>
        </div>

        <!-- Output -->
        <div class="card bg-base-100 shadow-xl h-full lg:col-span-2">
            <div class="card-body p-4 sm:p-6">
                <div class="flex justify-between items-center mb-2">
                    <h2 class="card-title text-base opacity-70">@T("OutputLabel")</h2>
                    <div class="flex gap-2">
                        <button id="copy-btn" class="btn btn-sm btn-ghost" title="@T("CopyButton")">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>
                            Copy
                        </button>
                        <button id="download-btn" class="btn btn-sm btn-ghost" title="@T("DownloadButton")">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                            Download
                        </button>
                    </div>
                </div>
                
                <textarea id="output" class="textarea textarea-bordered w-full h-[600px] font-mono text-sm leading-relaxed bg-base-200 focus:bg-base-100 transition-colors" readonly></textarea>
                
                <div class="text-xs opacity-50 mt-2 text-right font-mono" id="stats">
                    0 words, 0 characters
                </div>
            </div>
        </div>

    </div>
    
    <script src="/tools/lorem-ipsum-generator.js"></script>

    <ToolSeoContent 
        Introduction="@T("Seo_Introduction")"
        DetailedDescription="@T("Seo_DetailedDescription")"
        DetailedDescriptionTitle="@TCommon("Seo_DetailedDescriptionTitle")"
        Examples="@T("Seo_Examples")"
        ExamplesTitle="@TCommon("Seo_ExamplesTitle")"
        HowToSteps="@T("Seo_HowToSteps")"
        HowToTitle="@TCommon("Seo_HowToTitle")"
        Tips="@T("Seo_Tips")"
        TipsTitle="@TCommon("Seo_TipsTitle")" />
</ToolLayout>

@code {
    protected override string LocalizationNamespace { get; set; } = "tools/lorem-ipsum-generator";
}
