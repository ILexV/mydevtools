@page "/{lang}/markdown-preview"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.MarkdownPreview_Title"
          Description="@AppStrings.MarkdownPreview_Description"
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="markdown-preview" />

<JsonLdTool ToolName="@AppStrings.MarkdownPreview_Title"
            Description="@AppStrings.MarkdownPreview_Description"
            CurrentUrl="@Navigation.Uri" />

<ToolLayout Title="@AppStrings.MarkdownPreview_Title" Description="@AppStrings.MarkdownPreview_Description">
    <div id="markdown-preview-root">
        <!-- Toolbar -->
        <div class="markdown-toolbar">
            <div class="toolbar-section">
                <button class="btn btn-sm" id="md-bold" type="button" title="@AppStrings.MarkdownPreview_Bold">
                    <strong>B</strong>
                </button>
                <button class="btn btn-sm" id="md-italic" type="button" title="@AppStrings.MarkdownPreview_Italic">
                    <em>I</em>
                </button>
                <button class="btn btn-sm" id="md-heading" type="button" title="@AppStrings.MarkdownPreview_Heading">
                    H
                </button>
                <button class="btn btn-sm" id="md-link" type="button" title="@AppStrings.MarkdownPreview_Link">
                    🔗
                </button>
                <button class="btn btn-sm" id="md-image" type="button" title="@AppStrings.MarkdownPreview_Image">
                    🖼️
                </button>
                <button class="btn btn-sm" id="md-code" type="button" title="@AppStrings.MarkdownPreview_Code">
                    &lt;/&gt;
                </button>
                <button class="btn btn-sm" id="md-list" type="button" title="@AppStrings.MarkdownPreview_List">
                    ≡
                </button>
            </div>
            <div class="toolbar-section">
                <button class="btn btn-secondary btn-sm" id="md-clear" type="button">@AppStrings.MarkdownPreview_Clear</button>
            </div>
        </div>

        <!-- Split View -->
        <div class="markdown-split-view">
            <!-- Editor Section -->
            <div class="markdown-editor-section">
                <label class="label" for="markdown-input"><span class="label-text font-semibold">@AppStrings.MarkdownPreview_EditorLabel</span></label>
                <textarea id="markdown-input" 
                          placeholder="@AppStrings.MarkdownPreview_EditorPlaceholder"
                          spellcheck="false"></textarea>
            </div>

            <!-- Preview Section -->
            <div class="markdown-preview-section">
                <label class="label"><span class="label-text font-semibold">@AppStrings.MarkdownPreview_PreviewLabel</span></label>
                <div id="markdown-output" class="markdown-content"></div>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex flex-wrap gap-2">
            <button class="btn btn-secondary" id="md-copy-html" type="button">@AppStrings.MarkdownPreview_CopyHTML</button>
            <button class="btn btn-secondary" id="md-copy-md" type="button">@AppStrings.MarkdownPreview_CopyMarkdown</button>
            <button class="btn btn-secondary" id="md-download" type="button">@AppStrings.MarkdownPreview_Download</button>
        </div>

        <div class="alert alert-error" id="markdown-error" style="display: none;"></div>
    </div>
</ToolLayout>

<!-- Include marked.js locally -->
<script src="/js/marked.min.js"></script>
<script src="/js/markdown-preview.js"></script>

<style>
    .markdown-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        margin-bottom: 1rem;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .toolbar-section {
        display: flex;
        gap: 0.25rem;
        align-items: center;
    }

    .toolbar-btn {
        padding: 0.375rem 0.75rem;
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.875rem;
        transition: background 0.2s;
        min-width: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .toolbar-btn:hover {
        background: var(--bg-hover);
    }

    .markdown-split-view {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    @@media (max-width: 768px) {
        .markdown-split-view {
            grid-template-columns: 1fr;
        }
    }

    .markdown-editor-section,
    .markdown-preview-section {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .markdown-editor-section label,
    .markdown-preview-section label {
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

    #markdown-input {
        min-height: 400px;
        font-family: 'Courier New', monospace;
        font-size: 0.875rem;
        resize: vertical;
        padding: 1rem;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: var(--bg-primary);
        color: var(--text-primary);
    }

    .markdown-content {
        min-height: 400px;
        padding: 1rem;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: var(--bg-primary);
        overflow-y: auto;
        line-height: 1.6;
    }

    /* Markdown content styling */
    .markdown-content h1,
    .markdown-content h2,
    .markdown-content h3,
    .markdown-content h4,
    .markdown-content h5,
    .markdown-content h6 {
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        font-weight: 600;
        line-height: 1.25;
    }

    .markdown-content h1 { font-size: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.3rem; }
    .markdown-content h2 { font-size: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.3rem; }
    .markdown-content h3 { font-size: 1.25rem; }
    .markdown-content h4 { font-size: 1rem; }
    .markdown-content h5 { font-size: 0.875rem; }
    .markdown-content h6 { font-size: 0.85rem; color: var(--text-secondary); }

    .markdown-content p {
        margin: 0.75rem 0;
    }

    .markdown-content ul,
    .markdown-content ol {
        margin: 0.75rem 0;
        padding-left: 2rem;
    }

    .markdown-content li {
        margin: 0.25rem 0;
    }

    .markdown-content code {
        background: var(--bg-secondary);
        padding: 0.2em 0.4em;
        border-radius: 3px;
        font-family: 'Courier New', monospace;
        font-size: 0.875em;
    }

    .markdown-content pre {
        background: var(--bg-secondary);
        padding: 1rem;
        border-radius: 8px;
        overflow-x: auto;
        margin: 1rem 0;
    }

    .markdown-content pre code {
        background: none;
        padding: 0;
    }

    .markdown-content blockquote {
        border-left: 4px solid var(--border-color);
        padding-left: 1rem;
        margin: 1rem 0;
        color: var(--text-secondary);
    }

    .markdown-content table {
        border-collapse: collapse;
        width: 100%;
        margin: 1rem 0;
    }

    .markdown-content th,
    .markdown-content td {
        border: 1px solid var(--border-color);
        padding: 0.5rem;
        text-align: left;
    }

    .markdown-content th {
        background: var(--bg-secondary);
        font-weight: 600;
    }

    .markdown-content a {
        color: #3b82f6;
        text-decoration: none;
    }

    .markdown-content a:hover {
        text-decoration: underline;
    }

    .markdown-content img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 1rem 0;
    }

    .markdown-content hr {
        border: none;
        border-top: 1px solid var(--border-color);
        margin: 2rem 0;
    }
</style>

@code {
    /// <summary>
    /// Language parameter from URL route
    /// </summary>
    [Parameter]
    public string Lang { get; set; } = "en";
}
