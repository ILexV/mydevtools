@page "/{lang}/markdown-preview"
@inject NavigationManager Navigation
@inherits ToolComponentBase

<ToolLayout Title="@T("Title")" Description="@T("Description")">
    <MetaTags Title="@T("Title")"
              Description="@T("Description")"
              CurrentUrl="@Navigation.Uri"
              ToolPath="markdown-preview" />

    <div id="markdown-preview-root" class="flex flex-col h-full">
        <!-- Toolbar -->
        <div class="flex flex-wrap items-center justify-between gap-2 p-2 mb-4 rounded-lg bg-base-200 border border-base-300">
            <div class="flex flex-wrap gap-1">
                <div class="join">
                    <button class="btn btn-sm btn-ghost join-item" id="md-bold" type="button" title="@T("Bold")">
                        <strong class="text-lg">B</strong>
                    </button>
                    <button class="btn btn-sm btn-ghost join-item" id="md-italic" type="button" title="@T("Italic")">
                        <em class="text-lg">I</em>
                    </button>
                    <button class="btn btn-sm btn-ghost join-item" id="md-heading" type="button" title="@T("Heading")">
                        <span class="text-lg font-bold">H</span>
                    </button>
                </div>
                <div class="join">
                    <button class="btn btn-sm btn-ghost join-item" id="md-link" type="button" title="@T("Link")">
                        🔗
                    </button>
                    <button class="btn btn-sm btn-ghost join-item" id="md-image" type="button" title="@T("Image")">
                        🖼️
                    </button>
                </div>
                <div class="join">
                    <button class="btn btn-sm btn-ghost join-item" id="md-code" type="button" title="@T("Code")">
                        &lt;/&gt;
                    </button>
                    <button class="btn btn-sm btn-ghost join-item" id="md-list" type="button" title="@T("List")">
                        ≡
                    </button>
                </div>
            </div>
            <div>
                <label class="label cursor-pointer gap-2 border border-base-300 rounded-lg px-2 hover:bg-base-200 transition-colors">
                    <span class="label-text text-xs font-semibold">@T("SyncScroll")</span>
                    <input type="checkbox" class="toggle toggle-xs toggle-primary" id="md-sync-scroll" checked />
                </label>
            </div>
            <div>
                <button class="btn btn-sm btn-error btn-outline" id="md-clear" type="button">@T("Clear")</button>
            </div>
        </div>

        <!-- Split View -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 h-[600px] mb-4">
            <!-- Editor Section -->
            <div class="flex flex-col h-full min-h-0">
                <label class="label pt-0" for="markdown-input">
                    <span class="label-text font-bold">@T("EditorLabel")</span>
                </label>
                <textarea id="markdown-input" 
                          class="textarea textarea-bordered flex-1 min-h-0 w-full font-mono resize-none text-base leading-normal p-4"
                          placeholder="@T("EditorPlaceholder")"
                          spellcheck="false"></textarea>
            </div>

            <!-- Preview Section -->
            <div class="flex flex-col h-full min-h-0">
                <label class="label pt-0">
                    <span class="label-text font-bold">@T("PreviewLabel")</span>
                </label>
                <div id="markdown-output" class="prose prose-sm max-w-none flex-1 min-h-0 w-full border border-base-300 rounded-lg p-6 overflow-y-auto bg-base-100 shadow-sm"></div>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex flex-wrap gap-2 justify-end">
            <button class="btn btn-neutral" id="md-copy-html" type="button">
                @T("CopyHTML")
            </button>
            <button class="btn btn-neutral" id="md-copy-md" type="button">
                @T("CopyMarkdown")
            </button>
            <button class="btn btn-primary" id="md-download" type="button">
                @T("Download")
            </button>
        </div>

        <div class="alert alert-error mt-4" id="markdown-error" style="display: none;">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>Error!</span>
        </div>
    </div>

    <ToolSeoContent 
        Introduction="@T("Seo_Introduction")"
        DetailedDescription="@T("Seo_DetailedDescription")"
        DetailedDescriptionTitle="@TCommon("Seo_DetailedDescriptionTitle")"
        Examples="@T("Seo_Examples")"
        ExamplesTitle="@TCommon("Seo_ExamplesTitle")"
        HowToSteps="@T("Seo_HowToSteps")"
        HowToTitle="@TCommon("Seo_HowToTitle")"
        Tips="@T("Seo_Tips")"
        TipsTitle="@TCommon("Seo_TipsTitle")" />
</ToolLayout>

<!-- Include marked.js locally -->
<script src="/js/marked.min.js"></script>
<script src="/js/markdown-preview.js"></script>

@code {
    protected override string LocalizationNamespace { get; set; } = "tools/markdown-preview";
}
