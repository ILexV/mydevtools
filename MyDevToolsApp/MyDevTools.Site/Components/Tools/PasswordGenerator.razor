@page "/{lang}/password-generator"
@inject NavigationManager Navigation
@inherits ToolComponentBase

<ToolLayout Title="@T("Title")" Description="@T("Description")">
    
    <MetaTags 
        Title="@T("Title")" 
        Description="@T("Description")" 
        CurrentUrl="@Navigation.Uri" 
        ToolPath="password-generator" />

    <div id="password-generator-root"
         data-copied="@T("Copied")"
         class="max-w-5xl mx-auto space-y-6">

        <!-- Result Card -->
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body p-6">
                <div class="form-control">
                    <label class="label justify-center pb-1">
                        <span class="label-text font-bold text-lg">@T("ResultLabel")</span>
                    </label>
                    <div class="join w-full">
                        <input type="text" id="pg-result" class="input input-bordered join-item w-full text-center font-mono text-xl tracking-wider bg-base-200 text-base-content" readonly placeholder="..." />
                        <button class="btn btn-primary join-item px-6" id="pg-copy-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                            </svg>
                            <span class="hidden sm:inline ml-2">@T("CopyButton")</span>
                        </button>
                    </div>
                    <div class="mt-4">
                        <button id="pg-generate-btn" class="btn btn-secondary w-full btn-lg shadow-md">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 mr-2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                            </svg>
                            @T("GenerateButton")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Options Card -->
            <div class="card bg-base-100 shadow-xl h-full">
                <div class="card-body p-6">
                    <h3 class="card-title text-base mb-4 flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
                        </svg>
                        Options
                    </h3>
                    
                    <div class="space-y-4">
                        <div class="form-control w-full">
                            <label class="label cursor-pointer justify-between" for="pg-length">
                                <span class="label-text font-medium">@T("LengthLabel")</span>
                                <span id="pg-length-val" class="badge badge-lg badge-neutral font-mono">16</span>
                            </label>
                            <input type="range" class="range range-primary range-sm" id="pg-length" min="4" max="128" value="16" step="1" />
                            <div class="w-full flex justify-between text-xs px-2 mt-1 opacity-50">
                                <span>4</span>
                                <span>64</span>
                                <span>128</span>
                            </div>
                        </div>

                        <div class="divider my-2"></div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2">
                            <div class="form-control">
                                <label class="label cursor-pointer justify-start gap-3">
                                    <input type="checkbox" class="toggle toggle-primary toggle-sm" id="pg-uppercase" checked />
                                    <span class="label-text">@T("UppercaseLabel")</span>
                                </label>
                            </div>

                            <div class="form-control">
                                <label class="label cursor-pointer justify-start gap-3">
                                    <input type="checkbox" class="toggle toggle-primary toggle-sm" id="pg-lowercase" checked />
                                    <span class="label-text">@T("LowercaseLabel")</span>
                                </label>
                            </div>

                            <div class="form-control">
                                <label class="label cursor-pointer justify-start gap-3">
                                    <input type="checkbox" class="toggle toggle-primary toggle-sm" id="pg-numbers" checked />
                                    <span class="label-text">@T("NumbersLabel")</span>
                                </label>
                            </div>

                            <div class="form-control">
                                <label class="label cursor-pointer justify-start gap-3">
                                    <input type="checkbox" class="toggle toggle-primary toggle-sm" id="pg-special" checked />
                                    <span class="label-text">@T("SpecialLabel")</span>
                                </label>
                            </div>
                        </div>

                        <div class="form-control w-full mt-2">
                            <label class="label py-1" for="pg-special-chars"><span class="label-text text-sm opacity-70">@T("CustomSpecialLabel")</span></label>
                            <input type="text" class="input input-bordered w-full font-mono text-sm" id="pg-special-chars" placeholder="!@@#$%^&amp;*()_+-=[]{}|;:,.<>?" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- History Card -->
            <div class="card bg-base-100 shadow-xl h-full">
                <div class="card-body p-6">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="card-title text-base flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            @T("HistoryLabel")
                        </h3>
                        <button class="btn btn-xs btn-ghost text-error" id="pg-clear-history-btn">
                            @T("ClearHistory")
                        </button>
                    </div>
                    
                    <div class="overflow-x-auto rounded-lg border border-base-200">
                        <table class="table table-zebra table-sm w-full">
                            <tbody id="pg-history-list">
                                <!-- JS will populate -->
                            </tbody>
                        </table>
                        <div id="pg-history-empty" class="text-center text-sm opacity-50 py-4">
                            History is empty
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
    
    <script src="/tools/password-generator.js"></script>

    <ToolSeoContent 
        Introduction="@T("Seo_Introduction")"
        DetailedDescription="@T("Seo_DetailedDescription")"
        DetailedDescriptionTitle="@TCommon("Seo_DetailedDescriptionTitle")"
        Examples="@T("Seo_Examples")"
        ExamplesTitle="@TCommon("Seo_ExamplesTitle")"
        HowToSteps="@T("Seo_HowToSteps")"
        HowToTitle="@TCommon("Seo_HowToTitle")"
        Tips="@T("Seo_Tips")"
        TipsTitle="@TCommon("Seo_TipsTitle")" />
</ToolLayout>

@code {
    protected override string LocalizationNamespace { get; set; } = "tools/password-generator";
}
