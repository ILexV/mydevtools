@page "/{lang}/password-generator"
@using MyDevTools.Site.Components.Layout
@using MyDevTools.Site.Resources
@using MyDevTools.Site.Components.Seo
@inject NavigationManager Navigation

<ToolLayout Title="@AppStrings.PasswordGenerator_Title" Description="@AppStrings.PasswordGenerator_Description">
    
    <MetaTags 
        Title="@AppStrings.PasswordGenerator_Title" 
        Description="@AppStrings.PasswordGenerator_Description" 
        CurrentUrl="@Navigation.Uri" />

    <HreflangLinks ToolPath="password-generator" />

    <JsonLdTool ToolName="@AppStrings.PasswordGenerator_Title" 
                Description="@AppStrings.PasswordGenerator_Description" 
                CurrentUrl="@Navigation.Uri" />

    <div id="password-generator-root"
         data-copied="@AppStrings.PasswordGenerator_Copied"
         class="tool-container">

        <div class="card mb-4">
            <div class="card-body">
                <div class="result-section">
                    <label class="form-label text-muted small">@AppStrings.PasswordGenerator_ResultLabel</label>
                    <div class="input-group input-group-lg mb-3">
                        <input type="text" id="pg-result" class="form-control font-monospace text-center" readonly placeholder="..." />
                        <button class="btn btn-primary" id="pg-copy-btn">
                            @AppStrings.PasswordGenerator_CopyButton
                        </button>
                    </div>
                    <button id="pg-generate-btn" class="btn btn-success w-100 py-2 fw-bold">
                        @AppStrings.PasswordGenerator_GenerateButton
                    </button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-transparent fw-bold">Options</div>
                    <div class="card-body">
                        
                        <div class="mb-4">
                            <label for="pg-length" class="form-label d-flex justify-content-between">
                                <span>@AppStrings.PasswordGenerator_LengthLabel</span>
                                <span id="pg-length-val" class="badge bg-secondary">16</span>
                            </label>
                            <input type="range" class="form-range" id="pg-length" min="4" max="128" value="16">
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="pg-uppercase" checked>
                            <label class="form-check-label" for="pg-uppercase">@AppStrings.PasswordGenerator_UppercaseLabel</label>
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="pg-lowercase" checked>
                            <label class="form-check-label" for="pg-lowercase">@AppStrings.PasswordGenerator_LowercaseLabel</label>
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="pg-numbers" checked>
                            <label class="form-check-label" for="pg-numbers">@AppStrings.PasswordGenerator_NumbersLabel</label>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="pg-special" checked>
                            <label class="form-check-label" for="pg-special">@AppStrings.PasswordGenerator_SpecialLabel</label>
                        </div>

                        <div class="mb-2">
                            <label for="pg-special-chars" class="form-label small">@AppStrings.PasswordGenerator_CustomSpecialLabel</label>
                            <input type="text" class="form-control form-control-sm font-monospace" id="pg-special-chars" placeholder="!@@#$%^&*()_+-=[]{}|;:,.<>?" />
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-transparent fw-bold d-flex justify-content-between align-items-center">
                        <span>@AppStrings.PasswordGenerator_HistoryLabel</span>
                        <button class="btn btn-sm btn-outline-danger" id="pg-clear-history-btn">@AppStrings.PasswordGenerator_ClearHistory</button>
                    </div>
                    <div class="card-body p-0">
                        <div id="pg-history-list" class="list-group list-group-flush history-container">
                            <!-- JS will populate -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <style>
        .result-section input {
            font-size: 1.5rem;
            letter-spacing: 1px;
        }
        .history-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem 1rem;
            border-bottom: 1px solid var(--bs-border-color);
            font-family: var(--bs-font-monospace);
        }
        .history-item:last-child {
            border-bottom: none;
        }
        .history-pass {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            margin-right: 10px;
        }
        .btn-icon {
            background: none;
            border: none;
            cursor: pointer;
            opacity: 0.6;
            transition: opacity 0.2s;
        }
        .btn-icon:hover {
            opacity: 1;
        }
        .copied-state {
            color: green;
        }
    </style>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
