@page "/{lang}/password-generator"
@using MyDevTools.Site.Components.Layout
@using MyDevTools.Site.Resources
@using MyDevTools.Site.Components.Seo
@inject NavigationManager Navigation

<ToolLayout Title="@AppStrings.PasswordGenerator_Title" Description="@AppStrings.PasswordGenerator_Description">
    
    <MetaTags 
        Title="@AppStrings.PasswordGenerator_Title" 
        Description="@AppStrings.PasswordGenerator_Description" 
        CurrentUrl="@Navigation.Uri" />

    <HreflangLinks ToolPath="password-generator" />

    <JsonLdTool ToolName="@AppStrings.PasswordGenerator_Title" 
                Description="@AppStrings.PasswordGenerator_Description" 
                CurrentUrl="@Navigation.Uri" />

    <div id="password-generator-root"
         data-copied="@AppStrings.PasswordGenerator_Copied"
         class="tool-container">

        <div class="card bg-base-200 mb-4">
            <div class="card-body">
                <div class="result-section space-y-4">
                    <label class="label"><span class="label-text font-semibold">@AppStrings.PasswordGenerator_ResultLabel</span></label>
                    <div class="join w-full">
                        <input type="text" id="pg-result" class="input input-bordered input-lg join-item font-mono text-center flex-1" readonly placeholder="..." />
                        <button class="btn btn-primary join-item" id="pg-copy-btn">
                            @AppStrings.PasswordGenerator_CopyButton
                        </button>
                    </div>
                    <button id="pg-generate-btn" class="btn btn-success w-full">
                        @AppStrings.PasswordGenerator_GenerateButton
                    </button>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div>
                <div class="card bg-base-200 h-full">
                    <div class="card-header bg-transparent font-bold p-4">Options</div>
                    <div class="card-body space-y-4">
                        
                        <div class="form-control w-full">
                            <label class="label" for="pg-length">
                                <span class="label-text">@AppStrings.PasswordGenerator_LengthLabel</span>
                                <span id="pg-length-val" class="badge badge-secondary">16</span>
                            </label>
                            <input type="range" class="range range-primary" id="pg-length" min="4" max="128" value="16" />
                        </div>

                        <div class="form-control">
                            <label class="label cursor-pointer">
                                <span class="label-text">@AppStrings.PasswordGenerator_UppercaseLabel</span>
                                <input type="checkbox" class="toggle toggle-primary" id="pg-uppercase" checked />
                            </label>
                        </div>

                        <div class="form-control">
                            <label class="label cursor-pointer">
                                <span class="label-text">@AppStrings.PasswordGenerator_LowercaseLabel</span>
                                <input type="checkbox" class="toggle toggle-primary" id="pg-lowercase" checked />
                            </label>
                        </div>

                        <div class="form-control">
                            <label class="label cursor-pointer">
                                <span class="label-text">@AppStrings.PasswordGenerator_NumbersLabel</span>
                                <input type="checkbox" class="toggle toggle-primary" id="pg-numbers" checked />
                            </label>
                        </div>

                        <div class="form-control">
                            <label class="label cursor-pointer">
                                <span class="label-text">@AppStrings.PasswordGenerator_SpecialLabel</span>
                                <input type="checkbox" class="toggle toggle-primary" id="pg-special" checked />
                            </label>
                        </div>

                        <div class="form-control w-full">
                            <label class="label" for="pg-special-chars"><span class="label-text text-sm">@AppStrings.PasswordGenerator_CustomSpecialLabel</span></label>
                            <input type="text" class="input input-sm input-bordered w-full font-mono" id="pg-special-chars" placeholder="!@@#$%^&*()_+-=[]{}|;:,.<>?" />
                        </div>

                    </div>
                </div>
            </div>

            <div>
                <div class="card bg-base-200 h-full">
                    <div class="card-header bg-transparent font-bold flex justify-between items-center p-4">
                        <span>@AppStrings.PasswordGenerator_HistoryLabel</span>
                        <button class="btn btn-sm btn-outline btn-error" id="pg-clear-history-btn">@AppStrings.PasswordGenerator_ClearHistory</button>
                    </div>
                    <div class="card-body p-0">
                        <div id="pg-history-list" class="history-container">
                            <!-- JS will populate -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <style>
        .result-section input {
            font-size: 1.5rem;
            letter-spacing: 1px;
        }
        .history-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem 1rem;
            border-bottom: 1px solid var(--bs-border-color);
            font-family: var(--bs-font-monospace);
        }
        .history-item:last-child {
            border-bottom: none;
        }
        .history-pass {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            margin-right: 10px;
        }
        .btn-icon {
            background: none;
            border: none;
            cursor: pointer;
            opacity: 0.6;
            transition: opacity 0.2s;
        }
        .btn-icon:hover {
            opacity: 1;
        }
        .copied-state {
            color: green;
        }
    </style>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
