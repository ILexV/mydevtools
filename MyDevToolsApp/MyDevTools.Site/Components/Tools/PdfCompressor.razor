@page "/{lang}/pdf-compressor"
@inject NavigationManager Navigation
@inherits ToolComponentBase

<ToolLayout Title="@T("Title")" Description="@T("Description")">
    <MetaTags Title="@T("Title")"
              Description="@T("Description")"
              CurrentUrl="@Navigation.Uri"
              ToolPath="pdf-compressor" />

    <div id="pdf-compressor-root" class="max-w-5xl mx-auto space-y-8"
         data-loading="@TCommon("Common_Loading")"
         data-error="@TCommon("Common_Error")"
         data-processing="Compressing..."
         data-done="Compressed!"
         data-download="@T("DownloadButton")">

        <!-- Input Card -->
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body p-4 sm:p-6">
                <h2 class="card-title text-primary flex items-center gap-2 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5l-6-6" />
                    </svg>
                    @TCommon("Common_Input")
                </h2>
                
                <div class="upload-box mb-6">
                    <FileDropZone Id="pdf-compressor-drop-zone"
                                  InputId="pdf-compress-input"
                                  IconSvg='<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" /></svg>'
                                  Description="@T("DropZoneTitle")"
                                  Accept=".pdf"
                                  ShowFileInfo="false" 
                                  AllowMultiple="true" />
                </div>
            </div>
        </div>

        <!-- File List & Actions -->
        <div class="card bg-base-100 shadow-xl hidden file-list-container">
            <div class="card-body p-4 sm:p-6">
                <h3 class="card-title text-base opacity-70 mb-4">Files to Process</h3>
                
                <div class="overflow-x-auto rounded-lg border border-base-200 mb-6">
                    <table class="table w-full">
                        <thead class="bg-base-200">
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Original Size</th>
                                <th>Compressed Size</th>
                                <th>Status / Action</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody class="file-list">
                            <!-- Items injected by JS -->
                        </tbody>
                    </table>
                </div>

                <div class="flex flex-wrap gap-4 justify-end">
                    <button id="pdf-compress-btn" class="btn btn-primary w-full sm:w-auto shadow-md">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                        </svg>
                        @T("CompressButton")
                    </button>
                </div>
                
                <div class="alert alert-error shadow-lg text-sm mt-4 hidden" id="pdf-error">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span id="pdf-error-text">@TCommon("Common_Error")</span>
                </div>
            </div>
        </div>
    </div>

    <ToolSeoContent 
        Introduction="@T("Seo_Introduction")"
        DetailedDescription="@T("Seo_DetailedDescription")"
        DetailedDescriptionTitle="@TCommon("Seo_DetailedDescriptionTitle")"
        Examples="@T("Seo_Examples")"
        ExamplesTitle="@TCommon("Seo_ExamplesTitle")"
        HowToSteps="@T("Seo_HowToSteps")"
        HowToTitle="@TCommon("Seo_HowToTitle")"
        Tips="@T("Seo_Tips")"
        TipsTitle="@TCommon("Seo_TipsTitle")" />
</ToolLayout>

@code {
    protected override string LocalizationNamespace { get; set; } = "tools/pdf-compressor";
}