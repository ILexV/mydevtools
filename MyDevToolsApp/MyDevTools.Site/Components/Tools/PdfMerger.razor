@page "/{lang}/pdf-merger"
@inject NavigationManager Navigation
@inherits ToolComponentBase

<ToolLayout Title="@T("Title")" Description="@T("Description")">
    <MetaTags Title="@T("Title")"
              Description="@T("Description")"
              CurrentUrl="@Navigation.Uri"
              ToolPath="pdf-merger"
              Keywords="@T("Keywords")"
              Category="PDF"
              HowToSteps="@T("Seo_HowToSteps")" />

    <div id="pdf-merger-root" class="max-w-5xl mx-auto space-y-8"
         data-loading="@TCommon("Common_Loading")"
         data-error="@TCommon("Common_Error")"
         data-processing="@T("MergeButton")"
         data-done="@T("Success")">

        <!-- Input Card -->
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body p-4 sm:p-6">
                <h2 class="card-title text-primary flex items-center gap-2 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                    </svg>
                    @TCommon("Common_Input")
                </h2>

                <div class="upload-box mb-6">
                    <FileDropZone Id="pdf-merger-drop-zone"
                                  InputId="pdf-input-files"
                                  IconSvg='<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" /></svg>'
                                  Description="@T("DropZoneTitle")"
                                  Accept=".pdf"
                                  ShowFileInfo="false"
                                  AllowMultiple="true" />
                </div>
            </div>
        </div>

        <!-- File List & Actions -->
        <div class="card bg-base-100 shadow-xl hidden file-list-container">
            <div class="card-body p-4 sm:p-6">
                <h3 class="card-title text-base opacity-70 mb-4">@T("DropZoneTitle")</h3>

                <div class="overflow-x-auto rounded-lg border border-base-200 mb-6">
                    <table class="table w-full">
                        <thead class="bg-base-200">
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Size</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody class="file-list">
                            <!-- Items injected by JS -->
                        </tbody>
                    </table>
                </div>

                <div class="flex flex-wrap gap-4 justify-end items-center">
                    <button id="pdf-merge-btn" class="btn btn-primary w-full sm:w-auto shadow-md">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
                        </svg>
                        @T("MergeButton")
                    </button>
                    <a id="pdf-download-btn" class="btn btn-success w-full sm:w-auto shadow-md hidden" download="merged.pdf">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        @T("DownloadButton")
                    </a>
                </div>

                <div class="alert alert-error shadow-lg text-sm mt-4 hidden" id="pdf-error">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span id="pdf-error-text">@TCommon("Common_Error")</span>
                </div>
            </div>
        </div>
    </div>

    <ToolSeoContent
        Introduction="@T("Seo_Introduction")"
        DetailedDescription="@T("Seo_DetailedDescription")"
        DetailedDescriptionTitle="@TCommon("Seo_DetailedDescriptionTitle")"
        Examples="@T("Seo_Examples")"
        ExamplesTitle="@TCommon("Seo_ExamplesTitle")"
        HowToSteps="@T("Seo_HowToSteps")"
        HowToTitle="@TCommon("Seo_HowToTitle")"
        Tips="@T("Seo_Tips")"
        TipsTitle="@TCommon("Seo_TipsTitle")" />
</ToolLayout>

@code {
    protected override string LocalizationNamespace { get; set; } = "tools/pdf-merger";
}
