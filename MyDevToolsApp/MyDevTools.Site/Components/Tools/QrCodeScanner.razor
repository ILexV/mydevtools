@page "/{lang}/qr-scanner"
@using MyDevTools.Site.Resources
@using MyDevTools.Site.Components.Seo
@inject NavigationManager Navigation

<ToolLayout Title="@AppStrings.QrScanner_Title" Description="@AppStrings.QrScanner_Description">
    <MetaTags Title="@AppStrings.QrScanner_Title" 
              Description="@AppStrings.QrScanner_Description" 
              CurrentUrl="@Navigation.Uri"
              ToolPath="qr-scanner" />

    <div id="qr-scanner-tool-root" class="max-w-4xl mx-auto space-y-6">
        
        <!-- Input Card -->
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body p-4 sm:p-6">
                <h2 class="card-title text-primary flex items-center gap-2 mb-4">
                    @* Custom Camera Icon or Generic Upload *@
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0ZM18.75 10.5h.008v.008h-.008V10.5Z" />
                    </svg>
                    @AppStrings.QrScanner_DropZone
                </h2>

                <FileDropZone 
                    Id="drop-zone" 
                    InputId="file-input"
                    IconSvg="@CameraIconSvg"
                    Description="@AppStrings.QrScanner_DropZone"
                    Accept="image/*"
                    ShowFileInfo="true"
                    ShowPreview="true"
                    ShowClearButton="true" />
            </div>
        </div>

        <!-- Result Section -->
        <div id="result-section" class="card bg-base-100 shadow-xl hidden">
            <div class="card-body p-4 sm:p-6">
                <h3 class="card-title text-secondary mb-4">
                    @AppStrings.QrScanner_ResultLabel
                </h3>
                
                <div class="relative">
                    <textarea id="result-text" readonly 
                        class="textarea textarea-bordered w-full font-mono text-base h-32 pr-12 bg-base-200 text-base-content"></textarea>
                    
                    <button id="copy-btn" class="btn btn-sm btn-ghost absolute top-2 right-2" title="Copy">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                    </button>
                </div>
                
                <!-- Link Action (Visible if URL) -->
                <div id="link-action" class="mt-4 hidden">
                    <a id="open-link-btn" href="#" target="_blank" rel="noopener noreferrer" 
                       class="btn btn-success text-white w-full sm:w-auto">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                        Open Link
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Error Message -->
        <div id="error-message" class="alert alert-error shadow-lg hidden">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span id="error-message-text"></span>
        </div>

    </div>
</ToolLayout>

<script src="/tools/qr-scanner.js"></script>

@code {
    [Parameter]
    public string? Lang { get; set; }

    private const string CameraIconSvg = @"<svg class=""w-12 h-12 text-gray-400"" fill=""none"" stroke=""currentColor"" viewBox=""0 0 24 24"">
    <path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"" />
    <path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M15 13a3 3 0 11-6 0 3 3 0 016 0z"" />
</svg>";
}
