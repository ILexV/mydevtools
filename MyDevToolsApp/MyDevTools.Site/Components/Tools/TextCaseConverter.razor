@page "/{lang}/text-case-converter"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<ToolLayout Title="@AppStrings.TextCaseConverter_Title" Description="@AppStrings.TextCaseConverter_Description">
    <MetaTags Title="@AppStrings.TextCaseConverter_Title" 
              Description="@AppStrings.TextCaseConverter_Description" 
              CurrentUrl="@Navigation.Uri"
              ToolPath="text-case-converter" />

    <div id="text-case-converter-root"
         data-copied="@AppStrings.TextCaseConverter_Copied"
         data-input-placeholder="@AppStrings.TextCaseConverter_InputPlaceholder"
         class="max-w-4xl mx-auto">
        
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body p-4 sm:p-6">
                
                <!-- Toolbar with Copy/Clear -->
                <div class="flex flex-wrap justify-between items-center gap-2 mb-4">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-semibold opacity-70">@AppStrings.Common_Input / @AppStrings.Common_Output</span>
                    </div>
                    <div class="join">
                        <button type="button" class="btn btn-sm btn-ghost join-item text-error" id="tcc-clear-btn" title="@AppStrings.TextCaseConverter_ClearButton">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                            @AppStrings.TextCaseConverter_ClearButton
                        </button>
                        <button type="button" class="btn btn-sm btn-ghost join-item" id="tcc-copy-btn" title="@AppStrings.TextCaseConverter_CopyButton">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                            </svg>
                            @AppStrings.TextCaseConverter_CopyButton
                        </button>
                    </div>
                </div>

                <!-- Text Area -->
                <textarea id="tcc-input-text" 
                          rows="12" 
                          placeholder="@AppStrings.TextCaseConverter_InputPlaceholder" 
                          class="textarea textarea-bordered w-full font-mono text-base leading-relaxed bg-base-200 focus:bg-base-100 transition-colors duration-200"></textarea>

                <div class="divider my-6 text-sm font-bold opacity-50">ACTIONS</div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Standard Cases -->
                    <div class="flex flex-col gap-2">
                        <h3 class="text-sm font-semibold opacity-70 mb-1">Standard</h3>
                        <div class="grid grid-cols-2 gap-2">
                            <button type="button" class="btn btn-secondary" data-case-type="sentence">@AppStrings.TextCaseConverter_SentenceCase</button>
                            <button type="button" class="btn btn-secondary" data-case-type="lower">@AppStrings.TextCaseConverter_LowerCase</button>
                            <button type="button" class="btn btn-secondary" data-case-type="upper">@AppStrings.TextCaseConverter_UpperCase</button>
                            <button type="button" class="btn btn-secondary" data-case-type="title">@AppStrings.TextCaseConverter_TitleCase</button>
                            <button type="button" class="btn btn-outline" data-case-type="alternating">@AppStrings.TextCaseConverter_AlternatingCase</button>
                            <button type="button" class="btn btn-outline" data-case-type="inverse">@AppStrings.TextCaseConverter_InverseCase</button>
                        </div>
                    </div>

                    <!-- Code Cases -->
                    <div class="flex flex-col gap-2">
                        <h3 class="text-sm font-semibold opacity-70 mb-1">Code</h3>
                        <div class="grid grid-cols-2 gap-2">
                             <button type="button" class="btn btn-neutral" data-case-type="camel">@AppStrings.TextCaseConverter_CamelCase</button>
                            <button type="button" class="btn btn-neutral" data-case-type="snake">@AppStrings.TextCaseConverter_SnakeCase</button>
                            <button type="button" class="btn btn-neutral" data-case-type="kebab">@AppStrings.TextCaseConverter_KebabCase</button>
                            <!-- Placeholder for potentially new cases like PascalCase or ConstantCase in future -->
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    
    <script src="/tools/text-case-converter.js"></script>

    <ToolSeoContent 
        Introduction="@AppStrings.TextCaseConverter_Seo_Introduction"
        DetailedDescription="@AppStrings.TextCaseConverter_Seo_DetailedDescription"
        DetailedDescriptionTitle="@AppStrings.Seo_DetailedDescriptionTitle"
        Examples="@AppStrings.TextCaseConverter_Seo_Examples"
        ExamplesTitle="@AppStrings.Seo_ExamplesTitle"
        HowToSteps="@AppStrings.TextCaseConverter_Seo_HowToSteps"
        HowToTitle="@AppStrings.Seo_HowToTitle"
        Tips="@AppStrings.TextCaseConverter_Seo_Tips"
        TipsTitle="@AppStrings.Seo_TipsTitle" />
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
