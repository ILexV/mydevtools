@page "/{lang}/text-diff-viewer"
@inject NavigationManager Navigation
@inherits ToolComponentBase

<ToolLayout Title="@T("Title")" Description="@T("Description")">
    <MetaTags Title="@T("Title")" 
              Description="@T("Description")" 
              CurrentUrl="@Navigation.Uri"
              ToolPath="text-diff-viewer" />

    <div id="text-diff-viewer-root"
         data-error-msg="@T("ErrorMessage")"
         data-loading-msg="@TCommon("Common_Loading")"
         class="max-w-6xl mx-auto">
        
        <!-- Controls & Input Area -->
        <div class="card bg-base-100 shadow-xl mb-6">
            <div class="card-body p-4 sm:p-6">
                
                <!-- Input Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-4">
                    <!-- Original -->
                    <div class="form-control w-full">
                        <label class="label justify-between" for="diff-original-text">
                            <span class="label-text font-bold text-lg">@T("OriginalLabel")</span>
                            <div class="tooltip" data-tip="@T("ChooseOriginalFile")">
                                <label for="diff-original-file" class="btn btn-xs btn-outline">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
                                    </svg>
                                    Load File
                                </label>
                                <input type="file" id="diff-original-file" class="hidden" />
                            </div>
                        </label>
                        <textarea id="diff-original-text" 
                                  class="textarea textarea-bordered h-64 font-mono text-sm leading-relaxed" 
                                  placeholder="@T("OriginalPlaceholder")"></textarea>
                    </div>

                    <!-- Modified -->
                    <div class="form-control w-full">
                        <label class="label justify-between" for="diff-modified-text">
                            <span class="label-text font-bold text-lg">@T("ModifiedLabel")</span>
                            <div class="tooltip" data-tip="@T("ChooseModifiedFile")">
                                <label for="diff-modified-file" class="btn btn-xs btn-outline">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
                                    </svg>
                                    Load File
                                </label>
                                <input type="file" id="diff-modified-file" class="hidden" />
                            </div>
                        </label>
                        <textarea id="diff-modified-text" 
                                  class="textarea textarea-bordered h-64 font-mono text-sm leading-relaxed" 
                                  placeholder="@T("ModifiedPlaceholder")"></textarea>
                    </div>
                </div>

                <!-- Action Bar -->
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div class="join">
                        <button type="button" class="btn btn-primary join-item" id="diff-compare-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                            </svg>
                            @T("CompareButton")
                        </button>
                        <button type="button" class="btn btn-secondary join-item" id="diff-clear-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                            @T("ClearButton")
                        </button>
                    </div>

                    <div class="flex items-center gap-4 bg-base-200 px-4 py-2 rounded-lg">
                        <label class="label cursor-pointer gap-2 m-0 p-0">
                            <span class="label-text font-medium">@T("LineByLine")</span>
                            <input type="radio" name="diff-view-mode" class="radio radio-primary radio-sm" value="line-by-line" />
                        </label>
                        <div class="divider divider-horizontal mx-0"></div>
                        <label class="label cursor-pointer gap-2 m-0 p-0">
                            <span class="label-text font-medium">@T("SideBySide")</span>
                            <input type="radio" name="diff-view-mode" class="radio radio-primary radio-sm" value="side-by-side" checked />
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Output Area -->
        <div id="diff-output" class="card bg-base-100 shadow-xl overflow-hidden min-h-[100px] hidden">
            <!-- Diff2Html renders here -->
        </div>
    </div>
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsdiff/5.1.0/diff.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/diff2html/bundles/js/diff2html-ui.min.js"></script>
    <script src="/tools/text-diff-viewer.js"></script>

    <ToolSeoContent 
        Introduction="@T("Seo_Introduction")"
        DetailedDescription="@T("Seo_DetailedDescription")"
        DetailedDescriptionTitle="@TCommon("Seo_DetailedDescriptionTitle")"
        Examples="@T("Seo_Examples")"
        ExamplesTitle="@TCommon("Seo_ExamplesTitle")"
        HowToSteps="@T("Seo_HowToSteps")"
        HowToTitle="@TCommon("Seo_HowToTitle")"
        Tips="@T("Seo_Tips")"
        TipsTitle="@TCommon("Seo_TipsTitle")" />
</ToolLayout>

@code {
    protected override string LocalizationNamespace { get; set; } = "tools/text-diff-viewer";
}