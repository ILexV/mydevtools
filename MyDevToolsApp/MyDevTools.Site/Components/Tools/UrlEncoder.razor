@page "/{lang}/url-encoder"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.UrlEncoder_Title"
          Description="@AppStrings.UrlEncoder_Description"
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="url-encoder" />

<JsonLdTool ToolName="@AppStrings.UrlEncoder_Title"
            Description="@AppStrings.UrlEncoder_Description"
            CurrentUrl="@Navigation.Uri" />

<ToolLayout Title="@AppStrings.UrlEncoder_Title" Description="@AppStrings.UrlEncoder_Description">
    <div id="url-encoder-root"
         data-error="@AppStrings.Common_Error"
         data-copied="@AppStrings.UrlEncoder_Copied">

        <div class="tool-links" aria-label="@AppStrings.UrlEncoder_OtherFormats">
            <span class="tool-links-title">@AppStrings.UrlEncoder_OtherFormats</span>
            <a class="tool-link" href="/@Lang/hex-encoder">@AppStrings.UrlEncoder_LinkHex</a>
            <a class="tool-link" href="/@Lang/base32-encoder">@AppStrings.UrlEncoder_LinkBase32</a>
            <a class="tool-link" href="/@Lang/base58-encoder">@AppStrings.UrlEncoder_LinkBase58</a>
            <a class="tool-link" href="/@Lang/base64-encoder">@AppStrings.UrlEncoder_LinkBase64</a>
        </div>

        <div class="tool-grid">
            <div class="input-section">
                <label for="url-input">@AppStrings.UrlEncoder_InputLabel</label>
                <textarea id="url-input" rows="10" placeholder="@AppStrings.UrlEncoder_InputPlaceholder"></textarea>

                <div class="tool-settings">
                    <div class="tool-setting">
                        <label for="url-mode">@AppStrings.UrlEncoder_ModeLabel</label>
                        <select id="url-mode">
                            <option value="component">@AppStrings.UrlEncoder_Mode_Component</option>
                            <option value="uri">@AppStrings.UrlEncoder_Mode_Uri</option>
                            <option value="form">@AppStrings.UrlEncoder_Mode_Form</option>
                        </select>
                    </div>

                    <div class="tool-setting">
                        <label for="url-charset">@AppStrings.UrlEncoder_CharsetLabel</label>
                        <select id="url-charset">
                            <option value="utf-8">UTF-8</option>
                            <option value="utf-16le">UTF-16LE</option>
                            <option value="utf-16be">UTF-16BE</option>
                            <option value="ascii">ASCII</option>
                            <option value="latin1">ISO-8859-1 (Latin-1)</option>
                        </select>
                    </div>
                </div>

                <div class="action-buttons">
                    <button class="btn btn-primary" id="url-encode-btn" type="button">@AppStrings.UrlEncoder_ActionEncode</button>
                    <button class="btn btn-secondary" id="url-decode-btn" type="button">@AppStrings.UrlEncoder_ActionDecode</button>
                    <button class="btn btn-secondary" id="url-swap-btn" type="button">@AppStrings.UrlEncoder_ActionSwap</button>
                    <button class="btn btn-secondary" id="url-clear-btn" type="button">@AppStrings.UrlEncoder_ActionClear</button>
                </div>

                <div class="tool-error" id="url-error" hidden></div>
            </div>

            <div class="output-section">
                <label for="url-output">@AppStrings.UrlEncoder_OutputLabel</label>
                <textarea id="url-output" rows="10" readonly></textarea>

                <div class="action-buttons">
                    <button class="btn btn-secondary" id="url-copy-btn" type="button">@AppStrings.UrlEncoder_Copy</button>
                </div>
            </div>
        </div>
    </div>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
