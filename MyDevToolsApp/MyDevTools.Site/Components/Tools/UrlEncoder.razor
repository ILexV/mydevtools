@page "/{lang}/url-encoder"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.UrlEncoder_Title"
          Description="@AppStrings.UrlEncoder_Description"
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="url-encoder" />

<JsonLdTool ToolName="@AppStrings.UrlEncoder_Title"
            Description="@AppStrings.UrlEncoder_Description"
            CurrentUrl="@Navigation.Uri" />

<ToolLayout Title="@AppStrings.UrlEncoder_Title" Description="@AppStrings.UrlEncoder_Description">
    <div id="url-encoder-root"
         data-error="@AppStrings.Common_Error"
         data-copied="@AppStrings.UrlEncoder_Copied">

        <div class="flex flex-wrap gap-2 items-center mb-4" aria-label="@AppStrings.UrlEncoder_OtherFormats">
            <span class="tool-links-title">@AppStrings.UrlEncoder_OtherFormats</span>
            <a class="link link-primary" href="/@Lang/hex-encoder">@AppStrings.UrlEncoder_LinkHex</a>
            <a class="link link-primary" href="/@Lang/base32-encoder">@AppStrings.UrlEncoder_LinkBase32</a>
            <a class="link link-primary" href="/@Lang/base58-encoder">@AppStrings.UrlEncoder_LinkBase58</a>
            <a class="link link-primary" href="/@Lang/base64-encoder">@AppStrings.UrlEncoder_LinkBase64</a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="space-y-4">
                <label class="label" for="url-input"><span class="label-text font-semibold">@AppStrings.UrlEncoder_InputLabel</span></label>
                <textarea id="url-input" rows="10" placeholder="@AppStrings.UrlEncoder_InputPlaceholder" class="textarea textarea-bordered w-full font-mono"></textarea>

                <div class="collapse collapse-arrow bg-base-200">
                    <input type="checkbox" checked /> 
                    <div class="collapse-title text-xl font-medium">
                        Settings
                    </div>
                    <div class="collapse-content space-y-4">
                        <div class="form-control w-full">
                            <label class="label" for="url-mode"><span class="label-text">@AppStrings.UrlEncoder_ModeLabel</span></label>
                            <select id="url-mode" class="select select-bordered w-full">
                                <option value="component">@AppStrings.UrlEncoder_Mode_Component</option>
                                <option value="uri">@AppStrings.UrlEncoder_Mode_Uri</option>
                                <option value="form">@AppStrings.UrlEncoder_Mode_Form</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label" for="url-charset"><span class="label-text">@AppStrings.UrlEncoder_CharsetLabel</span></label>
                            <select id="url-charset" class="select select-bordered w-full">
                                <option value="utf-8">UTF-8</option>
                                <option value="utf-16le">UTF-16LE</option>
                                <option value="utf-16be">UTF-16BE</option>
                                <option value="ascii">ASCII</option>
                                <option value="latin1">ISO-8859-1 (Latin-1)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap gap-2">
                    <button class="btn btn-primary" id="url-encode-btn" type="button">@AppStrings.UrlEncoder_ActionEncode</button>
                    <button class="btn btn-secondary" id="url-decode-btn" type="button">@AppStrings.UrlEncoder_ActionDecode</button>
                    <button class="btn btn-secondary" id="url-swap-btn" type="button">@AppStrings.UrlEncoder_ActionSwap</button>
                    <button class="btn btn-secondary" id="url-clear-btn" type="button">@AppStrings.UrlEncoder_ActionClear</button>
                </div>

                <div class="alert alert-error" id="url-error" style="display: none;"></div>
            </div>

            <div class="space-y-4">
                <label class="label" for="url-output"><span class="label-text font-semibold">@AppStrings.UrlEncoder_OutputLabel</span></label>
                <textarea id="url-output" rows="10" readonly class="textarea textarea-bordered w-full font-mono"></textarea>

                <div class="flex flex-wrap gap-2">
                    <button class="btn btn-secondary" id="url-copy-btn" type="button">@AppStrings.UrlEncoder_Copy</button>
                </div>
            </div>
        </div>
    </div>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
