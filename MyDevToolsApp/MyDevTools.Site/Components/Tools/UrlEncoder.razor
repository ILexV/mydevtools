@page "/{lang}/url-encoder"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<ToolLayout Title="@AppStrings.UrlEncoder_Title" Description="@AppStrings.UrlEncoder_Description">
    <MetaTags Title="@AppStrings.UrlEncoder_Title"
              Description="@AppStrings.UrlEncoder_Description"
              CurrentUrl="@Navigation.Uri"
              ToolPath="url-encoder" />

    <div id="url-encoder-root"
         class="grid grid-cols-1 lg:grid-cols-2 gap-6"
         data-error="@AppStrings.Common_Error"
         data-copied="@AppStrings.UrlEncoder_Copied">

        <!-- Input & Settings Card -->
        <div class="card bg-base-200 shadow-xl h-fit">
            <div class="card-body">
                <h2 class="card-title text-base opacity-70 mb-4">Input & Settings</h2>

                <!-- Text Input -->
                <div class="form-control">
                    <label class="label" for="url-input">
                        <span class="label-text font-semibold">@AppStrings.UrlEncoder_InputLabel</span>
                    </label>
                    <textarea id="url-input" class="textarea textarea-bordered h-48 font-mono text-sm" placeholder="@AppStrings.UrlEncoder_InputPlaceholder"></textarea>
                </div>

                <!-- Advanced Settings -->
                <div class="collapse collapse-arrow bg-base-100 border border-base-300 rounded-box mt-4">
                    <input type="checkbox" checked /> 
                    <div class="collapse-title font-medium text-sm">
                        Settings
                    </div>
                    <div class="collapse-content">
                        <div class="grid grid-cols-1 gap-4 pt-2">
                            <!-- Mode -->
                            <div class="form-control w-full">
                                <label class="label py-1" for="url-mode">
                                    <span class="label-text text-xs">@AppStrings.UrlEncoder_ModeLabel</span>
                                </label>
                                <select id="url-mode" class="select select-bordered select-sm w-full">
                                    <option value="component">@AppStrings.UrlEncoder_Mode_Component</option>
                                    <option value="uri">@AppStrings.UrlEncoder_Mode_Uri</option>
                                    <option value="form">@AppStrings.UrlEncoder_Mode_Form</option>
                                </select>
                            </div>

                            <!-- Charset -->
                            <div class="form-control w-full">
                                <label class="label py-1" for="url-charset">
                                    <span class="label-text text-xs">@AppStrings.UrlEncoder_CharsetLabel</span>
                                </label>
                                <select id="url-charset" class="select select-bordered select-sm w-full">
                                    <option value="utf-8">UTF-8</option>
                                    <option value="utf-16le">UTF-16LE</option>
                                    <option value="utf-16be">UTF-16BE</option>
                                    <option value="ascii">ASCII</option>
                                    <option value="latin1">ISO-8859-1 (Latin-1)</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="card-actions mt-6 grid grid-cols-2 gap-4">
                    <button class="btn btn-primary" id="url-encode-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                        @AppStrings.UrlEncoder_ActionEncode
                    </button>
                    <button class="btn btn-secondary" id="url-decode-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
                        @AppStrings.UrlEncoder_ActionDecode
                    </button>
                </div>
                
                <div class="flex justify-between mt-2">
                     <button class="btn btn-ghost btn-sm text-error" id="url-clear-btn">
                         <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                         @AppStrings.UrlEncoder_ActionClear
                     </button>
                     <button class="btn btn-ghost btn-sm" id="url-swap-btn">
                         <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" /></svg>
                         @AppStrings.UrlEncoder_ActionSwap
                     </button>
                </div>
                
                <div class="alert alert-error shadow-lg mt-4 hidden" id="url-error"></div>
            </div>
        </div>

        <!-- Output Card -->
        <div class="card bg-base-200 shadow-xl h-fit">
            <div class="card-body">
                <h2 class="card-title text-base opacity-70 mb-4">Output</h2>
                
                <div class="form-control h-full">
                    <textarea id="url-output" class="textarea textarea-bordered h-[500px] font-mono text-sm leading-relaxed" readonly></textarea>
                </div>
                
                <div class="card-actions justify-between items-center mt-4">
                    <div class="text-xs opacity-50"></div>
                    <div class="flex gap-2">
                        <button class="btn btn-ghost btn-sm" id="url-copy-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>
                            @AppStrings.UrlEncoder_Copy
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Related Links -->
        <div class="col-span-1 lg:col-span-2 mt-4">
            <div class="flex flex-wrap gap-3 justify-center items-center opacity-70 text-sm">
                <span class="font-bold">@AppStrings.UrlEncoder_OtherFormats</span>
                <a class="link link-hover" href="/@Lang/hex-encoder">@AppStrings.UrlEncoder_LinkHex</a>
                <span class="opacity-30">|</span>
                <a class="link link-hover" href="/@Lang/base32-encoder">@AppStrings.UrlEncoder_LinkBase32</a>
                <span class="opacity-30">|</span>
                <a class="link link-hover" href="/@Lang/base58-encoder">@AppStrings.UrlEncoder_LinkBase58</a>
                <span class="opacity-30">|</span>
                <a class="link link-hover" href="/@Lang/base64-encoder">@AppStrings.UrlEncoder_LinkBase64</a>
            </div>
        </div>

    </div>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
