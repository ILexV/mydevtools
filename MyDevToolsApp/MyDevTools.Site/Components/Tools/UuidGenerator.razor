@page "/{lang}/uuid-generator"
@inject NavigationManager Navigation
@inherits ToolComponentBase

<ToolLayout Title="@T("title")" Description="@T("description")">
    
    <MetaTags 
        Title="@T("title")" 
        Description="@T("description")" 
        CurrentUrl="@Navigation.Uri" 
        ToolPath="uuid-generator" />

    <div id="uuid-generator-root" data-copied="@T("copied")">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            <!-- Settings -->
            <div class="col-span-1 lg:col-span-4 card bg-base-200 shadow-xl h-fit">
                <div class="card-body">
                    <h2 class="card-title text-base opacity-70 mb-4">@T("title")</h2>
                    
                    <div class="form-control w-full">
                        <label class="label">
                            <span class="label-text font-semibold">@T("versionLabel")</span>
                        </label>
                        <select id="uuid-version" class="select select-bordered w-full">
                            <option value="v4" selected>@T("version4")</option>
                            <option value="v7">@T("version7")</option>
                        </select>
                    </div>

                    <div class="form-control w-full">
                        <label class="label">
                            <span class="label-text font-semibold">@T("formatLabel")</span>
                        </label>
                        <select id="uuid-format" class="select select-bordered w-full">
                            <option value="hyphenated" selected>@T("formatHyphenated")</option>
                            <option value="plain">@T("formatPlain")</option>
                            <option value="braces">@T("formatBraces")</option>
                            <option value="urn">@T("formatUrn")</option>
                        </select>
                    </div>

                    <div class="form-control w-full">
                        <label class="label">
                            <span class="label-text font-semibold">@T("caseLabel")</span>
                        </label>
                        <select id="uuid-case" class="select select-bordered w-full">
                            <option value="lower" selected>@T("caseLower")</option>
                            <option value="upper">@T("caseUpper")</option>
                        </select>
                    </div>

                    <div class="form-control w-full mt-2">
                        <label for="uuid-count" class="label">
                            <span class="label-text font-semibold">@T("countLabel")</span>
                            <span id="uuid-count-val" class="badge badge-neutral">1</span>
                        </label>
                        <input type="range" class="range range-primary range-sm" id="uuid-count" min="1" max="100" value="1">
                    </div>

                    <div class="card-actions mt-6">
                        <button id="uuid-generate-btn" class="btn btn-primary w-full">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
                            @T("generate")
                        </button>
                    </div>
                </div>
            </div>

            <!-- Output -->
            <div class="col-span-1 lg:col-span-8 card bg-base-200 shadow-xl h-fit">
                <div class="card-body">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="card-title text-base opacity-70">@T("outputLabel")</h2>
                        <div class="flex gap-2 opacity-0 transition-opacity duration-200" id="uuid-actions">
                            <button class="btn btn-sm btn-ghost" id="uuid-copy-all-btn" title="@T("copyAll")">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>
                            </button>
                            <button class="btn btn-sm btn-ghost" id="uuid-download-btn" title="@T("download")">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                            </button>
                            <button class="btn btn-sm btn-ghost text-error" id="uuid-clear-btn" title="@T("clear")">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                            </button>
                        </div>
                    </div>
                    
                    <div class="rounded-box bg-base-100 border border-base-300 min-h-[300px] overflow-hidden">
                        <div class="p-10 text-center opacity-50" id="uuid-placeholder">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-2 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            @T("outputPlaceholder")
                        </div>
                        
                        <div id="uuid-list-container" class="hidden max-h-[600px] overflow-y-auto">
                            <table class="table w-full">
                                <thead>
                                    <tr class="bg-base-200">
                                        <th class="w-16 text-center">#</th>
                                        <th>UUID</th>
                                        <th class="w-24 text-right">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="uuid-list" class="font-mono text-sm">
                                    <!-- Rows injected here -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        /* Fix for select dropdowns in dark theme */
        #uuid-generator-root select {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
        }
        
        #uuid-generator-root select option {
            background-color: var(--bg-primary);
            color: var(--text-primary);
        }
        
        [data-theme="dark"] #uuid-generator-root select {
            background-color: var(--bg-secondary);
            color: var(--text-primary);
        }
        
        [data-theme="dark"] #uuid-generator-root select option {
            background-color: var(--bg-secondary);
            color: var(--text-primary);
        }
        
        .uuid-list {
            font-family: var(--bs-font-monospace);
            max-height: 600px;
            overflow-y: auto;
        }
        .uuid-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--bs-border-color);
            transition: background-color 0.2s;
        }
        .uuid-item:last-child {
            border-bottom: none;
        }
        .uuid-item:hover {
            background-color: var(--bs-secondary-bg);
        }
        .uuid-value {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            margin-right: 10px;
            user-select: all;
            cursor: text;
        }
        .uuid-copy-btn {
            background: none;
            border: 1px solid var(--bs-border-color);
            border-radius: 4px;
            padding: 0.25rem 0.5rem;
            cursor: pointer;
            opacity: 0.7;
            transition: opacity 0.2s, border-color 0.2s;
            font-size: 0.875rem;
        }
        .uuid-copy-btn:hover {
            opacity: 1;
            border-color: var(--bs-primary);
        }
        .uuid-copy-btn.copied {
            color: green;
            border-color: green;
        }
        #uuid-output-container {
            min-height: 300px;
        }
    </style>

    <script>
        (function() {
            'use strict';

            // UUID v4 generator using Web Crypto API
            function generateUUIDv4() {
                const bytes = new Uint8Array(16);
                crypto.getRandomValues(bytes);
                
                // Set version (4) and variant bits
                bytes[6] = (bytes[6] & 0x0f) | 0x40;
                bytes[8] = (bytes[8] & 0x3f) | 0x80;
                
                const hex = Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('');
                return hex;
            }

            // UUID v7 generator (timestamp-based)
            function generateUUIDv7() {
                const timestamp = Date.now();
                const bytes = new Uint8Array(16);
                
                // Timestamp (48 bits = 6 bytes)
                bytes[0] = (timestamp >> 40) & 0xff;
                bytes[1] = (timestamp >> 32) & 0xff;
                bytes[2] = (timestamp >> 24) & 0xff;
                bytes[3] = (timestamp >> 16) & 0xff;
                bytes[4] = (timestamp >> 8) & 0xff;
                bytes[5] = timestamp & 0xff;
                
                // Random bytes for the rest
                const randomBytes = new Uint8Array(10);
                crypto.getRandomValues(randomBytes);
                bytes.set(randomBytes, 6);
                
                // Set version (7) and variant bits
                bytes[6] = (bytes[6] & 0x0f) | 0x70;
                bytes[8] = (bytes[8] & 0x3f) | 0x80;
                
                const hex = Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('');
                return hex;
            }

            // Format UUID according to user preferences
            function formatUUID(hex, format, caseType) {
                let formatted;
                const hyphenated = `${hex.slice(0,8)}-${hex.slice(8,12)}-${hex.slice(12,16)}-${hex.slice(16,20)}-${hex.slice(20)}`;
                
                switch(format) {
                    case 'plain':
                        formatted = hex;
                        break;
                    case 'braces':
                        formatted = `{${hyphenated}}`;
                        break;
                    case 'urn':
                        formatted = `urn:uuid:${hyphenated}`;
                        break;
                    case 'hyphenated':
                    default:
                        formatted = hyphenated;
                        break;
                }
                
                return caseType === 'upper' ? formatted.toUpperCase() : formatted.toLowerCase();
            }

            // Copy to clipboard
            async function copyToClipboard(text, button) {
                try {
                    await navigator.clipboard.writeText(text);
                    const originalText = button.textContent;
                    const copiedText = document.getElementById('uuid-generator-root').dataset.copied;
                    button.textContent = copiedText;
                    button.classList.add('copied');
                    setTimeout(() => {
                        button.textContent = originalText;
                        button.classList.remove('copied');
                    }, 2000);
                } catch (err) {
                    console.error('Failed to copy:', err);
                }
            }

            // Download UUIDs as text file
            function downloadUUIDs(uuids) {
                const blob = new Blob([uuids.join('\n')], { type: 'text/plain' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `uuids-${new Date().toISOString().slice(0,10)}.txt`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            }

            // Render UUID list
            function renderUUIDs(uuids) {
                const placeholder = document.getElementById('uuid-placeholder');
                const listContainer = document.getElementById('uuid-list-container');
                const list = document.getElementById('uuid-list');
                const actions = document.getElementById('uuid-actions');
                
                if (uuids.length === 0) {
                    placeholder.style.display = 'block';
                    if(listContainer) listContainer.classList.add('hidden');
                    if(actions) {
                        actions.classList.remove('opacity-100');
                        actions.classList.add('opacity-0');
                    }
                    return;
                }
                
                placeholder.style.display = 'none';
                if(listContainer) listContainer.classList.remove('hidden');
                if(actions) {
                    actions.classList.remove('opacity-0');
                    actions.classList.add('opacity-100');
                }
                
                list.innerHTML = uuids.map((uuid, index) => `
                    <tr class="hover">
                        <td class="text-center opacity-50 select-none">${index + 1}</td>
                        <td class="select-all font-mono">${uuid}</td>
                        <td class="text-right">
                            <button class="btn btn-xs btn-ghost uuid-copy-btn" data-uuid="${uuid}">
                                Copy
                            </button>
                        </td>
                    </tr>
                `).join('');
                
                // Attach copy handlers
                list.querySelectorAll('.uuid-copy-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        copyToClipboard(btn.dataset.uuid, btn);
                    });
                });
            }

            // Initialize
            function init() {
                const root = document.getElementById('uuid-generator-root');
                if (!root) return;

                let generatedUUIDs = [];
                
                const versionSelect = document.getElementById('uuid-version');
                const formatSelect = document.getElementById('uuid-format');
                const caseSelect = document.getElementById('uuid-case');
                const countInput = document.getElementById('uuid-count');
                const countValue = document.getElementById('uuid-count-val');
                const generateBtn = document.getElementById('uuid-generate-btn');
                const copyAllBtn = document.getElementById('uuid-copy-all-btn');
                const downloadBtn = document.getElementById('uuid-download-btn');
                const clearBtn = document.getElementById('uuid-clear-btn');
                
                // Update count display
                countInput.addEventListener('input', () => {
                    countValue.textContent = countInput.value;
                });
                
                // Generate UUIDs
                generateBtn.addEventListener('click', () => {
                    const version = versionSelect.value;
                    const format = formatSelect.value;
                    const caseType = caseSelect.value;
                    const count = parseInt(countInput.value);
                    
                    const newUUIDs = [];
                    for (let i = 0; i < count; i++) {
                        const hex = version === 'v7' ? generateUUIDv7() : generateUUIDv4();
                        const formatted = formatUUID(hex, format, caseType);
                        newUUIDs.push(formatted);
                    }
                    
                    generatedUUIDs = newUUIDs;
                    renderUUIDs(generatedUUIDs);
                });
                
                // Copy all
                copyAllBtn.addEventListener('click', () => {
                    copyToClipboard(generatedUUIDs.join('\n'), copyAllBtn);
                });
                
                // Download
                downloadBtn.addEventListener('click', () => {
                    downloadUUIDs(generatedUUIDs);
                });
                
                // Clear
                clearBtn.addEventListener('click', () => {
                    generatedUUIDs = [];
                    renderUUIDs(generatedUUIDs);
                });
            }

            // Handle Blazor enhanced navigation
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
            
            document.addEventListener('DOMContentLoaded', init);
            window.addEventListener('pageshow', init);
        })();
    </script>

    <ToolSeoContent 
        Introduction="@T("seoIntroduction")"
        DetailedDescription="@T("seoDetailedDescription")"
        DetailedDescriptionTitle="@TCommon("Seo_DetailedDescriptionTitle")"
        Examples="@T("seoExamples")"
        ExamplesTitle="@TCommon("Seo_ExamplesTitle")"
        HowToSteps="@T("seoHowToSteps")"
        HowToTitle="@TCommon("Seo_HowToTitle")"
        Tips="@T("seoTips")"
        TipsTitle="@TCommon("Seo_TipsTitle")" />
</ToolLayout>

@code {
    protected override string LocalizationNamespace { get; set; } = "tools/uuid-generator";
}
