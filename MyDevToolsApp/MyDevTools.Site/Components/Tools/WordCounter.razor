@page "/{lang}/word-counter"
@inject NavigationManager Navigation
@inherits ToolComponentBase

<ToolLayout Title="@T("Title")" Description="@T("Description")">
    <MetaTags Title="@T("Title")" 
              Description="@T("Description")" 
              CurrentUrl="@Navigation.Uri"
              ToolPath="word-counter"
              Keywords="@T("Keywords")"
              Category="Text"
              HowToSteps="@T("Seo_HowToSteps")" />

    <div id="word-counter-root"
         data-copied="@T("Copied")"
         data-input-placeholder="@T("InputPlaceholder")"
         data-reading-time-label="@T("ReadingTime")"
         data-speaking-time-label="@T("SpeakingTime")"
         class="max-w-5xl mx-auto">
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- Left Column: Text Input -->
            <div class="lg:col-span-2">
                <div class="card bg-base-100 shadow-xl">
                    <div class="card-body p-4 sm:p-6">
                        
                        <!-- Toolbar -->
                        <div class="flex flex-wrap justify-between items-center gap-2 mb-4">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-semibold opacity-70">@TCommon("Common_Input")</span>
                            </div>
                            <div class="join">
                                <button type="button" class="btn btn-sm btn-ghost join-item text-error" id="wc-clear-btn" title="@T("ClearButton")">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                    </svg>
                                    @T("ClearButton")
                                </button>
                                <button type="button" class="btn btn-sm btn-ghost join-item" id="wc-copy-btn" title="@T("CopyButton")">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                                    </svg>
                                    @T("CopyButton")
                                </button>
                                <button type="button" class="btn btn-sm btn-ghost join-item" id="wc-paste-btn" title="@T("PasteButton")">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                                    </svg>
                                    @T("PasteButton")
                                </button>
                            </div>
                        </div>

                        <!-- Text Area -->
                        <textarea id="wc-input-text" 
                                  rows="12" 
                                  placeholder="@T("InputPlaceholder")" 
                                  class="textarea textarea-bordered w-full font-mono text-base leading-relaxed bg-base-200 focus:bg-base-100 transition-colors duration-200"></textarea>

                    </div>
                </div>
            </div>

            <!-- Right Column: Statistics -->
            <div class="lg:col-span-1">
                <div class="card bg-base-100 shadow-xl">
                    <div class="card-body p-4 sm:p-6">
                        <h3 class="text-lg font-bold mb-4">@T("Statistics")</h3>
                        
                        <div class="stats stats-vertical w-full bg-base-200">
                            <div class="stat">
                                <div class="stat-title">@T("Words")</div>
                                <div class="stat-value text-3xl text-primary" id="wc-stat-words">0</div>
                                <div class="stat-desc">@T("WordsDesc")</div>
                            </div>
                            
                            <div class="stat">
                                <div class="stat-title">@T("CharactersWithSpaces")</div>
                                <div class="stat-value text-2xl" id="wc-stat-chars-with">0</div>
                            </div>
                            
                            <div class="stat">
                                <div class="stat-title">@T("CharactersWithoutSpaces")</div>
                                <div class="stat-value text-2xl" id="wc-stat-chars-without">0</div>
                            </div>
                            
                            <div class="stat">
                                <div class="stat-title">@T("Lines")</div>
                                <div class="stat-value text-xl" id="wc-stat-lines">0</div>
                            </div>
                            
                            <div class="stat">
                                <div class="stat-title">@T("Paragraphs")</div>
                                <div class="stat-value text-xl" id="wc-stat-paragraphs">0</div>
                            </div>
                            
                            <div class="stat">
                                <div class="stat-title">@T("Sentences")</div>
                                <div class="stat-value text-xl" id="wc-stat-sentences">0</div>
                            </div>
                        </div>

                        <div class="divider my-4">@T("EstimatedTime")</div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div class="bg-base-200 rounded-lg p-3 text-center">
                                <div class="text-sm opacity-70 mb-1">@T("ReadingTime")</div>
                                <div class="font-bold text-lg" id="wc-reading-time">0 @T("Minutes")</div>
                            </div>
                            <div class="bg-base-200 rounded-lg p-3 text-center">
                                <div class="text-sm opacity-70 mb-1">@T("SpeakingTime")</div>
                                <div class="font-bold text-lg" id="wc-speaking-time">0 @T("Minutes")</div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
    
    <script src="/tools/word-counter.js"></script>

    <ToolSeoContent 
        Introduction="@T("Seo_Introduction")"
        DetailedDescription="@T("Seo_DetailedDescription")"
        DetailedDescriptionTitle="@TCommon("Seo_DetailedDescriptionTitle")"
        Examples="@T("Seo_Examples")"
        ExamplesTitle="@TCommon("Seo_ExamplesTitle")"
        HowToSteps="@T("Seo_HowToSteps")"
        HowToTitle="@TCommon("Seo_HowToTitle")"
        Tips="@T("Seo_Tips")"
        TipsTitle="@TCommon("Seo_TipsTitle")" />
</ToolLayout>

@code {
    protected override string LocalizationNamespace { get; set; } = "tools/word-counter";
}
