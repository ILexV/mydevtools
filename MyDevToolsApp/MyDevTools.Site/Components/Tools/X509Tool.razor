@page "/{lang}/x509"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation
@inherits ToolComponentBase

<ToolLayout Title="@T("Title")" Description="@T("Description")">
    <MetaTags Title="@T("Title")"
              Description="@T("Description")"
              CurrentUrl="@Navigation.Uri"
              ToolPath="x509" />

    <div id="x509-root"
         data-loading="@AppStrings.Common_Loading"
         data-error="@AppStrings.Common_Error"
         data-copy="@T("Copy")"
         data-copied="@T("Copied")"
         data-download="@T("Download")"
         data-warnings-title="@T("WarningsTitle")"
         class="max-w-5xl mx-auto space-y-8">

        <!-- Generator Section -->
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body p-4 sm:p-6">
                <h2 class="card-title text-primary flex items-center gap-2 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                    </svg>
                        @T("SelfSignedSectionTitle")
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-control w-full">
                        <label class="label font-semibold" for="x509-subject">@T("SubjectLabel")</label>
                        <input id="x509-subject" type="text" placeholder="CN=example.com,O=My Org,C=US" class="input input-bordered w-full font-mono text-sm" />
                        <label class="label">
                            <span class="label-text-alt opacity-70">Format: CN=Name,O=Org,C=Country</span>
                        </label>
                    </div>
                    <div class="form-control w-full">
                        <label class="label font-semibold" for="x509-validity">@T("ValidityDaysLabel")</label>
                        <input id="x509-validity" type="number" min="1" value="365" class="input input-bordered w-full" />
                    </div>
                </div>

                <div class="flex flex-wrap gap-2 mt-4 justify-end">
                    <button class="btn btn-secondary" id="x509-generate-csr" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-1">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                        </svg>
                        @T("GenerateCsr")
                    </button>
                    <button class="btn btn-primary" id="x509-generate-selfsigned" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-1">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
                        </svg>
                        @T("GenerateSelfSigned")
                    </button>
                </div>
            </div>
        </div>

        <!-- Parse Section -->
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body p-4 sm:p-6">
                <h2 class="card-title text-secondary flex items-center gap-2 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                    </svg>
                        @T("ParseSectionTitle")
                </h2>

                <div class="form-control w-full">
                                            <label class="label font-semibold" for="x509-parse-input">@T("ParseLabel")</label>
                    <textarea id="x509-parse-input" rows="6" placeholder="@T("ParsePlaceholder")" class="textarea textarea-bordered w-full font-mono text-sm leading-relaxed"></textarea>
                </div>

                <div class="card-actions justify-end mt-4">
                    <button class="btn btn-secondary" id="x509-parse-btn" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-1">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                        </svg>
                        @T("ParseButton")
                    </button>
                </div>
            </div>
        </div>

        <!-- Output Section -->
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body p-4 sm:p-6">
                <h2 class="card-title text-base flex items-center gap-2 mb-4">
                    @T("OutputLabel")
                </h2>
                
                <div class="form-control w-full">
                    <textarea id="x509-output" rows="12" readonly class="textarea textarea-bordered w-full font-mono text-sm leading-relaxed bg-base-200 text-base-content/70"></textarea>
                </div>

                <div class="card-actions justify-end mt-4 gap-2">
                    <button class="btn btn-ghost btn-sm" id="x509-copy" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                        </svg>
                        @T("Copy")
                    </button>
                    <button class="btn btn-ghost btn-sm" id="x509-download" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                        </svg>
                        @T("Download")
                    </button>
                </div>

                <div class="alert alert-error shadow-lg hidden mt-4" id="x509-warnings">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span id="x509-warnings-text"></span>
                </div>
            </div>
        </div>
    </div>
    
    <script src="/tools/x509-tool.js"></script>

    <ToolSeoContent 
        Introduction="@T("Seo_Introduction")"
        DetailedDescription="@T("Seo_DetailedDescription")"
        DetailedDescriptionTitle="@AppStrings.Seo_DetailedDescriptionTitle"
        Examples="@T("Seo_Examples")"
        ExamplesTitle="@AppStrings.Seo_ExamplesTitle"
        HowToSteps="@T("Seo_HowToSteps")"
        HowToTitle="@AppStrings.Seo_HowToTitle"
        Tips="@T("Seo_Tips")"
        TipsTitle="@AppStrings.Seo_TipsTitle" />
</ToolLayout>

@code {
    protected override string LocalizationNamespace { get; set; } = "tools/x509";
}