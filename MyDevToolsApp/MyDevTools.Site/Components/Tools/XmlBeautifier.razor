@page "/{lang}/xml-beautifier"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.XmlBeautifier_Title" 
          Description="@AppStrings.XmlBeautifier_Description" 
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="xml-beautifier" />

<JsonLdTool ToolName="@AppStrings.XmlBeautifier_Title" 
            Description="@AppStrings.XmlBeautifier_Description" 
            CurrentUrl="@Navigation.Uri" />

<ToolLayout Title="@AppStrings.XmlBeautifier_Title" Description="@AppStrings.XmlBeautifier_Description">
    <div id="xml-beautifier-root"
         data-error-invalid-xml="@AppStrings.XmlBeautifier_ErrorInvalidXml"
         data-copied="@AppStrings.XmlBeautifier_Copied"
         data-copy-button="@AppStrings.XmlBeautifier_CopyButton"
         data-input-placeholder="@AppStrings.XmlBeautifier_InputPlaceholder">
        
        <div class="editor-container">
            <div class="settings-bar">
                <div class="settings-group">
                    <div class="file-buttons">
                        <button class="btn btn-secondary btn-sm" id="xml-open-file-btn" type="button" title="Open XML file">
                            📁
                        </button>
                        <button class="btn btn-secondary btn-sm" id="xml-save-file-btn" type="button" title="Save XML file">
                            💾
                        </button>
                    </div>
                    <div class="form-control">
                        <label class="label" for="xml-indent-select"><span class="label-text">@AppStrings.XmlBeautifier_IndentSizeLabel</span></label>
                        <select id="xml-indent-select" class="select select-bordered select-sm">
                            <option value="2">@AppStrings.XmlBeautifier_Indent2Spaces</option>
                            <option value="4" selected>@AppStrings.XmlBeautifier_Indent4Spaces</option>
                            <option value="tab">@AppStrings.XmlBeautifier_IndentTab</option>
                        </select>
                    </div>
                    <div class="form-control">
                        <label class="label cursor-pointer gap-2">
                            <input type="checkbox" id="xml-compact-mode" class="checkbox checkbox-sm" />
                            <span class="label-text">@AppStrings.XmlBeautifier_CompactMode</span>
                        </label>
                    </div>
                </div>

                <div class="flex flex-wrap gap-2">
                    <button class="btn btn-primary btn-sm" id="xml-format-btn" type="button" title="@AppStrings.XmlBeautifier_FormatButton">
                        ⚙️
                    </button>
                    <button class="btn btn-secondary btn-sm" id="xml-copy-btn" type="button" title="@AppStrings.XmlBeautifier_CopyButton">
                        📋
                    </button>
                    <button class="btn btn-secondary btn-sm" id="xml-clear-btn" type="button" title="@AppStrings.XmlBeautifier_ClearButton">
                        🗑️
                    </button>
                </div>
            </div>

            <div id="xml-editor"></div>
            <input type="file" id="xml-file-input" accept=".xml" style="display: none;" />
        </div>
    </div>
</ToolLayout>

@code {
    [Parameter]
    public string Lang { get; set; } = "en";
}
