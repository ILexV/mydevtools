@page "/{lang}/yaml-beautifier-validator"
@using MyDevTools.Site.Resources
@inject NavigationManager Navigation

<MetaTags Title="@AppStrings.YamlBeautifierValidator_Title"
          Description="@AppStrings.YamlBeautifierValidator_Description"
          CurrentUrl="@Navigation.Uri" />

<HreflangLinks ToolPath="yaml-beautifier-validator" />

<JsonLdTool ToolName="@AppStrings.YamlBeautifierValidator_Title"
            Description="@AppStrings.YamlBeautifierValidator_Description"
            CurrentUrl="@Navigation.Uri" />

<link href="/tools/yaml-beautifier.css" rel="stylesheet" />

<ToolLayout Title="@AppStrings.YamlBeautifierValidator_Title" Description="@AppStrings.YamlBeautifierValidator_Description">
    <div id="yaml-beautifier-validator-root"
         data-loading="@AppStrings.Common_Loading"
         data-error="@AppStrings.Common_Error"
         data-format="@AppStrings.YamlBeautifierValidator_Format"
         data-validate="@AppStrings.YamlBeautifierValidator_Validate"
         data-valid="@AppStrings.YamlBeautifierValidator_Valid"
         data-invalid="@AppStrings.YamlBeautifierValidator_Invalid">

        <!-- Toolbar -->
        <div class="card bg-base-200 shadow-sm mb-6">
            <div class="card-body p-4">
                <div class="flex flex-wrap gap-2 items-center justify-between">
                    <div class="join">
                        <button class="btn btn-primary join-item" id="format-yaml-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                            </svg>
                            @AppStrings.YamlBeautifierValidator_Format
                        </button>
                        <button class="btn btn-secondary join-item" id="validate-yaml-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            @AppStrings.YamlBeautifierValidator_Validate
                        </button>
                    </div>

                    <button class="btn btn-ghost text-error" id="clear-yaml-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                        </svg>
                        @AppStrings.YamlBeautifierValidator_Clear
                    </button>
                </div>
            </div>
        </div>

        <!-- Editor Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            
            <!-- Input Column -->
            <div class="flex flex-col gap-2">
                <div class="flex justify-between items-center px-1">
                    <h3 class="font-semibold text-lg">@AppStrings.YamlBeautifierValidator_InputLabel</h3>
                    <button class="btn btn-xs btn-ghost" id="paste-yaml-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5" />
                        </svg>
                        Paste
                    </button>
                </div>
                <div id="yaml-input" class="code-mirror-editor h-[600px] shadow-sm"></div>
            </div>

            <!-- Output Column -->
            <div class="flex flex-col gap-2">
                <div class="flex justify-between items-center px-1">
                    <h3 class="font-semibold text-lg">@AppStrings.YamlBeautifierValidator_OutputLabel</h3>
                    <button class="btn btn-xs btn-ghost" id="copy-yaml-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                        </svg>
                        @AppStrings.Base64Encoder_Copy
                    </button>
                </div>
                <div id="yaml-output" class="code-mirror-editor h-[600px] shadow-sm"></div>
            </div>
        </div>

        <div class="alert alert-error mt-4 shadow-lg hidden" id="yaml-error">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span class="error-text"></span>
        </div>
    </div>

    <script src="/tools/yaml-beautifier-validator.js"></script>
</ToolLayout>

@code {
    /// <summary>
    /// Language parameter from URL route
    /// </summary>
    [Parameter]
    public string Lang { get; set; } = "en";
}
