{
  "name": "@mydevtools/site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "New static Astro frontend for MyDevTools (GitHub Pages).",
  "browserslist": [
    "defaults",
    "supports es6-module",
    "supports wasm"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node build-sw.mjs",
    "build:pages": "astro build && node build-sw.mjs",
    "check": "astro check",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:smoke": "node --test scripts/smoke-dist.mjs",
    "verify": "astro check && npm run validate:i18n && node --test && npm run build && node --test scripts/smoke-dist.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.9.2"
  }
}
