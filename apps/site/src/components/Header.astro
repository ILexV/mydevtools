---
/**
 * Header — Prism site chrome (design spec §1/§9).
 * Brand badge + search pill (opens palette) + theme toggle + lang switcher.
 * Mobile: hamburger opens the MobileNav drawer (catalog/favorites/recent/lang).
 * `path` is the in-locale path so the language switcher preserves location.
 */
import { LOCALES, type LocaleCode } from "@/registry/locales";
import { localizedPath } from "@/lib/url";
import { t } from "@/i18n/messages";
import Icon from "@/components/Icon.astro";

interface Props {
  locale: LocaleCode;
  path?: string;
}

const { locale, path = "" } = Astro.props as Props;
const brand = t(locale, "common", "AppName");
const searchLabel = t(locale, "common", "Common_Search");
const searchPlaceholder = t(locale, "common", "CommandPalette_SearchPlaceholder");
const homeLabel = t(locale, "common", "Nav_Home");
const toolsLabel = t(locale, "common", "Nav_Tools");
const languageLabel = t(locale, "common", "Language");
const favTitle = t(locale, "common", "CommandPalette_FavoritesTitle");
const recentTitle = t(locale, "common", "CommandPalette_RecentTitle");
---

<header class="site-header">
  <div class="header-inner">
    <button type="button" class="icon-btn nav-toggle" data-nav-toggle aria-label="Menu">
      <Icon name="menu" size={16} />
    </button>

    <a class="brand" href={localizedPath(locale)}>
      <span class="logo-badge"><Icon name="logo-mark" size={16} /></span>
      <span class="brand-name">{brand}</span>
    </a>

    <button
      type="button"
      class="search-pill"
      data-search-open
      aria-label={`${searchLabel} (Ctrl+K)`}
    >
      <Icon name="search" size={14} />
      <span class="search-text">{searchPlaceholder}</span>
      <kbd>Ctrl K</kbd>
    </button>

    <div class="header-actions">
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle theme" title="Theme">
        <span class="icon-sun"><Icon name="sun" size={16} /></span>
        <span class="icon-moon"><Icon name="moon" size={16} /></span>
      </button>

      <details class="lang-switcher">
        <summary class="icon-btn lang-btn" aria-label={languageLabel} title={languageLabel}>
          <Icon name="globe" size={16} />
          <span class="lang-code">{locale.toUpperCase()}</span>
        </summary>
        <div class="lang-list" role="menu">
          {LOCALES.map((l) => (
            <a
              role="menuitem"
              hreflang={l.bcp47}
              href={localizedPath(l.code, path)}
              aria-current={l.code === locale ? "true" : undefined}
            >{l.nativeName}</a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>

<!-- MobileNav drawer (mobile composition, spec §9) -->
<div class="nav-scrim" data-nav-close hidden></div>
<nav class="mobile-nav" data-mobile-nav aria-label="Mobile navigation" hidden>
  <div class="mnav-head">
    <span class="brand"><span class="logo-badge"><Icon name="logo-mark" size={14} /></span>{brand}</span>
    <button type="button" class="icon-btn" data-nav-close aria-label="Close"><Icon name="close" size={15} /></button>
  </div>
  <span class="lbl">{toolsLabel}</span>
  <a class="mnav-link" href={localizedPath(locale)} data-nav-close>{homeLabel}</a>
  <a class="mnav-link" href={`${localizedPath(locale)}#catalog`} data-nav-close>{toolsLabel}</a>
  <span class="lbl mnav-gap">{favTitle} / {recentTitle}</span>
  <div class="mnav-favs" data-mnav-favs><span class="mnav-empty">—</span></div>
  <span class="lbl mnav-gap">{languageLabel}</span>
  <div class="mnav-langs">
    {LOCALES.map((l) => (
      <a hreflang={l.bcp47} href={localizedPath(l.code, path)} aria-current={l.code === locale ? "true" : undefined}>{l.code.toUpperCase()}</a>
    ))}
  </div>
</nav>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--mdt-surface) 72%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--mdt-border-soft);
  }
  .header-inner {
    max-width: var(--mdt-content-max);
    margin: 0 auto;
    padding: 0.7rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--mdt-text);
    text-decoration: none;
  }
  .logo-badge {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    color: #fff;
    background: linear-gradient(135deg, var(--mdt-accent), var(--mdt-accent-2));
    box-shadow: 0 4px 14px color-mix(in srgb, var(--mdt-accent) 40%, transparent);
    flex-shrink: 0;
  }
  .search-pill {
    flex: 1;
    max-width: 400px;
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--mdt-surface-raised);
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-sm);
    padding: 8px 12px;
    color: var(--mdt-text-faint);
    font-size: var(--mdt-fs-meta);
    cursor: text;
    transition: border-color var(--mdt-dur-micro), box-shadow var(--mdt-dur-micro);
  }
  .search-pill:hover {
    border-color: color-mix(in srgb, var(--mdt-accent) 55%, var(--mdt-border));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--mdt-accent) 14%, transparent);
  }
  .search-pill .search-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-pill kbd {
    margin-left: auto;
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-micro);
    border: 1px solid var(--mdt-border);
    border-radius: 5px;
    padding: 1.5px 6px;
    color: var(--mdt-text-muted);
    flex-shrink: 0;
  }
  .header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .icon-sun,
  .icon-moon {
    display: grid;
    place-items: center;
  }
  :global([data-theme="dark"]) .icon-sun { display: none; }
  :global([data-theme="light"]) .icon-moon { display: none; }
  :global(:root:not([data-theme])) .icon-moon { display: none; }

  .lang-switcher { position: relative; }
  .lang-btn {
    width: auto;
    padding: 0 9px;
    gap: 5px;
    display: inline-flex;
    list-style: none;
  }
  .lang-btn::-webkit-details-marker { display: none; }
  .lang-code {
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-micro);
    font-weight: 500;
  }
  .lang-list {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    min-width: 9.5rem;
    background: var(--mdt-surface-raised);
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-md);
    padding: 0.3rem;
    box-shadow: var(--mdt-shadow-e2);
    display: grid;
    gap: 0.1rem;
    z-index: 60;
  }
  .lang-list a {
    padding: 0.45rem 0.6rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--mdt-text);
    font-size: 0.875rem;
  }
  .lang-list a:hover { background: var(--mdt-surface-inset); }
  .lang-list a[aria-current="true"] { color: var(--mdt-accent); font-weight: 600; }

  .nav-toggle { display: none; }

  /* ---------- MobileNav drawer ---------- */
  .nav-scrim {
    position: fixed;
    inset: 0;
    background: rgba(4, 6, 10, 0.55);
    backdrop-filter: blur(3px);
    z-index: 80;
    opacity: 0;
    transition: opacity var(--mdt-dur) var(--mdt-ease);
  }
  .nav-scrim.open { opacity: 1; }
  .mobile-nav {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(84vw, 330px);
    background: var(--mdt-surface-muted);
    border-right: 1px solid var(--mdt-border);
    z-index: 85;
    padding: 1.1rem 1.1rem 1.75rem;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    transform: translateX(-103%);
    transition: transform 380ms var(--mdt-ease);
  }
  .mobile-nav.open { transform: none; }
  /* [hidden] must beat display:flex when the drawer is closed */
  .mobile-nav[hidden],
  .nav-scrim[hidden] { display: none; }
  .mnav-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.2rem;
  }
  .mnav-head .brand { font-size: 0.95rem; }
  .mnav-head .logo-badge { width: 26px; height: 26px; border-radius: 8px; }
  .mobile-nav .lbl { display: block; margin-bottom: 0.5rem; }
  .mnav-gap { margin-top: 1.1rem; }
  .mnav-link {
    display: flex;
    align-items: center;
    padding: 0.55rem 0.65rem;
    border-radius: var(--mdt-radius-sm);
    color: var(--mdt-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: all var(--mdt-dur-micro);
  }
  .mnav-link:hover {
    color: var(--mdt-text);
    background: color-mix(in srgb, var(--mdt-accent) 10%, transparent);
  }
  .mnav-empty { color: var(--mdt-text-faint); font-size: 0.85rem; padding: 0.2rem 0.65rem; }
  .mnav-langs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .mnav-langs a {
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-micro);
    color: var(--mdt-text-muted);
    text-decoration: none;
    border: 1px solid var(--mdt-border);
    border-radius: 7px;
    padding: 5px 9px;
  }
  .mnav-langs a[aria-current="true"] {
    color: var(--mdt-accent);
    border-color: color-mix(in srgb, var(--mdt-accent) 45%, var(--mdt-border));
    background: color-mix(in srgb, var(--mdt-accent) 8%, transparent);
  }

  @media (max-width: 700px) {
    .search-pill { display: none; }
    .nav-toggle { display: inline-grid; }
    .header-inner { padding: 0.6rem 1rem; }
  }
  /* Mid-size: pill stays, code suffix hides to save room */
  @media (max-width: 900px) {
    .lang-code { display: none; }
    .lang-btn { width: 34px; padding: 0; }
  }
</style>
