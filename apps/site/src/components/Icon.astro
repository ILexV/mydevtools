---
/**
 * Icon — the Prism icon family (design spec §7): 20×20 viewBox, stroke 1.7,
 * round caps/joins, no fill, currentColor. One consistent optical size.
 * Usage: <Icon name="encoding" size={18} />
 * Category names match CategoryId in src/registry/categories.ts.
 */

export interface Props {
  name: IconName;
  size?: number;
}

export const ICONS = {
