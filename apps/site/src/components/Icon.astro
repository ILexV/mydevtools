  "structured-data": '<path d="M6.5 3.5c-1.7 0-2 1-2 2.2v1.6c0 1-.5 1.7-1.5 1.7 1 0 1.5.7 1.5 1.7v1.6c0 1.2.3 2.2 2 2.2M13.5 3.5c1.7 0 2 1 2 2.2v1.6c0 1 .5 1.7 1.5 1.7-1 0-1.5.7-1.5 1.7v1.6c0 1.2-.3 2.2-2 2.2"/>',
