export type IconName = keyof typeof ICONS;

const { name, size = 20 } = Astro.props as Props;
const body = ICONS[name];
---

<svg
  viewBox="0 0 20 20"
  width={size}
  height={size}
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={body}
/>
