---
/**
 * CommandPalette — global tool launcher rendered on every BaseLayout page
 * (Stage 8). Markup + localized strings + a compact JSON island with the
 * per-locale tool index; behavior lives in `scripts/palette.ts`.
 *
 * Data-island entry: slug → { t: title, h: href, c: category label, k: keywords }
 */
import type { LocaleCode } from "@/registry/locales";
import { buildCatalog, categoryLabel } from "@/registry/catalog";
import { t } from "@/i18n/messages";

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props as Props;
const catalog = buildCatalog(locale);
const index = Object.fromEntries(
  catalog.tools.map((tool) => [
    tool.slug,
    { t: tool.title, h: tool.href, c: categoryLabel(locale, tool.category), k: tool.keywords.join(" ") },
  ]),
);
const indexJson = JSON.stringify(index);

const searchLabel = t(locale, "common", "Common_Search");
const placeholder = t(locale, "common", "CommandPalette_SearchPlaceholder");
---

<div
  class="palette"
  data-palette
  hidden
  data-label-noresults={t(locale, "common", "CommandPalette_NoResults")}
  data-label-hint={t(locale, "common", "CommandPalette_TypeToSearch")}
  data-label-favorites={t(locale, "common", "CommandPalette_FavoritesTitle")}
  data-label-recent={t(locale, "common", "CommandPalette_RecentTitle")}
>
  <div class="palette-backdrop" data-palette-close></div>
  <div class="palette-panel" role="dialog" aria-modal="true" aria-label={searchLabel}>
    <input
      class="palette-input"
      data-palette-input
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-results"
      placeholder={placeholder}
      aria-label={searchLabel}
      autocomplete="off"
      spellcheck="false"
    />
    <div class="palette-results" id="palette-results" data-palette-results role="listbox" aria-label={searchLabel}></div>
    <div class="palette-foot" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd></span>
      <span><kbd>Enter</kbd> ↵</span>
      <span><kbd>Esc</kbd> ✕</span>
      <span><kbd>Ctrl</kbd>+<kbd>K</kbd></span>
    </div>
  </div>
</div>
<script is:inline type="application/json" data-palette-json set:html={indexJson} />

<style is:global>
  .palette {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 12vh 1rem 1rem;
  }
  .palette[hidden] { display: none; }
  .palette-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 6, 10, 0.55);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  .palette-panel {
    position: relative;
    width: 100%;
    max-width: 34rem;
    background: var(--mdt-surface-raised);
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius);
    box-shadow: var(--mdt-shadow-e2);
    overflow: hidden;
  }
  .palette-input {
    width: 100%;
    padding: 0.9rem 1rem;
    font: inherit;
    color: var(--mdt-text);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--mdt-border);
    outline: none;
  }
  .palette-results {
    max-height: 20rem;
    overflow-y: auto;
    padding: 0.35rem;
  }
  .palette-group {
    padding: 0.45rem 0.65rem 0.25rem;
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-micro);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mdt-text-faint);
  }
  .palette-option {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.65rem;
    border-radius: var(--mdt-radius-sm);
    cursor: pointer;
    color: var(--mdt-text);
  }
  .palette-option[data-active="true"] {
    background: var(--mdt-accent);
    color: var(--mdt-accent-contrast);
  }
  .palette-option[data-active="true"] .palette-opt-cat { color: inherit; opacity: 0.8; }
  .palette-opt-title { font-size: 0.92rem; }
  .palette-opt-cat {
    font-size: 0.75rem;
    color: var(--mdt-text-muted);
    flex-shrink: 0;
  }
  .palette-empty {
    padding: 1.25rem 0.65rem;
    text-align: center;
    color: var(--mdt-text-muted);
    font-size: 0.9rem;
  }
  .palette-foot {
    display: flex;
    gap: 1rem;
    padding: 0.5rem 0.85rem;
    border-top: 1px solid var(--mdt-border);
    color: var(--mdt-text-muted);
    font-size: 0.72rem;
  }
  .palette-foot kbd {
    padding: 0.1rem 0.3rem;
    border: 1px solid var(--mdt-border);
    border-radius: 4px;
    font-family: var(--mdt-font-mono);
    font-size: 0.68rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .palette-panel { animation: palette-in 180ms var(--mdt-ease); }
    @keyframes palette-in {
      from { opacity: 0; transform: translateY(-8px) scale(0.99); }
      to { opacity: 1; transform: none; }
    }
  }
</style>
