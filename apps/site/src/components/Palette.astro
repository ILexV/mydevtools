---
/**
 * CommandPalette — global tool launcher rendered on every BaseLayout page
 * (Stage 8). Markup + localized strings + a compact JSON island with the
 * per-locale tool index; behavior lives in `scripts/palette.ts`.
 *
 * Data-island entry: slug → { t: title, h: href, c: category label, k: keywords, g: category id }
 */
import type { LocaleCode } from "@/registry/locales";
import { buildCatalog, categoryLabel } from "@/registry/catalog";
import { CATEGORY_IDS } from "@/registry/categories";
import Icon, { ICONS } from "./Icon.astro";
import { t } from "@/i18n/messages";

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props as Props;
const catalog = buildCatalog(locale);
const index = Object.fromEntries(
  catalog.tools.map((tool) => [
    tool.slug,
    { t: tool.title, h: tool.href, c: categoryLabel(locale, tool.category), k: tool.keywords.join(" "), g: tool.category },
  ]),
);
const indexJson = JSON.stringify(index);
/** SVG bodies for the 13 category icons, keyed by category id (Prism family). */
const iconsJson = JSON.stringify(Object.fromEntries(CATEGORY_IDS.map((id) => [id, ICONS[id]])));

const searchLabel = t(locale, "common", "Common_Search");
const placeholder = t(locale, "common", "CommandPalette_SearchPlaceholder");
---

<div
  class="palette"
  data-palette
  popover="manual"
  data-label-noresults={t(locale, "common", "CommandPalette_NoResults")}
  data-label-hint={t(locale, "common", "CommandPalette_TypeToSearch")}
  data-label-favorites={t(locale, "common", "CommandPalette_FavoritesTitle")}
  data-label-recent={t(locale, "common", "CommandPalette_RecentTitle")}
  data-label-popular={t(locale, "common", "CommandPalette_PopularTitle")}
  data-icons={iconsJson}
>
  <div class="palette-backdrop" data-palette-close></div>
  <div class="palette-panel" role="dialog" aria-modal="true" aria-label={searchLabel}>
    <div class="palette-head">
      <Icon name="search" size={16} />
      <input
        class="palette-input"
        data-palette-input
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-autocomplete="list"
        aria-controls="palette-results"
        placeholder={placeholder}
        aria-label={searchLabel}
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="palette-esc" aria-hidden="true">Esc</kbd>
    </div>
    <div class="palette-results" id="palette-results" data-palette-results role="listbox" aria-label={searchLabel}></div>
    <div class="palette-foot" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> {t(locale, "common", "CommandPalette_HintNavigate")}</span>
      <span><kbd>↵</kbd> {t(locale, "common", "CommandPalette_HintOpen")}</span>
      <span><kbd>Esc</kbd> {t(locale, "common", "CommandPalette_HintClose")}</span>
    </div>
  </div>
</div>
<script is:inline type="application/json" data-palette-json set:html={indexJson} />

<style is:global>
  .palette {
    position: fixed;
    inset: 0;
    /* Reset [popover] UA box styles (fit-content size, auto margin, Canvas
       background, solid border, 0.25em padding, overflow:auto). The global
       `* { margin: 0 }` reset already kills the UA auto margin, which left
       the shrink-wrapped popover stuck to the top-left with a visible frame. */
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    border: none;
    background: transparent;
    color: var(--mdt-text);
    overflow: visible;
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 12vh 1rem 1rem;
  }
  /* popover="manual" hides via the UA `[popover]:not(:popover-open)` rule, but
     our author `.palette { display:flex }` beats UA-origin styles regardless of
     specificity — so re-assert the hidden state as an author rule. */
  .palette:not(:popover-open) {
    display: none;
  }
  .palette-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 6, 10, 0.55);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  .palette-panel {
    position: relative;
    width: 100%;
    max-width: 34rem;
    display: flex;
    flex-direction: column;
    background: var(--mdt-surface-raised);
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius);
    box-shadow: var(--mdt-shadow-e2);
    overflow: hidden;
  }
  /* 52px search header: icon + input + Esc hint. The input is always focused
     while open, so focus is shown by the icon/hairline turning accent. */
  .palette-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    height: 3.25rem;
    padding: 0 0.9rem 0 1rem;
    border-bottom: 1px solid var(--mdt-border);
    color: var(--mdt-text-faint);
  }
  .palette-head:focus-within {
    color: var(--mdt-accent);
    border-bottom-color: color-mix(in srgb, var(--mdt-accent) 45%, var(--mdt-border));
  }
  .palette-input {
    flex: 1;
    min-width: 0;
    height: 100%;
    font: inherit;
    font-size: var(--mdt-fs-body);
    color: var(--mdt-text);
    background: transparent;
    border: none;
    outline: none;
  }
  .palette-input::placeholder { color: var(--mdt-text-faint); }
  .palette kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.35rem;
    height: 1.25rem;
    padding: 0 0.3rem;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-xs);
    background: var(--mdt-surface-inset);
    color: var(--mdt-text-muted);
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-micro);
    line-height: 1;
  }
  .palette-results {
    max-height: min(30rem, 62vh);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.3rem 0.4rem 0.4rem;
  }
  /* Group header: quiet sentence-case label; sticky within its group with an
     opaque background so rows scrolling beneath stay hidden. */
  .palette-group {
    position: sticky;
    top: 0;
    z-index: 2;
    padding: 0.55rem 0.7rem 0.3rem;
    background: var(--mdt-surface-raised);
    font-size: var(--mdt-fs-label);
    font-weight: 500;
    color: var(--mdt-text-faint);
  }
  /* 48px result row; selection = faint category tint + 3px left rail. */
  .palette-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--mdt-radius-sm);
    cursor: pointer;
    color: var(--mdt-text);
  }
  .palette-option[data-active="true"] {
    background: color-mix(in srgb, var(--mdt-cat) 9%, transparent);
    box-shadow: inset 3px 0 0 var(--mdt-cat);
  }
  .palette-opt-icon {
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: var(--mdt-radius-xs);
    background: color-mix(in srgb, var(--mdt-cat) 12%, transparent);
    color: var(--mdt-cat);
  }
  .palette-opt-title {
    font-size: var(--mdt-fs-small);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .palette-opt-title mark {
    background: none;
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--mdt-cat) 70%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .palette-opt-cat {
    flex-shrink: 1;
    max-width: 45%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--mdt-fs-label);
    color: var(--mdt-text-faint);
  }
  .palette-option[data-active="true"] .palette-opt-cat { color: var(--mdt-text-muted); }
  .palette-empty {
    padding: 1.5rem 0.75rem;
    text-align: center;
    color: var(--mdt-text-muted);
    font-size: var(--mdt-fs-small);
  }
  .palette-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    padding: 0.55rem 1rem;
    border-top: 1px solid var(--mdt-border-soft);
    background: var(--mdt-surface-muted);
    color: var(--mdt-text-faint);
    font-size: var(--mdt-fs-label);
  }
  .palette-foot span { display: inline-flex; align-items: center; gap: 0.3rem; }
  @media (max-width: 40rem) {
    /* Mobile: top sheet spanning the viewport width. */
    .palette { padding: 0.5rem 0.5rem 1rem; }
    .palette-results { max-height: min(34rem, 70vh); }
    .palette-opt-cat { max-width: 38%; }
    .palette .palette-esc { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .palette-panel { animation: palette-in 160ms var(--mdt-ease); }
    @keyframes palette-in {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: none; }
    }
  }
</style>
