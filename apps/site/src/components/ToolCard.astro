---
/**
 * ToolCard — Prism catalog directory entry: per-tool monogram tile inline with
 * the title (slide-in arrow), 2-line description, favorite toggle.
 *
 * Structure: a relative `.tool-card` wrapper holds a full-size `.card-link`
 * anchor (so the whole tile is clickable) and a `.card-fav` toggle button as a
 * sibling (NOT nested in the anchor — valid HTML + the click no longer falls
 * through to navigation). Category color comes from the parent section's
 * `--mdt-cat` (set in index.astro / [slug].astro). `data-keywords` feeds
 * client-side search; the favorite engine keys off `data-fav-toggle`/`data-slug`.
 *
 * View Transitions (source side of the cross-document morph into the tool page
 * header): the tile is `tool-icon-<slug>`, the bare title text (not the arrow)
 * is `tool-title-<slug>`. Slug-based names stay unique on any page.
 */
import type { CatalogTool } from "@/registry/catalog";
import type { LocaleCode } from "@/registry/locales";
import { t } from "@/i18n/messages";
import Icon from "@/components/Icon.astro";

interface Props {
  tool: CatalogTool;
  locale: LocaleCode;
}

const { tool, locale } = Astro.props as Props;
const favLabel = t(locale, "common", "Badge_Favorite");
// Monogram length picks the font size so 1–4 glyphs fit the same 32px tile.
const monoLen = Math.min(4, [...tool.monogram].length);
---

<div class="tool-card" data-tool-card data-slug={tool.slug} data-keywords={tool.keywords.join(" ")}>
  <a class="card-link" href={tool.href}>
    <span class="card-head">
      <span
        class="mono"
        data-len={monoLen}
        aria-hidden="true"
        style={`view-transition-name: tool-icon-${tool.slug}`}
      >{tool.monogram}</span>
      <span class="card-title">
        <span class="card-title-text" style={`view-transition-name: tool-title-${tool.slug}`}>{tool.title}</span>
        <span class="go"><Icon name="arrow-right" size={13} /></span>
      </span>
    </span>
    <span class="card-desc">{tool.description}</span>
  </a>
  <button
    type="button"
    class="card-fav"
    data-fav-toggle
    data-fav-slot
    data-slug={tool.slug}
    aria-label={favLabel}
    aria-pressed="false"
    title={favLabel}
  ></button>
</div>

<style>
  .tool-card {
    position: relative;
    padding: 1rem;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius);
    background: var(--mdt-surface-raised);
    transition: transform var(--mdt-dur) var(--mdt-ease),
      border-color var(--mdt-dur), box-shadow var(--mdt-dur);
  }
  /* Spotlight: category-tinted glow at the pointer (--mx/--my set by the home
     page script; without them it sits at the top centre). */
  .tool-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      280px circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in srgb, var(--mdt-cat) 14%, transparent),
      transparent 65%
    );
    opacity: 0;
    transition: opacity var(--mdt-dur) var(--mdt-ease);
    pointer-events: none;
  }
  .tool-card:hover::before {
    opacity: 1;
  }
  .tool-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--mdt-cat) 55%, var(--mdt-border));
    box-shadow: var(--mdt-shadow-e1);
  }
  .card-link {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--mdt-text);
    text-decoration: none;
  }
  /* Whole card is the link: show the focus ring on the card box. */
  .card-link:focus-visible {
    outline: none;
  }
  /* Same ring as the global focus layer: category colour + soft halo. */
  .tool-card:has(.card-link:focus-visible) {
    outline: var(--mdt-focus-width, 2px) solid var(--mdt-cat, var(--mdt-accent));
    outline-offset: var(--mdt-focus-offset, 2px);
    box-shadow: 0 0 0 7px color-mix(in srgb, var(--mdt-cat, var(--mdt-accent)) 22%, transparent);
  }
  .card-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 32px;
    padding-right: 2.1rem; /* keep the title clear of the fav button */
  }
  /* Monogram tile: fixed 32px square; glyph size shrinks with length. */
  .mono {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: color-mix(in srgb, var(--mdt-cat) 13%, transparent);
    border: 1px solid color-mix(in srgb, var(--mdt-cat) 28%, transparent);
    color: var(--mdt-cat);
    font-family: var(--mdt-font-mono);
    font-weight: 700;
    font-size: 16px;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
    overflow: hidden;
    transition: transform var(--mdt-dur) var(--mdt-ease), background-color var(--mdt-dur);
  }
  .mono[data-len="2"] { font-size: 14px; }
  .mono[data-len="3"] { font-size: 12px; letter-spacing: -0.06em; }
  .mono[data-len="4"] { font-size: 10px; letter-spacing: -0.07em; }
  .tool-card:hover .mono {
    transform: scale(1.06);
    background-color: color-mix(in srgb, var(--mdt-cat) 20%, transparent);
  }
  .card-title {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 7px;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  .card-title-text {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .go {
    margin-left: auto;
    color: var(--mdt-text-faint);
    opacity: 0;
    transform: translateX(-5px);
    transition: opacity var(--mdt-dur-micro) var(--mdt-ease), transform var(--mdt-dur-micro) var(--mdt-ease),
      color var(--mdt-dur-micro);
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
  }
  .tool-card:hover .go {
    opacity: 1;
    transform: none;
    color: var(--mdt-cat);
  }
  .card-desc {
    color: var(--mdt-text-muted);
    font-size: var(--mdt-fs-meta);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-fav {
    position: absolute;
    top: calc(1rem + 1px);
    right: 0.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--mdt-text-faint);
    cursor: pointer;
    transition: color var(--mdt-dur-micro) var(--mdt-ease),
      background-color var(--mdt-dur-micro) var(--mdt-ease);
  }
  .card-fav:hover {
    color: var(--mdt-warning);
    background: color-mix(in srgb, var(--mdt-warning) 12%, transparent);
  }
  .card-fav[aria-pressed="true"] {
    color: var(--mdt-warning);
  }
  @media (prefers-reduced-motion: reduce) {
    .tool-card:hover { transform: none; }
    .tool-card:hover .mono { transform: none; }
  }
</style>
