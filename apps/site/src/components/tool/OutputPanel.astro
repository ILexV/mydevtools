---
/**
 * OutputPanel — result area (tool UI kit): head row with the label and an
 * `actions` slot (copy / download / swap — CopyButton, `ds-btn ds-btn-small`
 * or `ds-btn-ghost`), then the default slot (a readonly `.ds-field-textarea`,
 * `.ds-code-block`, or `.ds-result-list` the controller fills).
 * Opt-in `summaryProps` renders a `.ds-output-summary` live region
 * (role="status", aria-live="polite") below the result; fill it with
 * `setLiveText()` from `@/scripts/tool-ui` so screen readers hear each update.
 *
 * Workbench options (all opt-in, defaults keep the legacy look):
 * - `panel`: render as a `.ds-card` with the ~48px `.ds-panel-head` band
 *   (title + `.ds-panel-actions`) — the output column of a `.ds-workbench`.
 * - `emptyHint` (+ `emptyProps`): start empty (`is-empty`) with a compact
 *   `.ds-empty-state` placeholder; mark the result body `ds-when-filled` so it
 *   stays hidden until `syncEmptyState(panel, false)`.
 *
 *   <OutputPanel panel label={s.output} for="b64-out" emptyHint={s.outputEmpty} data-b64-output-panel>
 *     <Fragment slot="actions"><CopyButton ghost label={c.copy} copiedLabel={c.copied} data-b64-copy /></Fragment>
 *     <textarea id="b64-out" class="ds-field-textarea mono ds-when-filled" readonly data-b64-output></textarea>
 *   </OutputPanel>
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  label: string;
  /** id of the output control when it is a form field. */
  for?: string;
  /** Renders the live summary line; pass the controller hook here. */
  summaryProps?: HTMLAttributes<"p">;
  /** Workbench panel look (ds-card + 48px panel head). */
  panel?: boolean;
  /** Empty-state hint; also starts the panel in the `is-empty` state. */
  emptyHint?: string;
  emptyProps?: HTMLAttributes<"div">;
}

const {
  label,
  for: htmlFor,
  summaryProps,
  panel = false,
  emptyHint,
  emptyProps,
  class: className,
  ...rest
} = Astro.props as Props;
const LabelTag = htmlFor ? "label" : "span";
const hasActions = Astro.slots.has("actions");
---

<section
  class:list={["ds-output", { "ds-card": panel, "ds-stack": panel, "is-empty": emptyHint !== undefined }, className]}
  {...rest}
>
  {panel ? (
    <div class="ds-panel-head">
      <LabelTag class="ds-panel-title" for={htmlFor}>{label}</LabelTag>
      {hasActions && <div class="ds-panel-actions"><slot name="actions" /></div>}
    </div>
  ) : (
    <div class="ds-output-head">
      <LabelTag class="ds-label" for={htmlFor}>{label}</LabelTag>
      {hasActions && <div class="ds-actions"><slot name="actions" /></div>}
    </div>
  )}
  {emptyHint !== undefined && (
    <div class="ds-empty-state" {...emptyProps}><p class="ds-empty-state-hint">{emptyHint}</p></div>
  )}
  <slot />
  {summaryProps && <p class="ds-output-summary" role="status" aria-live="polite" {...summaryProps}></p>}
</section>
