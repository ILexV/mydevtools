---
import type { LocaleCode, LocaleMeta } from "@/registry/locales";
import { LOCALES } from "@/registry/locales";
import Seo from "@/components/Seo.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Palette from "@/components/Palette.astro";
import InstallPrompt from "@/components/InstallPrompt.astro";
import "@/styles/global.css";

interface Props {
  locale: LocaleCode;
  path?: string;
  title: string;
  description: string;
  keywords?: string[];
  /** Home page emits WebSite+Organization JSON-LD; tools emit SoftwareApplication. */
  isHome?: boolean;
  /** Localized category name — inserted into the tool breadcrumb JSON-LD. */
  categoryName?: string;
  /** `Seo_HowToSteps` markdown — forwarded to Seo for HowTo JSON-LD. */
  howToSteps?: string;
}

const {
  locale,
  path = "",
  title,
  description,
  keywords = [],
  isHome = false,
  categoryName,
  howToSteps,
} = Astro.props as Props;
const meta: LocaleMeta = LOCALES.find((l) => l.code === locale)!;
---

<!doctype html>
<html lang={meta.bcp47} dir={meta.dir}>
  <head>
    <Seo
      locale={locale}
      path={path}
      title={title}
      description={description}
      keywords={keywords}
      isHome={isHome}
      categoryName={categoryName}
      howToSteps={howToSteps}
    />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (!stored) {
            stored = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.setAttribute("data-theme", stored === "dark" ? "dark" : "light");
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Header locale={locale} path={path} />
    <slot />
    <Footer locale={locale} />
    <Palette locale={locale} />
    <InstallPrompt locale={locale} />

    <!-- Global shell: theme toggle, language switcher, search, favorites/recent. -->
    <script>
      import "@/scripts/chrome.ts";
      import "@/scripts/favorites.ts";
      import "@/scripts/palette.ts";
      import "@/scripts/pwa-install.ts";
    </script>

    <!-- PWA: register the build-generated service worker (production only). -->
    <script>
      import "@/scripts/sw-register.ts";
    </script>

    <!-- Service-worker update prompt. -->
    <div id="sw-update-toast" hidden role="status" aria-live="polite"></div>
  </body>
</html>
