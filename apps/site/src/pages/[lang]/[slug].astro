---
/**
 * `/{lang}/{slug}/` — tool page (Prism shell, design spec §9).
 * All 39 × 10 routes from the tool registry (validated at build). Tool head:
 * breadcrumb, category tile + H1 + description + privacy pill, favorite/share.
 * `--mdt-cat` scopes the category accent to the whole page.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolCard from "@/components/ToolCard.astro";
import ToolSeoContent from "@/components/ToolSeoContent.astro";
import Icon from "@/components/Icon.astro";
import { LOCALES, type LocaleCode } from "@/registry/locales";
import { TOOLS, resolveTool } from "@/registry/tools";
import { assertRegistryValid } from "@/registry/validate";
import { relatedTools, categoryLabel } from "@/registry/catalog";
import { t } from "@/i18n/messages";
import HashCalculator from "@/tools/HashCalculator.astro";
import UuidGenerator from "@/tools/UuidGenerator.astro";
import WordCounter from "@/tools/WordCounter.astro";
import ColorConverter from "@/tools/ColorConverter.astro";
import LoremIpsumGenerator from "@/tools/LoremIpsumGenerator.astro";
import TextCaseConverter from "@/tools/TextCaseConverter.astro";
import UnitConverter from "@/tools/UnitConverter.astro";
import DateConverter from "@/tools/DateConverter.astro";
import HtmlEntityEncoder from "@/tools/HtmlEntityEncoder.astro";
import Base64Encoder from "@/tools/Base64Encoder.astro";
import Base32Encoder from "@/tools/Base32Encoder.astro";
import Base58Encoder from "@/tools/Base58Encoder.astro";
import HexEncoder from "@/tools/HexEncoder.astro";
import UrlEncoder from "@/tools/UrlEncoder.astro";
import HmacCalculator from "@/tools/HmacCalculator.astro";
import JwtDecoder from "@/tools/JwtDecoder.astro";
import JwtEncoder from "@/tools/JwtEncoder.astro";
import PasswordGenerator from "@/tools/PasswordGenerator.astro";
import OpenSshKeys from "@/tools/OpenSshKeys.astro";
import X509Tool from "@/tools/X509Tool.astro";
import JsonBeautifier from "@/tools/JsonBeautifier.astro";
import JsonToTypeScript from "@/tools/JsonToTypeScript.astro";
import XmlBeautifier from "@/tools/XmlBeautifier.astro";
import YamlBeautifierValidator from "@/tools/YamlBeautifierValidator.astro";
import CronGenerator from "@/tools/CronGenerator.astro";
import CronParser from "@/tools/CronParser.astro";
import TextDiffViewer from "@/tools/TextDiffViewer.astro";
import MarkdownPreview from "@/tools/MarkdownPreview.astro";
import RegexTester from "@/tools/RegexTester.astro";
import IpSubnetCalculator from "@/tools/IpSubnetCalculator.astro";
import QrCodeGenerator from "@/tools/QrCodeGenerator.astro";
import QrCodeScanner from "@/tools/QrCodeScanner.astro";
import AeadFileCrypto from "@/tools/AeadFileCrypto.astro";
import ImageCompressor from "@/tools/ImageCompressor.astro";
import ImageConverter from "@/tools/ImageConverter.astro";
import ImageResizer from "@/tools/ImageResizer.astro";
import PdfCompressor from "@/tools/PdfCompressor.astro";
import PdfMerger from "@/tools/PdfMerger.astro";
import PdfToText from "@/tools/PdfToText.astro";

assertRegistryValid();

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    TOOLS.map((tool) => ({ params: { lang: locale.code, slug: tool.slug } })),
  );
}

interface Params {
  lang: LocaleCode;
  slug: string;
}

const { lang, slug } = Astro.params as Params;
const resolved = resolveTool(slug);
if (!resolved) throw new Error(`Unknown tool slug in route: ${slug}`);

const { tool, namespace } = resolved;
const title = t(lang, namespace, "Title");
const description = t(lang, namespace, "Description");
const catLabel = categoryLabel(lang, tool.category);
const related = relatedTools(lang, slug);
const favLabel = t(lang, "common", "Badge_Favorite");
const shareLabel = t(lang, "common", "Common_Share");
const copiedLabel = t(lang, "common", "Common_LinkCopied");
const relatedLabel = `${catLabel}`;
const homeLabel = t(lang, "common", "Nav_Home");
const privacyLabel = t(lang, "common", "NoDataSent");

// Seo_HowToSteps drives both the HowTo JSON-LD and the visible SEO block.
// `t()` returns the raw key when missing — pass undefined in that case.
const howToRaw = t(lang, namespace, "Seo_HowToSteps");
const howToSteps = howToRaw === "Seo_HowToSteps" || !howToRaw.trim() ? undefined : howToRaw;

const TOOL_COMPONENTS: Record<string, any> = {
  "hash-calculator": HashCalculator,
  "uuid-generator": UuidGenerator,
  "word-counter": WordCounter,
  "color-converter": ColorConverter,
  "lorem-ipsum-generator": LoremIpsumGenerator,
  "text-case-converter": TextCaseConverter,
  "unit-converter": UnitConverter,
  "date-converter": DateConverter,
  "html-entity-encoder": HtmlEntityEncoder,
  "base64-encoder": Base64Encoder,
  "base32-encoder": Base32Encoder,
  "base58-encoder": Base58Encoder,
  "hex-encoder": HexEncoder,
  "url-encoder": UrlEncoder,
  "hmac-calculator": HmacCalculator,
  "jwt-decoder": JwtDecoder,
  "jwt-encoder": JwtEncoder,
  "password-generator": PasswordGenerator,
  "openssh-keys": OpenSshKeys,
  "x509": X509Tool,
  "json-beautifier": JsonBeautifier,
  "json-to-typescript": JsonToTypeScript,
  "xml-beautifier": XmlBeautifier,
  "yaml-beautifier-validator": YamlBeautifierValidator,
  "cron-generator": CronGenerator,
  "cron-parser": CronParser,
  "text-diff-viewer": TextDiffViewer,
  "markdown-preview": MarkdownPreview,
  "regex-tester": RegexTester,
  "ip-subnet-calculator": IpSubnetCalculator,
  "qr-code-generator": QrCodeGenerator,
  "qr-scanner": QrCodeScanner,
  "aead-file": AeadFileCrypto,
  "image-compressor": ImageCompressor,
  "image-converter": ImageConverter,
  "image-resizer": ImageResizer,
  "pdf-compressor": PdfCompressor,
  "pdf-merger": PdfMerger,
  "pdf-to-text": PdfToText,
};
const ActiveTool = TOOL_COMPONENTS[slug];
---

<BaseLayout locale={lang} path={slug} title={title} description={description} keywords={[tool.slug]} categoryName={catLabel} howToSteps={howToSteps}>
  <span data-visit-slug data-slug={slug} hidden></span>
  <div class="scroll-progress" aria-hidden="true"></div>
  <main class="tool" style={`--mdt-cat: var(--mdt-cat-${tool.category})`}>
    <header class="tool-head">
      <nav class="crumbs" aria-label="breadcrumb">
        <a href={`/${lang}/`}>{homeLabel}</a>
        <span aria-hidden="true">/</span>
        <span>{catLabel}</span>
        <span aria-hidden="true">/</span>
        <span class="crumb-current">{tool.slug}</span>
      </nav>
      <div class="tool-title-row">
        <span class="tile"><Icon name={tool.category} size={22} /></span>
        <div class="tool-title-text">
          <h1>{title}</h1>
          <p class="tool-desc">{description}</p>
        </div>
        <div class="tool-actions">
          <span class="privacy-pill"><Icon name="lock" size={11} />{privacyLabel}</span>
          <button
            type="button"
            class="ds-icon-btn fav-toggle"
            data-fav-toggle
            data-slug={slug}
            aria-pressed="false"
            aria-label={favLabel}
            title={favLabel}
          >
            <Icon name="star" size={16} />
          </button>
          <button
            type="button"
            class="ds-icon-btn share-btn"
            data-share
            data-copied-label={copiedLabel}
            aria-label={shareLabel}
            title={shareLabel}
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
          </button>
        </div>
      </div>
    </header>

    <div class="tool-body">
      <noscript>
        <div class="nojs-banner" role="alert">
          <span class="nojs-icon"><Icon name="alert" size={20} /></span>
          <div class="nojs-text">
            <p class="nojs-title">{t(lang, "common", "Common_NoJsTitle")}</p>
            <p class="nojs-body">{t(lang, "common", "Common_NoJsBody")}</p>
          </div>
        </div>
      </noscript>
      {ActiveTool && <ActiveTool lang={lang} />}
    </div>

    <ToolSeoContent locale={lang} namespace={namespace} />

    {related.length > 0 && (
      <section class="related">
        <h2 class="related-heading">{relatedLabel}</h2>
        <div class="cat-grid">
          {related.map((rel) => (
            <ToolCard tool={rel} locale={lang} />
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .tool {
    max-width: var(--mdt-content-max);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2.25rem) 1.25rem 3rem;
    /* Tool page accent = category accent (spec §2): brand stays in site chrome. */
    --mdt-accent: var(--mdt-cat);
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-micro);
    color: var(--mdt-text-faint);
    margin-bottom: 1.1rem;
    flex-wrap: wrap;
  }
  .crumbs a { color: var(--mdt-text-faint); text-decoration: none; }
  .crumbs a:hover { color: var(--mdt-cat); }
  .crumb-current { color: var(--mdt-cat); }

  .tool-title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.95rem;
  }
  .tool-title-row .tile {
    width: 46px;
    height: 46px;
    border-radius: 13px;
    margin-top: 0.15rem;
  }
  .tool-title-text { min-width: 0; }
  h1 {
    font-weight: 650;
    font-size: clamp(1.45rem, 3vw, 1.9rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .tool-desc {
    color: var(--mdt-text-muted);
    font-size: var(--mdt-fs-small);
    max-width: 65ch;
    margin-top: 0.35rem;
  }
  .tool-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .fav-toggle:hover { border-color: var(--mdt-warning); color: var(--mdt-warning); }
  .fav-toggle[aria-pressed="true"] { color: var(--mdt-warning); border-color: var(--mdt-warning); }
  .fav-toggle[aria-pressed="true"] svg { fill: currentColor; }
  .fav-toggle:hover svg { transform: none; }
  .share-btn.copied { border-color: var(--mdt-success); color: var(--mdt-success); }
  .share-btn:hover svg { transform: none; }

  .tool-body { margin-top: 1.75rem; }
  .nojs-banner {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 1rem 1.15rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--mdt-warning);
    border-left-width: 3px;
    border-radius: var(--mdt-radius);
    background: color-mix(in srgb, var(--mdt-warning) 8%, var(--mdt-surface-raised));
  }
  .nojs-icon { color: var(--mdt-warning); flex-shrink: 0; margin-top: 1px; }
  .nojs-title { font-weight: 650; color: var(--mdt-text); margin-bottom: 0.2rem; }
  .nojs-body { color: var(--mdt-text-muted); font-size: var(--mdt-fs-small); }

  .related { margin-top: 3rem; }
  .related-heading {
    font-weight: 650;
    font-size: var(--mdt-fs-h3);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.875rem; }

  @media (max-width: 640px) {
    .tool { padding: 1.25rem 1rem 2.5rem; }
    .privacy-pill { display: none; }
    .tool-title-row .tile { width: 40px; height: 40px; border-radius: 11px; }
  }
</style>
<style is:inline>
  /* Reading-progress indicator — pure CSS via animation-timeline: scroll(root),
     zero JS. is:inline (verbatim, no minify/scope) so the minifier doesn't fold
     animation-timeline into the animation shorthand (which Chromium rejects).
     Chromium-only; non-supporting engines see no bar (scaleX(0) = invisible).
     Tracks scroll 1:1, so reduced-motion users still get the indicator cleanly. */
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 100%;
    transform-origin: 0 50%;
    transform: scaleX(0);
    background: linear-gradient(90deg, var(--mdt-cat), var(--mdt-accent-2));
    z-index: 120;
    pointer-events: none;
    animation: none;
  }
  @supports (animation-timeline: scroll()) {
    .scroll-progress {
      animation: sp-grow linear both;
      animation-timeline: scroll(root);
    }
    @keyframes sp-grow {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }
  }
</style>
