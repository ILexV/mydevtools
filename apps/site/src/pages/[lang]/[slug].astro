---
/**
 * `/{lang}/{slug}/` — tool page. All 39 × 10 routes from the tool registry
 * (validated at build). Dispatches to a per-tool component via `TOOL_COMPONENTS`;
 * slugs without an entry yet show a Stage-9 placeholder. Header chrome, favorite
 * toggle and related tools are shared by every tool.
 *
 * Adding a migrated tool = create `src/tools/<Name>.astro` + register it below.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolCard from "@/components/ToolCard.astro";
import { LOCALES, type LocaleCode } from "@/registry/locales";
import { TOOLS, resolveTool } from "@/registry/tools";
import { assertRegistryValid } from "@/registry/validate";
import { relatedTools, categoryLabel } from "@/registry/catalog";
import { t } from "@/i18n/messages";
import HashCalculator from "@/tools/HashCalculator.astro";
import UuidGenerator from "@/tools/UuidGenerator.astro";
import WordCounter from "@/tools/WordCounter.astro";
import ColorConverter from "@/tools/ColorConverter.astro";
import LoremIpsumGenerator from "@/tools/LoremIpsumGenerator.astro";
import TextCaseConverter from "@/tools/TextCaseConverter.astro";
import UnitConverter from "@/tools/UnitConverter.astro";
import DateConverter from "@/tools/DateConverter.astro";
import HtmlEntityEncoder from "@/tools/HtmlEntityEncoder.astro";
import Base64Encoder from "@/tools/Base64Encoder.astro";
import Base32Encoder from "@/tools/Base32Encoder.astro";
import Base58Encoder from "@/tools/Base58Encoder.astro";
import HexEncoder from "@/tools/HexEncoder.astro";
import UrlEncoder from "@/tools/UrlEncoder.astro";
import HmacCalculator from "@/tools/HmacCalculator.astro";
import JwtDecoder from "@/tools/JwtDecoder.astro";
import JwtEncoder from "@/tools/JwtEncoder.astro";
import PasswordGenerator from "@/tools/PasswordGenerator.astro";
import OpenSshKeys from "@/tools/OpenSshKeys.astro";
import X509Tool from "@/tools/X509Tool.astro";
import JsonBeautifier from "@/tools/JsonBeautifier.astro";
import JsonToTypeScript from "@/tools/JsonToTypeScript.astro";
import XmlBeautifier from "@/tools/XmlBeautifier.astro";
import YamlBeautifierValidator from "@/tools/YamlBeautifierValidator.astro";
import CronGenerator from "@/tools/CronGenerator.astro";
import CronParser from "@/tools/CronParser.astro";
import TextDiffViewer from "@/tools/TextDiffViewer.astro";
import MarkdownPreview from "@/tools/MarkdownPreview.astro";
import RegexTester from "@/tools/RegexTester.astro";
import IpSubnetCalculator from "@/tools/IpSubnetCalculator.astro";
import QrCodeGenerator from "@/tools/QrCodeGenerator.astro";
import QrCodeScanner from "@/tools/QrCodeScanner.astro";
import AeadFileCrypto from "@/tools/AeadFileCrypto.astro";
import ImageCompressor from "@/tools/ImageCompressor.astro";
import ImageConverter from "@/tools/ImageConverter.astro";
import ImageResizer from "@/tools/ImageResizer.astro";
import PdfCompressor from "@/tools/PdfCompressor.astro";
import PdfMerger from "@/tools/PdfMerger.astro";
import PdfToText from "@/tools/PdfToText.astro";

assertRegistryValid();

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    TOOLS.map((tool) => ({ params: { lang: locale.code, slug: tool.slug } })),
  );
}

interface Params {
  lang: LocaleCode;
  slug: string;
}

const { lang, slug } = Astro.params as Params;
const resolved = resolveTool(slug);
if (!resolved) throw new Error(`Unknown tool slug in route: ${slug}`);

const { tool, namespace } = resolved;
const title = t(lang, namespace, "Title");
const description = t(lang, namespace, "Description");
const catLabel = categoryLabel(lang, tool.category);
const related = relatedTools(lang, slug);
const favLabel = t(lang, "common", "Badge_Favorite");
const relatedLabel = `${catLabel}`;

// Migrated tools render their own component; others show a placeholder.
const TOOL_COMPONENTS: Record<string, any> = {
  "hash-calculator": HashCalculator,
  "uuid-generator": UuidGenerator,
  "word-counter": WordCounter,
  "color-converter": ColorConverter,
  "lorem-ipsum-generator": LoremIpsumGenerator,
  "text-case-converter": TextCaseConverter,
  "unit-converter": UnitConverter,
  "date-converter": DateConverter,
  "html-entity-encoder": HtmlEntityEncoder,
  "base64-encoder": Base64Encoder,
  "base32-encoder": Base32Encoder,
  "base58-encoder": Base58Encoder,
  "hex-encoder": HexEncoder,
  "url-encoder": UrlEncoder,
  "hmac-calculator": HmacCalculator,
  "jwt-decoder": JwtDecoder,
  "jwt-encoder": JwtEncoder,
  "password-generator": PasswordGenerator,
  "openssh-keys": OpenSshKeys,
  "x509": X509Tool,
  "json-beautifier": JsonBeautifier,
  "json-to-typescript": JsonToTypeScript,
  "xml-beautifier": XmlBeautifier,
  "yaml-beautifier-validator": YamlBeautifierValidator,
  "cron-generator": CronGenerator,
  "cron-parser": CronParser,
  "text-diff-viewer": TextDiffViewer,
  "markdown-preview": MarkdownPreview,
  "regex-tester": RegexTester,
  "ip-subnet-calculator": IpSubnetCalculator,
  "qr-code-generator": QrCodeGenerator,
  "qr-scanner": QrCodeScanner,
  "aead-file": AeadFileCrypto,
  "image-compressor": ImageCompressor,
  "image-converter": ImageConverter,
  "image-resizer": ImageResizer,
  "pdf-compressor": PdfCompressor,
  "pdf-merger": PdfMerger,
  "pdf-to-text": PdfToText,
};
const ActiveTool = TOOL_COMPONENTS[slug];
---

<BaseLayout locale={lang} path={slug} title={title} description={description} keywords={[tool.slug]} categoryName={catLabel}>
  <span data-visit-slug data-slug={slug} hidden></span>
  <main class="tool">
    <header class="tool-head">
      <nav class="crumbs" aria-label="breadcrumb">
        <a href={`/${lang}/`}>{t(lang, "common", "Nav_Home")}</a>
        <span aria-hidden="true">/</span>
        <span>{catLabel}</span>
      </nav>
      <div class="tool-title-row">
        <h1>{title}</h1>
        <button
          type="button"
          class="fav-toggle"
          data-fav-toggle
          data-slug={slug}
          aria-pressed="false"
          aria-label={favLabel}
          title={favLabel}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 18.9 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/></svg>
        </button>
      </div>
      <p class="tool-desc">{description}</p>
      {ActiveTool ? (
        <div class="tool-body"><ActiveTool lang={lang} /></div>
      ) : (
        <div class="tool-placeholder">
          {t(lang, namespace, "Description")} — UI migration pending (Stage 9).
        </div>
      )}
    </header>

    {related.length > 0 && (
      <section class="related">
        <h2>{relatedLabel}</h2>
        <div class="cat-grid">
          {related.map((rel) => (
            <ToolCard tool={rel} locale={lang} />
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .tool {
    max-width: var(--mdt-content-max);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2.5rem) 1.25rem 2rem;
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--mdt-text-muted);
    margin-bottom: 0.75rem;
  }
  .crumbs a { color: var(--mdt-text-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--mdt-accent); }
  .tool-title-row { display: flex; align-items: center; gap: 0.75rem; }
  h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .fav-toggle {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface-raised);
    color: var(--mdt-text-muted);
    cursor: pointer;
  }
  .fav-toggle:hover { border-color: var(--mdt-warning); color: var(--mdt-warning); }
  .fav-toggle[aria-pressed="true"] { color: var(--mdt-warning); border-color: var(--mdt-warning); }
  .fav-toggle[aria-pressed="true"] svg { fill: currentColor; }
  .tool-desc { color: var(--mdt-text-muted); max-width: 65ch; margin-top: 0.6rem; }
  .tool-body { margin-top: 1.75rem; }
  .tool-placeholder {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border: 1px dashed var(--mdt-border);
    border-radius: var(--mdt-radius);
    color: var(--mdt-text-muted);
    font-size: 0.9rem;
  }
  .related { margin-top: 3rem; }
  .related h2 { font-size: 1.1rem; margin-bottom: 0.75rem; }
  .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.75rem; }
</style>
