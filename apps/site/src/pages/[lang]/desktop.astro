---
/**
 * `/{lang}/desktop/` — computer workspace. Not indexed: the canonical tool
 * documents stay at `/{lang}/{slug}/`. Windows load those pages with `?embed=1`.
 */
import Icon from "@/components/Icon.astro";
import { ICONS, type IconName } from "@/components/Icon.astro";
import { TOOL_ICONS } from "@/desktop/tool-icons";
import { WALLPAPER_PRESETS } from "@/desktop/wallpaper";
import { getNamespace, t } from "@/i18n/messages";
import { localizedPath, withBase } from "@/lib/url";
import { buildCatalog } from "@/registry/catalog";
import { LOCALES, type LocaleCode } from "@/registry/locales";
import "@/styles/desktop.css";
import "@/styles/global.css";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale.code } }));
}

interface Params {
  lang: LocaleCode;
}

const { lang } = Astro.params as Params;
const meta = LOCALES.find((locale) => locale.code === lang)!;
const catalog = buildCatalog(lang);
const siteName = t(lang, "common", "AppName");
const title = t(lang, "desktop", "Title");
const homeHref = localizedPath(lang);
const strings = Object.fromEntries(
  Object.entries(getNamespace(lang, "desktop")).filter((entry): entry is [string, string] => typeof entry[1] === "string"),
);

function iconBody(key: string): string {
  return key in ICONS ? ICONS[key as IconName] : "";
}

const payload = {
  tools: catalog.tools.map((tool) => ({
    slug: tool.slug,
    title: tool.title,
    description: tool.description,
    monogram: tool.monogram,
    icon: TOOL_ICONS[tool.slug],
    category: tool.category,
    href: tool.href,
  })),
  categories: catalog.categories.map((category) => ({
    id: category.id,
    label: category.label,
    icon: iconBody(category.iconKey),
  })),
  strings,
  // Window chrome, launcher and widgets draw these in the browser.
  icons: Object.fromEntries(
    (["star", "help", "more", "minimize", "maximize", "restore", "close", "external", "tile", "chevron", "plus", "check", "history", "folder", "windows", "apps", "desktop", "settings", "lock"] as const).map((name) => [name, ICONS[name]]),
  ),
};
const payloadJson = JSON.stringify(payload).replace(/</g, "\\u003c");
const label = (key: string) => t(lang, "desktop", key);
---

<!doctype html>
<html lang={meta.bcp47} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={label("EmptyDesktop")} />
    <title>{title} — {siteName}</title>
    <link rel="icon" type="image/svg+xml" href={withBase("icons/favicon.svg")} />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase("icons/icon-192.png")} />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (!stored) {
            stored = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.setAttribute("data-theme", stored === "dark" ? "dark" : "light");
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="desk">
    <h1 class="visually-hidden">{title}</h1>
    <div class="desk-bg wp-dusk" data-desk-bg aria-hidden="true">
      <span class="desk-bg-blur"></span>
      <span class="desk-bg-photo"></span>
      <span class="desk-bg-dim"></span>
    </div>
    <header class="desk-top">
      <a class="desk-brand" href={homeHref} data-desk-exit>
        <span class="desk-brand-mark"><Icon name="logo-mark" size={15} /></span>
        <span>{siteName}</span>
      </a>
      <button type="button" class="desk-search" data-desk-search aria-keyshortcuts="Control+K Meta+K">
        <Icon name="search" size={15} />
        <span class="desk-search-label">{label("SearchPlaceholder")}</span>
        <kbd>Ctrl K</kbd>
      </button>
      <span class="desk-top-spacer"></span>
      <button type="button" class="desk-top-btn desk-theme" data-theme-toggle aria-label={label("Theme")} title={label("Theme")}>
        <span class="icon-sun"><Icon name="sun" size={17} /></span>
        <span class="icon-moon"><Icon name="moon" size={17} /></span>
      </button>
      <details class="desk-lang">
        <summary class="desk-top-btn desk-lang-btn" aria-label={t(lang, "common", "Language")} title={t(lang, "common", "Language")}>
          <Icon name="globe" size={17} />
          <span>{lang.toUpperCase()}</span>
        </summary>
        <div class="desk-lang-list">
          {LOCALES.map((locale) => (
            <a href={localizedPath(locale.code, "desktop")} hreflang={locale.bcp47} lang={locale.bcp47} aria-current={locale.code === lang ? "true" : undefined}>
              {locale.nativeName}
            </a>
          ))}
        </div>
      </details>
      <button type="button" class="desk-top-btn" data-desk-settings aria-label={label("Settings")} title={label("Settings")}>
        <Icon name="settings" size={17} />
      </button>
      <a class="desk-top-btn desk-exit" href={homeHref} data-desk-exit>
        <Icon name="exit" size={16} />
        <span>{label("BackToCatalog")}</span>
      </a>
    </header>

    <div class="desk-stage" data-desk-stage>
      <div class="desk-icons" data-desk-icons></div>
      <aside class="desk-widgets" data-desk-widgets hidden></aside>
      <div class="desk-windows" data-desk-windows></div>
      <div class="desk-snap" data-desk-snap hidden></div>
      <div class="desk-hint" data-desk-hint>
        <p id="desk-move-hint">{label("MoveHint")}</p>
        <button type="button" class="ds-btn ds-btn-small" data-hint-dismiss>{label("MoveHintDismiss")}</button>
      </div>
    </div>

    <footer class="desk-taskbar" aria-label={label("Taskbar")}>
      <button type="button" class="desk-launch" data-desk-catalog aria-haspopup="dialog">
        <Icon name="apps" size={17} />
        <span>{label("AllTools")}</span>
      </button>
      <div class="desk-tasks" data-desk-tasks></div>
      <div class="desk-tray">
        <button type="button" class="desk-tray-btn" data-desk-workspaces aria-label={label("Workspaces")} title={label("Workspaces")}>
          <Icon name="layers" size={17} />
        </button>
        <button type="button" class="desk-tray-btn" data-desk-overview aria-label={label("Overview")} title={label("Overview")}>
          <Icon name="windows" size={17} />
          <span class="desk-count" data-desk-count hidden>0</span>
        </button>
        <button type="button" class="desk-tray-btn" data-desk-show aria-label={label("ShowDesktop")} title={label("ShowDesktop")}>
          <Icon name="desktop" size={17} />
        </button>
        <span class="desk-clock" data-desk-clock aria-hidden="true">
          <span data-clock-time></span>
          <span data-clock-date></span>
        </span>
      </div>
    </footer>
    <div class="desk-layout-notice" data-layout-notice hidden>
      <span role="status">{label("LayoutChanged")}</span>
      <button type="button" class="ds-btn ds-btn-small" data-layout-undo>{label("UndoLayout")}</button>
      <button type="button" class="desk-win-btn" data-layout-dismiss aria-label={label("Close")} title={label("Close")}><Icon name="close" size={16} /></button>
    </div>

    <div class="desk-menu" data-desk-menu role="menu" hidden></div>
    <section class="desk-pop" data-desk-pop role="dialog" aria-labelledby="desk-pop-title" hidden></section>

    <dialog class="desk-dialog desk-launcher" data-catalog-dialog aria-labelledby="desk-catalog-title">
      <div class="desk-dialog-head">
        <h2 id="desk-catalog-title">{label("AllTools")}</h2>
        <button type="button" class="desk-win-btn" data-dialog-close aria-label={label("Close")} title={label("Close")}><Icon name="close" size={16} /></button>
      </div>
      <div class="desk-launcher-search">
        <Icon name="search" size={17} />
        <input type="search" data-catalog-input placeholder={label("SearchPlaceholder")} aria-label={label("Search")} autocomplete="off" />
      </div>
      <div class="desk-launcher-main">
        <nav class="desk-launcher-nav" data-catalog-nav aria-label={label("Catalog")}></nav>
        <div class="desk-launcher-results" data-catalog-results></div>
      </div>
    </dialog>

    <dialog class="desk-dialog desk-settings" data-settings-dialog aria-labelledby="desk-settings-title">
      <div class="desk-dialog-head">
        <h2 id="desk-settings-title">{label("Settings")}</h2>
        <button type="button" class="desk-win-btn" data-settings-cancel aria-label={label("Cancel")} title={label("Cancel")}><Icon name="close" size={16} /></button>
      </div>
      <div class="desk-dialog-body">
        <section class="desk-set-section">
          <h3>{label("Wallpaper")}</h3>
          <div class="desk-swatches" role="radiogroup" aria-label={label("Wallpaper")}>
            {WALLPAPER_PRESETS.map((preset) => (
              <button type="button" class="desk-swatch" data-preset={preset.id} role="radio" aria-checked="false" aria-label={label(preset.labelKey)}>
                <span class={`desk-swatch-art wp-${preset.id}`}></span>
                <span class="desk-swatch-name">{label(preset.labelKey)}</span>
              </button>
            ))}
          </div>
          <div class="desk-set-row">
            <span class="desk-set-label">{label("CustomImage")}</span>
            <div class="desk-set-control">
              <label class="ds-btn ds-btn-small desk-file">
                <Icon name="upload" size={15} />
                {label("ChooseImage")}
                <input type="file" accept="image/jpeg,image/png,image/webp" data-wallpaper-file />
              </label>
              <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-remove-image>{label("RemoveImage")}</button>
            </div>
          </div>
          <p class="desk-warning" data-image-warning hidden>{label("ImageTooSmall")}</p>
          <div class="desk-set-row">
            <span class="desk-set-label">{label("Placement")}</span>
            <div class="desk-seg" role="radiogroup" aria-label={label("Placement")}>
              <label><input type="radio" name="desk-fit" value="cover" data-fit checked /><span>{label("FitCover")}</span></label>
              <label><input type="radio" name="desk-fit" value="contain" data-fit /><span>{label("FitContain")}</span></label>
            </div>
          </div>
          <label class="desk-set-row">
            <span class="desk-set-label">{label("Dim")}</span>
            <span class="desk-set-control desk-range">
              <input type="range" min="0" max="60" step="1" data-dim value="0" />
              <output data-dim-value>0%</output>
            </span>
          </label>
        </section>
        <section class="desk-set-section">
          <h3>{label("IconsSection")}</h3>
          <div class="desk-set-row">
            <span class="desk-set-label">{label("IconSize")}</span>
            <div class="desk-seg" role="radiogroup" aria-label={label("IconSize")}>
              <label><input type="radio" name="desk-icon-size" value="regular" data-icon-size checked /><span>{label("IconRegular")}</span></label>
              <label><input type="radio" name="desk-icon-size" value="large" data-icon-size /><span>{label("IconLarge")}</span></label>
            </div>
          </div>
          <div class="desk-set-row">
            <span class="desk-set-label">{label("Density")}</span>
            <div class="desk-seg" role="radiogroup" aria-label={label("Density")}>
              <label><input type="radio" name="desk-density" value="comfortable" data-density checked /><span>{label("DensityComfortable")}</span></label>
              <label><input type="radio" name="desk-density" value="compact" data-density /><span>{label("DensityCompact")}</span></label>
            </div>
          </div>
          <label class="desk-set-row">
            <span class="desk-set-label">{label("LockIcons")}</span>
            <input class="ds-switch" type="checkbox" data-lock />
          </label>
          <div class="desk-set-actions">
            <button type="button" class="ds-btn ds-btn-small" data-align>{label("AlignIcons")}</button>
            <button type="button" class="ds-btn ds-btn-small" data-restore-icons>{label("RestoreIcons")}</button>
            <button type="button" class="ds-btn ds-btn-small" data-layout-undo disabled>{label("UndoLayout")}</button>
          </div>
        </section>
        <section class="desk-set-section">
          <h3>{label("StartSection")}</h3>
          <label class="desk-set-row">
            <span class="desk-set-label">
              {label("Remember")}
              <small>{label("RememberHint")}</small>
            </span>
            <input class="ds-switch" type="checkbox" data-remember />
          </label>
          <div class="desk-set-row">
            <span class="desk-set-label">
              {label("ResetLayout")}
              <small>{label("ResetLayoutHint")}</small>
            </span>
            <button type="button" class="ds-btn ds-btn-small" data-reset-layout>{label("ResetLayout")}</button>
          </div>
        </section>
      </div>
      <div class="desk-dialog-actions">
        <button type="button" class="ds-btn" data-settings-cancel>{label("Cancel")}</button>
        <button type="button" class="ds-btn ds-btn-primary" data-settings-apply>{label("Apply")}</button>
      </div>
    </dialog>

    <dialog class="desk-dialog" data-overview-dialog aria-labelledby="desk-overview-title">
      <div class="desk-dialog-head">
        <h2 id="desk-overview-title">{label("Overview")}</h2>
        <button type="button" class="desk-win-btn" data-dialog-close aria-label={label("Close")} title={label("Close")}><Icon name="close" size={16} /></button>
      </div>
      <div class="desk-dialog-body">
        <input class="ds-field" type="search" data-overview-input placeholder={label("SearchPlaceholder")} aria-label={label("Search")} autocomplete="off" />
        <div class="desk-overview-list" data-overview-list></div>
      </div>
      <div class="desk-dialog-actions">
        <button type="button" class="ds-btn ds-btn-small" data-close-others>{label("CloseOthers")}</button>
      </div>
    </dialog>

    <dialog class="desk-dialog desk-dialog-narrow" data-discard-dialog aria-labelledby="desk-discard-title">
      <div class="desk-dialog-head">
        <h2 id="desk-discard-title" data-discard-title>{label("DiscardTitle")}</h2>
      </div>
      <div class="desk-dialog-body">
        <p data-discard-body>{label("DiscardBody")}</p>
      </div>
      <div class="desk-dialog-actions">
        <button type="button" class="ds-btn" data-discard-stay>{label("DiscardStay")}</button>
        <button type="button" class="ds-btn ds-btn-primary" data-discard-close>{label("DiscardClose")}</button>
      </div>
    </dialog>

    <dialog class="desk-dialog desk-dialog-narrow" data-help-dialog aria-labelledby="desk-help-title">
      <div class="desk-dialog-head">
        <h2 id="desk-help-title" data-help-title>{label("Help")}</h2>
        <button type="button" class="desk-win-btn" data-dialog-close aria-label={label("Close")} title={label("Close")}><Icon name="close" size={16} /></button>
      </div>
      <div class="desk-dialog-body">
        <p data-help-body></p>
      </div>
    </dialog>

    <dialog class="desk-dialog" data-workspaces-dialog aria-labelledby="desk-workspaces-title">
      <div class="desk-dialog-head">
        <h2 id="desk-workspaces-title">{label("WorkspacesTitle")}</h2>
        <button type="button" class="desk-win-btn" data-dialog-close aria-label={label("Close")} title={label("Close")}><Icon name="close" size={16} /></button>
      </div>
      <div class="desk-dialog-body">
        <p class="desk-muted">{label("WorkspacesHint")}</p>
        <div class="desk-workspace-list" data-workspace-list></div>
        <p class="desk-muted" data-workspace-empty hidden>{label("NoWorkspaces")}</p>
        <div class="desk-workspace-save">
          <label class="desk-field">
            {label("WorkspaceName")}
            <input class="ds-field" type="text" maxlength="80" data-workspace-name autocomplete="off" />
          </label>
          <button type="button" class="ds-btn ds-btn-primary" data-workspace-save disabled>{label("SaveWorkspace")}</button>
        </div>
        <p class="desk-muted" data-workspace-nothing hidden>{label("NothingToSave")}</p>
        <p class="desk-muted" data-workspace-limit hidden>{label("WorkspaceLimit")}</p>
      </div>
    </dialog>

    <dialog class="desk-dialog desk-dialog-narrow" data-workspace-rename aria-labelledby="desk-workspace-rename-title">
      <div class="desk-dialog-head">
        <h2 id="desk-workspace-rename-title">{label("RenameWorkspace")}</h2>
        <button type="button" class="desk-win-btn" data-dialog-close aria-label={label("Close")} title={label("Close")}><Icon name="close" size={16} /></button>
      </div>
      <div class="desk-dialog-body">
        <label class="desk-field">
          {label("WorkspaceName")}
          <input class="ds-field" type="text" maxlength="80" data-workspace-rename-name autocomplete="off" />
        </label>
      </div>
      <div class="desk-dialog-actions">
        <button type="button" class="ds-btn" data-dialog-close>{label("Cancel")}</button>
        <button type="button" class="ds-btn ds-btn-primary" data-workspace-rename-save>{label("Apply")}</button>
      </div>
    </dialog>

    <dialog class="desk-dialog desk-dialog-narrow" data-workspace-delete aria-labelledby="desk-workspace-delete-title">
      <div class="desk-dialog-head">
        <h2 id="desk-workspace-delete-title">{label("DeleteWorkspaceTitle")}</h2>
      </div>
      <div class="desk-dialog-body">
        <p data-workspace-delete-body></p>
      </div>
      <div class="desk-dialog-actions">
        <button type="button" class="ds-btn" data-dialog-close>{label("Cancel")}</button>
        <button type="button" class="ds-btn ds-btn-primary" data-workspace-delete-confirm>{label("DeleteWorkspace")}</button>
      </div>
    </dialog>

    <dialog class="desk-dialog desk-dialog-narrow" data-tile-dialog aria-labelledby="desk-tile-title">
      <div class="desk-dialog-head">
        <h2 id="desk-tile-title">{label("TileWith")}</h2>
        <button type="button" class="desk-win-btn" data-dialog-close aria-label={label("Close")} title={label("Close")}><Icon name="close" size={16} /></button>
      </div>
      <div class="desk-dialog-body">
        <div class="desk-tile-list" data-tile-list></div>
        <div class="desk-tile-ratios">
          <button type="button" class="ds-btn" data-ratio="1:1">{label("TileEven")}</button>
          <button type="button" class="ds-btn" data-ratio="2:1">{label("TileLeftWide")}</button>
          <button type="button" class="ds-btn" data-ratio="1:2">{label("TileRightWide")}</button>
        </div>
      </div>
    </dialog>

    <script is:inline type="application/json" id="desk-data" set:html={payloadJson}></script>
    <script>
      import { bootDesktop } from "@/desktop/client";
      import "@/scripts/sw-register.ts";
      bootDesktop();
    </script>
  </body>
</html>
