---
/**
 * `/{lang}/` — localized home (Prism, design spec §1/§9).
 * Registry-driven catalog grouped by category, hero with ambient monograms,
 * client-side search, favorites/recent from a JSON island.
 * Adding a tool to `tools.ts` adds a card here (Stage 4 Gate 4) + search index.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolCard from "@/components/ToolCard.astro";
import Icon from "@/components/Icon.astro";
import { LOCALES, type LocaleCode } from "@/registry/locales";
import { buildCatalog } from "@/registry/catalog";
import { t } from "@/i18n/messages";

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l.code } }));
}

interface Params {
  lang: LocaleCode;
}

const { lang } = Astro.params as Params;
const catalog = buildCatalog(lang);
const heroTitle = t(lang, "home", "Title");
const heroSubtitle = t(lang, "home", "Subtitle");
const heroCta = t(lang, "home", "CTA_Start");
const searchPlaceholder = t(lang, "common", "CommandPalette_SearchPlaceholder");
const siteName = t(lang, "common", "AppName");
const noResults = t(lang, "common", "CommandPalette_NoResults");
const favTitle = t(lang, "common", "CommandPalette_FavoritesTitle");
const recentTitle = t(lang, "common", "CommandPalette_RecentTitle");
const statTools = t(lang, "home", "Stat_Tools");
const statLanguages = t(lang, "home", "Stat_Languages");
const statLocal = t(lang, "home", "Stat_Local");

// Compact index for client-side favorites/recent rendering.
const index = Object.fromEntries(
  catalog.tools.map((tool) => [tool.slug, { title: tool.title, href: tool.href, category: tool.category }]),
);
const indexJson = JSON.stringify(index);
---

<BaseLayout locale={lang} title={siteName} description={heroSubtitle} isHome>
  <div class="ambient" aria-hidden="true">
    <span class="g" style="--x:6%;--y:12%;--d:8s;--s:15px">{"{}"}</span>
    <span class="g" style="--x:88%;--y:9%;--d:10s;--s:13px">0x</span>
    <span class="g" style="--x:14%;--y:78%;--d:9s;--s:17px">▦</span>
    <span class="g" style="--x:79%;--y:70%;--d:11s;--s:14px">⚿</span>
    <span class="g" style="--x:46%;--y:5%;--d:8.5s;--s:12px">%</span>
    <span class="g" style="--x:64%;--y:85%;--d:10.5s;--s:15px">Aa</span>
    <span class="g" style="--x:30%;--y:90%;--d:9.5s;--s:13px">01</span>
    <span class="g" style="--x:93%;--y:45%;--d:12s;--s:16px">#</span>
    <span class="g" style="--x:3%;--y:45%;--d:11s;--s:12px">µ</span>
  </div>

  <main class="home">
    <section class="hero">
      <span class="hero-pill"><span class="dot"></span>{t(lang, "common", "NoDataSent")}</span>
      <h1>{heroTitle}</h1>
      <p class="hero-subtitle">{heroSubtitle}</p>
      <div class="hero-actions">
        <a class="ds-btn ds-btn-primary" href="#catalog">{heroCta}<Icon name="arrow-right" size={14} /></a>
      </div>
      <div class="hero-stats">
        <div class="stat"><b class="tabular">{catalog.tools.length}</b><span>{statTools}</span></div>
        <div class="stat"><b class="tabular">{LOCALES.length}</b><span>{statLanguages}</span></div>
        <div class="stat"><b class="tabular">100%</b><span>{statLocal}</span></div>
      </div>
    </section>

    <div class="your-tools">
      <section data-fav-section hidden>
        <h2 class="yt-heading">{favTitle}</h2>
      </section>
      <section data-recent-section hidden>
        <h2 class="yt-heading">{recentTitle}</h2>
      </section>
    </div>

    <section class="search-bar" aria-label={searchPlaceholder}>
      <Icon name="search" size={16} />
      <input type="search" id="catalog-search" placeholder={searchPlaceholder} autocomplete="off" aria-label={searchPlaceholder} />
      <kbd>/</kbd>
    </section>

    <section id="catalog" class="catalog">
      {catalog.categories.map((cat) => (
        <div class="cat-section" data-cat-section style={`--mdt-cat: var(--mdt-cat-${cat.id})`}>
          <div class="cat-head">
            <span class="cat-icon"><Icon name={cat.id} size={17} /></span>
            <h2 class="cat-heading" data-cat-heading>{cat.label}</h2>
            <span class="cat-count tabular">{cat.tools.length}</span>
          </div>
          <div class="cat-grid">
            {cat.tools.map((tool) => (
              <ToolCard tool={tool} locale={lang} />
            ))}
          </div>
        </div>
      ))}
      <p class="no-results" data-no-results hidden>{noResults}</p>
    </section>
  </main>
  <script is:inline type="application/json" data-catalog-json set:html={indexJson} />


  <script>
    const input = document.getElementById("catalog-search") as HTMLInputElement | null;
    if (input) {
      const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-tool-card]"));
      const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-cat-section]"));
      const noResults = document.querySelector<HTMLElement>("[data-no-results]");
      const filter = () => {
        const q = input.value.trim().toLowerCase();
        let visible = 0;
        for (const card of cards) {
          const hay = (
            (card.querySelector(".card-title")?.textContent ?? "") + " " +
            (card.querySelector(".card-desc")?.textContent ?? "") + " " +
            (card.getAttribute("data-keywords") ?? "")
          ).toLowerCase();
          const match = q === "" || hay.includes(q);
          card.classList.toggle("hidden", !match);
          if (match) visible++;
        }
        for (const section of sections) {
          const hasVisible = section.querySelectorAll("[data-tool-card]:not(.hidden)").length > 0;
          section.classList.toggle("hidden", !hasVisible);
        }
        if (noResults) noResults.hidden = visible !== 0;
      };
      input.addEventListener("input", filter);
      document.addEventListener("keydown", (e) => {
        if (e.key === "/" && document.activeElement !== input) {
          e.preventDefault();
          input.focus();
        }
      });
    }
  </script>
</BaseLayout>

<style>
  /* ---------- ambient monograms (signature, spec §1.4) ---------- */
  .ambient {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .ambient::before {
    content: "";
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(38% 30% at 18% 12%, color-mix(in srgb, var(--mdt-accent) 12%, transparent), transparent 70%),
      radial-gradient(34% 28% at 85% 8%, color-mix(in srgb, var(--mdt-accent-2) 10%, transparent), transparent 70%);
    animation: drift 26s ease-in-out infinite alternate;
  }
  @keyframes drift {
    to { transform: translate3d(3%, -2%, 0) scale(1.06); }
  }
  .ambient .g {
    position: absolute;
    left: var(--x);
    top: var(--y);
    font-family: var(--mdt-font-mono);
    font-weight: 600;
    font-size: var(--s);
    color: var(--mdt-text-faint);
    opacity: 0.5;
    animation: floaty var(--d) ease-in-out infinite alternate;
  }
  @keyframes floaty {
    from { transform: translateY(-8px) rotate(-3deg); }
    to { transform: translateY(10px) rotate(4deg); }
  }

  .home {
    position: relative;
    z-index: 1;
    max-width: var(--mdt-content-max);
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4.5rem) 1.25rem 5rem;
  }

  /* ---------- hero ---------- */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-bottom: 2.5rem;
    animation: rise 0.5s var(--mdt-ease) both;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
  }
  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-micro);
    color: var(--mdt-text-muted);
    border: 1px solid var(--mdt-border);
    background: color-mix(in srgb, var(--mdt-surface-raised) 70%, transparent);
    padding: 6px 13px;
    border-radius: 999px;
  }
  .hero-pill .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mdt-success);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--mdt-success) 55%, transparent);
    animation: pulse 2.2s infinite;
  }
  @keyframes pulse {
    70% { box-shadow: 0 0 0 8px transparent; }
  }
  h1 {
    margin-top: 1.3rem;
    font-weight: 650;
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 22ch;
  }
  .hero-subtitle {
    margin-top: 1.1rem;
    color: var(--mdt-text-muted);
    font-size: 1.05rem;
    max-width: 56ch;
  }
  .hero-actions { margin-top: 1.7rem; }
  .hero-actions .ds-btn svg { transition: transform var(--mdt-dur-micro) var(--mdt-ease); }
  .hero-actions .ds-btn:hover svg { transform: translateX(3px); }
  .hero-stats {
    margin-top: 2.4rem;
    display: flex;
    gap: 2.5rem;
  }
  .stat b {
    font-weight: 650;
    font-size: 1.875rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .stat span {
    display: block;
    margin-top: 5px;
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-micro);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mdt-text-faint);
  }

  /* ---------- favorites / recent ---------- */
  .your-tools { display: grid; gap: 0.75rem; margin-bottom: 1.5rem; }
  .your-tools section:not([hidden]) { display: block; }
  .yt-heading {
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-micro);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mdt-text-faint);
    margin-bottom: 0.5rem;
  }
  :global([data-fav-section] a), :global([data-recent-section] a) {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.85rem;
    margin: 0.2rem 0.35rem 0.2rem 0;
    border: 1px solid var(--mdt-border);
    border-radius: 999px;
    background: var(--mdt-surface-raised);
    color: var(--mdt-text);
    text-decoration: none;
    font-size: var(--mdt-fs-meta);
    transition: border-color var(--mdt-dur-micro);
  }
  :global([data-fav-section] a:hover), :global([data-recent-section] a:hover) {
    border-color: var(--mdt-accent);
  }

  /* ---------- sticky catalog search ---------- */
  .search-bar {
    position: sticky;
    top: calc(var(--mdt-header-h) + 0.5rem);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.95rem;
    margin-bottom: 2rem;
    background: color-mix(in srgb, var(--mdt-surface-raised) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-md);
    color: var(--mdt-text-faint);
    transition: border-color var(--mdt-dur-micro), box-shadow var(--mdt-dur-micro);
  }
  .search-bar:focus-within {
    border-color: color-mix(in srgb, var(--mdt-accent) 55%, var(--mdt-border));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--mdt-accent) 14%, transparent);
  }
  .search-bar input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    color: var(--mdt-text);
    font-size: 0.95rem;
  }
  .search-bar kbd {
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-micro);
    border: 1px solid var(--mdt-border);
    border-radius: 5px;
    padding: 1.5px 7px;
    color: var(--mdt-text-muted);
    background: var(--mdt-surface-inset);
  }

  /* ---------- category sections ---------- */
  #catalog { scroll-margin-top: calc(var(--mdt-header-h) + 4.5rem); }
  .cat-section { margin-bottom: 2.75rem; scroll-margin-top: calc(var(--mdt-header-h) + 4.5rem); }
  .cat-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.1rem;
  }
  .cat-icon {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--mdt-cat) 15%, transparent);
    color: var(--mdt-cat);
    border: 1px solid color-mix(in srgb, var(--mdt-cat) 30%, transparent);
    flex-shrink: 0;
  }
  .cat-heading {
    font-weight: 650;
    font-size: var(--mdt-fs-h3);
    letter-spacing: -0.02em;
  }
  .cat-count {
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-micro);
    color: var(--mdt-text-faint);
    border: 1px solid var(--mdt-border);
    border-radius: 6px;
    padding: 2px 7px;
    background: var(--mdt-surface-inset);
  }
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.875rem;
  }
  .no-results { color: var(--mdt-text-muted); padding: 1rem 0; }
  .hidden { display: none !important; }

  @media (max-width: 1024px) {
    .cat-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .cat-grid { grid-template-columns: 1fr; }
    .hero-stats { gap: 1.6rem; flex-wrap: wrap; }
    .home { padding: 1.75rem 1rem 4rem; }
  }
</style>
