---
/**
 * `/{lang}/` — localized home. Registry-driven catalog grouped by category,
 * client-side search, and favorites/recent sections rendered from a JSON island.
 * Adding a tool to `tools.ts` adds a card here (Stage 4 Gate 4) + search index.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolCard from "@/components/ToolCard.astro";
import { LOCALES, type LocaleCode } from "@/registry/locales";
import { buildCatalog } from "@/registry/catalog";
import { t } from "@/i18n/messages";

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l.code } }));
}

interface Params {
  lang: LocaleCode;
}

const { lang } = Astro.params as Params;
const catalog = buildCatalog(lang);
const heroTitle = t(lang, "home", "Title");
const heroSubtitle = t(lang, "home", "Subtitle");
const heroCta = t(lang, "home", "CTA_Start");
const searchPlaceholder = t(lang, "common", "CommandPalette_SearchPlaceholder");
const siteName = t(lang, "common", "AppName");
const noResults = t(lang, "common", "CommandPalette_NoResults");
const favTitle = t(lang, "common", "CommandPalette_FavoritesTitle");
const recentTitle = t(lang, "common", "CommandPalette_RecentTitle");

// Compact index for client-side favorites/recent rendering.
const index = Object.fromEntries(
  catalog.tools.map((tool) => [tool.slug, { title: tool.title, href: tool.href, category: tool.category }]),
);
const indexJson = JSON.stringify(index);
---

<BaseLayout locale={lang} title={siteName} description={heroSubtitle} isHome>
  <main class="home">
    <section class="hero">
      <span class="privacy-badge">{t(lang, "common", "NoDataSent")}</span>
      <h1>{heroTitle}</h1>
      <p class="hero-subtitle">{heroSubtitle}</p>
      <a class="hero-cta" href="#catalog">{heroCta}</a>
    </section>

    <div class="your-tools">
      <section data-fav-section hidden>
        <h2 class="yt-heading">{favTitle}</h2>
      </section>
      <section data-recent-section hidden>
        <h2 class="yt-heading">{recentTitle}</h2>
      </section>
    </div>

    <section class="search-bar" aria-label={searchPlaceholder}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
      <input type="search" id="catalog-search" placeholder={searchPlaceholder} autocomplete="off" aria-label={searchPlaceholder} />
    </section>

    <section id="catalog" class="catalog">
      {catalog.categories.map((cat) => (
        <div class="cat-section" data-cat-section>
          <h2 class="cat-heading" data-cat-heading>{cat.label}</h2>
          <div class="cat-grid">
            {cat.tools.map((tool) => (
              <ToolCard tool={tool} locale={lang} />
            ))}
          </div>
        </div>
      ))}
      <p class="no-results" data-no-results hidden>{noResults}</p>
    </section>
  </main>
  <script is:inline type="application/json" data-catalog-json set:html={indexJson} />


  <script>
    const input = document.getElementById("catalog-search") as HTMLInputElement | null;
    if (input) {
      const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-tool-card]"));
      const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-cat-section]"));
      const noResults = document.querySelector<HTMLElement>("[data-no-results]");
      const filter = () => {
        const q = input.value.trim().toLowerCase();
        let visible = 0;
        for (const card of cards) {
          const hay = (
            (card.querySelector(".card-title")?.textContent ?? "") + " " +
            (card.querySelector(".card-desc")?.textContent ?? "") + " " +
            (card.getAttribute("data-keywords") ?? "")
          ).toLowerCase();
          const match = q === "" || hay.includes(q);
          card.classList.toggle("hidden", !match);
          if (match) visible++;
        }
        for (const section of sections) {
          const hasVisible = section.querySelectorAll("[data-tool-card]:not(.hidden)").length > 0;
          section.classList.toggle("hidden", !hasVisible);
        }
        if (noResults) noResults.hidden = visible !== 0;
      };
      input.addEventListener("input", filter);
      document.addEventListener("keydown", (e) => {
        if (e.key === "/" && document.activeElement !== input) {
          e.preventDefault();
          input.focus();
        }
      });
    }
  </script>
</BaseLayout>

<style>
  .home {
    max-width: var(--mdt-content-max);
    margin: 0 auto;
    padding: clamp(1.75rem, 5vw, 3.5rem) 1.25rem 2rem;
  }
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: 1.5rem;
  }
  .privacy-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--mdt-surface-muted);
    border: 1px solid var(--mdt-border);
    color: var(--mdt-success);
  }
  h1 {
    font-size: clamp(1.85rem, 4.5vw, 3.1rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    max-width: 20ch;
  }
  .hero-subtitle { color: var(--mdt-text-muted); font-size: 1.05rem; max-width: 56ch; }
  .hero-cta {
    margin-top: 0.4rem;
    padding: 0.7rem 1.3rem;
    border-radius: var(--mdt-radius);
    background: var(--mdt-accent);
    color: var(--mdt-accent-contrast);
    text-decoration: none;
    font-weight: 600;
  }
  .hero-cta:hover { filter: brightness(1.05); }

  .your-tools { display: grid; gap: 0.75rem; margin-bottom: 1.5rem; }
  .your-tools section:not([hidden]) { display: block; }
  .yt-heading { font-size: 0.95rem; color: var(--mdt-text-muted); margin-bottom: 0.4rem; }
  :global([data-fav-section] a), :global([data-recent-section] a) {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.8rem;
    margin: 0.2rem 0.3rem 0.2rem 0;
    border: 1px solid var(--mdt-border);
    border-radius: 999px;
    background: var(--mdt-surface-raised);
    color: var(--mdt-text);
    text-decoration: none;
    font-size: 0.85rem;
  }
  :global([data-fav-section] a:hover), :global([data-recent-section] a:hover) { border-color: var(--mdt-accent); }

  .search-bar {
    position: sticky;
    top: 3.6rem;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem;
    margin-bottom: 1.5rem;
    background: var(--mdt-surface-raised);
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius);
    color: var(--mdt-text-muted);
  }
  .search-bar input { flex: 1; border: none; outline: none; background: transparent; color: var(--mdt-text); font-size: 1rem; }

  .cat-section { margin-bottom: 2.25rem; }
  .cat-heading {
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--mdt-border);
  }
  .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.75rem; }
  .no-results { color: var(--mdt-text-muted); padding: 2rem 0; text-align: center; }
  .hidden { display: none !important; }
</style>
