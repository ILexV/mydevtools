---
/**
 * `/design/` — internal Prism component showcase (Stage 6 dev page).
 *
 * Standalone document: BaseLayout requires locale/SEO props, so this page
 * inlines the same no-flash theme script instead. Not linked anywhere and
 * excluded from the sitemap (sitemap is registry-driven). Strings are
 * hardcoded English — this page is not localized.
 */
import Icon from "@/components/Icon.astro";
import { CATEGORIES } from "@/registry/categories";
import "@/styles/global.css";

const STRESS = [
  { lang: "de", text: "Passwort-Generator für kryptographisch sichere Zufallskennwörter" },
  { lang: "ru", text: "Генератор паролей с криптографически стойкой случайностью" },
  { lang: "ja", text: "オンライン開発者ツール — すべてブラウザで処理" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Prism design system</title>

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (!stored) {
            stored = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.setAttribute("data-theme", stored === "dark" ? "dark" : "light");
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <main class="showcase">
      <p class="note-bar">Internal showcase — not linked, not in sitemap</p>

      <header class="showcase-head">
        <h1 class="display">Prism design system</h1>
        <p class="lede">Every component, every state, both themes. Static — hover and focus are live CSS.</p>
      </header>

      <!-- 1. Buttons -->
      <section class="panel section">
        <h2 class="lbl">Buttons</h2>
        <div class="row">
          <button class="btn" type="button">Default</button>
          <button class="btn btn-primary" type="button">Primary</button>
          <button class="btn btn-small" type="button">Small</button>
          <button class="icon-btn" type="button" aria-label="Favorite">
            <Icon name="star" size={16} />
          </button>
        </div>
        <div class="row">
          <button class="btn" type="button" disabled>Disabled</button>
          <button class="btn btn-primary" type="button" disabled>Disabled primary</button>
          <button class="icon-btn" type="button" disabled aria-label="Favorite (disabled)">
            <Icon name="star" size={16} />
          </button>
          <button class="btn" type="button" aria-disabled="true">
            <span class="spinner" aria-hidden="true"></span>
            Processing…
          </button>
        </div>
      </section>

      <!-- 2. Fields -->
      <section class="panel section">
        <h2 class="lbl">Fields</h2>
        <div class="stack">
          <input class="field" type="text" placeholder="Paste a JWT, URL, or base64 blob…" />
          <input class="field mono" type="text" value="e30.eyJhbGciOiJIUzI1NiJ9.signature" aria-label="Mono field" />
          <textarea class="field-textarea" rows="3" placeholder='{"name": "value"} — multi-line JSON input…'></textarea>
          <select class="field-select" aria-label="Output format">
            <option>Hex (lowercase)</option>
            <option>Base64</option>
            <option>Base64url</option>
          </select>
          <input class="field" type="text" disabled value="Read-only computed digest" aria-label="Disabled field" />
          <div class="field-error-group">
            <input class="field field-invalid" type="text" value="sha-0" aria-invalid="true" aria-label="Field with error" />
            <p class="field-error-msg">Unknown algorithm “sha-0” — pick SHA-1, SHA-256, or SHA-512.</p>
          </div>
        </div>
      </section>

      <!-- 3. Toggles -->
      <section class="panel section">
        <h2 class="lbl">Toggles</h2>
        <div class="row">
          <label class="toggle-row"><input class="switch" type="checkbox" checked /> On</label>
          <label class="toggle-row"><input class="switch" type="checkbox" /> Off</label>
          <label class="toggle-row"><input class="switch" type="checkbox" disabled /> Disabled</label>
        </div>
        <div class="row">
          <label class="toggle-row"><input class="check" type="checkbox" checked /> Remember theme</label>
          <label class="toggle-row"><input class="check" type="checkbox" /> Remember theme</label>
        </div>
        <div class="row" role="radiogroup" aria-label="Case">
          <label class="toggle-row"><input class="radio" type="radio" name="case" checked /> lowercase</label>
          <label class="toggle-row"><input class="radio" type="radio" name="case" /> UPPERCASE</label>
        </div>
      </section>

      <!-- 4. Chips -->
      <section class="panel section">
        <h2 class="lbl">Chips</h2>
        <div class="row">
          <span class="chip">sha-256</span>
          <span class="chip">base64</span>
          <span class="chip">client-side</span>
          <div class="row" style="--mdt-cat: var(--mdt-cat-hashing)">
            <span class="chip chip-cat">hashing</span>
            <span class="chip chip-cat">hmac</span>
          </div>
        </div>
      </section>

      <!-- 5. Category tiles -->
      <section class="panel section">
        <h2 class="lbl">Category tiles</h2>
        <div class="tile-grid">
          {CATEGORIES.map((c) => (
            <div class="tile-cell" style={`--mdt-cat: var(--mdt-cat-${c.id})`}>
              <span class="tile"><Icon name={c.id} size={20} /></span>
              <span class="lbl">{c.id}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 6. Feedback -->
      <section class="panel section">
        <h2 class="lbl">Feedback</h2>
        <div class="stack">
          <div class="alert alert-info" role="status">Everything runs in your browser — nothing is uploaded.</div>
          <div class="alert alert-success" role="status">Hash computed in 12 ms — copied to clipboard.</div>
          <div class="alert alert-warning" role="status">Input is 2 048 characters — regex may be slow on this pattern.</div>
          <div class="alert alert-error" role="alert">14.6 MB — exceeds 10 MB per-file limit for WebP.</div>
          <div><span class="privacy-pill"><Icon name="lock" size={12} /> 100% client-side · no uploads</span></div>
          <div class="progress-row">
            <div class="progress" role="progressbar" aria-valuenow={62} aria-valuemin={0} aria-valuemax={100} aria-label="Converting images"><i style="width: 62%"></i></div>
            <span class="chip">62%</span>
          </div>
          <div class="row">
            <span class="spinner" role="status" aria-label="Loading"></span>
            <span class="lbl">spinner</span>
          </div>
          <div class="stack">
            <div class="skeleton" style="width: 100%; height: 0.875rem"></div>
            <div class="skeleton" style="width: 60%; height: 0.875rem"></div>
          </div>
          <div>
            <div class="toast" style="position: static; transform: none; animation: none">
              <Icon name="check" size={16} /> Copied to clipboard
            </div>
          </div>
          <div class="row">
            <button class="btn" type="button" data-tip="Copy to clipboard">
              <Icon name="copy" size={16} /> Hover for tooltip
            </button>
          </div>
        </div>
      </section>

      <!-- 7. Segmented control -->
      <section class="panel section">
        <h2 class="lbl">Segmented control</h2>
        <div class="seg" role="group" aria-label="Indentation">
          <button type="button">2 spaces</button>
          <button type="button" class="on" aria-pressed="true">4 spaces</button>
          <button type="button">Tabs</button>
        </div>
      </section>

      <!-- 8. Dialog -->
      <section class="panel section">
        <h2 class="lbl">Dialog</h2>
        <div class="dialog demo-dialog" role="dialog" aria-label="Clear recent tools">
          <h3 class="h3">Clear recent tools?</h3>
          <p class="body-muted">This removes the local history of tools you opened. Favorites are kept.</p>
          <div class="row dialog-actions">
            <button class="btn" type="button">Cancel</button>
            <button class="btn btn-primary" type="button">Clear history</button>
          </div>
        </div>
      </section>

      <!-- 9. Typography -->
      <section class="panel section">
        <h2 class="lbl">Typography</h2>
        <div class="stack type-stack">
          <p class="display">Every developer tool, zero uploads</p>
          <h2 class="h2">Hash calculator</h2>
          <h3 class="h3">SHA-256 digest</h3>
          <p>Body — Inter renders UI prose at a comfortable reading size, with muted supporting copy kept one step down the scale.</p>
          <p class="mono hash-line">d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592</p>
          <p><span class="lbl">micro label</span></p>
          <p>Press <kbd class="kbd">Ctrl</kbd> + <kbd class="kbd">K</kbd> to search, <kbd class="kbd">Esc</kbd> to close.</p>
          <p class="tabular">Processed 1 024.50 KB in 0.42 s</p>
        </div>
      </section>

      <!-- 10. Long-string stress (Gate 6) -->
      <section class="panel section">
        <h2 class="lbl">Long strings — DE / RU / CJK</h2>
        {STRESS.map((s) => (
          <div class="stress-block">
            <p class="lbl">{s.lang} — button / chip / card title</p>
            <div class="row">
              <button class="btn stress-wrap" type="button">{s.text}</button>
              <span class="chip stress-ellipsis">{s.text}</span>
            </div>
            <div class="stress-card">
              <h3 class="h3 stress-wrap">{s.text}</h3>
            </div>
          </div>
        ))}
      </section>
    </main>

    <!-- Floating theme toggle -->
    <div class="theme-fab">
      <button class="icon-btn" type="button" data-set-theme="light" aria-label="Light theme" title="Light theme">
        <Icon name="sun" size={16} />
      </button>
      <button class="icon-btn" type="button" data-set-theme="dark" aria-label="Dark theme" title="Dark theme">
        <Icon name="moon" size={16} />
      </button>
    </div>

    <script>
      document.querySelectorAll("[data-set-theme]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const theme = btn.getAttribute("data-set-theme");
          if (theme !== "light" && theme !== "dark") return;
          document.documentElement.setAttribute("data-theme", theme);
          try {
            localStorage.setItem("theme", theme);
          } catch (e) {}
        });
      });
    </script>
  </body>
</html>

<style>
  .showcase {
    max-width: var(--mdt-content-max);
    margin: 0 auto;
    padding: 2rem 1.25rem 5rem;
    background: var(--mdt-surface);
    display: grid;
    gap: 1rem;
  }

  .note-bar {
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    color: var(--mdt-warning);
    border: 1px dashed color-mix(in srgb, var(--mdt-warning) 40%, transparent);
    border-radius: var(--mdt-radius-xs);
    padding: 6px 12px;
  }

  .showcase-head {
    display: grid;
    gap: 0.375rem;
  }

  .lede {
    color: var(--mdt-text-muted);
    max-width: 60ch;
  }

  .section {
    padding: 1.25rem;
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .stack {
    display: grid;
    gap: 0.75rem;
    max-width: 34rem;
  }

  .toggle-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .tile-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .tile-cell {
    display: grid;
    gap: 0.375rem;
    justify-items: center;
  }

  .progress-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .progress-row .progress {
    flex: 1;
  }

  .field-error-group {
    display: grid;
    gap: 0.375rem;
  }

  .field-invalid {
    border-color: color-mix(in srgb, var(--mdt-danger) 60%, var(--mdt-border));
  }

  .field-error-msg {
    color: var(--mdt-danger);
    font-size: var(--mdt-fs-meta);
  }

  .demo-dialog {
    max-width: 24rem;
    display: grid;
    gap: 0.75rem;
  }

  .dialog-actions {
    justify-content: flex-end;
  }

  .body-muted {
    color: var(--mdt-text-muted);
  }

  .display {
    font-size: clamp(2.25rem, 5vw + 1rem, 4rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .h2 {
    font-size: var(--mdt-fs-h2);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .h3 {
    font-size: var(--mdt-fs-h3);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .type-stack {
    max-width: 62ch;
  }

  .hash-line {
    font-size: var(--mdt-fs-meta);
    color: var(--mdt-text-muted);
    overflow-wrap: anywhere;
  }

  .stress-block {
    display: grid;
    gap: 0.625rem;
  }

  .stress-wrap {
    overflow-wrap: anywhere;
  }

  .btn.stress-wrap {
    white-space: normal;
    max-width: 20rem;
    text-align: left;
  }

  .stress-ellipsis {
    max-width: 14rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .stress-card {
    max-width: 16rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-md);
    background: var(--mdt-surface-inset);
  }

  .theme-fab {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    display: flex;
    gap: 0.5rem;
    z-index: 50;
  }
</style>
