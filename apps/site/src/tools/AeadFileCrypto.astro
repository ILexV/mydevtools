---
/**
 * AEAD File Encrypt/Decrypt (cryptography WASM domain). Two panels (encrypt
 * with algorithm + shared password, decrypt) plus a full-width output section
 * (progress + cancel, header hex, result, download). Streaming chunked WASM
 * ops via aead-file-client (legacy parity).
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import FileButton from "@/components/tool/FileButton.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import Progress from "@/components/tool/Progress.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/aead-file";
const s = {
  encryptSectionTitle: t(lang, ns, "EncryptSectionTitle"),
  decryptSectionTitle: t(lang, ns, "DecryptSectionTitle"),
  fileLabel: t(lang, ns, "FileLabel"),
  fileHint: t(lang, ns, "FileHint"),
  algorithmLabel: t(lang, ns, "AlgorithmLabel"),
  passwordLabel: t(lang, ns, "PasswordLabel"),
  encryptButton: t(lang, ns, "EncryptButton"),
  decryptButton: t(lang, ns, "DecryptButton"),
  headerLabel: t(lang, ns, "HeaderLabel"),
  outputLabel: t(lang, ns, "OutputLabel"),
  resultLabel: t(lang, ns, "ResultLabel"),
  download: t(lang, ns, "Download"),
  fileProgressTitle: t(lang, ns, "FileProgressTitle"),
  cancel: t(lang, ns, "Cancel"),
  sharedPasswordNote: t(lang, ns, "SharedPasswordNote"),
  errorSelectFileToEncrypt: t(lang, ns, "ErrorSelectFileToEncrypt"),
  errorSelectFileToDecrypt: t(lang, ns, "ErrorSelectFileToDecrypt"),
  errorPasswordRequired: t(lang, ns, "ErrorPasswordRequired"),
  errorOperationCanceled: t(lang, ns, "ErrorOperationCanceled"),
  errorDecryptFailed: t(lang, ns, "ErrorDecryptFailed"),
  errorInvalidContainer: t(lang, ns, "ErrorInvalidContainer"),
  showPassword: t(lang, ns, "ShowPassword"),
  fileChoose: t(lang, "common", "Common_FileChooseButton"),
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-stack" data-aead-tool>
  <div class="ds-tool-grid">
    <section class="ds-card ds-stack" aria-labelledby="aead-enc-title">
      <h2 class="ds-card-title" id="aead-enc-title">{s.encryptSectionTitle}</h2>

      <div class="ds-field-group">
        <span class="ds-label" id="aead-enc-file-label">{s.fileLabel}</span>
        <FileButton
          label={s.fileChoose}
          inputProps={{ "data-aead-enc-file": true, "aria-describedby": "aead-enc-file-label aead-enc-file-hint" }}
          nameProps={{ "data-aead-enc-filename": true }}
        />
        <p class="ds-hint" id="aead-enc-file-hint">{s.fileHint}</p>
      </div>

      <Field label={s.algorithmLabel} for="aead-algorithm">
        <select id="aead-algorithm" class="ds-field-select" data-aead-algorithm>
          <option value="aes-256-gcm">AES-256-GCM (Standard)</option>
          <option value="chacha20-poly1305">ChaCha20-Poly1305 (Fast)</option>
          <option value="xchacha20-poly1305">XChaCha20-Poly1305 (Extended Nonce)</option>
        </select>
      </Field>

      <Field label={s.passwordLabel} for="aead-password">
        <div class="ds-input-group">
          <input
            id="aead-password"
            type="password"
            class="ds-field"
            data-aead-password
            autocomplete="new-password"
            spellcheck="false"
            placeholder="••••••••"
          />
          <button
            type="button"
            class="ds-icon-btn"
            data-aead-toggle-password
            aria-pressed="false"
            aria-label={s.showPassword}
            title={s.showPassword}
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="18" height="18" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
          </button>
        </div>
      </Field>

      <button type="button" class="ds-btn ds-btn-primary ds-btn-block" data-aead-encrypt>{s.encryptButton}</button>
    </section>

    <section class="ds-card ds-stack" aria-labelledby="aead-dec-title">
      <h2 class="ds-card-title" id="aead-dec-title">{s.decryptSectionTitle}</h2>

      <div class="ds-field-group">
        <span class="ds-label" id="aead-dec-file-label">{s.fileLabel}</span>
        <FileButton
          label={s.fileChoose}
          accept=".aead,application/octet-stream"
          inputProps={{ "data-aead-dec-file": true, "aria-describedby": "aead-dec-file-label" }}
          nameProps={{ "data-aead-dec-filename": true }}
        />
      </div>

      <p class="ds-hint">{s.sharedPasswordNote}</p>

      <button type="button" class="ds-btn ds-btn-primary ds-btn-block" data-aead-decrypt>{s.decryptButton}</button>
    </section>
  </div>

  <section class="ds-card ds-stack" aria-labelledby="aead-out-title">
    <h2 class="ds-card-title" id="aead-out-title">{s.outputLabel}</h2>

    <Progress
      data-aead-progress
      title={s.fileProgressTitle}
      cancelLabel={s.cancel}
      cancelProps={{ "data-aead-cancel": true }}
      barProps={{ "data-aead-progress-bar": true }}
      fillProps={{ "data-aead-progress-fill": true }}
      labelProps={{ "data-aead-progress-stats": true }}
    />

    <Field label={s.headerLabel} for="aead-header">
      <textarea id="aead-header" class="ds-field-textarea mono aead-header" data-aead-header rows="3" readonly spellcheck="false"></textarea>
    </Field>

    <OutputPanel label={s.resultLabel} for="aead-result">
      <div class="ds-input-group">
        <input id="aead-result" type="text" class="ds-field mono" data-aead-result readonly aria-live="polite" />
        <button type="button" class="ds-btn" data-aead-download disabled>{s.download}</button>
      </div>
    </OutputPanel>

    <StatusMessage kind="error" data-aead-error />
  </section>
</div>

<script is:inline type="application/json" data-aead-strings set:html={stringsJson} />
<script>import "@/tools/aead-file.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .aead-header {
    min-height: 4.5rem;
  }
</style>
