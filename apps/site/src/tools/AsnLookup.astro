---
/**
 * ASN lookup. One address is matched against the prefix table in the local agent.
 * This shell supplies the form, the result block and the localized string island.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import AgentConnection from "@/components/tool/AgentConnection.astro";
import Field from "@/components/tool/Field.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props { lang: LocaleCode }
const { lang } = Astro.props as Props;
const ns = "tools/asn-lookup";
const clientKeys = [
  "Connected", "Disconnected", "Connecting", "NotConnected",
  "AgentConnectedShort", "AgentDisconnectedShort", "ConnectionNotSaved", "NeedAsnCapability",
  "InvalidQuery", "Checking", "Check", "Copied", "CopyFailed",
  "StatusFound", "StatusFoundPartial", "StatusReserved", "StatusNotFound",
  "CoversYes", "CoversNo", "EmptyValue",
  "ErrorGeneric", "Error_agent_unavailable", "Error_invalid_response", "Error_invalid_request",
  "Error_unauthorized", "Error_forbidden", "Error_pairing_invalid", "Error_pairing_expired",
  "Error_pairing_rate_limited", "Error_unsupported_capability", "Error_timeout", "Error_busy",
  "Error_network_error", "Error_incompatible_protocol", "Error_not_found", "Error_asn_unavailable",
] as const;
const strings = Object.fromEntries(clientKeys.map((key) => [key, t(lang, ns, key)]));
const stringsJson = JSON.stringify(strings);
---

<div class="asn-lookup" data-asn-lookup>
  <section class="ds-card asn-card" aria-labelledby="asn-query-title">
    <div class="ds-panel-head">
      <h2 id="asn-query-title" class="ds-panel-title">{t(lang, ns, "QueryTitle")}</h2>
      <AgentConnection lang={lang} ns={ns} prefix="asn" connectKey="connect-agent" />
    </div>
    <div class="ds-settings">
      <Field class="ds-settings-wide" label={t(lang, ns, "QueryLabel")} for="asn-lookup-query" hint={t(lang, ns, "QueryHint")}>
        <input id="asn-lookup-query" class="ds-field mono" type="text" autocomplete="off" spellcheck="false" placeholder={t(lang, ns, "QueryPlaceholder")} data-asn-query />
      </Field>
    </div>
    <div class="ds-action-row">
      <button type="button" class="ds-btn ds-btn-primary" data-asn-check disabled>{t(lang, ns, "Check")}</button>
      <button type="button" class="ds-btn" data-asn-stop hidden>{t(lang, ns, "Stop")}</button>
    </div>
    <StatusMessage kind="info" data-asn-result />
    <StatusMessage kind="error" data-asn-error />
  </section>

  <section class="ds-card asn-card" aria-labelledby="asn-answer-title">
    <div class="asn-results-head">
      <h2 id="asn-answer-title" class="ds-panel-title">{t(lang, ns, "AnswerTitle")}</h2>
      <button type="button" class="ds-btn ds-btn-small" data-asn-copy disabled>{t(lang, ns, "CopyText")}</button>
    </div>
    <p class="ds-hint" data-asn-empty>{t(lang, ns, "EmptyResult")}</p>
    <dl class="asn-facts" data-asn-facts hidden>
      <div><dt>{t(lang, ns, "AddressLabel")}</dt><dd class="mono" data-asn-address></dd></div>
      <div><dt>{t(lang, ns, "PrefixLabel")}</dt><dd class="mono" data-asn-prefix></dd></div>
      <div><dt>{t(lang, ns, "AsnLabel")}</dt><dd class="mono" data-asn-asn></dd></div>
      <div><dt>{t(lang, ns, "NameLabel")}</dt><dd class="mono" data-asn-name></dd></div>
      <div><dt>{t(lang, ns, "CoversLabel")}</dt><dd class="mono" data-asn-covers></dd></div>
    </dl>
  </section>
  <script is:inline type="application/json" data-asn-strings set:html={stringsJson} />
</div>

<script>import "@/tools/asn-lookup.client.ts";</script>

<style>
  .asn-lookup { display: flex; flex-direction: column; gap: 1rem; min-width: 0; max-width: 100%; }
  .asn-card { min-width: 0; }
  .asn-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 0.55rem 1rem; margin: 0.85rem 0; }
  .asn-facts div { min-width: 0; }
  .asn-facts dt { color: var(--mdt-text-muted); font-size: 0.78rem; }
  .asn-facts dd { margin: 0; overflow-wrap: anywhere; }
  .asn-results-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.4rem 1rem; }
  .asn-results-head h2 { margin: 0; }
</style>
