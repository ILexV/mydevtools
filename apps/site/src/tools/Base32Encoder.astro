---
/**
 * Base32 Encoder / Decoder tool UI. Static shell on the shared tool UI kit
 * (`ds-*`, docs/qa/tool-ui-kit.md); behavior lives in `base32-encoder.client.ts`,
 * which calls the shared `encoding-client` (one-shot text ops) and
 * `encoding-file-client` (worker-backed file ops with progress + cancel).
 *
 * Locale strings for the tool namespace are embedded as a JSON island so the
 * browser controller gets only its own strings.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import CopyButton from "@/components/tool/CopyButton.astro";
import EmptyState from "@/components/tool/EmptyState.astro";
import Field from "@/components/tool/Field.astro";
import FileDrop from "@/components/tool/FileDrop.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import Progress from "@/components/tool/Progress.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";

interface Props {
  lang: LocaleCode;
}

const { lang } = Astro.props as Props;
const ns = "tools/base32-encoder";

const s = {
  inputTextLabel: t(lang, ns, "InputTextLabel"),
  emptyHint: t(lang, ns, "EmptyHint"),
  outputEmpty: t(lang, ns, "OutputEmpty"),
  loadExample: t(lang, "common", "Common_LoadExample"),
  fileHint: t(lang, ns, "FileHint"),
  charsetLabel: t(lang, ns, "CharsetLabel"),
  alphabetLabel: t(lang, ns, "AlphabetLabel"),
  alphabetRfc4648: t(lang, ns, "AlphabetRfc4648"),
  alphabetCrockford: t(lang, ns, "AlphabetCrockford"),
  alphabetZBase32: t(lang, ns, "AlphabetZBase32"),
  paddingLabel: t(lang, ns, "PaddingLabel"),
  paddingRequired: t(lang, ns, "PaddingRequired"),
  paddingOptional: t(lang, ns, "PaddingOptional"),
  paddingNone: t(lang, ns, "PaddingNone"),
  caseLabel: t(lang, ns, "CaseLabel"),
  caseAuto: t(lang, ns, "CaseAuto"),
  caseUpper: t(lang, ns, "CaseUpper"),
  caseLower: t(lang, ns, "CaseLower"),
  decodeOptionsLabel: t(lang, ns, "DecodeOptionsLabel"),
  allowWhitespace: t(lang, ns, "AllowWhitespace"),
  outputModeLabel: t(lang, ns, "OutputModeLabel"),
  outputModePreview: t(lang, ns, "OutputModePreview"),
  outputModeFull: t(lang, ns, "OutputModeFull"),
  actionEncode: t(lang, ns, "ActionEncode"),
  actionDecode: t(lang, ns, "ActionDecode"),
  actionSwap: t(lang, ns, "ActionSwap"),
  actionClear: t(lang, ns, "ActionClear"),
  outputLabel: t(lang, ns, "OutputLabel"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, "common", "Common_Copied"),
  copyFailed: t(lang, "common", "Common_CopyFailed"),
  preparing: t(lang, "common", "Common_Preparing"),
  download: t(lang, ns, "Download"),
  fileProgressTitle: t(lang, ns, "FileProgressTitle"),
  cancel: t(lang, ns, "Cancel"),
  previewTruncated: t(lang, ns, "PreviewTruncated"),
  fileDecoded: t(lang, ns, "FileDecoded"),
  statsOutput: t(lang, ns, "StatsOutput"),
  errInvalidChar: t(lang, ns, "Error_InvalidChar"),
  errNotRepresentable: t(lang, ns, "Error_NotRepresentable"),
  errInvalidLength: t(lang, ns, "Error_InvalidLength"),
  errWhitespace: t(lang, ns, "Error_Whitespace"),
  errPadding: t(lang, ns, "Error_Padding"),
  errNotText: t(lang, ns, "Error_NotText"),
  errInvalidData: t(lang, ns, "Error_InvalidData"),
  errCopyFailed: t(lang, ns, "Error_CopyFailed"),
  error: t(lang, "common", "Common_Error"),
  clearFile: t(lang, "common", "Common_ClearFile"),
  dropTitle: t(lang, "common", "Common_FileDropTitle"),
  chooseFile: t(lang, "common", "Common_FileChooseButton"),
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-workbench" data-b32-tool>
  <ToolPanel title={s.inputTextLabel} for="b32-input-text">
    <Fragment slot="actions">
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-b32-clear>{s.actionClear}</button>
    </Fragment>
    <div class="ds-editor is-empty" data-b32-input-host>
      <textarea
        id="b32-input-text"
        class="ds-field-textarea mono enc-input"
        data-b32-input
        rows="8"
        spellcheck="false"
        aria-describedby="b32-input-empty"
      ></textarea>
      <EmptyState
        hint={s.emptyHint}
        hintId="b32-input-empty"
        exampleLabel={s.loadExample}
        buttonProps={{ "data-b32-example": true }}
      />
    </div>

    <FileDrop
      compact
      data-b32-drop
      title={s.dropTitle}
      sub={s.fileHint}
      buttonLabel={s.chooseFile}
      inputProps={{ "data-b32-file": true }}
    >
      <div class="ds-file-row">
        <span class="ds-file-name" data-b32-filename aria-live="polite"></span>
        <button type="button" class="ds-btn-link" data-b32-file-clear hidden>{s.clearFile}</button>
      </div>
    </FileDrop>

    <div class="ds-settings">
      <Field label={s.charsetLabel} for="b32-charset">
        <select id="b32-charset" class="ds-field-select" data-b32-charset>
          <option value="utf-8">UTF-8</option>
          <option value="utf-16le">UTF-16LE</option>
          <option value="utf-16be">UTF-16BE</option>
          <option value="ascii">ASCII</option>
          <option value="latin1">ISO-8859-1 (Latin-1)</option>
        </select>
      </Field>
      <Field label={s.alphabetLabel} for="b32-alphabet">
        <select id="b32-alphabet" class="ds-field-select" data-b32-alphabet>
          <option value="rfc4648">{s.alphabetRfc4648}</option>
          <option value="crockford">{s.alphabetCrockford}</option>
          <option value="zbase32">{s.alphabetZBase32}</option>
        </select>
      </Field>
      <Field label={s.paddingLabel} for="b32-padding">
        <select id="b32-padding" class="ds-field-select" data-b32-padding>
          <option value="required">{s.paddingRequired}</option>
          <option value="optional">{s.paddingOptional}</option>
          <option value="none">{s.paddingNone}</option>
        </select>
      </Field>
      <Field label={s.caseLabel} for="b32-case">
        <select id="b32-case" class="ds-field-select" data-b32-case>
          <option value="auto">{s.caseAuto}</option>
          <option value="upper">{s.caseUpper}</option>
          <option value="lower">{s.caseLower}</option>
        </select>
      </Field>
      <Field class="ds-settings-wide" label={s.outputModeLabel} for="b32-output-mode">
        <select id="b32-output-mode" class="ds-field-select" data-b32-output-mode>
          <option value="preview">{s.outputModePreview}</option>
          <option value="full">{s.outputModeFull}</option>
        </select>
      </Field>
      <fieldset class="ds-check-group ds-settings-wide">
        <legend class="ds-label">{s.decodeOptionsLabel}</legend>
        <label class="ds-check-row">
          <input type="checkbox" class="ds-check" data-b32-allow-whitespace checked />
          <span>{s.allowWhitespace}</span>
        </label>
      </fieldset>
    </div>

    <div class="ds-action-row">
      <button type="button" class="ds-btn ds-btn-primary" data-b32-encode>{s.actionEncode}</button>
      <button type="button" class="ds-btn" data-b32-decode>{s.actionDecode}</button>
      <button type="button" class="ds-btn" data-b32-swap>{s.actionSwap}</button>
    </div>

    <Progress
      data-b32-progress
      title={s.fileProgressTitle}
      cancelLabel={s.cancel}
      cancelProps={{ "data-b32-cancel": true }}
      barProps={{ "data-b32-progress-bar": true }}
      fillProps={{ "data-b32-progress-fill": true }}
      labelProps={{ "data-b32-progress-label": true }}
    />
    <StatusMessage kind="error" data-b32-error />
  </ToolPanel>

  <OutputPanel panel label={s.outputLabel} for="b32-output" emptyHint={s.outputEmpty} data-b32-output-panel>
    <Fragment slot="actions">
      <CopyButton ghost label={s.copy} copiedLabel={s.copied} failedLabel={s.copyFailed} data-b32-copy disabled />
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-b32-download disabled>{s.download}</button>
    </Fragment>
    <textarea
      id="b32-output"
      class="ds-field-textarea mono enc-output ds-when-filled"
      data-b32-output
      rows="16"
      spellcheck="false"
      readonly
    ></textarea>
    <p class="ds-hint ds-when-filled" data-b32-stats aria-live="polite"></p>
  </OutputPanel>
</div>

<script is:inline type="application/json" data-b32-strings set:html={stringsJson} />
<script>
  import "@/tools/base32-encoder.client.ts";
</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .enc-output {
    word-break: break-all;
  }
</style>
