---
/**
 * Base58 Encoder / Decoder tool UI.
 * Static shell; behavior lives in `base58-encoder.client.ts`, which uses the
 * main-thread `encoding-client` for text and the worker-backed
 * `encoding-file-client` for files (progress + cancel, no UI blocking).
 *
 * Locale strings for the tool namespace are embedded as a JSON island.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";

interface Props {
  lang: LocaleCode;
}

const { lang } = Astro.props as Props;
const ns = "tools/base58-encoder";

const s = {
  inputTextLabel: t(lang, ns, "InputTextLabel"),
  inputTextPlaceholder: t(lang, ns, "InputTextPlaceholder"),
  inputFileLabel: t(lang, ns, "InputFileLabel"),
  fileHint: t(lang, ns, "FileHint"),
  charsetLabel: t(lang, ns, "CharsetLabel"),
  alphabetLabel: t(lang, ns, "AlphabetLabel"),
  alphabetBitcoin: t(lang, ns, "AlphabetBitcoin"),
  alphabetFlickr: t(lang, ns, "AlphabetFlickr"),
  alphabetRipple: t(lang, ns, "AlphabetRipple"),
  decodeOptionsLabel: t(lang, ns, "DecodeOptionsLabel"),
  allowWhitespace: t(lang, ns, "AllowWhitespace"),
  outputModeLabel: t(lang, ns, "OutputModeLabel"),
  outputModePreview: t(lang, ns, "OutputModePreview"),
  outputModeFull: t(lang, ns, "OutputModeFull"),
  actionEncode: t(lang, ns, "ActionEncode"),
  actionDecode: t(lang, ns, "ActionDecode"),
  actionSwap: t(lang, ns, "ActionSwap"),
  actionClear: t(lang, ns, "ActionClear"),
  outputLabel: t(lang, ns, "OutputLabel"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, ns, "Copied"),
  download: t(lang, ns, "Download"),
  fileProgressTitle: t(lang, ns, "FileProgressTitle"),
  cancel: t(lang, ns, "Cancel"),
  fileSizeLimitEncode: t(lang, ns, "FileSizeLimitEncode"),
  fileSizeLimitDecode: t(lang, ns, "FileSizeLimitDecode"),
  fileDecoded: t(lang, ns, "FileDecoded"),
  previewTruncated: t(lang, ns, "PreviewTruncated"),
  errorLabel: t(lang, "common", "Common_Error"),
};
const stringsJson = JSON.stringify(s);
---

<div class="b58-tool" data-b58-tool>
  <div class="b58-grid">
    <section class="b58-panel">
      <label class="field-label" for="b58-input">{s.inputTextLabel}</label>
      <textarea id="b58-input" data-b58-input rows="10" placeholder={s.inputTextPlaceholder}></textarea>

      <div class="file-row">
        <label class="file-btn">
          <input type="file" data-b58-file hidden />
          {s.inputFileLabel}
        </label>
        <span class="file-name" data-b58-filename></span>
        <button type="button" class="link-btn" data-b58-file-clear hidden>{s.actionClear}</button>
      </div>
      <p class="file-hint">{s.fileHint}</p>

      <div class="settings-grid">
        <div class="setting">
          <label class="field-label" for="b58-charset">{s.charsetLabel}</label>
          <select id="b58-charset" data-b58-charset>
            <option value="utf-8">UTF-8</option>
            <option value="utf-16le">UTF-16LE</option>
            <option value="utf-16be">UTF-16BE</option>
            <option value="ascii">ASCII</option>
            <option value="latin1">ISO-8859-1 (Latin-1)</option>
          </select>
        </div>
        <div class="setting">
          <label class="field-label" for="b58-alphabet">{s.alphabetLabel}</label>
          <select id="b58-alphabet" data-b58-alphabet>
            <option value="bitcoin">{s.alphabetBitcoin}</option>
            <option value="flickr">{s.alphabetFlickr}</option>
            <option value="ripple">{s.alphabetRipple}</option>
          </select>
        </div>
        <div class="setting">
          <label class="field-label" for="b58-output-mode">{s.outputModeLabel}</label>
          <select id="b58-output-mode" data-b58-output-mode>
            <option value="preview">{s.outputModePreview}</option>
            <option value="full">{s.outputModeFull}</option>
          </select>
        </div>
        <div class="setting">
          <span class="field-label">{s.decodeOptionsLabel}</span>
          <label class="check-row">
            <input type="checkbox" data-b58-allow-whitespace checked />
            <span>{s.allowWhitespace}</span>
          </label>
        </div>
      </div>

      <div class="b58-actions">
        <button type="button" class="primary-btn" data-b58-encode>{s.actionEncode}</button>
        <button type="button" class="ghost-btn" data-b58-decode>{s.actionDecode}</button>
        <button type="button" class="ghost-btn" data-b58-swap>{s.actionSwap}</button>
        <button type="button" class="ghost-btn" data-b58-clear>{s.actionClear}</button>
        <button type="button" class="ghost-btn" data-b58-cancel hidden>{s.cancel}</button>
      </div>

      <p class="b58-error" data-b58-error role="alert" hidden></p>
    </section>

    <section class="b58-panel">
      <label class="field-label" for="b58-output">{s.outputLabel}</label>
      <div class="b58-progress" data-b58-progress hidden>
        <div class="progress-track"><div class="progress-fill" data-b58-progress-fill></div></div>
        <span class="progress-label" data-b58-progress-label></span>
      </div>
      <textarea id="b58-output" data-b58-output rows="18" readonly></textarea>
      <div class="output-actions">
        <button type="button" class="ghost-btn" data-b58-copy>{s.copy}</button>
        <button type="button" class="ghost-btn" data-b58-download>{s.download}</button>
      </div>
    </section>
  </div>
</div>

<script is:inline type="application/json" data-b58-strings set:html={stringsJson} />
<script>
  import "@/tools/base58-encoder.client.ts";
</script>

<style>
  .b58-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .b58-grid { grid-template-columns: 1fr 1fr; }
  }
  .b58-panel { min-width: 0; }

  .field-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--mdt-text-muted);
    margin-bottom: 0.4rem;
  }
  textarea {
    width: 100%;
    resize: vertical;
    padding: 0.7rem;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius);
    background: var(--mdt-surface-raised);
    color: var(--mdt-text);
    font-family: var(--mdt-font-mono);
    font-size: 0.9rem;
  }
  textarea:focus { outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px; }
  textarea[readonly] { word-break: break-all; }

  .file-row { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.75rem; flex-wrap: wrap; }
  .file-btn {
    display: inline-flex;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-sm);
    cursor: pointer;
    font-size: 0.88rem;
  }
  .file-btn:hover { border-color: var(--mdt-accent); }
  .file-name { font-size: 0.85rem; color: var(--mdt-text-muted); font-family: var(--mdt-font-mono); }
  .file-hint { font-size: 0.8rem; color: var(--mdt-text-muted); margin-top: 0.4rem; }

  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.9rem;
    margin-top: 1.1rem;
  }
  .setting select {
    width: 100%;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface-raised);
    color: var(--mdt-text);
    font-size: 0.88rem;
  }
  .check-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.88rem;
    cursor: pointer;
    padding: 0.45rem 0;
  }
  .check-row input { accent-color: var(--mdt-accent); }

  .b58-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .primary-btn, .ghost-btn {
    padding: 0.65rem 1.2rem;
    border-radius: var(--mdt-radius);
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;
  }
  .primary-btn { background: var(--mdt-accent); color: var(--mdt-accent-contrast); }
  .primary-btn:hover { filter: brightness(1.05); }
  .primary-btn:disabled, .ghost-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .ghost-btn { background: var(--mdt-surface-raised); border-color: var(--mdt-border); color: var(--mdt-text); }
  .ghost-btn:hover { border-color: var(--mdt-accent); }
  .link-btn { background: none; border: none; color: var(--mdt-accent); cursor: pointer; font-size: 0.82rem; padding: 0; }

  .b58-error {
    margin-top: 1rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--mdt-danger);
    border-radius: var(--mdt-radius-sm);
    color: var(--mdt-danger);
    background: color-mix(in srgb, var(--mdt-danger) 8%, transparent);
    font-size: 0.88rem;
  }

  .b58-progress { margin-bottom: 0.75rem; }
  .progress-track { height: 0.5rem; background: var(--mdt-surface-muted); border-radius: 999px; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--mdt-accent); width: 0%; transition: width 0.12s linear; }
  .progress-label { display: block; font-size: 0.8rem; color: var(--mdt-text-muted); margin-top: 0.35rem; font-family: var(--mdt-font-mono); }

  .output-actions { display: flex; gap: 0.6rem; justify-content: flex-end; margin-top: 0.75rem; }
</style>
