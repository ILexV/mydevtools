---
/**
 * Base64 Encoder/Decoder (encoding WASM domain) on the shared tool UI kit
 * (`ds-*`, docs/qa/tool-ui-kit.md). Text + file (drag & drop), encode/decode,
 * settings (charset/alphabet/padding/line-wrap/output mode), decode option
 * (allow-whitespace), swap/clear/copy/download. File ops via the encoding
 * worker (progress + cancel). Decode detects images (preview) and binaries
 * (info + download) per legacy parity. Behavior: `base64-encoder.client.ts`.
 *
 * Locale strings for the tool namespace are embedded as a JSON island so the
 * browser controller gets only its own strings.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import CopyButton from "@/components/tool/CopyButton.astro";
import EmptyState from "@/components/tool/EmptyState.astro";
import Field from "@/components/tool/Field.astro";
import FileDrop from "@/components/tool/FileDrop.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import Progress from "@/components/tool/Progress.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";

interface Props {
  lang: LocaleCode;
}

const { lang } = Astro.props as Props;
const ns = "tools/base64-encoder";

const s = {
  inputTextLabel: t(lang, ns, "InputTextLabel"),
  emptyHint: t(lang, ns, "EmptyHint"),
  outputEmpty: t(lang, ns, "OutputEmpty"),
  loadExample: t(lang, "common", "Common_LoadExample"),
  fileHint: t(lang, ns, "FileHint"),
  charsetLabel: t(lang, ns, "CharsetLabel"),
  alphabetLabel: t(lang, ns, "AlphabetLabel"),
  alphabetStandard: t(lang, ns, "AlphabetStandard"),
  alphabetUrlSafe: t(lang, ns, "AlphabetUrlSafe"),
  paddingLabel: t(lang, ns, "PaddingLabel"),
  paddingRequired: t(lang, ns, "PaddingRequired"),
  paddingOptional: t(lang, ns, "PaddingOptional"),
  paddingNone: t(lang, ns, "PaddingNone"),
  lineWrapLabel: t(lang, ns, "LineWrapLabel"),
  lineWrapNone: t(lang, ns, "LineWrapNone"),
  lineWrap76: t(lang, ns, "LineWrap76"),
  decodeOptionsLabel: t(lang, ns, "DecodeOptionsLabel"),
  allowWhitespace: t(lang, ns, "AllowWhitespace"),
  imageDetected: t(lang, ns, "ImageDetected"),
  binaryDetected: t(lang, ns, "BinaryDetected"),
  binaryDownloadHint: t(lang, ns, "BinaryDownloadHint"),
  statsOutput: t(lang, ns, "StatsOutput"),
  statsImage: t(lang, ns, "StatsImage"),
  outputModeLabel: t(lang, ns, "OutputModeLabel"),
  outputModePreview: t(lang, ns, "OutputModePreview"),
  outputModeFull: t(lang, ns, "OutputModeFull"),
  actionEncode: t(lang, ns, "ActionEncode"),
  actionDecode: t(lang, ns, "ActionDecode"),
  actionSwap: t(lang, ns, "ActionSwap"),
  actionClear: t(lang, ns, "ActionClear"),
  outputLabel: t(lang, ns, "OutputLabel"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, "common", "Common_Copied"),
  copyFailed: t(lang, "common", "Common_CopyFailed"),
  preparing: t(lang, "common", "Common_Preparing"),
  download: t(lang, ns, "Download"),
  fileProgressTitle: t(lang, ns, "FileProgressTitle"),
  cancel: t(lang, ns, "Cancel"),
  previewTruncated: t(lang, ns, "PreviewTruncated"),
  fileDecoded: t(lang, ns, "FileDecoded"),
  errInvalidChar: t(lang, ns, "Error_InvalidChar"),
  errNotRepresentable: t(lang, ns, "Error_NotRepresentable"),
  errInvalidLength: t(lang, ns, "Error_InvalidLength"),
  errWhitespace: t(lang, ns, "Error_Whitespace"),
  errPadding: t(lang, ns, "Error_Padding"),
  errNotText: t(lang, ns, "Error_NotText"),
  errInvalidData: t(lang, ns, "Error_InvalidData"),
  errCopyFailed: t(lang, ns, "Error_CopyFailed"),
  error: t(lang, "common", "Common_Error"),
  clearFile: t(lang, "common", "Common_ClearFile"),
  dropTitle: t(lang, "common", "Common_FileDropTitle"),
  chooseFile: t(lang, "common", "Common_FileChooseButton"),
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-workbench" data-b64-tool>
  <ToolPanel title={s.inputTextLabel} for="b64-input-text">
    <Fragment slot="actions">
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-b64-clear>{s.actionClear}</button>
    </Fragment>
    <div class="ds-editor is-empty" data-b64-input-host>
      <textarea
        id="b64-input-text"
        class="ds-field-textarea mono enc-input"
        data-b64-input
        rows="8"
        spellcheck="false"
        aria-describedby="b64-input-empty"
      ></textarea>
      <EmptyState
        hint={s.emptyHint}
        hintId="b64-input-empty"
        exampleLabel={s.loadExample}
        buttonProps={{ "data-b64-example": true }}
      />
    </div>

    <FileDrop
      compact
      data-b64-drop
      title={s.dropTitle}
      sub={s.fileHint}
      buttonLabel={s.chooseFile}
      inputProps={{ "data-b64-file": true }}
    >
      <div class="ds-file-row">
        <span class="ds-file-name" data-b64-filename aria-live="polite"></span>
        <button type="button" class="ds-btn-link" data-b64-file-clear hidden>{s.clearFile}</button>
      </div>
    </FileDrop>

    <div class="ds-settings">
      <Field label={s.charsetLabel} for="b64-charset">
        <select id="b64-charset" class="ds-field-select" data-b64-charset>
          <option value="utf-8">UTF-8</option>
          <option value="utf-16le">UTF-16LE</option>
          <option value="utf-16be">UTF-16BE</option>
          <option value="ascii">ASCII</option>
          <option value="latin1">ISO-8859-1 (Latin-1)</option>
        </select>
      </Field>
      <Field label={s.alphabetLabel} for="b64-alphabet">
        <select id="b64-alphabet" class="ds-field-select" data-b64-alphabet>
          <option value="standard">{s.alphabetStandard}</option>
          <option value="urlsafe">{s.alphabetUrlSafe}</option>
        </select>
      </Field>
      <Field label={s.paddingLabel} for="b64-padding">
        <select id="b64-padding" class="ds-field-select" data-b64-padding>
          <option value="required">{s.paddingRequired}</option>
          <option value="optional">{s.paddingOptional}</option>
          <option value="none">{s.paddingNone}</option>
        </select>
      </Field>
      <Field label={s.lineWrapLabel} for="b64-linewrap">
        <select id="b64-linewrap" class="ds-field-select" data-b64-linewrap>
          <option value="none">{s.lineWrapNone}</option>
          <option value="76">{s.lineWrap76}</option>
        </select>
      </Field>
      <Field class="ds-settings-wide" label={s.outputModeLabel} for="b64-output-mode">
        <select id="b64-output-mode" class="ds-field-select" data-b64-output-mode>
          <option value="preview">{s.outputModePreview}</option>
          <option value="full">{s.outputModeFull}</option>
        </select>
      </Field>
      <fieldset class="ds-check-group ds-settings-wide">
        <legend class="ds-label">{s.decodeOptionsLabel}</legend>
        <label class="ds-check-row">
          <input type="checkbox" class="ds-check" data-b64-allow-whitespace checked />
          <span>{s.allowWhitespace}</span>
        </label>
      </fieldset>
    </div>

    <div class="ds-action-row">
      <button type="button" class="ds-btn ds-btn-primary" data-b64-encode>{s.actionEncode}</button>
      <button type="button" class="ds-btn" data-b64-decode>{s.actionDecode}</button>
      <button type="button" class="ds-btn" data-b64-swap>{s.actionSwap}</button>
    </div>

    <Progress
      data-b64-progress
      title={s.fileProgressTitle}
      cancelLabel={s.cancel}
      cancelProps={{ "data-b64-cancel": true }}
      barProps={{ "data-b64-progress-bar": true }}
      fillProps={{ "data-b64-progress-fill": true }}
      labelProps={{ "data-b64-progress-label": true }}
    />
    <StatusMessage kind="error" data-b64-error />
  </ToolPanel>

  <OutputPanel panel label={s.outputLabel} for="b64-output" emptyHint={s.outputEmpty} data-b64-output-panel>
    <Fragment slot="actions">
      <CopyButton ghost label={s.copy} copiedLabel={s.copied} failedLabel={s.copyFailed} data-b64-copy disabled />
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-b64-download disabled>{s.download}</button>
    </Fragment>
    <textarea
      id="b64-output"
      class="ds-field-textarea mono enc-output ds-when-filled"
      data-b64-output
      rows="16"
      spellcheck="false"
      readonly
    ></textarea>
    <div class="b64-detect ds-when-filled" data-b64-detect role="status" hidden>
      <p class="b64-detect-label" data-b64-detect-label></p>
      <p class="ds-hint" data-b64-detect-hint></p>
      <img class="b64-detect-img" data-b64-detect-img alt="" hidden />
    </div>
    <p class="ds-hint ds-when-filled" data-b64-stats aria-live="polite"></p>
  </OutputPanel>
</div>

<script is:inline type="application/json" data-b64-strings set:html={stringsJson} />
<script>
  import "@/tools/base64-encoder.client.ts";
</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .enc-output {
    word-break: break-all;
  }
  /* Decoded image / binary info panel (unique to base64). */
  .b64-detect {
    display: grid;
    gap: 0.35rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface-inset);
    font-size: var(--mdt-fs-small);
    overflow-wrap: anywhere;
  }
  .b64-detect-label {
    font-weight: 600;
    color: var(--mdt-text);
  }
  .b64-detect-img {
    max-width: 100%;
    max-height: 16rem;
    justify-self: start;
    border-radius: var(--mdt-radius-sm);
    /* Checkerboard behind transparent images. */
    background: repeating-conic-gradient(var(--mdt-surface-muted) 0 25%, var(--mdt-surface-raised) 0 50%) 0 0 / 16px 16px;
  }
</style>
