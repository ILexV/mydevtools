---
/**
 * Color Converter tool (pure JS). Picker + manual input in any notation
 * (hex / rgb() / hsl() / cmyk(), auto-detected) → HEX/RGB/HSL/CMYK with
 * per-format copy rows, a WCAG contrast checker (fg/bg pair with Swap and
 * "use converted colour" buttons, 16/24 px preview, ratio headline + four
 * AA/AAA Pass/Fail results) and a linear-light tint/shade palette whose
 * swatches copy their HEX.
 * Visuals come from the shared tool UI layer (ds-*, docs/qa/tool-ui-kit.md).
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import CopyButton from "@/components/tool/CopyButton.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/color-converter";
const s = {
  inputTitle: t(lang, ns, "InputTitle"),
  colorPicker: t(lang, ns, "ColorPicker"),
  manualInput: t(lang, ns, "ManualInput"),
  inputHint: t(lang, ns, "InputHint"),
  convert: t(lang, ns, "Convert"),
  clear: t(lang, ns, "Clear"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, "common", "Common_Copied"),
  copyFailed: t(lang, ns, "CopyFailed"),
  invalidColor: t(lang, ns, "Error_InvalidColor"),
  emptyNoColor: t(lang, ns, "Empty_NoColor"),
  convertedFormats: t(lang, ns, "ConvertedFormats"),
  shadesPalette: t(lang, ns, "ShadesPalette"),
  contrastChecker: t(lang, ns, "ContrastChecker"),
  foreground: t(lang, ns, "ForegroundColor"),
  background: t(lang, ns, "BackgroundColor"),
  ratio: t(lang, ns, "ContrastRatio"),
  wcagCompliance: t(lang, ns, "WCAGCompliance"),
  aaNormal: t(lang, ns, "WCAG_AA_Normal"),
  aaLarge: t(lang, ns, "WCAG_AA_Large"),
  aaaNormal: t(lang, ns, "WCAG_AAA_Normal"),
  aaaLarge: t(lang, ns, "WCAG_AAA_Large"),
  pass: t(lang, ns, "Pass"),
  fail: t(lang, ns, "Fail"),
  previewText: t(lang, ns, "PreviewText"),
  swap: t(lang, ns, "Swap"),
  useConverted: t(lang, ns, "UseConverted"),
  useAsForeground: t(lang, ns, "UseAsForeground"),
  useAsBackground: t(lang, ns, "UseAsBackground"),
  pairCaption: t(lang, ns, "PairCaption"),
  largeTextNote: t(lang, ns, "LargeTextNote"),
  alphaNote: t(lang, ns, "AlphaNote"),
  paletteHint: t(lang, ns, "PaletteHint"),
  swatchShade: t(lang, ns, "Swatch_Shade"),
  swatchTint: t(lang, ns, "Swatch_Tint"),
  swatchOriginal: t(lang, ns, "Swatch_Original"),
};
const stringsJson = JSON.stringify(s);
const DEFAULT = "#3b82f6";
---

<div class="ds-stack color-tool" data-color-tool>
  <div class="ds-workbench">
    <ToolPanel title={s.inputTitle}>
      <div class="color-input-row">
        <Field label={s.colorPicker} for="color-picker" class="color-picker-field">
          <input id="color-picker" type="color" class="ds-color-well" data-color-picker value={DEFAULT} />
        </Field>
        <Field label={s.manualInput} for="color-input" class="color-manual-field">
          <input
            id="color-input"
            type="text"
            class="ds-field mono"
            data-color-hex
            value={DEFAULT}
            spellcheck="false"
            autocomplete="off"
            aria-describedby="color-input-hint"
          />
        </Field>
      </div>
      <p class="ds-hint" id="color-input-hint">{s.inputHint}</p>
      <p class="ds-hint color-alpha-note" data-color-alpha-note hidden></p>
      <div class="ds-action-row">
        <button type="button" class="ds-btn ds-btn-primary" data-color-convert>{s.convert}</button>
        <button type="button" class="ds-btn" data-color-clear>{s.clear}</button>
      </div>
      <StatusMessage kind="error" data-color-error />
      <div class="color-preview" data-color-swatch aria-hidden="true"></div>
    </ToolPanel>

    <ToolPanel title={s.convertedFormats}>
      <div class="ds-result-list" data-color-formats></div>
      <p class="ds-empty" data-color-empty hidden>{s.emptyNoColor}</p>
    </ToolPanel>
  </div>

  <ToolPanel title={s.contrastChecker}>
    <div class="contrast-body">
      <div class="contrast-inputs">
        <div class="contrast-wells">
          <div class="contrast-well">
            <Field label={s.foreground} for="color-fg">
              <input id="color-fg" type="color" class="ds-color-well ds-color-well-wide" data-color-fg value="#1e3a8a" />
            </Field>
            <button type="button" class="ds-btn ds-btn-small ds-btn-ghost contrast-use" data-color-use-fg aria-label={s.useAsForeground}>
              <span class="contrast-use-chip" data-color-use-chip aria-hidden="true"></span>{s.useConverted}
            </button>
          </div>
          <div class="contrast-well">
            <Field label={s.background} for="color-bg">
              <input id="color-bg" type="color" class="ds-color-well ds-color-well-wide" data-color-bg value="#ffffff" />
            </Field>
            <button type="button" class="ds-btn ds-btn-small ds-btn-ghost contrast-use" data-color-use-bg aria-label={s.useAsBackground}>
              <span class="contrast-use-chip" data-color-use-chip aria-hidden="true"></span>{s.useConverted}
            </button>
          </div>
        </div>
        <div class="contrast-pair-row">
          <button type="button" class="ds-btn ds-btn-small" data-color-swap>
            <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h11l-3-3M16 13H5l3 3" /></svg>
            {s.swap}
          </button>
          <span class="contrast-pair mono" data-color-pair aria-live="polite"></span>
        </div>
        <!-- Pure sample of the tested pair: no status labels inside. -->
        <div class="color-preview-text" data-color-preview>
          <p class="color-preview-line color-preview-normal"><span>{s.previewText}</span><span class="color-preview-size">16 px</span></p>
          <p class="color-preview-line color-preview-large"><span>{s.previewText}</span><span class="color-preview-size">24 px</span></p>
        </div>
        <p class="ds-hint">{s.largeTextNote}</p>
      </div>
      <div class="ds-result-headline contrast-headline">
        <span class="ds-result-headline-label" id="color-ratio-label">{s.ratio}</span>
        <output class="ds-result-headline-value" data-color-ratio aria-labelledby="color-ratio-label" aria-live="polite">—</output>
        <CopyButton
          iconOnly
          label={`${s.copy} ${s.ratio}`}
          copiedLabel={s.copied}
          data-color-ratio-copy
        />
        <ul class="ds-result-headline-meta wcag-grid" data-color-wcag aria-label={s.wcagCompliance}></ul>
      </div>
    </div>
  </ToolPanel>

  <ToolPanel title={s.shadesPalette}>
    <p class="ds-hint palette-hint" data-color-palette-hint>{s.paletteHint}</p>
    <div class="shade-strip" data-color-shades></div>
    <p class="ds-empty" data-color-empty hidden>{s.emptyNoColor}</p>
  </ToolPanel>
</div>

<script is:inline type="application/json" data-color-strings set:html={stringsJson} />
<script>import "@/tools/color-converter.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .color-input-row { display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end; }
  .color-input-row > :global(.color-manual-field) { flex: 1 1 12rem; min-width: 0; }
  .color-input-row ~ :global(.ds-hint) { margin-top: -0.5rem; }

  .color-preview {
    height: 3.5rem;
    border-radius: var(--mdt-radius-sm);
    border: 1px solid var(--mdt-border);
  }

  /* Contrast: inputs + live sample left, headline ratio right (stacked < 720px). */
  .contrast-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 720px) {
    .contrast-body { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
  }
  .contrast-wells {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1rem;
  }
  .contrast-well { display: grid; gap: 0.4rem; justify-items: start; min-width: 0; }
  .contrast-well > :global(.ds-field-group) { width: 100%; }
  .contrast-use { white-space: normal; text-align: start; gap: 0.45rem; }
  .contrast-use-chip {
    flex-shrink: 0;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 3px;
    border: 1px solid var(--mdt-border);
  }
  .contrast-pair-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; }
  .contrast-pair-row .ds-btn { gap: 0.4rem; }
  .contrast-pair { font-size: var(--mdt-fs-label); color: var(--mdt-text-muted); overflow-wrap: anywhere; }
  .contrast-inputs { display: grid; gap: 0.85rem; min-width: 0; }
  .contrast-inputs > .ds-hint { margin: -0.35rem 0 0; }
  /* Preview: regular weight at 16 and 24 CSS px, the sizes the AA/AAA rows refer to. */
  .color-preview-text {
    display: grid;
    gap: 0.35rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-sm);
    overflow-wrap: anywhere;
  }
  .color-preview-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
    font-weight: 400;
    line-height: 1.3;
  }
  .color-preview-normal { font-size: 16px; }
  .color-preview-large { font-size: 24px; }
  .color-preview-size { flex-shrink: 0; font-family: var(--mdt-font-mono); font-size: 12px; }
  .contrast-headline {
    padding: 0.9rem 1rem;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface-inset);
  }
  /* AA/AAA outcomes: quiet labelled 2×2 grid (controller builds the items). */
  .wcag-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem 1rem;
    padding: 0.6rem 0 0;
    margin: 0.4rem 0 0;
    border-top: 1px solid var(--mdt-border);
    list-style: none;
  }
  /* Wide: column 1 = normal text (AA, AAA), column 2 = large text (AA, AAA). */
  @media (min-width: 1000px) {
    .wcag-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, auto); grid-auto-flow: column; }
  }
  .wcag-grid :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    min-width: 0;
  }
  .wcag-grid :global(.wcag-level) { min-width: 0; overflow-wrap: anywhere; }
  .wcag-grid :global(.ds-status) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    font-weight: 600;
    font-size: var(--mdt-fs-label);
  }

  /* Swatches are built by the controller → :global inside the tool root.
     Each is a copy button: chip on top, label stack (Tint/Shade % + HEX) in
     kit copy faces below, so "✓ Copied" replaces the label, not the colour. */
  .palette-hint { margin: 0 0 0.75rem; }
  .shade-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(max(64px, 5.5rem), 1fr));
    gap: 0.5rem;
  }
  .shade-strip :global(.color-swatch) {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface-inset);
    color: var(--mdt-text);
    cursor: pointer;
    font: inherit;
    text-align: start;
    transition: border-color var(--mdt-dur-micro), transform var(--mdt-dur-micro);
  }
  .shade-strip :global(.color-swatch:hover) {
    border-color: color-mix(in srgb, var(--mdt-cat) 45%, var(--mdt-border));
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .shade-strip :global(.color-swatch:hover) { transform: none; }
  }
  .shade-strip :global(.color-swatch.is-base) { border-color: var(--mdt-cat); }
  .shade-strip :global(.color-swatch.is-copied) { border-color: var(--mdt-success); }
  .shade-strip :global(.color-swatch-chip) {
    display: block;
    height: 2.75rem;
    border-bottom: 1px solid var(--mdt-border);
  }
  .shade-strip :global(.color-swatch .ds-copy-faces) { display: grid; padding: 0.35rem 0.5rem 0.4rem; }
  .shade-strip :global(.color-swatch .ds-copy-face) { justify-content: flex-start; min-width: 0; }
  .shade-strip :global(.color-swatch .ds-copy-face-idle) {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.05rem;
    white-space: normal;
  }
  .shade-strip :global(.color-swatch .ds-copy-face-done) { color: var(--mdt-success); font-size: var(--mdt-fs-label); font-weight: 600; }
  .shade-strip :global(.color-swatch-name) { font-size: var(--mdt-fs-micro); color: var(--mdt-text-muted); overflow-wrap: anywhere; }
  .shade-strip :global(.color-swatch.is-base .color-swatch-name) { color: var(--mdt-text); font-weight: 600; }
  .shade-strip :global(.color-swatch-hex) { font-family: var(--mdt-font-mono); font-size: var(--mdt-fs-micro); }
</style>
