---
/**
 * Cron Expression Generator (pure JS). Five field inputs (minute / hour /
 * day-of-month / month / day-of-week) → Generate builds the cron expression,
 * validates it, renders a human-readable description and the next 5 execution
 * times (local time, selectable date format persisted in localStorage). Copy
 * button with 1200ms feedback. Parsing/description/next runs live in the
 * shared pure `cron-core.ts`; DOM wiring in `cron-generator.client.ts`.
 */
import { t, pluralVariants } from "@/i18n/messages";
import { scheduleTemplates } from "@/tools/cron-strings";
import { localizedPath } from "@/lib/url";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/cron-generator";
const s = {
  linkToParser: t(lang, ns, "LinkToParser"),
  parserTitle: t(lang, ns, "ParserTitle"),
  generatorTitle: t(lang, ns, "GeneratorTitle"),
  minuteLabel: t(lang, ns, "MinuteLabel"),
  hourLabel: t(lang, ns, "HourLabel"),
  dayLabel: t(lang, ns, "DayLabel"),
  monthLabel: t(lang, ns, "MonthLabel"),
  weekdayLabel: t(lang, ns, "WeekdayLabel"),
  fieldHintExamples: t(lang, ns, "FieldHintExamples"),
  generatedExpressionLabel: t(lang, ns, "GeneratedExpressionLabel"),
  descriptionLabel: t(lang, ns, "DescriptionLabel"),
  nextExecutionsPreviewLabel: t(lang, ns, "NextExecutionsPreviewLabel"),
  generateToSeeResult: t(lang, ns, "GenerateToSeeResult"),
  actionGenerate: t(lang, ns, "ActionGenerate"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, ns, "Copied"),
  dateFormatLocale: t(lang, ns, "DateFormatLocale"),
  dateFormatLocale12h: t(lang, ns, "DateFormatLocale12h"),
  dateFormatFullMonth: t(lang, ns, "DateFormatFullMonth"),
  dateFormatISO: t(lang, ns, "DateFormatISO"),
  dateFormatCompact: t(lang, ns, "DateFormatCompact"),
  dateFormatAmerican: t(lang, ns, "DateFormatAmerican"),
  dateFormatVerbose: t(lang, ns, "DateFormatVerbose"),
};
// Strings consumed by the client controller (human-readable description
// building blocks + month/weekday names used for parsing and rendering).
const clientStrings = {
  lang,
  copied: s.copied,
  errorInvalidExpression: t(lang, ns, "ErrorInvalidExpression"),
  errorExpectedFields: t(lang, ns, "ErrorExpectedFields"),
  errorUnknownPreset: t(lang, ns, "ErrorUnknownPreset"),
  errorFieldValue: t(lang, ns, "ErrorFieldValue"),
  noUpcomingRuns: t(lang, ns, "NoUpcomingRuns"),
  fieldNames: {
    minute: t(lang, ns, "PartMinute"),
    hour: t(lang, ns, "PartHour"),
    day: t(lang, ns, "PartDay"),
    month: t(lang, ns, "PartMonth"),
    weekday: t(lang, ns, "PartWeekday"),
  },
  // Every description template (Schedule*, incl. plural/ordinal variants).
  ...scheduleTemplates(lang, ns),
  months: t(lang, ns, "MonthNames").split(","),
  weekdays: t(lang, ns, "WeekdayNames").split(","),
  monthsLong: t(lang, ns, "MonthNamesLong").split(","),
  weekdaysLong: t(lang, ns, "WeekdayNamesLong").split(","),
  // ru (и др. флективные локали) могут дать <Key>_<one/few/many> варианты.
  ...pluralVariants(lang, ns),
};
const stringsJson = JSON.stringify(clientStrings);
const parserUrl = localizedPath(lang, "cron-parser");
---

<div class="ds-stack" data-crong-tool>
  <p class="ds-alert ds-alert-info">
    {s.linkToParser} → <a href={parserUrl}>{s.parserTitle}</a>
  </p>

  <div class="ds-tool-grid">
    <section class="ds-card ds-stack" aria-labelledby="crong-build-title">
      <h2 class="ds-card-title" id="crong-build-title">{s.generatorTitle}</h2>

      <Field label={s.minuteLabel} for="crong-minute" hint={s.fieldHintExamples}>
        <input
          id="crong-minute"
          type="text"
          class="ds-field mono"
          data-crong-minute
          value="0"
          placeholder="0-59, *, */5, 1,2,3"
          aria-describedby="crong-error"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
        />
      </Field>
      <Field label={s.hourLabel} for="crong-hour">
        <input
          id="crong-hour"
          type="text"
          class="ds-field mono"
          data-crong-hour
          value="*"
          placeholder="0-23, *, */2"
          aria-describedby="crong-error"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
        />
      </Field>
      <Field label={s.dayLabel} for="crong-day">
        <input
          id="crong-day"
          type="text"
          class="ds-field mono"
          data-crong-day
          value="*"
          placeholder="1-31, *, L, 1-15"
          aria-describedby="crong-error"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
        />
      </Field>
      <Field label={s.monthLabel} for="crong-month">
        <input
          id="crong-month"
          type="text"
          class="ds-field mono"
          data-crong-month
          value="*"
          placeholder="1-12, *, JAN-DEC"
          aria-describedby="crong-error"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
        />
      </Field>
      <Field label={s.weekdayLabel} for="crong-weekday">
        <input
          id="crong-weekday"
          type="text"
          class="ds-field mono"
          data-crong-weekday
          value="*"
          placeholder="0-6, *, 1-5, MON-FRI"
          aria-describedby="crong-error"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
        />
      </Field>

      <button type="button" class="ds-btn ds-btn-primary ds-btn-block" data-crong-generate>{s.actionGenerate}</button>

      <StatusMessage kind="error" id="crong-error" data-crong-error />
    </section>

    <section class="ds-card ds-stack" aria-labelledby="crong-result-title">
      <h2 class="ds-card-title" id="crong-result-title">{s.generatedExpressionLabel}</h2>

      <div class="ds-input-group">
        <input
          type="text"
          class="ds-field mono crong-output"
          data-crong-output
          readonly
          aria-labelledby="crong-result-title"
        />
        <button type="button" class="ds-btn ds-btn-small" data-crong-copy>{s.copy}</button>
      </div>

      <OutputPanel label={s.descriptionLabel}>
        <div class="ds-code-block" data-crong-description aria-live="polite">{s.generateToSeeResult}</div>
      </OutputPanel>

      <OutputPanel label={s.nextExecutionsPreviewLabel}>
        <Fragment slot="actions">
          <select class="ds-field-select crong-format" data-crong-date-format aria-label={s.nextExecutionsPreviewLabel}>
            <option value="locale">{s.dateFormatLocale}</option>
            <option value="locale-12h">{s.dateFormatLocale12h}</option>
            <option value="full-month">{s.dateFormatFullMonth}</option>
            <option value="iso">{s.dateFormatISO}</option>
            <option value="compact">{s.dateFormatCompact}</option>
            <option value="american">{s.dateFormatAmerican}</option>
            <option value="verbose">{s.dateFormatVerbose}</option>
          </select>
        </Fragment>
        <div data-crong-next aria-live="polite"></div>
      </OutputPanel>
    </section>
  </div>
</div>

<script is:inline type="application/json" data-crong-strings set:html={stringsJson} />
<script>import "@/tools/cron-generator.client.ts";</script>

<style>
  .crong-output { font-size: 1.05rem; }
  .crong-format { width: auto; max-width: 100%; min-width: 0; }

  /* Next-run list (rows are created by the controller → :global). */
  [data-crong-tool] :global(.cron-next) { margin: 0; padding-left: 2.2rem; }
  [data-crong-tool] :global(.cron-next li + li) { margin-top: 0.3rem; }
  [data-crong-tool] :global(.cron-next li::marker) { color: var(--mdt-text-faint); }
</style>
