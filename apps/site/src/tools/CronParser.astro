---
/**
 * Cron Expression Parser (pure JS). Parses a 5-field cron expression (or an
 * @preset like @daily/@reboot) into validation, a human-readable description,
 * the next 5 execution times (local time, selectable date format persisted in
 * localStorage), and a per-field breakdown. Live parsing on input (300ms
 * debounce), quick presets, copy description. Parsing/description/next runs
 * live in the shared pure `cron-core.ts`; DOM wiring in `cron-parser.client.ts`.
 */
import { t, pluralVariants } from "@/i18n/messages";
import { scheduleTemplates } from "@/tools/cron-strings";
import { localizedPath } from "@/lib/url";
import type { LocaleCode } from "@/registry/locales";
import CopyButton from "@/components/tool/CopyButton.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/cron-parser";
const s = {
  linkToGenerator: t(lang, ns, "LinkToGenerator"),
  generatorTitle: t(lang, ns, "GeneratorTitle"),
  inputLabel: t(lang, ns, "InputLabel"),
  inputPlaceholder: t(lang, ns, "InputPlaceholder"),
  presetsLabel: t(lang, ns, "PresetsLabel"),
  presetEveryHour: t(lang, ns, "PresetEveryHour"),
  presetEvery6Hours: t(lang, ns, "PresetEvery6Hours"),
  presetDaily2AM: t(lang, ns, "PresetDaily2AM"),
  presetWeekdays9AM: t(lang, ns, "PresetWeekdays9AM"),
  presetHourAt0Title: t(lang, ns, "PresetHourAt0Title"),
  presetEvery6HoursTitle: t(lang, ns, "PresetEvery6HoursTitle"),
  presetDaily2AMTitle: t(lang, ns, "PresetDaily2AMTitle"),
  presetWeekdays9AMTitle: t(lang, ns, "PresetWeekdays9AMTitle"),
  presetWeekly: t(lang, ns, "PresetWeekly"),
  presetDaily: t(lang, ns, "PresetDaily"),
  presetHourly: t(lang, ns, "PresetHourly"),
  presetReboot: t(lang, ns, "PresetReboot"),
  presetMonthly: t(lang, ns, "PresetMonthly"),
  presetYearly: t(lang, ns, "PresetYearly"),
  actionParse: t(lang, ns, "ActionParse"),
  actionClear: t(lang, ns, "ActionClear"),
  resultsLabel: t(lang, ns, "ResultsLabel"),
  humanReadableLabel: t(lang, ns, "HumanReadableLabel"),
  nextExecutionsLabel: t(lang, ns, "NextExecutionsLabel"),
  dateFormatLabel: t(lang, ns, "DateFormatLabel"),
  dateFormatLocale: t(lang, ns, "DateFormatLocale"),
  dateFormatLocale12h: t(lang, ns, "DateFormatLocale12h"),
  dateFormatFullMonth: t(lang, ns, "DateFormatFullMonth"),
  dateFormatISO: t(lang, ns, "DateFormatISO"),
  dateFormatCompact: t(lang, ns, "DateFormatCompact"),
  dateFormatAmerican: t(lang, ns, "DateFormatAmerican"),
  dateFormatVerbose: t(lang, ns, "DateFormatVerbose"),
  partsLabel: t(lang, ns, "PartsLabel"),
  partMinute: t(lang, ns, "PartMinute"),
  partHour: t(lang, ns, "PartHour"),
  partDay: t(lang, ns, "PartDay"),
  partMonth: t(lang, ns, "PartMonth"),
  partWeekday: t(lang, ns, "PartWeekday"),
  parseToSeeResult: t(lang, ns, "ParseToSeeResult"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, "common", "Common_Copied"),
  copyFailed: t(lang, "common", "Common_CopyFailed"),
};
// Strings consumed by the client controller (descriptions, errors, names).
const clientStrings = {
  lang,
  copy: s.copy,
  copied: s.copied,
  copyFailed: s.copyFailed,
  parseToSeeResult: s.parseToSeeResult,
  errorInvalidExpression: t(lang, ns, "ErrorInvalidExpression"),
  errorExpectedFields: t(lang, ns, "ErrorExpectedFields"),
  errorUnknownPreset: t(lang, ns, "ErrorUnknownPreset"),
  errorFieldValue: t(lang, ns, "ErrorFieldValue"),
  noUpcomingRuns: t(lang, ns, "NoUpcomingRuns"),
  fieldNames: {
    minute: s.partMinute,
    hour: s.partHour,
    day: s.partDay,
    month: s.partMonth,
    weekday: s.partWeekday,
  },
  // Every description template (Schedule*, incl. plural/ordinal variants).
  ...scheduleTemplates(lang, ns),
  months: t(lang, ns, "MonthNames").split(","),
  weekdays: t(lang, ns, "WeekdayNames").split(","),
  monthsLong: t(lang, ns, "MonthNamesLong").split(","),
  weekdaysLong: t(lang, ns, "WeekdayNamesLong").split(","),
  // ru (и др. флективные локали) могут дать <Key>_<one/few/many> варианты.
  ...pluralVariants(lang, ns),
};
const stringsJson = JSON.stringify(clientStrings);
const generatorUrl = localizedPath(lang, "cron-generator");
---

<div class="ds-stack" data-cronp-tool>
  <p class="ds-alert ds-alert-info">
    {s.linkToGenerator} → <a href={generatorUrl}>{s.generatorTitle}</a>
  </p>

  <div class="ds-workbench">
    <ToolPanel title={s.inputLabel} for="cronp-input">
      <Fragment slot="actions">
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-cronp-clear>{s.actionClear}</button>
      </Fragment>
      <input
        type="text"
        id="cronp-input"
        class="ds-field mono cronp-input"
        data-cronp-input
        placeholder={s.inputPlaceholder}
        value="* * * * *"
        aria-describedby="cronp-error"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
      />

    <div class="ds-field-group">
      <span class="ds-label" id="cronp-presets-label">{s.presetsLabel}</span>
      <div class="ds-chip-list" role="group" aria-labelledby="cronp-presets-label">
        <button type="button" class="ds-chip-btn" data-cronp-preset="0 * * * *" title={s.presetHourAt0Title}>{s.presetEveryHour}</button>
        <button type="button" class="ds-chip-btn" data-cronp-preset="0 */6 * * *" title={s.presetEvery6HoursTitle}>{s.presetEvery6Hours}</button>
        <button type="button" class="ds-chip-btn" data-cronp-preset="0 2 * * *" title={s.presetDaily2AMTitle}>{s.presetDaily2AM}</button>
        <button type="button" class="ds-chip-btn" data-cronp-preset="0 9 * * 1-5" title={s.presetWeekdays9AMTitle}>{s.presetWeekdays9AM}</button>
        <button type="button" class="ds-chip-btn" data-cronp-preset="@weekly">{s.presetWeekly}</button>
        <button type="button" class="ds-chip-btn" data-cronp-preset="@daily">{s.presetDaily}</button>
        <button type="button" class="ds-chip-btn" data-cronp-preset="@hourly">{s.presetHourly}</button>
        <button type="button" class="ds-chip-btn" data-cronp-preset="@reboot">{s.presetReboot}</button>
        <button type="button" class="ds-chip-btn" data-cronp-preset="@monthly">{s.presetMonthly}</button>
        <button type="button" class="ds-chip-btn" data-cronp-preset="@yearly">{s.presetYearly}</button>
      </div>
    </div>

      <div class="ds-action-row">
        <button type="button" class="ds-btn ds-btn-primary" data-cronp-parse>{s.actionParse}</button>
      </div>

      <StatusMessage kind="error" id="cronp-error" data-cronp-error />
    </ToolPanel>

    <OutputPanel panel label={s.resultsLabel} emptyHint={s.parseToSeeResult} data-cronp-output-panel>
      <div class="ds-result-headline ds-when-filled">
        <span class="ds-result-headline-label">{s.humanReadableLabel}</span>
        <output class="ds-result-headline-value cron-headline" data-cronp-human aria-live="polite"></output>
        <CopyButton iconOnly label={s.copy} copiedLabel={s.copied} failedLabel={s.copyFailed} data-cronp-copy />
      </div>

      <div class="ds-field-group ds-when-filled">
        <div class="ds-label-row">
          <span class="ds-label" id="cronp-next-label">{s.nextExecutionsLabel}</span>
          <select class="ds-field-select cron-format" data-cronp-date-format aria-label={s.dateFormatLabel}>
            <option value="locale">{s.dateFormatLocale}</option>
            <option value="locale-12h">{s.dateFormatLocale12h}</option>
            <option value="full-month">{s.dateFormatFullMonth}</option>
            <option value="iso">{s.dateFormatISO}</option>
            <option value="compact">{s.dateFormatCompact}</option>
            <option value="american">{s.dateFormatAmerican}</option>
            <option value="verbose">{s.dateFormatVerbose}</option>
          </select>
        </div>
        <div data-cronp-next aria-live="polite"></div>
      </div>

      <div class="ds-field-group ds-when-filled">
        <span class="ds-label" id="cronp-parts-label">{s.partsLabel}</span>
        <dl class="ds-result-list cron-parts" aria-labelledby="cronp-parts-label">
        <div class="ds-result-row ds-result-row-info"><dt class="ds-result-key">{s.partMinute}</dt><dd class="ds-result-value" data-cronp-part-minute>*</dd></div>
        <div class="ds-result-row ds-result-row-info"><dt class="ds-result-key">{s.partHour}</dt><dd class="ds-result-value" data-cronp-part-hour>*</dd></div>
        <div class="ds-result-row ds-result-row-info"><dt class="ds-result-key">{s.partDay}</dt><dd class="ds-result-value" data-cronp-part-day>*</dd></div>
        <div class="ds-result-row ds-result-row-info"><dt class="ds-result-key">{s.partMonth}</dt><dd class="ds-result-value" data-cronp-part-month>*</dd></div>
        <div class="ds-result-row ds-result-row-info"><dt class="ds-result-key">{s.partWeekday}</dt><dd class="ds-result-value" data-cronp-part-weekday>*</dd></div>
        </dl>
      </div>
    </OutputPanel>
  </div>
</div>

<script is:inline type="application/json" data-cronp-strings set:html={stringsJson} />
<script>import "@/tools/cron-parser.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .cronp-input { font-size: 1.05rem; }
  .cron-format { width: auto; max-width: 100%; min-width: 0; }
  /* The description is prose, not a number: calmer than the default headline size. */
  .cron-headline { font-family: var(--mdt-font-sans); font-size: 1.15rem; line-height: 1.4; }
  /* Field breakdown: aligned name column (rows are "key + value", no button). */
  .cron-parts .ds-result-row-info { grid-template-columns: minmax(0, 9rem) minmax(0, 1fr); }
  .cron-parts dd { margin: 0; color: var(--mdt-cat); font-weight: 600; }

  /* Next-run list (rows are created by the controller → :global). */
  [data-cronp-tool] :global(.cron-next) { margin: 0; padding-left: 2.2rem; }
  [data-cronp-tool] :global(.cron-next li + li) { margin-top: 0.3rem; }
  [data-cronp-tool] :global(.cron-next li::marker) { color: var(--mdt-text-faint); }
</style>
