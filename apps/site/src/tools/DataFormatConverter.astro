---
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import FileDrop from "@/components/tool/FileDrop.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import Progress from "@/components/tool/Progress.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import "@/styles/explorer-ui.css";
interface Props { lang: LocaleCode }
const { lang } = Astro.props;
const ns = "tools/data-format-converter";
const keys = ["Loading", "Importing", "Converting", "Ready", "Canceled", "Error", "ErrorJson", "Empty", "Row", "KeepType", "ColumnType", "Elapsed", "Saved", "ChooseFile", "PreviewNote"];
const stringsJson = JSON.stringify({ ...Object.fromEntries(keys.map(key => [key, t(lang, ns, key)])), Lang: lang });
---
<div class="ds-workbench ds-workbench-single converter-workbench" data-converter-tool>
  <ToolPanel title={t(lang, ns, "InputTitle")}>
    <FileDrop compact title={t(lang, ns, "InputTitle")} buttonLabel={t(lang, ns, "ChooseFile")} changeLabel={t(lang, ns, "ChooseFile")} sub={t(lang, ns, "InputHint")} accept=".csv,.tsv,.json,.jsonl,.ndjson,.parquet" data-converter-dropzone inputProps={{ "data-converter-file": true }} />
    <div class="ds-settings">
      <Field label={t(lang, ns, "InputFormat")} for="converter-input-format"><select id="converter-input-format" class="ds-field-select" data-converter-input-format><option value="auto">{t(lang, ns, "Auto")}</option><option value="csv">CSV / TSV</option><option value="json">JSON</option><option value="jsonl">JSONL</option><option value="parquet">Parquet</option></select></Field>
      <Field label={t(lang, ns, "Delimiter")} for="converter-delimiter"><select id="converter-delimiter" class="ds-field-select" data-converter-delimiter><option value="auto">{t(lang, ns, "Auto")}</option><option value=",">{t(lang, ns, "Comma")}</option><option value=";">{t(lang, ns, "Semicolon")}</option><option value={"\t"}>{t(lang, ns, "Tab")}</option><option value="|">|</option></select></Field>
      <Field label={t(lang, ns, "Encoding")} for="converter-encoding"><select id="converter-encoding" class="ds-field-select" data-converter-encoding><option value="utf-8">UTF-8</option><option value="utf-16le">UTF-16 LE</option><option value="utf-16be">UTF-16 BE</option><option value="windows-1251">Windows-1251</option><option value="windows-1252">Windows-1252</option></select></Field>
      <label class="ds-check-row"><input class="ds-check" type="checkbox" data-converter-header checked /><span>{t(lang, ns, "Header")}</span></label>
    </div>
    <p class="ds-hint">{t(lang, ns, "InputOptionsHint")}</p>
    <div class="ds-action-row"><button type="button" class="ds-btn ds-btn-primary" data-converter-open>{t(lang, ns, "Open")}</button><button type="button" class="ds-btn" data-converter-clear>{t(lang, ns, "Clear")}</button></div>
    <Progress title={t(lang, ns, "ProgressTitle")} barLabel={t(lang, ns, "ProgressTitle")} cancelLabel={t(lang, ns, "Cancel")} data-converter-progress cancelProps={{ "data-converter-cancel": true }} barProps={{ "data-converter-bar": true }} fillProps={{ "data-converter-fill": true }} labelProps={{ "data-converter-progress-label": true }} />
    <StatusMessage kind="info" data-converter-status />
    <StatusMessage kind="error" data-converter-error />
    <p class="ds-hint">{t(lang, ns, "PrivacyNote")}</p>
    <p class="ds-hint">{t(lang, ns, "Limits")}</p>
  </ToolPanel>
  <section data-converter-loaded hidden>
    <ToolPanel title={t(lang, ns, "OutputTitle")}>
      <div class="converter-columns" data-converter-columns></div>
      <p class="ds-hint">{t(lang, ns, "TypesHint")}</p>
      <button type="button" class="ds-btn" data-converter-preview>{t(lang, ns, "Preview")}</button>
      <p class="ds-hint" data-converter-preview-note></p>
      <div data-converter-table></div>
      <div class="ds-settings">
        <Field label={t(lang, ns, "OutputFormat")} for="converter-output-format"><select id="converter-output-format" class="ds-field-select" data-converter-output-format><option value="csv">CSV</option><option value="json">JSON</option><option value="jsonl">JSONL</option><option value="parquet">Parquet</option></select></Field>
        <Field label={t(lang, ns, "OutputDelimiter")} for="converter-output-delimiter"><select id="converter-output-delimiter" class="ds-field-select" data-converter-output-delimiter><option value=",">{t(lang, ns, "Comma")}</option><option value=";">{t(lang, ns, "Semicolon")}</option><option value={"\t"}>{t(lang, ns, "Tab")}</option><option value="|">|</option></select></Field>
        <label class="ds-check-row"><input class="ds-check" type="checkbox" data-converter-output-header checked /><span>{t(lang, ns, "OutputHeader")}</span></label>
      </div>
      <p class="ds-hint">{t(lang, ns, "OutputHint")}</p>
      <button type="button" class="ds-btn ds-btn-primary" data-converter-download>{t(lang, ns, "Download")}</button>
    </ToolPanel>
  </section>
</div>
<script is:inline type="application/json" data-converter-strings set:html={stringsJson} />
<script>import "@/tools/data-format-converter.client.ts";</script>
<style>
  .converter-workbench { align-items: start; }
  .converter-columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 0.75rem; max-height: 20rem; overflow: auto; }
</style>
