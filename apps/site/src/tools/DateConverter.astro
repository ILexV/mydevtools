---
/**
 * Date Converter tool (pure JS). Convert between Unix timestamps (sec/ms),
 * ISO 8601 strings, and human-readable formats (ISO/European/UTC/Local/RFC
 * 2822/Unix sec/ms/Custom). Custom-format tokens: yyyy MM dd HH mm ss SSS.
 * Workbench: input panel (editor with empty state + example, settings, Convert /
 * Now) | output panel (compact placeholder until a date is converted, Copy),
 * then the assumed-zone note, a relative-time line and "Same instant" world-clock
 * rows (UTC, device, New York, Tokyo) as a <dl> of <time datetime> values.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import EmptyState from "@/components/tool/EmptyState.astro";
import CopyButton from "@/components/tool/CopyButton.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/date-converter";
const s = {
  lang,
  inputLabel: t(lang, ns, "InputLabel"),
  outputLabel: t(lang, ns, "OutputLabel"),
  actionConvert: t(lang, ns, "ActionConvert"),
  actionCurrentTime: t(lang, ns, "ActionCurrentTime"),
  inputTypeLabel: t(lang, ns, "InputTypeLabel"),
  inputTypeAuto: t(lang, ns, "InputType_Auto"),
  inputTypeUnixSec: t(lang, ns, "InputType_UnixSec"),
  inputTypeUnixMs: t(lang, ns, "InputType_UnixMs"),
  inputTypeIso: t(lang, ns, "InputType_ISO"),
  outputFormatLabel: t(lang, ns, "OutputFormatLabel"),
  formatIso: t(lang, ns, "Format_ISO"),
  formatRfc: t(lang, ns, "Format_RFC"),
  formatUnixSec: t(lang, ns, "Format_UnixSec"),
  formatUnixMs: t(lang, ns, "Format_UnixMs"),
  formatUtc: t(lang, ns, "Format_UTC"),
  formatLocal: t(lang, ns, "Format_Local"),
  formatEuropean: t(lang, ns, "Format_European"),
  formatCustom: t(lang, ns, "Format_Custom"),
  customFormatPlaceholder: t(lang, ns, "CustomFormatPlaceholder"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, "common", "Common_Copied"),
  loadExample: t(lang, "common", "Common_LoadExample"),
  emptyHint: t(lang, ns, "EmptyHint"),
  outputEmpty: t(lang, ns, "OutputEmpty"),
  errorInvalid: t(lang, ns, "Error_Invalid"),
  copyFailed: t(lang, ns, "CopyFailed"),
  sameInstant: t(lang, ns, "SameInstantTitle"),
  zoneUtc: t(lang, ns, "Zone_Utc"),
  zoneDevice: t(lang, ns, "Zone_Device"),
  relativeLine: t(lang, ns, "RelativeLine"),
  assumedUtc: t(lang, ns, "AssumedZone_Utc"),
  assumedLocal: t(lang, ns, "AssumedZone_Local"),
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-workbench" data-date-tool>
  <ToolPanel title={s.inputLabel} for="date-input">
    <div class="ds-editor ds-editor-compact is-empty" data-date-input-host>
      <textarea id="date-input" class="ds-field-textarea mono date-textarea" data-date-input rows="3" spellcheck="false" autocomplete="off" aria-describedby="date-input-empty"></textarea>
      <EmptyState hint={s.emptyHint} hintId="date-input-empty" exampleLabel={s.loadExample} buttonProps={{ "data-date-example": true }} />
    </div>

    <div class="ds-settings ds-settings-flat">
      <Field label={s.inputTypeLabel} for="date-input-type">
        <select id="date-input-type" class="ds-field-select" data-date-input-type>
          <option value="auto">{s.inputTypeAuto}</option>
          <option value="unix-sec">{s.inputTypeUnixSec}</option>
          <option value="unix-ms">{s.inputTypeUnixMs}</option>
          <option value="iso">{s.inputTypeIso}</option>
        </select>
      </Field>
      <Field label={s.outputFormatLabel} for="date-output-format">
        <select id="date-output-format" class="ds-field-select" data-date-output-format>
          <option value="iso">{s.formatIso}</option>
          <option value="euro">{s.formatEuropean}</option>
          <option value="utc">{s.formatUtc}</option>
          <option value="local">{s.formatLocal}</option>
          <option value="rfc">{s.formatRfc}</option>
          <option value="unix-sec">{s.formatUnixSec}</option>
          <option value="unix-ms">{s.formatUnixMs}</option>
          <option value="custom">{s.formatCustom}</option>
        </select>
      </Field>
      <Field label={s.formatCustom} for="date-custom" data-date-custom-wrap hidden>
        <input id="date-custom" type="text" class="ds-field mono" data-date-custom placeholder={s.customFormatPlaceholder} spellcheck="false" autocomplete="off" />
      </Field>
    </div>

    <div class="ds-action-row">
      <button type="button" class="ds-btn ds-btn-primary" data-date-convert>{s.actionConvert}</button>
      <button type="button" class="ds-btn" data-date-now>{s.actionCurrentTime}</button>
    </div>

    <StatusMessage kind="error" data-date-error />
  </ToolPanel>

  <OutputPanel panel label={s.outputLabel} for="date-output" emptyHint={s.outputEmpty} data-date-output-panel>
    <Fragment slot="actions">
      <CopyButton ghost label={s.copy} copiedLabel={s.copied} data-date-copy disabled />
    </Fragment>
    <textarea id="date-output" class="ds-field-textarea mono date-textarea ds-when-filled" data-date-output rows="2" readonly aria-live="polite"></textarea>
    <div class="date-instant ds-when-filled" data-date-instant>
      <p class="ds-hint date-assumed" data-date-assumed hidden></p>
      <p class="date-relative" data-date-relative-line><time data-date-relative></time></p>
      <h3 class="ds-label date-instant-title" id="date-same-instant">{s.sameInstant}</h3>
      <dl class="date-zones" aria-labelledby="date-same-instant" data-date-zones></dl>
    </div>
  </OutputPanel>
</div>

<script is:inline type="application/json" data-date-strings set:html={stringsJson} />
<script>import "@/tools/date-converter.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  /* Timestamps are one line: the input uses `.ds-editor-compact`; the
     output matches its height. */
  textarea[data-date-output] { min-height: 5rem; }
  .date-instant { display: grid; gap: 0.75rem; min-width: 0; }
  .date-assumed, .date-relative { margin: 0; }
  .date-relative { font-size: var(--mdt-fs-meta); color: var(--mdt-text-muted); }
  .date-instant-title { margin: 0.25rem 0 -0.25rem; }
</style>

<style is:global>
  /* "Same instant" rows are controller-built: global, scoped to the tool root. */
  [data-date-tool] .date-zones { margin: 0; padding: 0; border-top: 1px solid var(--mdt-border); }
  [data-date-tool] .date-zone-row {
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding: 12px 0;
    border-bottom: 1px solid var(--mdt-border);
  }
  [data-date-tool] .date-zone-row dt { display: grid; gap: 0.1rem; min-width: 0; }
  [data-date-tool] .date-zone-name { font-size: var(--mdt-fs-meta); font-weight: 600; color: var(--mdt-text); }
  [data-date-tool] .date-zone-id { font-family: var(--mdt-font-mono); font-size: var(--mdt-fs-label); color: var(--mdt-text-muted); overflow-wrap: anywhere; }
  [data-date-tool] .date-zone-row dd { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.15rem 0.75rem; margin: 0; min-width: 0; }
  /* Dates wrap instead of ellipsizing (long localized weekday/month names). */
  [data-date-tool] .date-zone-time { font-size: var(--mdt-fs-meta); color: var(--mdt-text); overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
  [data-date-tool] .date-zone-offset { font-family: var(--mdt-font-mono); font-size: var(--mdt-fs-label); color: var(--mdt-text-muted); white-space: nowrap; }
  @media (max-width: 560px) {
    [data-date-tool] .date-zone-row { grid-template-columns: minmax(0, 1fr); }
  }
</style>
