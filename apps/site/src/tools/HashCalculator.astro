---
/**
 * Hash Calculator tool UI (Stage 9 reference + Stage 7 Gate 7 proof).
 * Static shell; behavior lives in `hash-calculator.client.ts`, which calls the
 * worker-backed `hash-client` (text or sequential files, progress/cancel).
 *
 * Workbench: text/file selection → algorithms → Calculate | per-source
 * digests, expected-checksum comparison, terminal errors/cancellation and
 * TXT/CSV/JSON downloads. Only algorithm choices persist in localStorage.
 *
 * Locale strings for the current tool namespace are embedded as a JSON island
 * (Stage 5: browser controller gets only its own namespace strings).
 */
import { HASH_ALGORITHMS, DEFAULT_HASH_ALGORITHMS } from "@/tools/hash-algorithms";
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import EmptyState from "@/components/tool/EmptyState.astro";
import Progress from "@/components/tool/Progress.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import Icon from "@/components/Icon.astro";

interface Props {
  lang: LocaleCode;
}

const { lang } = Astro.props as Props;
const ns = "tools/hash-calculator";

const strings = {
  inputLabel: t(lang, ns, "InputLabel"),
  fileLabel: t(lang, ns, "FileLabel"),
  fileHint: t(lang, ns, "FileHint"),
  fileProgressTitle: t(lang, ns, "FileProgressTitle"),
  cancel: t(lang, ns, "Cancel"),
  calculate: t(lang, ns, "Calculate"),
  clear: t(lang, ns, "Clear"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, "common", "Common_Copied"),
  open: t(lang, "common", "Common_Open"),
  loadExample: t(lang, "common", "Common_LoadExample"),
  emptyHint: t(lang, ns, "EmptyHint"),
  resultsLabel: t(lang, ns, "ResultsLabel"),
  outputEmpty: t(lang, ns, "OutputEmpty"),
  algorithmsTitle: t(lang, ns, "AlgorithmsTitle"),
  algorithmsSelected: t(lang, ns, "AlgorithmsSelected"),
  algorithmsSearchPlaceholder: t(lang, ns, "AlgorithmsSearchPlaceholder"),
  algorithmsReset: t(lang, ns, "AlgorithmsReset"),
  selectAtLeastOne: t(lang, ns, "SelectAtLeastOneAlgorithm"),
  preparing: t(lang, "common", "Common_Preparing"),
  expectedLabel: t(lang, ns, "ExpectedLabel"),
  expectedHint: t(lang, ns, "ExpectedHint"),
  expectedErrorWhitespace: t(lang, ns, "ExpectedErrorWhitespace"),
  expectedErrorNonHex: t(lang, ns, "ExpectedErrorNonHex"),
  compareMatches: t(lang, ns, "CompareMatches"),
  compareNoMatch: t(lang, ns, "CompareNoMatch"),
  comparePending: t(lang, ns, "ComparePending"),
  compareStale: t(lang, ns, "CompareStale"),
  rowMatches: t(lang, ns, "RowMatches"),
  selectedFiles: t(lang, ns, "SelectedFiles"),
  removeFile: t(lang, ns, "RemoveFile"),
  textResult: t(lang, ns, "TextResult"),
  statusReady: t(lang, ns, "StatusReady"),
  statusHashing: t(lang, ns, "StatusHashing"),
  statusDone: t(lang, ns, "StatusDone"),
  statusCanceled: t(lang, ns, "StatusCanceled"),
  statusError: t(lang, ns, "StatusError"),
  processingError: t(lang, ns, "ProcessingError"),
  progressStats: t(lang, ns, "ProgressStats"),
  resultStats: t(lang, ns, "ResultStats"),
  exportLabel: t(lang, ns, "ExportLabel"),
  exportFormat: t(lang, ns, "ExportFormat"),
};
const defaults: Record<string, true> = Object.fromEntries(DEFAULT_HASH_ALGORITHMS.map((id) => [id, true]));
const stringsJson = JSON.stringify(strings);
---

<div class="ds-workbench" data-hash-tool>
  <ToolPanel title={strings.inputLabel} for="hash-textarea" meta="" metaProps={{ "data-hash-filename": true }}>
    <Fragment slot="actions">
      <label class="ds-btn ds-btn-small ds-btn-ghost ds-file-btn">
        <input type="file" multiple data-hash-file aria-label={strings.fileLabel} />{strings.open}
      </label>
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-hash-clear>{strings.clear}</button>
    </Fragment>
    <div class="ds-editor is-empty" data-hash-input-host>
      <textarea
        id="hash-textarea"
        class="ds-field-textarea mono hash-input"
        data-hash-textarea
        rows="8"
        aria-describedby="hash-input-empty hash-file-hint"
      ></textarea>
      <EmptyState
        hint={strings.emptyHint}
        hintId="hash-input-empty"
        exampleLabel={strings.loadExample}
        buttonProps={{ "data-hash-example": true }}
      />
    </div>
    <p class="ds-hint hash-file-hint" id="hash-file-hint">{strings.fileHint}</p>
    <ul class="ds-file-list" data-hash-files aria-label={strings.fileLabel} hidden></ul>

    <div class="ds-settings hash-algos">
      <Field label={strings.algorithmsTitle} asideProps={{ "data-hash-algo-count": true }}>
        <input
          type="search"
          class="ds-field"
          data-hash-algo-search
          placeholder={strings.algorithmsSearchPlaceholder}
          aria-label={strings.algorithmsSearchPlaceholder}
          autocomplete="off"
        />
        <div class="algo-list" data-hash-algo-list role="group" aria-label={strings.algorithmsTitle}>
          {HASH_ALGORITHMS.map((alg) => (
            <label class="algo-item">
              <input type="checkbox" class="ds-check" value={alg.id} data-hash-algo checked={defaults[alg.id] === true} />
              <span>{alg.label}</span>
            </label>
          ))}
        </div>
      </Field>
      <button type="button" class="ds-btn-link" data-hash-algo-reset>{strings.algorithmsReset}</button>
    </div>

    <div class="ds-action-row">
      <button type="button" class="ds-btn ds-btn-primary" data-hash-calculate>{strings.calculate}</button>
      <button type="button" class="ds-btn" data-hash-cancel hidden>{strings.cancel}</button>
    </div>

    <Progress
      data-hash-progress
      barLabel={strings.fileProgressTitle}
      barProps={{ "data-hash-progress-bar": true }}
      fillProps={{ "data-hash-progress-fill": true }}
      labelProps={{ "data-hash-progress-label": true }}
    />
    <StatusMessage kind="error" data-hash-error />
  </ToolPanel>

  <OutputPanel panel label={strings.resultsLabel} emptyHint={strings.outputEmpty} data-hash-output>
    <Fragment slot="actions">
      <select class="ds-field-select hash-export-format" data-hash-export-format aria-label={strings.exportFormat}>
        <option value="txt">TXT</option>
        <option value="csv">CSV</option>
        <option value="json">JSON</option>
      </select>
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-hash-export disabled>
        <Icon name="download" size={16} />{strings.exportLabel}
      </button>
    </Fragment>
    <Field label={strings.expectedLabel} for="hash-expected" hint={strings.expectedHint} class="hash-expected">
      <input
        id="hash-expected"
        type="text"
        class="ds-field mono"
        data-hash-expected
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-describedby="hash-expected-error hash-expected-hint"
      />
      <p class="ds-hint ds-hint-error hash-expected-error" id="hash-expected-error" data-hash-expected-error hidden></p>
    </Field>
    <p class="hash-compare-summary" data-hash-compare-summary hidden></p>
    <div class="ds-result-list ds-when-filled" data-hash-results aria-live="polite"></div>
    <p class="visually-hidden" role="status" aria-live="polite" data-hash-compare-live></p>
  </OutputPanel>
</div>

<script is:inline type="application/json" data-hash-strings set:html={stringsJson} />
<script>
  import "@/tools/hash-calculator.client.ts";
</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .ds-editor > .hash-input {
    min-height: 12rem;
  }
  .hash-file-hint {
    margin-top: -0.5rem;
  }
  .hash-export-format {
    width: auto;
  }
  .hash-algos {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .hash-algos > :global(.ds-field-group) {
    align-self: stretch;
  }
  .algo-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 0.25rem;
    max-height: 16rem;
    overflow: auto;
    margin-top: 0.6rem;
    padding: 0.2rem;
  }
  .algo-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.45rem;
    border-radius: var(--mdt-radius-xs);
    cursor: pointer;
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-meta);
    color: var(--mdt-text-muted);
    transition: background var(--mdt-dur-micro), color var(--mdt-dur-micro);
  }
  .algo-item:hover {
    background: var(--mdt-surface-raised);
    color: var(--mdt-text);
  }
  .algo-item:has(:checked) {
    color: var(--mdt-cat);
  }
  @media (prefers-reduced-motion: reduce) {
    .algo-item { transition: none; }
  }
  /* Expected-hash field sits above the empty hint while there is no result. */
  [data-hash-tool] :global([data-hash-output] > .ds-empty-state) { order: 1; }
  [data-hash-tool] :global([data-hash-output] > .ds-panel-head) { order: -1; }
  .hash-expected .ds-hint-error { margin-top: 6px; }
  .hash-compare-summary {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: var(--mdt-fs-meta);
    font-weight: 600;
    color: var(--mdt-text-muted);
    overflow-wrap: anywhere;
  }
  .hash-compare-summary.is-success { color: var(--mdt-success); }
  .hash-compare-summary :global(svg) { width: 1.1rem; height: 1.1rem; flex-shrink: 0; }
</style>

<!-- Runtime rows (controller-created): global, scoped under the tool root. -->
<style is:global>
  [data-hash-tool] [data-hash-results] { --ds-result-key-w: 8rem; }
  [data-hash-tool] .hash-row-key { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.5rem; }
  [data-hash-tool] .ds-result-row.is-match {
    margin-inline: -0.6rem;
    padding-inline: 0.6rem;
    border-radius: var(--mdt-radius-sm);
    background: color-mix(in srgb, var(--mdt-success) 9%, transparent);
    box-shadow: inset 3px 0 0 var(--mdt-success);
  }
  [data-hash-tool] .hash-match-badge {
    font-family: var(--mdt-font-sans);
    font-weight: 600;
    letter-spacing: 0;
    white-space: normal;
  }
  [data-hash-tool] .hash-match-badge svg { width: 0.9rem; height: 0.9rem; flex-shrink: 0; }
</style>
