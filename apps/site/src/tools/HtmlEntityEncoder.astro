---
/**
 * HTML Entity Encoder/Decoder tool (pure JS) on the shared tool UI kit
 * (`ds-*`, docs/qa/tool-ui-kit.md). Input + mode/format settings → encode or
 * decode; swap, clear, copy. Named/decimal/hex formats × special-chars /
 * non-ASCII / all modes. Transforms live in `entities.ts`.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import CopyButton from "@/components/tool/CopyButton.astro";
import EmptyState from "@/components/tool/EmptyState.astro";
import Field from "@/components/tool/Field.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/html-entity-encoder";
const s = {
  inputLabel: t(lang, ns, "InputLabel"),
  emptyHint: t(lang, ns, "EmptyHint"),
  outputEmpty: t(lang, ns, "OutputEmpty"),
  loadExample: t(lang, "common", "Common_LoadExample"),
  outputTitle: t(lang, ns, "OutputTitle"),
  settingsTitle: t(lang, ns, "SettingsTitle"),
  modeLabel: t(lang, ns, "ModeLabel"),
  modeAll: t(lang, ns, "Mode_All"),
  modeSpecialChars: t(lang, ns, "Mode_SpecialChars"),
  modeNonAscii: t(lang, ns, "Mode_NonAscii"),
  formatLabel: t(lang, ns, "FormatLabel"),
  formatNamed: t(lang, ns, "Format_Named"),
  formatDecimal: t(lang, ns, "Format_Decimal"),
  formatHex: t(lang, ns, "Format_Hex"),
  actionEncode: t(lang, ns, "ActionEncode"),
  actionDecode: t(lang, ns, "ActionDecode"),
  actionSwap: t(lang, ns, "ActionSwap"),
  actionClear: t(lang, ns, "ActionClear"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, "common", "Common_Copied"),
  copyFailed: t(lang, "common", "Common_CopyFailed"),
  errCopyFailed: t(lang, ns, "Error_CopyFailed"),
  outputSummary: t(lang, ns, "OutputSummary"),
  lang,
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-workbench" data-ent-tool>
  <ToolPanel title={s.inputLabel} for="ent-input">
    <Fragment slot="actions">
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-ent-clear>{s.actionClear}</button>
    </Fragment>
    <div class="ds-editor is-empty" data-ent-input-host>
      <textarea
        id="ent-input"
        class="ds-field-textarea mono"
        data-ent-input
        rows="10"
        spellcheck="false"
        aria-describedby="ent-input-empty"
      ></textarea>
      <EmptyState
        hint={s.emptyHint}
        hintId="ent-input-empty"
        exampleLabel={s.loadExample}
        buttonProps={{ "data-ent-example": true }}
      />
    </div>

    <div class="ds-settings" role="group" aria-label={s.settingsTitle}>
      <Field label={s.modeLabel} for="ent-mode">
        <select id="ent-mode" class="ds-field-select" data-ent-mode>
          <option value="specialchars" selected>{s.modeSpecialChars}</option>
          <option value="nonascii">{s.modeNonAscii}</option>
          <option value="all">{s.modeAll}</option>
        </select>
      </Field>
      <Field label={s.formatLabel} for="ent-format">
        <select id="ent-format" class="ds-field-select" data-ent-format>
          <option value="named" selected>{s.formatNamed}</option>
          <option value="decimal">{s.formatDecimal}</option>
          <option value="hex">{s.formatHex}</option>
        </select>
      </Field>
    </div>

    <div class="ds-action-row">
      <button type="button" class="ds-btn ds-btn-primary" data-ent-encode>{s.actionEncode}</button>
      <button type="button" class="ds-btn" data-ent-decode>{s.actionDecode}</button>
      <button type="button" class="ds-btn" data-ent-swap>{s.actionSwap}</button>
    </div>

    <StatusMessage kind="error" data-ent-error />
  </ToolPanel>

  <OutputPanel
    panel
    label={s.outputTitle}
    for="ent-output"
    emptyHint={s.outputEmpty}
    summaryProps={{ "data-ent-summary": true }}
    data-ent-output-panel
  >
    <Fragment slot="actions">
      <CopyButton ghost label={s.copy} copiedLabel={s.copied} failedLabel={s.copyFailed} data-ent-copy disabled />
    </Fragment>
    <textarea
      id="ent-output"
      class="ds-field-textarea mono ent-output ds-when-filled"
      data-ent-output
      rows="14"
      spellcheck="false"
      readonly
    ></textarea>
  </OutputPanel>
</div>

<script is:inline type="application/json" data-ent-strings set:html={stringsJson} />
<script>import "@/tools/html-entity-encoder.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .ent-output {
    overflow-wrap: anywhere;
  }
</style>
