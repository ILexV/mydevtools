---
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import AgentConnection from "@/components/tool/AgentConnection.astro";
import Field from "@/components/tool/Field.astro";
import Icon from "@/components/Icon.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import { editorPhrases } from "@/tools/editor-phrases";
import "@/styles/codemirror.css";

interface Props { lang: LocaleCode }
const { lang } = Astro.props as Props;
const ns = "tools/http-client";
const clientKeys = [
  "Connected", "Disconnected", "NotConnected", "Connecting", "Sending", "Canceled", "ResponseSummary", "PrivateAllowed",
  "PrivateBlocked", "DownloadName", "BinaryPreview", "NoResponse", "PreviewTruncated", "ErrorHeaders", "ErrorUrl", "ErrorBodyLimit",
  "ErrorGeneric", "Error_agent_unavailable", "Error_invalid_response", "Error_invalid_request", "Error_unauthorized",
  "Error_forbidden", "Error_pairing_invalid", "Error_pairing_expired", "Error_pairing_rate_limited",
  "Error_unsupported_capability", "Error_private_network_denied", "Error_target_denied", "Error_timeout",
  "Error_cancelled", "Error_response_too_large", "Error_request_too_large", "Error_busy", "Error_network_error",
  "Error_incompatible_protocol", "Error_vault_unavailable", "Error_vault_key_unavailable", "Error_vault_corrupt",
  "Error_vault_full", "Error_revision_conflict", "Error_not_found", "Error_secret_not_found", "Error_secret_host_denied", "ResponseBody", "EditorLoadError", "BodyLabel", "InvalidJson", "BodyEditorError", "ConnectionNotSaved",
  "HtmlPreviewError", "SavedRequests", "NewRequest", "RequestName", "UntitledRequest", "RenameRequest", "DeleteRequest",
  "DeleteRequestConfirm", "NewFolder", "FolderName", "RenameFolder", "DeleteFolder", "DeleteFolderConfirm", "MoveItem",
  "RootFolder", "SelectFolder", "ResizeSidebar", "FolderNameRequired", "WorkspacePrivacy", "WorkspaceSaveError",
  "WorkspaceLoadError", "WorkspacePrivacyAgent", "WorkspaceAgentLocked", "WorkspaceAgentRepair", "WorkspaceAgentLoadError",
  "WorkspaceAgentSaveError", "WorkspaceAgentMoved", "WorkspaceMerged", "WorkspaceImportedFolder", "SecretAddTitle",
  "SecretEditTitle", "SecretValueKeep", "SecretEdit", "SecretDelete", "SecretDeleteConfirm", "SecretCopy", "SecretCopyPlaceholder",
  "SecretCopied", "SecretSaved", "SecretDeleted", "SecretNameInvalid", "SecretNameTaken", "SecretValueInvalid", "SecretHostsInvalid",
  "KeyLabel", "ValueLabel", "EnabledLabel", "RemoveRow", "AddRow", "AuthType", "AuthInherit", "AuthNone", "AuthBasic", "AuthBearer",
  "AuthApiKey", "AuthOAuth2", "AuthAwsV4", "AuthUsername", "AuthPassword", "AuthToken", "AuthAddTo", "AuthInHeader", "AuthInQuery",
  "AuthTokenUrl", "AuthClientId", "AuthClientSecret", "AuthScope", "AuthClientAuth", "AuthClientAuthHeader", "AuthClientAuthBody",
  "AuthGetToken", "AuthAccessKey", "AuthSecretKey", "AuthSessionToken", "AuthRegion", "AuthService", "AuthHint", "AuthInheritFrom",
  "AuthInheritNone", "AuthInheritParent", "AuthTokenFetching", "AuthTokenReady", "AuthTokenReadyNoExpiry", "NoEnvironment",
  "GlobalVariables", "NewEnvironment", "NewEnvironmentName", "EnvironmentName", "DuplicateEnvironment", "DeleteEnvironment",
  "DeleteEnvironmentConfirm", "CopySuffix", "Variables", "FolderSettings", "FolderSettingsTitle", "UnresolvedVariables",
  "ErrorAuthIncomplete", "ErrorAwsSecret", "ErrorOAuthToken", "BodyFieldKind", "BodyKindText", "BodyKindFile",
  "BodyChooseFile", "BodyRemoveFile", "BodyFileMissing", "BodyBinary", "ErrorFileMissing",
  "ErrorGraphqlVariables", "ErrorFileUnset", "ErrorBinaryUnset", "ImportCurl", "CurlImported", "CurlIgnored", "CurlFiles", "CurlErrorNotCurl", "CurlErrorNoUrl",
  "CurlErrorQuote", "CodeCopied", "ImportPostman", "ExportPostman", "PostmanImported", "PostmanEnvironmentImported",
  "PostmanScripts", "PostmanUnsupported", "PostmanErrorFormat", "PostmanErrorVersion", "PostmanUntitled", "CloseTab", "UnsavedChanges", "History", "HistoryToday", "HistoryYesterday",
  "HistoryEmpty", "HistoryOff", "HistoryClearConfirm", "HistoryDelete", "HistoryLoadError", "HistorySaveError", "HistoryBodyDropped", "ScriptsLabel", "ScriptEditorError", "TestsPassed", "TestsSkipped", "ScriptErrorIn", "ScriptPre", "ScriptTest",
  "ScriptTimeout", "ScriptRunning", "RequestSkipped", "TreeMenu", "TreeHint", "Cancel", "AgentConnectedShort", "AgentDisconnectedShort", "AgentSettings",
] as const;
const strings = Object.fromEntries(clientKeys.map((key) => [key, t(lang, ns, key)]));
const stringsJson = JSON.stringify({ ...strings, Lang: lang, phrases: editorPhrases(lang) });
---

<div class="http-workbench" data-http-client>
  <aside class="http-saved" aria-labelledby="http-saved-title">
    <div class="http-saved-head">
      <h2 id="http-saved-title" class="ds-panel-title" title={t(lang, ns, "SavedRequests")}><span>{t(lang, ns, "SavedRequests")}</span></h2>
      <div class="http-saved-head-actions">
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-tree-action" aria-label={t(lang, ns, "NewRequest")} title={t(lang, ns, "NewRequest")} data-http-new>
          <Icon name="plus" size={15} />
        </button>
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-tree-action" aria-label={t(lang, ns, "NewFolder")} title={t(lang, ns, "NewFolder")} data-http-new-folder>
          <Icon name="folder" size={15} />
        </button>
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-tree-action" aria-label={t(lang, ns, "Secrets")} title={t(lang, ns, "Secrets")} aria-haspopup="dialog" hidden data-http-secrets>
          <Icon name="lock" size={15} />
        </button>
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-tree-action" aria-label={t(lang, ns, "History")} title={t(lang, ns, "History")} aria-pressed="false" aria-controls="http-history-panel" data-http-history-toggle>
          <Icon name="history" size={15} />
        </button>
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-tree-action" aria-label={t(lang, ns, "TreeMenu")} title={t(lang, ns, "TreeMenu")} aria-haspopup="menu" aria-controls="http-tree-menu" aria-expanded="false" data-http-tree-menu-button>
          <Icon name="more" size={15} />
        </button>
      </div>
    </div>
    <nav class="http-saved-list" aria-label={t(lang, ns, "SavedRequests")} tabindex="0" data-http-saved-list></nav>
    <section id="http-history-panel" class="http-history" aria-label={t(lang, ns, "History")} hidden data-http-history-panel>
      <label class="ds-check-row http-history-switch"><input class="ds-check" type="checkbox" data-http-history-enabled /><span>{t(lang, ns, "HistoryEnabled")}</span></label>
      <p class="ds-hint http-history-hint">{t(lang, ns, "HistoryHint")}</p>
      <StatusMessage kind="error" data-http-history-error />
      <p class="ds-hint http-history-empty" data-http-history-empty></p>
      <ul class="http-history-list" data-http-history-list></ul>
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-danger http-history-clear" hidden data-http-history-clear>{t(lang, ns, "HistoryClear")}</button>
    </section>
    <div class="http-saved-meta">
      <details class="http-workspace-info">
        <summary title={t(lang, ns, "WorkspacePrivacy")}><span aria-hidden="true">i</span> {t(lang, ns, "TreeHint")}</summary>
        <p class="ds-hint http-workspace-privacy" data-http-workspace-privacy>{t(lang, ns, "WorkspacePrivacy")}</p>
      </details>
      <StatusMessage kind="info" data-http-workspace-status />
      <StatusMessage kind="error" data-http-workspace-load-error />
      <StatusMessage kind="error" data-http-workspace-save-error />
    </div>
  </aside>
  <div id="http-tree-menu" class="http-tree-menu" role="menu" aria-label={t(lang, ns, "TreeMenu")} hidden data-http-tree-menu></div>
  <dialog class="http-move-dialog" aria-labelledby="http-move-title" data-http-move-dialog>
    <form method="dialog">
      <h2 id="http-move-title" class="ds-panel-title">{t(lang, ns, "MoveItem")}</h2>
      <label class="http-move-field">
        <span>{t(lang, ns, "SelectFolder")}</span>
        <select class="ds-field-select" data-http-move-destination></select>
      </label>
      <div class="ds-actions">
        <button type="submit" class="ds-btn ds-btn-small ds-btn-ghost" value="cancel">{t(lang, ns, "Cancel")}</button>
        <button type="button" class="ds-btn ds-btn-small ds-btn-primary" data-http-move-confirm>{t(lang, ns, "MoveItem")}</button>
      </div>
    </form>
  </dialog>
  <dialog class="http-move-dialog http-secrets-dialog" aria-labelledby="http-secrets-title" aria-describedby="http-secrets-hint" data-http-secrets-dialog>
    <div class="http-secrets-head">
      <h2 id="http-secrets-title" class="ds-panel-title">{t(lang, ns, "Secrets")}</h2>
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-tree-action" aria-label={t(lang, ns, "SecretsClose")} title={t(lang, ns, "SecretsClose")} data-http-secrets-close>
        <Icon name="close" size={15} />
      </button>
    </div>
    <p id="http-secrets-hint" class="ds-hint http-secrets-hint">{t(lang, ns, "SecretsHint", { params: { placeholder: "{{secret:name}}" } })}</p>
    <ul class="http-secrets-list" aria-labelledby="http-secrets-title" hidden data-http-secrets-list></ul>
    <p class="ds-hint http-secrets-empty" data-http-secrets-empty>{t(lang, ns, "SecretsEmpty")}</p>
    <form class="http-secrets-form" novalidate data-http-secrets-form>
      <h3 class="http-secrets-form-title" data-http-secrets-form-title>{t(lang, ns, "SecretAddTitle")}</h3>
      <label class="http-move-field">
        <span>{t(lang, ns, "SecretName")}</span>
        <input class="ds-field mono" type="text" maxlength="64" autocomplete="off" spellcheck="false" placeholder="API_TOKEN" required data-http-secret-name />
      </label>
      <label class="http-move-field">
        <span>{t(lang, ns, "SecretValue")}</span>
        <input class="ds-field mono" type="password" autocomplete="new-password" spellcheck="false" aria-describedby="http-secret-value-hint" required data-http-secret-value />
        <span id="http-secret-value-hint" class="ds-hint" hidden data-http-secret-value-hint>{t(lang, ns, "SecretValueKeep")}</span>
      </label>
      <label class="http-move-field">
        <span>{t(lang, ns, "SecretHosts")}</span>
        <input class="ds-field mono" type="text" autocomplete="off" spellcheck="false" placeholder="api.example.com, *.example.com" aria-describedby="http-secret-hosts-hint" required data-http-secret-hosts />
        <span id="http-secret-hosts-hint" class="ds-hint">{t(lang, ns, "SecretHostsHint")}</span>
      </label>
      <StatusMessage kind="error" data-http-secrets-error />
      <StatusMessage kind="success" data-http-secrets-status />
      <div class="ds-actions">
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" hidden data-http-secret-cancel-edit>{t(lang, ns, "Cancel")}</button>
        <button type="submit" class="ds-btn ds-btn-small ds-btn-primary" data-http-secret-save>{t(lang, ns, "SecretSave")}</button>
      </div>
    </form>
  </dialog>
  <dialog class="http-move-dialog http-secrets-dialog" aria-labelledby="http-env-title" data-http-env-dialog>
    <div class="http-secrets-head">
      <h2 id="http-env-title" class="ds-panel-title">{t(lang, ns, "Environments")}</h2>
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-tree-action" aria-label={t(lang, ns, "SecretsClose")} title={t(lang, ns, "SecretsClose")} data-http-env-close>
        <Icon name="close" size={15} />
      </button>
    </div>
    <p class="ds-hint http-secrets-hint">{t(lang, ns, "EnvironmentsHint")}</p>
    <div class="http-env-bar">
      <label class="http-move-field">
        <span>{t(lang, ns, "VariableSet")}</span>
        <select class="ds-field-select" data-http-env-set></select>
      </label>
      <button type="button" class="ds-btn ds-btn-small" data-http-env-new><Icon name="plus" size={14} />{t(lang, ns, "NewEnvironment")}</button>
    </div>
    <div class="http-env-bar" hidden data-http-env-name-row>
      <label class="http-move-field">
        <span>{t(lang, ns, "EnvironmentName")}</span>
        <input class="ds-field" type="text" autocomplete="off" spellcheck="false" data-http-env-name />
      </label>
      <div class="http-env-actions">
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-http-env-duplicate>{t(lang, ns, "DuplicateEnvironment")}</button>
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-danger" data-http-env-delete>{t(lang, ns, "DeleteEnvironment")}</button>
      </div>
    </div>
    <div data-http-env-rows></div>
  </dialog>
  <dialog class="http-move-dialog http-secrets-dialog" aria-labelledby="http-folder-title" data-http-folder-dialog>
    <div class="http-secrets-head">
      <h2 id="http-folder-title" class="ds-panel-title" data-http-folder-title></h2>
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-tree-action" aria-label={t(lang, ns, "SecretsClose")} title={t(lang, ns, "SecretsClose")} data-http-folder-close>
        <Icon name="close" size={15} />
      </button>
    </div>
    <h3 class="http-secrets-form-title">{t(lang, ns, "AuthLabel")}</h3>
    <div data-http-folder-auth></div>
    <h3 class="http-secrets-form-title">{t(lang, ns, "Variables")}</h3>
    <p class="ds-hint http-secrets-hint">{t(lang, ns, "FolderVariablesHint")}</p>
    <div data-http-folder-rows></div>
    <h3 class="http-secrets-form-title">{t(lang, ns, "ScriptsLabel")}</h3>
    <p class="ds-hint http-secrets-hint">{t(lang, ns, "FolderScriptsHint")}</p>
    <label class="http-auth-field" for="http-folder-script-pre">{t(lang, ns, "ScriptPre")}</label>
    <textarea id="http-folder-script-pre" class="ds-field-textarea mono http-folder-script" rows="4" autocomplete="off" spellcheck="false" data-http-folder-script="pre"></textarea>
    <label class="http-auth-field" for="http-folder-script-test">{t(lang, ns, "ScriptTest")}</label>
    <textarea id="http-folder-script-test" class="ds-field-textarea mono http-folder-script" rows="4" autocomplete="off" spellcheck="false" data-http-folder-script="test"></textarea>
  </dialog>
  <dialog class="http-move-dialog http-secrets-dialog" aria-labelledby="http-import-title" aria-describedby="http-import-hint" data-http-import-dialog>
    <form method="dialog" class="http-import-form" data-http-import-form>
      <div class="http-secrets-head">
        <h2 id="http-import-title" class="ds-panel-title">{t(lang, ns, "ImportCurlTitle")}</h2>
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-tree-action" aria-label={t(lang, ns, "SecretsClose")} title={t(lang, ns, "SecretsClose")} data-http-import-close>
          <Icon name="close" size={15} />
        </button>
      </div>
      <p class="ds-hint http-secrets-hint" id="http-import-hint">{t(lang, ns, "ImportCurlHint")}</p>
      <label class="visually-hidden" for="http-import-text">{t(lang, ns, "ImportCurlLabel")}</label>
      <textarea id="http-import-text" class="ds-field-textarea mono http-import-text" rows="8" autocomplete="off" spellcheck="false" placeholder="curl 'https://api.example.com/items' -H 'Accept: application/json'" data-http-import-text></textarea>
      <StatusMessage kind="error" data-http-import-error />
      <div class="ds-actions">
        <button type="submit" class="ds-btn ds-btn-small ds-btn-primary" data-http-import-submit>{t(lang, ns, "ImportCurlSubmit")}</button>
      </div>
    </form>
  </dialog>
  <dialog class="http-move-dialog http-secrets-dialog http-code-dialog" aria-labelledby="http-code-title" data-http-code-dialog>
    <div class="http-secrets-head">
      <h2 id="http-code-title" class="ds-panel-title">{t(lang, ns, "CodeTitle")}</h2>
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-tree-action" aria-label={t(lang, ns, "SecretsClose")} title={t(lang, ns, "SecretsClose")} data-http-code-close>
        <Icon name="close" size={15} />
      </button>
    </div>
    <div class="http-env-bar">
      <label class="http-move-field">
        <span>{t(lang, ns, "CodeLanguage")}</span>
        <select class="ds-field-select" data-http-code-language>
          <option value="curl">cURL</option>
          <option value="fetch">JavaScript fetch</option>
          <option value="python">Python requests</option>
          <option value="httpie">HTTPie</option>
        </select>
      </label>
      <button type="button" class="ds-btn ds-btn-small" data-http-code-copy><Icon name="copy" size={14} />{t(lang, ns, "CodeCopy")}</button>
    </div>
    <p class="ds-hint http-secrets-hint">{t(lang, ns, "CodeHint")}</p>
    <StatusMessage kind="error" data-http-code-error />
    <pre class="http-code-output mono" tabindex="0" aria-labelledby="http-code-title" data-http-code-output></pre>
  </dialog>
  <div
    class="http-sidebar-resizer"
    role="separator"
    tabindex="0"
    aria-label={t(lang, ns, "ResizeSidebar")}
    aria-orientation="vertical"
    aria-valuemin="192"
    aria-valuemax="480"
    aria-valuenow="240"
    data-http-sidebar-resizer
  ></div>
  <div class="ds-card http-main">
  <section class="http-request" aria-label={t(lang, ns, "RequestTitle")}>
    <div class="http-open-tabs">
      <div class="http-open-tablist" role="tablist" aria-label={t(lang, ns, "OpenTabs")} data-http-open-tablist></div>
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-tree-action http-tab-new" aria-label={t(lang, ns, "NewRequest")} title={t(lang, ns, "NewRequest")} data-http-tab-new>
        <Icon name="plus" size={15} />
      </button>
    </div>
    <div class="http-section-heading">
      <Icon name="globe" size={16} />
      <label class="visually-hidden" for="http-request-name">{t(lang, ns, "RequestName")}</label>
      <input id="http-request-name" class="http-request-name" type="text" autocomplete="off" spellcheck="false" placeholder={t(lang, ns, "UntitledRequest")} data-http-request-name />
      <div class="http-env-switch">
        <label class="visually-hidden" for="http-env-active">{t(lang, ns, "Environment")}</label>
        <select id="http-env-active" class="ds-field-select http-env-select" title={t(lang, ns, "Environment")} data-http-env-active>
          <option value="">{t(lang, ns, "NoEnvironment")}</option>
        </select>
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-tree-action" aria-label={t(lang, ns, "Environments")} title={t(lang, ns, "Environments")} aria-haspopup="dialog" data-http-env-open>
          <Icon name="layers" size={15} />
        </button>
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-tree-action" aria-label={t(lang, ns, "CodeTitle")} title={t(lang, ns, "CodeTitle")} aria-haspopup="dialog" data-http-code-open>
          <Icon name="encoding" size={15} />
        </button>
      </div>
      <AgentConnection lang={lang} ns={ns} prefix="http">
        <p class="ds-hint">{t(lang, ns, "LimitsNote")}</p>
        <p class="ds-hint">{t(lang, ns, "PrivateSetupNote")}</p>
      </AgentConnection>
    </div>
    <div class="http-compose">
      <label class="visually-hidden" for="http-method">{t(lang, ns, "MethodLabel")}</label>
      <select id="http-method" class="ds-field-select mono" data-http-method>
        { ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"].map((method) => <option value={method}>{method}</option>) }
      </select>
      <label class="visually-hidden" for="http-url">{t(lang, ns, "UrlLabel")}</label>
      <input id="http-url" class="ds-field mono" type="text" inputmode="url" placeholder="https://api.example.com/data" autocomplete="off" spellcheck="false" data-http-url />
      <div class="http-send-actions">
        <button type="button" class="ds-btn ds-btn-primary" disabled data-http-send><Icon name="zap" size={16} />{t(lang, ns, "Send")}</button>
        <button type="button" class="ds-btn" disabled hidden data-http-cancel>{t(lang, ns, "Cancel")}</button>
      </div>
    </div>

    <StatusMessage kind="warning" class="http-variables-warning" data-http-variables-warning />
    <div class="seg http-tabs" role="tablist" aria-label={t(lang, ns, "RequestTitle")} data-http-tabs>
      <button type="button" role="tab" id="http-request-params-tab" aria-selected="true" aria-controls="http-request-params-panel" tabindex="0">{t(lang, ns, "ParamsLabel")}<span class="http-count mono" data-http-params-count></span></button>
      <button type="button" role="tab" id="http-request-auth-tab" aria-selected="false" aria-controls="http-request-auth-panel" tabindex="-1">{t(lang, ns, "AuthLabel")}<span class="http-count mono" data-http-auth-mark></span></button>
      <button type="button" role="tab" id="http-request-headers-tab" aria-selected="false" aria-controls="http-request-headers-panel" tabindex="-1">{t(lang, ns, "HeadersLabel")}<span class="http-count mono" data-http-headers-count></span></button>
      <button type="button" role="tab" id="http-request-body-tab" aria-selected="false" aria-controls="http-request-body-panel" tabindex="-1">{t(lang, ns, "BodyLabel")}<span class="http-count mono" data-http-body-mark></span></button>
      <button type="button" role="tab" id="http-request-scripts-tab" aria-selected="false" aria-controls="http-request-scripts-panel" tabindex="-1">{t(lang, ns, "ScriptsLabel")}<span class="http-count mono" data-http-scripts-mark></span></button>
      <button type="button" role="tab" id="http-request-settings-tab" aria-selected="false" aria-controls="http-request-settings-panel" tabindex="-1">{t(lang, ns, "SettingsLabel")}</button>
    </div>
    {(["params", "headers"] as const).map((kind) => (
      <div id={`http-request-${kind}-panel`} class="http-tab-panel http-table-panel" role="tabpanel" aria-labelledby={`http-request-${kind}-tab`} hidden={kind !== "params"}>
        <p class="ds-hint http-table-hint">{t(lang, ns, kind === "params" ? "ParamsHint" : "HeadersHint")}</p>
        <div class="http-table-scroll">
          <table class="http-kv-table" aria-label={t(lang, ns, kind === "params" ? "ParamsLabel" : "HeadersLabel")} data-http-table={kind}>
            <thead><tr>
              <th class="http-check-cell"><span class="visually-hidden">{t(lang, ns, "EnabledLabel")}</span></th>
              <th scope="col">{t(lang, ns, "KeyLabel")}</th>
              <th scope="col">{t(lang, ns, "ValueLabel")}</th>
              <th class="http-remove-cell"><span class="visually-hidden">{t(lang, ns, "RemoveRow")}</span></th>
            </tr></thead>
            <tbody></tbody>
          </table>
        </div>
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-add-row" data-http-add-row={kind}><Icon name="plus" size={14} />{t(lang, ns, "AddRow")}</button>
      </div>
    ))}
    <div id="http-request-auth-panel" class="http-tab-panel" role="tabpanel" aria-labelledby="http-request-auth-tab" hidden data-http-auth-host></div>
    <div id="http-request-body-panel" class="http-tab-panel" role="tabpanel" aria-labelledby="http-request-body-tab" hidden>
      <div class="ds-action-row http-body-toolbar">
        <label class="visually-hidden" for="http-body-mode">{t(lang, ns, "BodyModeLabel")}</label>
        <select id="http-body-mode" class="ds-field-select" data-http-body-mode>
          <option value="none">{t(lang, ns, "BodyNone")}</option>
