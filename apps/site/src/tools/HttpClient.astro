---
import { t } from "@/i18n/messages";
import { localizedPath } from "@/lib/url";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import Icon from "@/components/Icon.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import { editorPhrases } from "@/tools/editor-phrases";
import "@/styles/codemirror.css";

interface Props { lang: LocaleCode }
const { lang } = Astro.props as Props;
const ns = "tools/http-client";
const agentHref = localizedPath(lang, "local-agent");
const clientKeys = [
  "Connected", "Disconnected", "NotConnected", "Connecting", "Sending", "Canceled", "ResponseSummary", "PrivateAllowed",
  "PrivateBlocked", "DownloadName", "BinaryPreview", "NoResponse", "PreviewTruncated", "ErrorHeaders", "ErrorUrl", "ErrorBodyLimit",
  "ErrorGeneric", "Error_agent_unavailable", "Error_invalid_response", "Error_invalid_request", "Error_unauthorized",
  "Error_forbidden", "Error_pairing_invalid", "Error_pairing_expired", "Error_pairing_rate_limited",
  "Error_unsupported_capability", "Error_private_network_denied", "Error_target_denied", "Error_timeout",
  "Error_cancelled", "Error_response_too_large", "Error_request_too_large", "Error_busy", "Error_network_error",
  "Error_incompatible_protocol", "ResponseBody", "EditorLoadError", "BodyLabel", "InvalidJson", "BodyEditorError", "ConnectionNotSaved",
  "HtmlPreviewError", "SavedRequests", "NewRequest", "RequestName", "UntitledRequest", "DeleteRequest", "DeleteRequestConfirm",
  "NewFolder", "FolderName", "RenameFolder", "DeleteFolder", "DeleteFolderConfirm", "MoveToFolder", "RootFolder",
  "SelectFolder", "ResizeSidebar", "FolderNameRequired", "FolderParent", "FolderActions",
  "WorkspacePrivacy", "WorkspaceSaveError", "WorkspaceLoadError", "AgentConnectedShort", "AgentDisconnectedShort", "AgentSettings",
] as const;
const strings = Object.fromEntries(clientKeys.map((key) => [key, t(lang, ns, key)]));
const stringsJson = JSON.stringify({ ...strings, Lang: lang, phrases: editorPhrases(lang) });
---

<div class="http-workbench" data-http-client>
  <aside class="http-saved" aria-labelledby="http-saved-title">
    <div class="http-saved-head">
      <h2 id="http-saved-title" class="ds-panel-title">{t(lang, ns, "SavedRequests")}</h2>
      <div class="http-saved-head-actions">
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-http-new-folder><Icon name="plus" size={14} />{t(lang, ns, "NewFolder")}</button>
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-http-new><Icon name="plus" size={14} />{t(lang, ns, "NewRequest")}</button>
      </div>
    </div>
    <nav class="http-saved-list" aria-label={t(lang, ns, "SavedRequests")} data-http-saved-list></nav>
    <div class="http-saved-footer">
      <div class="http-folder-actions" aria-label={t(lang, ns, "FolderActions")} data-http-folder-actions hidden>
        <div class="http-folder-buttons">
          <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-http-rename-folder>{t(lang, ns, "RenameFolder")}</button>
          <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-delete-folder" data-http-delete-folder>{t(lang, ns, "DeleteFolder")}</button>
        </div>
        <label class="http-sidebar-field">
          <span>{t(lang, ns, "FolderParent")}</span>
          <select class="ds-field-select" data-http-folder-parent></select>
        </label>
      </div>
      <label class="http-sidebar-field">
        <span>{t(lang, ns, "MoveToFolder")}</span>
        <select class="ds-field-select" data-http-request-folder></select>
      </label>
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-delete-request" data-http-delete>{t(lang, ns, "DeleteRequest")}</button>
      <p class="ds-hint http-workspace-privacy">{t(lang, ns, "WorkspacePrivacy")}</p>
      <StatusMessage kind="error" data-http-workspace-load-error />
      <StatusMessage kind="error" data-http-workspace-save-error />
    </div>
  </aside>
  <div
    class="http-sidebar-resizer"
    role="separator"
    tabindex="0"
    aria-label={t(lang, ns, "ResizeSidebar")}
    aria-orientation="vertical"
    aria-valuemin="192"
    aria-valuemax="480"
    aria-valuenow="240"
    data-http-sidebar-resizer
  ></div>
  <div class="ds-card http-main">
  <section class="http-request" aria-label={t(lang, ns, "RequestTitle")}>
    <div class="http-section-heading">
      <Icon name="globe" size={16} />
      <label class="visually-hidden" for="http-request-name">{t(lang, ns, "RequestName")}</label>
      <input id="http-request-name" class="http-request-name" type="text" autocomplete="off" spellcheck="false" placeholder={t(lang, ns, "UntitledRequest")} data-http-request-name />
      <details class="http-connect" open data-http-agent-settings>
        <summary class="http-connect-summary" title={t(lang, ns, "AgentSettings")}>
          <span class="http-connection-dot" aria-hidden="true"></span>
          <span class="http-connection-state" data-http-connection-state>{t(lang, ns, "AgentDisconnectedShort")}</span>
          <Icon name="settings" size={15} />
          <span class="visually-hidden">{t(lang, ns, "AgentSettings")}</span>
        </summary>
        <div class="http-connect-body">
          <h2 class="ds-panel-title">{t(lang, ns, "ConnectionTitle")}</h2>
          <div class="http-connect-row">
            <Field label={t(lang, ns, "PairCodeLabel")} for="http-pair-code" hint={t(lang, ns, "PairCodeHint")}>
              <input id="http-pair-code" class="ds-field mono" type="password" autocomplete="one-time-code" spellcheck="false" data-http-code />
            </Field>
            <p class="ds-hint">{t(lang, ns, "RememberConnectionHint")}</p>
            <div class="ds-action-row http-connect-actions">
              <button type="button" class="ds-btn ds-btn-primary" data-http-connect>{t(lang, ns, "Connect")}</button>
              <button type="button" class="ds-btn" data-http-disconnect disabled>{t(lang, ns, "Disconnect")}</button>
            </div>
          </div>
          <dl class="http-agent-meta" data-http-agent-meta hidden>
            <div><dt>{t(lang, ns, "AgentVersion")}</dt><dd class="mono" data-http-agent-version></dd></div>
            <div><dt>{t(lang, ns, "Capability")}</dt><dd class="mono">http.request</dd></div>
            <div><dt>{t(lang, ns, "LanPolicy")}</dt><dd data-http-lan></dd></div>
          </dl>
          <StatusMessage kind="info" data-http-connection-status />
          <StatusMessage kind="error" data-http-connection-error />
          <StatusMessage kind="info" data-http-storage-warning />
          <details class="http-setup">
            <summary>{t(lang, ns, "SetupTitle")}</summary>
            <div class="http-setup-body">
              <p class="ds-hint">{t(lang, ns, "SetupIntro")}</p>
              <a class="http-agent-link" href={agentHref}>{t(lang, ns, "InstallAgent")}</a>
              <ol class="http-steps">
                <li>{t(lang, ns, "SetupStep2")}</li>
                <li>{t(lang, ns, "SetupStep3")}</li>
                <li>{t(lang, ns, "SetupStep4")}</li>
              </ol>
              <p class="ds-hint">{t(lang, ns, "LimitsNote")}</p>
              <p class="ds-hint">{t(lang, ns, "PrivateSetupNote")}</p>
              <p class="ds-hint http-privacy">{t(lang, ns, "PrivacyNote")}</p>
            </div>
          </details>
        </div>
      </details>
    </div>
    <div class="http-compose">
      <label class="visually-hidden" for="http-method">{t(lang, ns, "MethodLabel")}</label>
      <select id="http-method" class="ds-field-select mono" data-http-method>
        { ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"].map((method) => <option value={method}>{method}</option>) }
      </select>
      <label class="visually-hidden" for="http-url">{t(lang, ns, "UrlLabel")}</label>
      <input id="http-url" class="ds-field mono" type="url" inputmode="url" placeholder="https://api.example.com/data" autocomplete="off" spellcheck="false" data-http-url />
      <div class="http-send-actions">
        <button type="button" class="ds-btn ds-btn-primary" disabled data-http-send><Icon name="zap" size={16} />{t(lang, ns, "Send")}</button>
        <button type="button" class="ds-btn" disabled hidden data-http-cancel>{t(lang, ns, "Cancel")}</button>
      </div>
    </div>

    <div class="seg http-tabs" role="tablist" aria-label={t(lang, ns, "RequestTitle")} data-http-tabs>
      <button type="button" role="tab" id="http-request-params-tab" aria-selected="true" aria-controls="http-request-params-panel" tabindex="0">{t(lang, ns, "ParamsLabel")}<span class="http-count mono" data-http-params-count></span></button>
      <button type="button" role="tab" id="http-request-headers-tab" aria-selected="false" aria-controls="http-request-headers-panel" tabindex="-1">{t(lang, ns, "HeadersLabel")}<span class="http-count mono" data-http-headers-count></span></button>
      <button type="button" role="tab" id="http-request-body-tab" aria-selected="false" aria-controls="http-request-body-panel" tabindex="-1">{t(lang, ns, "BodyLabel")}</button>
      <button type="button" role="tab" id="http-request-settings-tab" aria-selected="false" aria-controls="http-request-settings-panel" tabindex="-1">{t(lang, ns, "SettingsLabel")}</button>
    </div>
    {(["params", "headers"] as const).map((kind) => (
      <div id={`http-request-${kind}-panel`} class="http-tab-panel http-table-panel" role="tabpanel" aria-labelledby={`http-request-${kind}-tab`} hidden={kind !== "params"}>
        <p class="ds-hint http-table-hint">{t(lang, ns, kind === "params" ? "ParamsHint" : "HeadersHint")}</p>
        <div class="http-table-scroll">
          <table class="http-kv-table" aria-label={t(lang, ns, kind === "params" ? "ParamsLabel" : "HeadersLabel")} data-http-table={kind}>
            <thead><tr>
              <th class="http-check-cell"><span class="visually-hidden">{t(lang, ns, "EnabledLabel")}</span></th>
              <th scope="col">{t(lang, ns, "KeyLabel")}</th>
              <th scope="col">{t(lang, ns, "ValueLabel")}</th>
              <th class="http-remove-cell"><span class="visually-hidden">{t(lang, ns, "RemoveRow")}</span></th>
            </tr></thead>
            <tbody></tbody>
          </table>
        </div>
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost http-add-row" data-http-add-row={kind}><Icon name="plus" size={14} />{t(lang, ns, "AddRow")}</button>
      </div>
    ))}
    <div id="http-request-body-panel" class="http-tab-panel" role="tabpanel" aria-labelledby="http-request-body-tab" hidden>
      <div class="ds-action-row http-body-toolbar">
        <label class="visually-hidden" for="http-body-format">{t(lang, ns, "BodyFormatLabel")}</label>
        <select id="http-body-format" class="ds-field-select" data-http-body-format>
          <option value="text">{t(lang, ns, "TextFormat")}</option>
          <option value="json">JSON</option>
          <option value="html">HTML</option>
          <option value="xml">XML</option>
        </select>
        <button type="button" class="ds-btn ds-btn-small" data-http-format-json disabled>{t(lang, ns, "FormatJson")}</button>
      </div>
      <p class="ds-hint" id="http-body-hint">{t(lang, ns, "BodyHint")}</p>
      <StatusMessage kind="error" data-http-body-error />
      <StatusMessage kind="error" data-http-body-editor-error />
      <div class="mdt-cm http-body-editor" data-http-body-editor hidden></div>
      <label class="visually-hidden" for="http-body">{t(lang, ns, "BodyLabel")}</label>
      <textarea id="http-body" class="ds-field-textarea mono http-body" aria-describedby="http-body-hint" rows="10" autocomplete="off" spellcheck="false" data-http-body></textarea>
    </div>
    <div id="http-request-settings-panel" class="http-tab-panel" role="tabpanel" aria-labelledby="http-request-settings-tab" hidden>
      <div class="ds-settings http-options">
        <Field label={t(lang, ns, "TimeoutLabel")} for="http-timeout" hint={t(lang, ns, "TimeoutHint")}>
          <input id="http-timeout" class="ds-field mono" type="number" min="100" max="120000" step="100" value="30000" data-http-timeout />
        </Field>
        <label class="ds-check-row http-redirects"><input class="ds-check" type="checkbox" data-http-redirects /><span>{t(lang, ns, "FollowRedirects")}</span></label>
      </div>
    </div>
    <StatusMessage kind="info" data-http-request-status />
    <StatusMessage kind="error" data-http-request-error />
  </section>

  <OutputPanel label={t(lang, ns, "ResponseTitle")} emptyHint={t(lang, ns, "NoResponse")} class="http-response" data-http-output>
    <Fragment slot="actions">
      <dl class="http-response-meta" hidden data-http-response-meta>
        <div><dt class="visually-hidden">{t(lang, ns, "StatusLabel")}</dt><dd class="mono" data-http-response-status></dd></div>
        <div><dt class="visually-hidden">{t(lang, ns, "TimeLabel")}</dt><dd class="mono" data-http-response-time></dd></div>
        <div><dt class="visually-hidden">{t(lang, ns, "SizeLabel")}</dt><dd class="mono" data-http-response-size></dd></div>
      </dl>
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" disabled data-http-download><Icon name="download" size={15} />{t(lang, ns, "Download")}</button>
    </Fragment>
    <div class="ds-when-filled http-result" hidden data-http-result>
      <div class="seg http-tabs" role="tablist" aria-label={t(lang, ns, "ResponseTitle")} data-http-tabs>
        <button type="button" role="tab" id="http-response-body-tab" aria-selected="true" aria-controls="http-response-body-panel" tabindex="0">{t(lang, ns, "ResponseBody")}</button>
        <button type="button" role="tab" id="http-response-headers-tab" aria-selected="false" aria-controls="http-response-headers-panel" tabindex="-1">{t(lang, ns, "ResponseHeaders")}</button>
      </div>
      <section id="http-response-body-panel" class="http-tab-panel" role="tabpanel" aria-labelledby="http-response-body-tab">
        <div class="http-view-toolbar">
          <div class="seg http-view-modes" role="group" aria-label={t(lang, ns, "ResponseView")}>
            <button type="button" aria-pressed="true" data-http-view="pretty" disabled>{t(lang, ns, "PrettyLabel")}</button>
            <button type="button" aria-pressed="false" data-http-view="raw">{t(lang, ns, "RawLabel")}</button>
            <button type="button" aria-pressed="false" data-http-view="html" hidden>{t(lang, ns, "HtmlPreview")}</button>
          </div>
          <span class="ds-hint mono" data-http-response-type></span>
        </div>
        <StatusMessage kind="error" data-http-editor-error />
        <div class="mdt-cm http-response-editor" data-http-response-editor hidden></div>
        <pre class="ds-code-block mono http-preview" tabindex="0" data-http-response-preview></pre>
        <div data-http-html-preview hidden>
          <p class="ds-hint http-html-hint">{t(lang, ns, "HtmlPreviewHint")}</p>
          <iframe class="http-html-frame" title={t(lang, ns, "HtmlPreview")} sandbox="" referrerpolicy="no-referrer" data-http-html-frame></iframe>
        </div>
      </section>
      <section id="http-response-headers-panel" class="http-tab-panel" role="tabpanel" aria-labelledby="http-response-headers-tab" hidden>
        <pre class="ds-code-block mono http-preview" tabindex="0" data-http-response-headers></pre>
      </section>
      <p class="http-final-url"><span>{t(lang, ns, "FinalUrlLabel")}</span><code data-http-response-url></code></p>
    </div>
  </OutputPanel>
  </div>
  <template data-http-row-template>
    <tr>
      <td class="http-check-cell"><input type="checkbox" class="ds-check" checked aria-label={t(lang, ns, "EnabledLabel")} data-row-enabled /></td>
      <td><input class="ds-field mono" type="text" aria-label={t(lang, ns, "KeyLabel")} placeholder={t(lang, ns, "KeyLabel")} autocomplete="off" spellcheck="false" data-row-key /></td>
      <td><input class="ds-field mono" type="text" aria-label={t(lang, ns, "ValueLabel")} placeholder={t(lang, ns, "ValueLabel")} autocomplete="off" spellcheck="false" data-row-value /></td>
      <td class="http-remove-cell"><button type="button" class="ds-btn ds-btn-small ds-btn-ghost" aria-label={t(lang, ns, "RemoveRow")} title={t(lang, ns, "RemoveRow")} data-row-remove><Icon name="close" size={14} /></button></td>
    </tr>
  </template>

</div>

<script is:inline type="application/json" data-http-strings set:html={stringsJson} />
<script>import "@/tools/http-client.client.ts";</script>

<style>
  .http-workbench { --http-sidebar-width: 15rem; display: grid; grid-template-columns: minmax(12rem, var(--http-sidebar-width)) 0.55rem minmax(0, 1fr); align-items: stretch; max-width: 100%; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius); overflow: hidden; background: var(--mdt-surface-raised); }
  .http-saved { display: flex; min-width: 0; min-height: 36rem; flex-direction: column; background: var(--mdt-surface-muted); }
  .http-saved-head { display: grid; gap: 0.5rem; min-height: 2.75rem; padding: 0.55rem 0.65rem; border-bottom: 1px solid var(--mdt-border-soft); }
  .http-saved-head h2 { margin: 0; }
  .http-saved-head-actions, .http-folder-buttons { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .http-saved-head .ds-btn { min-width: 0; flex: 1 1 auto; padding-inline: 0.4rem; }
  .http-saved-list { display: block; flex: 1 1 auto; min-height: 0; overflow: auto; padding: 0.4rem; }
  .http-saved-list :global(.http-tree-group) { display: grid; gap: 0.12rem; margin: 0; padding: 0; list-style: none; }
  .http-saved-list :global(.http-tree-children) { padding-left: 0.8rem; }
  .http-saved-list :global(.http-tree-row) { display: grid; grid-template-columns: 1.7rem minmax(0, 1fr); align-items: center; min-width: 0; }
  .http-saved-list :global(.http-folder-toggle) { width: 1.65rem; min-width: 0; min-height: 1.65rem; padding: 0; color: var(--mdt-text-faint); }
  .http-saved-list :global(.http-folder-toggle-spacer) { width: 1.65rem; }
  .http-saved-list :global(.http-folder-select) { min-width: 0; min-height: 1.8rem; justify-content: flex-start; overflow: hidden; padding: 0.25rem 0.4rem; color: var(--mdt-text-muted); text-align: left; }
  .http-saved-list :global(.http-folder-select[aria-pressed="true"]) { color: var(--mdt-text); background: var(--mdt-surface-raised); box-shadow: inset 2px 0 var(--mdt-cat); }
  .http-saved-list :global(.http-folder-name) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .http-saved-list :global(.http-saved-item) { display: grid; grid-template-columns: 3.25rem minmax(0, 1fr); gap: 0.35rem; width: 100%; min-width: 0; min-height: 1.9rem; justify-content: stretch; padding: 0.3rem 0.45rem; color: var(--mdt-text-muted); text-align: left; }
  .http-saved-list :global(.http-saved-item:hover) { background: var(--mdt-surface-raised); color: var(--mdt-text); }
  .http-saved-list :global(.http-saved-item[aria-pressed="true"]) { background: var(--mdt-surface-raised); color: var(--mdt-text); box-shadow: inset 2px 0 var(--mdt-cat); }
  .http-saved-list :global(.http-saved-method) { min-width: 0; color: var(--mdt-cat); font-size: var(--mdt-fs-meta); font-weight: 700; }
  .http-saved-list :global(.http-saved-name) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--mdt-fs-label); font-weight: 650; }
  .http-saved-footer { display: grid; gap: 0.55rem; margin-top: auto; padding: 0.65rem; border-top: 1px solid var(--mdt-border-soft); }
  .http-folder-actions { display: grid; gap: 0.55rem; }
  .http-folder-actions[hidden] { display: none; }
  .http-folder-buttons > .ds-btn { flex: 1 1 auto; }
  .http-delete-folder, .http-delete-request { color: var(--mdt-danger); }
  .http-delete-request { justify-self: start; }
  .http-sidebar-field { display: grid; gap: 0.25rem; min-width: 0; color: var(--mdt-text-muted); font-size: var(--mdt-fs-meta); }
  .http-sidebar-field .ds-field-select { width: 100%; min-width: 0; }
  .http-workspace-privacy { margin: 0; font-size: var(--mdt-fs-meta); }
  .http-saved-footer :global(.ds-alert) { margin: 0; }
  .http-sidebar-resizer { position: relative; z-index: 1; width: 100%; cursor: col-resize; touch-action: none; background: var(--mdt-border-soft); }
  .http-sidebar-resizer::after { position: absolute; inset: 0 0 0 50%; width: 2px; content: ""; transform: translateX(-50%); background: transparent; }
  .http-sidebar-resizer:is(:hover, :focus-visible, .is-dragging)::after { background: var(--mdt-cat); }
  .http-sidebar-resizer:focus-visible { outline: 2px solid var(--mdt-cat); outline-offset: -2px; }
  .http-main { min-width: 0; padding: 0; border: 0; border-radius: 0; box-shadow: none; }
  .http-request { min-width: 0; }
  .http-section-heading { position: relative; z-index: 2; display: flex; align-items: center; gap: 0.5rem; height: 2.75rem; padding-inline: 1rem 0.65rem; border-bottom: 1px solid var(--mdt-border-soft); color: var(--mdt-text-muted); }
  .http-request-name { min-width: 0; flex: 1 1 auto; padding: 0.25rem 0.4rem; border: 1px solid transparent; border-radius: var(--mdt-radius-sm); color: var(--mdt-text); background: transparent; font: inherit; font-weight: 650; }
  .http-request-name:hover { border-color: var(--mdt-border-soft); }
  .http-request-name:focus { border-color: var(--mdt-cat); background: var(--mdt-surface-raised); outline: none; }
  .http-compose { display: grid; grid-template-columns: 6.25rem minmax(0, 1fr) auto; gap: 0.5rem; padding: 1rem 1rem 0.65rem; align-items: stretch; }
  .http-compose > :is(.ds-field, .ds-field-select) { min-height: 2.75rem; }
  .http-send-actions { display: flex; gap: 0.45rem; }
  .http-send-actions .ds-btn { min-height: 2.75rem; white-space: nowrap; }
  .http-tabs { width: 100%; overflow-x: auto; border: 0; border-bottom: 1px solid var(--mdt-border-soft); border-radius: 0; background: none; padding: 0 1rem; gap: 1.25rem; }
  .http-tabs > [role="tab"] { flex: 0 0 auto; padding: 0.65rem 0; border-radius: 0; border-bottom: 2px solid transparent; white-space: nowrap; }
  .http-tabs > [role="tab"][aria-selected="true"] { border-bottom-color: var(--mdt-cat); color: var(--mdt-text); background: none; }
  .http-count { margin-left: 0.35rem; color: var(--mdt-success); font-size: var(--mdt-fs-meta); }
  .http-count:empty { display: none; }
  .http-tab-panel { min-width: 0; }
  .http-request > .http-tab-panel { min-height: 13rem; max-height: 22rem; overflow: auto; padding: 0.85rem 1rem; }
  .http-request > .http-table-panel { padding: 0; }
  .http-tab-panel > :first-child { margin-top: 0; }
  .http-table-hint { padding: 0.7rem 1rem; margin: 0; }
  .http-table-scroll { overflow-x: auto; }
  .http-kv-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .http-kv-table th { padding: 0.45rem 0.6rem; text-align: left; font-size: var(--mdt-fs-meta); font-weight: 600; color: var(--mdt-text-muted); background: var(--mdt-surface-inset); }
  .http-kv-table :is(th, td) { border: 1px solid var(--mdt-border-soft); }
  .http-kv-table :is(th, td):first-child { border-left: 0; }
  .http-kv-table :is(th, td):last-child { border-right: 0; }
