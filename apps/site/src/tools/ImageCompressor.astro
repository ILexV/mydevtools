---
/**
 * Image Compressor (image-tools WASM domain, worker-backed). Upload/drag-drop
 * an image (png/jpeg/webp — legacy parity), tune quality (1-100, default 80)
 * and pick an output format (original/jpeg/png/webp), compress via
 * `compressImage` (cancellable), then preview the result with a size
 * comparison (savings % per legacy) and download it as `<name>_min.<ext>`
 * (jpeg → jpg — legacy parity). Single file only (legacy multi-file ZIP is a
 * documented deviation). UI: shared tool kit (FileDrop, ds-file-item, Progress).
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Icon from "@/components/Icon.astro";
import Field from "@/components/tool/Field.astro";
import FileDrop from "@/components/tool/FileDrop.astro";
import Progress from "@/components/tool/Progress.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/image-compressor";
const s = {
  dropZone: t(lang, ns, "DragDrop"),
  chooseFile: t(lang, "common", "Common_FileChooseButton"),
  clearFile: t(lang, "common", "Common_ClearFile"),
  quality: t(lang, ns, "Quality"),
  qualityHint: t(lang, ns, "QualityHint"),
  formatLabel: t(lang, ns, "FormatLabel"),
  formatOriginal: t(lang, ns, "FormatOriginal"),
  compress: t(lang, ns, "Compress"),
  compressing: t(lang, ns, "Compressing"),
  cancel: t(lang, ns, "Cancel"),
  done: t(lang, ns, "Done"),
  resultLabel: t(lang, ns, "ResultLabel"),
  originalSize: t(lang, ns, "OriginalSize"),
  compressedSize: t(lang, ns, "CompressedSize"),
  download: t(lang, ns, "Download"),
  previewAlt: t(lang, ns, "PreviewAlt"),
  errorNotImage: t(lang, ns, "ErrorNotImage"),
  errorUnsupported: t(lang, ns, "ErrorUnsupportedFormat"),
  errorCompression: t(lang, ns, "ErrorCompression"),
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-stack imgc-tool" data-imgc-tool>
  <FileDrop
    changeLabel={t(lang, "common", "Common_FileChangeButton")}
    data-imgc-dropzone
    title={s.dropZone}
    sub="PNG · JPEG · WebP"
    buttonLabel={s.chooseFile}
    accept="image/png, image/jpeg, image/webp"
    inputProps={{ "data-imgc-file": true }}
  />

  <div class="ds-file-item" data-imgc-selected hidden>
    <div class="imgc-file">
      <img class="imgc-thumb" data-imgc-preview alt={s.previewAlt} />
      <div class="imgc-file-text">
        <div class="ds-file-item-name" data-imgc-filename></div>
        <div class="ds-file-item-meta" data-imgc-filesize></div>
      </div>
    </div>
    <div class="ds-file-item-actions">
      <button type="button" class="ds-icon-btn" data-imgc-clear aria-label={s.clearFile} title={s.clearFile}>
        <Icon name="close" size={16} />
      </button>
    </div>
  </div>

  <div class="ds-settings">
    <Field label={s.quality} for="imgc-quality" hint={s.qualityHint} aside="80%" asideProps={{ "data-imgc-quality-value": true }}>
      <input type="range" id="imgc-quality" class="imgc-range" data-imgc-quality min="1" max="100" value="80" />
    </Field>
    <Field label={s.formatLabel} for="imgc-format">
      <select id="imgc-format" class="ds-field-select" data-imgc-format>
        <option value="original" selected>{s.formatOriginal}</option>
        <option value="jpeg">JPEG</option>
        <option value="png">PNG</option>
        <option value="webp">WebP</option>
      </select>
    </Field>
  </div>

  <div class="ds-actions">
    <button type="button" class="ds-btn ds-btn-primary" data-imgc-compress disabled>
      <Icon name="zap" size={16} />
      <span data-imgc-compress-label>{s.compress}</span>
    </button>
  </div>

  <Progress
    data-imgc-progress
    title={s.compressing}
    cancelLabel={s.cancel}
    cancelProps={{ "data-imgc-cancel": true }}
    indeterminate
  />

  <StatusMessage kind="error" data-imgc-error />

  <section class="ds-card ds-stack" data-imgc-result hidden aria-live="polite">
    <div class="ds-card-head">
      <span class="ds-card-title">{s.resultLabel}</span>
      <span class="ds-badge ds-badge-success" data-imgc-badge hidden></span>
    </div>
    <div class="imgc-output-wrap">
      <img class="imgc-output" data-imgc-output alt={s.previewAlt} />
    </div>
    <p class="imgc-output-meta">
      <span>{s.originalSize} <span class="imgc-meta-size" data-imgc-original-size></span></span>
      <span aria-hidden="true">→</span>
      <span>{s.compressedSize} <span class="imgc-meta-size" data-imgc-compressed-size></span></span>
    </p>
    <button type="button" class="ds-btn ds-btn-primary ds-btn-block" data-imgc-download>
      <Icon name="download" size={16} />
      {s.download}
    </button>
  </section>
</div>

<script is:inline type="application/json" data-imgc-strings set:html={stringsJson} />
<script>import "@/tools/image-compressor.client.ts";</script>

<style>
  .imgc-tool { max-width: 48rem; margin: 0 auto; }
  .imgc-file { display: flex; align-items: center; gap: 0.8rem; min-width: 0; }
  .imgc-file-text { min-width: 0; }
  .imgc-thumb {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
    border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface-muted);
  }
  .imgc-range { width: 100%; }
  .imgc-output-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 12rem;
    padding: 1rem;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-md);
    /* Checkerboard behind transparent results. */
    background-image: conic-gradient(var(--mdt-surface-muted) 25%, transparent 0 50%, var(--mdt-surface-muted) 0 75%, transparent 0);
    background-size: 1rem 1rem;
  }
  .imgc-output { max-width: 100%; max-height: 24rem; object-fit: contain; }
  .imgc-output-meta { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; font-size: var(--mdt-fs-small); color: var(--mdt-text-muted); overflow-wrap: anywhere; }
  .imgc-meta-size { font-family: var(--mdt-font-mono); font-weight: 600; color: var(--mdt-text); }
</style>
