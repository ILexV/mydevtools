---
/**
 * Image Converter (image-tools WASM domain). Upload/drag-drop an image, pick
 * a target format (png/jpeg/webp/gif/bmp/ico/tiff/tga — legacy parity),
 * optional quality slider for lossy targets (jpeg/webp only), convert via
 * `convertImage`, preview the result with size and download it under the
 * original name with the new extension.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/image-converter";
const s = {
  dropZone: t(lang, ns, "DragDrop"),
  chooseFile: t(lang, "common", "Common_FileChooseButton"),
  changeFile: t(lang, "common", "Common_FileChangeButton"),
  clearFile: t(lang, "common", "Common_ClearFile"),
  targetFormatLabel: t(lang, ns, "TargetFormatLabel"),
  quality: t(lang, ns, "Quality"),
  qualityLow: t(lang, ns, "QualityLow"),
  qualityHigh: t(lang, ns, "QualityHigh"),
  convert: t(lang, ns, "Convert"),
  processing: t(lang, ns, "Processing"),
  resultLabel: t(lang, ns, "ResultLabel"),
  outputSize: t(lang, ns, "OutputSize"),
  download: t(lang, ns, "Download"),
  previewAlt: t(lang, ns, "PreviewAlt"),
  errorNotImage: t(lang, ns, "ErrorNotImage"),
  errorConversion: t(lang, ns, "ErrorConversion"),
};
const stringsJson = JSON.stringify(s);
---

<div class="imgv-tool" data-imgv-tool>
  <div class="imgv-drop" data-imgv-dropzone>
    <input type="file" accept="image/*" data-imgv-file hidden />
    <button type="button" class="imgv-clear" data-imgv-clear aria-label={s.clearFile} title={s.clearFile} hidden>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="imgv-empty" data-imgv-empty>
      <svg class="imgv-icon" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <p class="imgv-drop-text">{s.dropZone}</p>
      <button type="button" class="primary-btn" data-imgv-choose>{s.chooseFile}</button>
    </div>

    <div class="imgv-selected" data-imgv-selected hidden>
      <img class="imgv-preview" data-imgv-preview alt={s.previewAlt} />
      <div class="imgv-fileinfo">
        <span class="imgv-filename" data-imgv-filename></span>
        <span class="imgv-filesize" data-imgv-filesize></span>
      </div>
      <button type="button" class="primary-btn" data-imgv-change>{s.changeFile}</button>
    </div>
  </div>

  <div class="imgv-settings">
    <div class="imgv-field">
      <label class="field-label" for="imgv-format">{s.targetFormatLabel}</label>
      <select id="imgv-format" data-imgv-format>
        <option value="png">PNG (Lossless)</option>
        <option value="jpeg">JPEG (Web)</option>
        <option value="webp">WebP (Modern)</option>
        <option value="gif">GIF</option>
        <option value="bmp">BMP</option>
        <option value="ico">ICO (Favicon)</option>
        <option value="tiff">TIFF</option>
        <option value="tga">TGA</option>
      </select>
    </div>

    <div class="imgv-field" data-imgv-quality-container hidden>
      <label class="field-label" for="imgv-quality">
        {s.quality}
        <span class="imgv-quality-value" data-imgv-quality-value>90</span>
      </label>
      <input type="range" id="imgv-quality" data-imgv-quality min="1" max="100" value="90" />
      <div class="imgv-quality-scale">
        <span>{s.qualityLow}</span>
        <span>{s.qualityHigh}</span>
      </div>
    </div>

    <button type="button" class="primary-btn imgv-convert" data-imgv-convert disabled>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
      </svg>
      <span data-imgv-convert-label>{s.convert}</span>
    </button>
  </div>

  <section class="imgv-result" data-imgv-result hidden>
    <span class="field-label">{s.resultLabel}</span>
    <div class="imgv-output-wrap">
      <img class="imgv-output" data-imgv-output alt={s.previewAlt} />
    </div>
    <p class="imgv-output-meta">
      {s.outputSize}
      <span class="imgv-output-size" data-imgv-output-size></span>
    </p>
    <button type="button" class="primary-btn imgv-download" data-imgv-download>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
      </svg>
      {s.download}
    </button>
  </section>

  <p class="imgv-error" data-imgv-error role="alert" hidden></p>
</div>

<script is:inline type="application/json" data-imgv-strings set:html={stringsJson} />
<script>import "@/tools/image-converter.client.ts";</script>

<style>
  .imgv-tool { max-width: 48rem; margin: 0 auto; }
  .imgv-drop {
    position: relative;
    border: 2px dashed var(--mdt-border);
    border-radius: var(--mdt-radius);
    padding: 2.25rem 1.5rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .imgv-drop:hover { border-color: var(--mdt-accent); }
  .imgv-drop.imgv-dragover { border-color: var(--mdt-accent); background: color-mix(in srgb, var(--mdt-accent) 8%, transparent); }
  .imgv-clear {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--mdt-text-muted);
    cursor: pointer;
  }
  .imgv-clear:hover { color: var(--mdt-danger); background: var(--mdt-surface-muted); }
  .imgv-empty, .imgv-selected { display: flex; flex-direction: column; align-items: center; gap: 0.9rem; }
  .imgv-icon { width: 3rem; height: 3rem; color: var(--mdt-text-muted); }
  .imgv-drop-text { font-size: 1.05rem; font-weight: 500; margin: 0; }
  .imgv-preview { max-width: 16rem; max-height: 12rem; object-fit: contain; border-radius: var(--mdt-radius-sm); box-shadow: 0 1px 4px rgb(0 0 0 / 0.15); }
  .imgv-fileinfo { display: flex; flex-direction: column; gap: 0.15rem; }
  .imgv-filename { font-weight: 500; overflow-wrap: anywhere; }
  .imgv-filesize { font-size: 0.82rem; color: var(--mdt-text-muted); font-family: var(--mdt-font-mono); }
  .primary-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; padding: 0.55rem 1rem; border-radius: var(--mdt-radius); font-weight: 600; cursor: pointer; border: 1px solid transparent; background: var(--mdt-accent); color: var(--mdt-accent-contrast); }
  .primary-btn:hover { filter: brightness(1.05); }
  .primary-btn:disabled { opacity: 0.55; cursor: not-allowed; filter: none; }
  .imgv-settings { margin-top: 1.25rem; display: flex; flex-direction: column; gap: 1rem; }
  .field-label { display: block; font-size: 0.8rem; font-weight: 600; color: var(--mdt-text-muted); margin-bottom: 0.35rem; }
  .imgv-field select { width: 100%; padding: 0.45rem 0.5rem; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm); background: var(--mdt-surface-raised); color: var(--mdt-text); }
  .imgv-field select:focus { outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px; }
  .imgv-quality-value { font-family: var(--mdt-font-mono); color: var(--mdt-text); }
  .imgv-field input[type="range"] { width: 100%; accent-color: var(--mdt-accent); }
  .imgv-quality-scale { display: flex; justify-content: space-between; font-size: 0.72rem; color: var(--mdt-text-muted); padding: 0 0.25rem; }
  .imgv-result { margin-top: 1.25rem; }
  .imgv-output-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 12rem;
    padding: 1rem;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius);
    background-image: conic-gradient(var(--mdt-surface-muted) 25%, transparent 0 50%, var(--mdt-surface-muted) 0 75%, transparent 0);
    background-size: 1rem 1rem;
  }
  .imgv-output { max-width: 100%; max-height: 24rem; object-fit: contain; border: 1px solid var(--mdt-border); }
  .imgv-output-meta { margin: 0.6rem 0 0; font-size: 0.85rem; color: var(--mdt-text-muted); }
  .imgv-output-size { font-family: var(--mdt-font-mono); font-weight: 600; color: var(--mdt-text); }
  .imgv-download { margin-top: 0.9rem; width: 100%; background: var(--mdt-success); }
  .imgv-convert { width: 100%; }
  .imgv-error { margin-top: 1rem; padding: 0.7rem 0.9rem; border: 1px solid var(--mdt-danger); border-radius: var(--mdt-radius-sm); color: var(--mdt-danger); background: color-mix(in srgb, var(--mdt-danger) 8%, transparent); font-size: 0.88rem; }
</style>
