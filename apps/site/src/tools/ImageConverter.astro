---
/**
 * Image Converter (image-tools WASM domain). Upload/drag-drop an image, pick
 * a target format (png/jpeg/webp/gif/bmp/ico/tiff/tga — legacy parity),
 * optional quality slider for lossy targets (jpeg/webp only), convert via
 * `convertImage`, preview the result with size and download it under the
 * original name with the new extension. Worker-backed and cancellable; UI on
 * the shared tool kit (FileDrop, ds-file-item, Progress, StatusMessage).
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Icon from "@/components/Icon.astro";
import Field from "@/components/tool/Field.astro";
import FileDrop from "@/components/tool/FileDrop.astro";
import Progress from "@/components/tool/Progress.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/image-converter";
const s = {
  dropZone: t(lang, ns, "DragDrop"),
  chooseFile: t(lang, "common", "Common_FileChooseButton"),
  clearFile: t(lang, "common", "Common_ClearFile"),
  targetFormatLabel: t(lang, ns, "TargetFormatLabel"),
  quality: t(lang, ns, "Quality"),
  qualityLow: t(lang, ns, "QualityLow"),
  qualityHigh: t(lang, ns, "QualityHigh"),
  convert: t(lang, ns, "Convert"),
  processing: t(lang, ns, "Processing"),
  cancel: t(lang, ns, "Cancel"),
  resultLabel: t(lang, ns, "ResultLabel"),
  outputSize: t(lang, ns, "OutputSize"),
  download: t(lang, ns, "Download"),
  previewAlt: t(lang, ns, "PreviewAlt"),
  errorNotImage: t(lang, ns, "ErrorNotImage"),
  errorUnsupported: t(lang, ns, "ErrorUnsupportedFormat"),
  errorConversion: t(lang, ns, "ErrorConversion"),
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-stack imgv-tool" data-imgv-tool>
  <FileDrop
    changeLabel={t(lang, "common", "Common_FileChangeButton")}
    data-imgv-dropzone
    title={s.dropZone}
    sub="PNG · JPEG · WebP · GIF · BMP · ICO · TIFF · TGA"
    buttonLabel={s.chooseFile}
    accept="image/*,.tga,.ico,.tif,.tiff"
    inputProps={{ "data-imgv-file": true }}
  />

  <div class="ds-file-item" data-imgv-selected hidden>
    <div class="imgv-file">
      <img class="imgv-thumb" data-imgv-preview alt={s.previewAlt} />
      <div class="imgv-file-text">
        <div class="ds-file-item-name" data-imgv-filename></div>
        <div class="ds-file-item-meta" data-imgv-filesize></div>
      </div>
    </div>
    <div class="ds-file-item-actions">
      <button type="button" class="ds-icon-btn" data-imgv-clear aria-label={s.clearFile} title={s.clearFile}>
        <Icon name="close" size={16} />
      </button>
    </div>
  </div>

  <div class="ds-settings">
    <Field label={s.targetFormatLabel} for="imgv-format">
      <select id="imgv-format" class="ds-field-select" data-imgv-format>
        <option value="png">PNG (Lossless)</option>
        <option value="jpeg">JPEG (Web)</option>
        <option value="webp">WebP (Modern)</option>
        <option value="gif">GIF</option>
        <option value="bmp">BMP</option>
        <option value="ico">ICO (Favicon)</option>
        <option value="tiff">TIFF</option>
        <option value="tga">TGA</option>
      </select>
    </Field>
    <Field label={s.quality} for="imgv-quality" aside="90" asideProps={{ "data-imgv-quality-value": true }} data-imgv-quality-container hidden>
      <input type="range" id="imgv-quality" class="imgv-range" data-imgv-quality min="1" max="100" value="90" />
      <div class="imgv-quality-scale" aria-hidden="true">
        <span>{s.qualityLow}</span>
        <span>{s.qualityHigh}</span>
      </div>
    </Field>
  </div>

  <div class="ds-actions">
    <button type="button" class="ds-btn ds-btn-primary" data-imgv-convert disabled>
      <Icon name="converters" size={16} />
      <span data-imgv-convert-label>{s.convert}</span>
    </button>
  </div>

  <Progress
    data-imgv-progress
    title={s.processing}
    cancelLabel={s.cancel}
    cancelProps={{ "data-imgv-cancel": true }}
    indeterminate
  />

  <StatusMessage kind="error" data-imgv-error />

  <section class="ds-card ds-stack" data-imgv-result hidden aria-live="polite">
    <div class="ds-card-head">
      <span class="ds-card-title">{s.resultLabel}</span>
    </div>
    <div class="imgv-output-wrap" data-imgv-output-wrap>
      <img class="imgv-output" data-imgv-output alt={s.previewAlt} />
    </div>
    <p class="imgv-output-meta">
      {s.outputSize}{" "}<span class="imgv-output-size" data-imgv-output-size></span>
    </p>
    <button type="button" class="ds-btn ds-btn-primary ds-btn-block" data-imgv-download>
      <Icon name="download" size={16} />
      {s.download}
    </button>
  </section>
</div>

<script is:inline type="application/json" data-imgv-strings set:html={stringsJson} />
<script>import "@/tools/image-converter.client.ts";</script>

<style>
  .imgv-tool { max-width: 48rem; margin: 0 auto; }
  .imgv-file { display: flex; align-items: center; gap: 0.8rem; min-width: 0; }
  .imgv-file-text { min-width: 0; }
  .imgv-thumb {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
    border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface-muted);
  }
  .imgv-range { width: 100%; }
  .imgv-quality-scale { display: flex; justify-content: space-between; font-size: var(--mdt-fs-label); color: var(--mdt-text-faint); }
  .imgv-output-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 12rem;
    padding: 1rem;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-md);
    /* Checkerboard behind transparent results. */
    background-image: conic-gradient(var(--mdt-surface-muted) 25%, transparent 0 50%, var(--mdt-surface-muted) 0 75%, transparent 0);
    background-size: 1rem 1rem;
  }
  .imgv-output { max-width: 100%; max-height: 24rem; object-fit: contain; }
  .imgv-output-meta { font-size: var(--mdt-fs-small); color: var(--mdt-text-muted); }
  .imgv-output-size { font-family: var(--mdt-font-mono); font-weight: 600; color: var(--mdt-text); }
</style>
