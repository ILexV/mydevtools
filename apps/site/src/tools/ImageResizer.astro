---
/**
 * Image Resizer (image-tools WASM domain). Upload/drag-drop an image, set
 * target width/height with an aspect-ratio lock (editing one dimension
 * auto-computes the other from the original ratio, per legacy), pick the
 * output format (jpeg/png/webp, guessed from the source extension), resize
 * via `resizeImage`, preview the result and download it as
 * `<name>_<w>x<h>.<ext>`. Worker-backed and cancellable; dimensions are
 * validated (positive integers, ≤16384 px/side, ≤64 MP — same as WASM).
 * UI on the shared tool kit (FileDrop, ds-file-item, Progress, StatusMessage).
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Icon from "@/components/Icon.astro";
import Field from "@/components/tool/Field.astro";
import FileDrop from "@/components/tool/FileDrop.astro";
import Progress from "@/components/tool/Progress.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/image-resizer";
const s = {
  dropZone: t(lang, "common", "Common_FileDropTitle"),
  chooseFile: t(lang, "common", "Common_FileChooseButton"),
  dropSub: t(lang, "common", "Common_FileDropSubtitle"),
  clearFile: t(lang, "common", "Common_ClearFile"),
  outputTitle: t(lang, "common", "Common_Output"),
  download: t(lang, "common", "Common_Download"),
  settingsLabel: t(lang, ns, "SettingsLabel"),
  originalInfo: t(lang, ns, "OriginalInfo"),
  width: t(lang, ns, "Width"),
  height: t(lang, ns, "Height"),
  lockAspectRatio: t(lang, ns, "LockAspectRatio"),
  formatLabel: t(lang, ns, "TargetFormatLabel"),
  resize: t(lang, ns, "Resize"),
  resizing: t(lang, ns, "Resizing"),
  cancel: t(lang, ns, "Cancel"),
  resultInfo: t(lang, ns, "ResultInfo"),
  previewAlt: t(lang, ns, "PreviewAlt"),
  errorNotImage: t(lang, ns, "ErrorNotImage"),
  errorLoadImage: t(lang, ns, "ErrorLoadImage"),
  errorInvalidDimensions: t(lang, ns, "ErrorInvalidDimensions"),
  errorUnsupported: t(lang, ns, "ErrorUnsupportedFormat"),
  errorTooLarge: t(lang, ns, "ErrorDimensionsTooLarge"),
  errorResizeFailed: t(lang, ns, "ErrorResizeFailed"),
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-stack imgr-tool" data-imgr-tool>
  <StatusMessage kind="error" data-imgr-error />

  <div class="ds-tool-grid">
    <section class="ds-card ds-stack">
      <FileDrop
        changeLabel={t(lang, "common", "Common_FileChangeButton")}
        data-imgr-dropzone
        title={s.dropZone}
        sub={s.dropSub}
        buttonLabel={s.chooseFile}
        accept="image/*,.tga,.ico,.tif,.tiff"
        inputProps={{ "data-imgr-file": true }}
      />

      <div class="ds-file-item" data-imgr-selected hidden>
        <div class="imgr-file">
          <img class="imgr-thumb" data-imgr-preview alt={s.previewAlt} />
          <div class="imgr-file-text">
            <div class="ds-file-item-name" data-imgr-filename></div>
            <div class="ds-file-item-meta" data-imgr-filesize></div>
          </div>
        </div>
        <div class="ds-file-item-actions">
          <button type="button" class="ds-icon-btn" data-imgr-clear aria-label={s.clearFile} title={s.clearFile}>
            <Icon name="close" size={16} />
          </button>
        </div>
      </div>

      <div class="ds-stack" data-imgr-settings hidden>
        <span class="ds-card-title">{s.settingsLabel}</span>
        <div class="ds-result-row ds-result-row-info imgr-info">
          <span class="ds-result-key">{s.originalInfo}</span>
          <span class="ds-result-value" data-imgr-original-info></span>
        </div>
        <div class="ds-settings ds-settings-flat imgr-dims">
          <Field label={s.width} for="imgr-width">
            <input type="number" id="imgr-width" class="ds-field mono" data-imgr-width min="1" max="16384" step="1" inputmode="numeric" placeholder="px" />
          </Field>
          <Field label={s.height} for="imgr-height">
            <input type="number" id="imgr-height" class="ds-field mono" data-imgr-height min="1" max="16384" step="1" inputmode="numeric" placeholder="px" />
          </Field>
        </div>
        <label class="ds-check-row">
          <input type="checkbox" class="ds-check" data-imgr-lock-ratio checked />
          <span>{s.lockAspectRatio}</span>
        </label>
        <Field label={s.formatLabel} for="imgr-format">
          <select id="imgr-format" class="ds-field-select" data-imgr-format>
            <option value="jpeg">JPEG</option>
            <option value="png">PNG</option>
            <option value="webp">WebP</option>
          </select>
        </Field>
        <button type="button" class="ds-btn ds-btn-primary ds-btn-block" data-imgr-resize disabled>
          <Icon name="images" size={16} />
          <span data-imgr-resize-label>{s.resize}</span>
        </button>
        <Progress
          data-imgr-progress
          title={s.resizing}
          cancelLabel={s.cancel}
          cancelProps={{ "data-imgr-cancel": true }}
          indeterminate
        />
      </div>
    </section>

    <section class="ds-card ds-stack" data-imgr-output hidden aria-live="polite">
      <span class="ds-card-title">{s.outputTitle}</span>
      <div class="imgr-result-wrap">
        <img class="imgr-result" data-imgr-result-preview alt={s.previewAlt} />
      </div>
      <div class="ds-result-row ds-result-row-info imgr-info">
        <span class="ds-result-key">{s.resultInfo}</span>
        <span class="ds-result-value" data-imgr-output-info></span>
      </div>
      <button type="button" class="ds-btn ds-btn-primary ds-btn-block" data-imgr-download>
        <Icon name="download" size={16} />
        {s.download}
      </button>
    </section>
  </div>
</div>

<script is:inline type="application/json" data-imgr-strings set:html={stringsJson} />
<script>import "@/tools/image-resizer.client.ts";</script>

<style>
  .imgr-tool { max-width: 64rem; margin: 0 auto; }
  .imgr-file { display: flex; align-items: center; gap: 0.8rem; min-width: 0; }
  .imgr-file-text { min-width: 0; }
  .imgr-thumb {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
    border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface-muted);
  }
  /* Two-column info row (no action column). */
  .imgr-info .ds-result-value { text-align: right; }
  .imgr-dims { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .imgr-result-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 12rem;
    padding: 1rem;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-md);
    background-image: conic-gradient(var(--mdt-surface-muted) 25%, transparent 0 50%, var(--mdt-surface-muted) 0 75%, transparent 0);
    background-size: 1rem 1rem;
  }
  .imgr-result { max-width: 100%; max-height: 24rem; object-fit: contain; }
</style>
