---
/**
 * IP Subnet Calculator tool (ipcalc WASM domain). IPv4: CIDR
 * (192.168.1.1/24), "IP mask" (192.168.1.1 255.255.255.0) or bare IP →
 * address/netmask/wildcard, network + prefix, broadcast, host range,
 * usable/total hosts, class + address-type badge, binary view. IPv6 (any input
 * with a colon): CIDR or bare address → compressed/expanded address, network,
 * prefix mask, first/last address, exact address count (BigInt) + type badge.
 * Calculate on button click or Enter; example buttons fill + run; copy buttons.
 * Subnet split (IPv4 and IPv6): divide the network into /N subnets — total
 * count (BigInt-safe) + the first 256 subnets (wasm/ipcalc/src/split.rs).
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/ip-subnet-calculator";
const s = {
  lang,
  inputLabel: t(lang, ns, "InputLabel"),
  calculate: t(lang, ns, "Calculate"),
  address: t(lang, ns, "Address"),
  netmask: t(lang, ns, "Netmask"),
  wildcard: t(lang, ns, "Wildcard"),
  network: t(lang, ns, "Network"),
  broadcast: t(lang, ns, "Broadcast"),
  hostMin: t(lang, ns, "HostMin"),
  hostMax: t(lang, ns, "HostMax"),
  hosts: t(lang, ns, "Hosts"),
  total: t(lang, ns, "Total"),
  classLabel: t(lang, ns, "Class"),
  expanded: t(lang, ns, "Expanded"),
  firstAddress: t(lang, ns, "FirstAddress"),
  lastAddress: t(lang, ns, "LastAddress"),
  addresses: t(lang, ns, "Addresses"),
  typeLabel: t(lang, ns, "Type"),
  // Address-type badge text, keyed by the WASM `scope` value.
  scopes: {
    private: t(lang, ns, "Private"),
    public: t(lang, ns, "Public"),
    shared: t(lang, ns, "Scope_Shared"),
    loopback: t(lang, ns, "Scope_Loopback"),
    "link-local": t(lang, ns, "Scope_LinkLocal"),
    documentation: t(lang, ns, "Scope_Documentation"),
    multicast: t(lang, ns, "Scope_Multicast"),
    reserved: t(lang, ns, "Scope_Reserved"),
    "unique-local": t(lang, ns, "Scope_UniqueLocal"),
    global: t(lang, ns, "Scope_Global"),
    unspecified: t(lang, ns, "Scope_Unspecified"),
    "ipv4-mapped": t(lang, ns, "Scope_Ipv4Mapped"),
  },
  binary: t(lang, ns, "Binary"),
  examples: t(lang, ns, "Examples"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, ns, "Copied"),
  copyFailed: t(lang, ns, "CopyFailed"),
  errorLoad: t(lang, ns, "Error_LoadFailed"),
  errorInvalidFormat: t(lang, ns, "Error_InvalidFormat"),
  splitTitle: t(lang, ns, "SplitTitle"),
  splitPrefixLabel: t(lang, ns, "SplitPrefixLabel"),
  splitPrefixHint: t(lang, ns, "SplitPrefixHint"),
  split: t(lang, ns, "Split"),
  splitCount: t(lang, ns, "SplitCount"),
  splitAddressesPer: t(lang, ns, "SplitAddressesPer"),
  splitUsablePer: t(lang, ns, "SplitUsablePer"),
  splitTruncated: t(lang, ns, "SplitTruncated"),
  splitColSubnet: t(lang, ns, "SplitColSubnet"),
  splitColHostRange: t(lang, ns, "SplitColHostRange"),
  splitColRange: t(lang, ns, "SplitColRange"),
  splitCopyList: t(lang, ns, "SplitCopyList"),
  errorSplitPrefix: t(lang, ns, "Error_SplitPrefix"),
};
const stringsJson = JSON.stringify(s);
const copyIcon =
  '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>';
---

<div class="ip-tool" data-ip-tool>
  <div class="ds-tool-grid ip-grid">
    <section class="ds-card ds-stack">
      <Field label={s.inputLabel} for="ip-cidr-input">
        <div class="ds-input-group">
          <input
            id="ip-cidr-input"
            type="text"
            class="ds-field mono"
            data-ip-input
            placeholder="192.168.1.1/24 · 2001:db8::1/64"
            autocomplete="off"
            spellcheck="false"
            autocapitalize="off"
            aria-describedby="ip-error"
          />
          <button type="button" class="ds-btn ds-btn-primary" data-ip-calculate>{s.calculate}</button>
        </div>
      </Field>
      <StatusMessage kind="error" id="ip-error" data-ip-error />
      <div class="ds-field-group">
        <span class="ds-label" id="ip-examples-label">{s.examples}</span>
        <div class="ds-chip-list" role="group" aria-labelledby="ip-examples-label">
          {["192.168.0.1/24", "10.0.0.0/8", "172.16.0.1 255.240.0.0", "10.0.0.1/31", "2001:db8:abcd:12::1/64"].map((ex) => (
            <button type="button" class="ds-chip-btn" data-ip-example={ex}>{ex}</button>
          ))}
        </div>
      </div>
    </section>

    <section class="ds-card ip-results" data-ip-results aria-live="polite" hidden>
      <table class="ip-table" data-ip-v4>
        <tbody>
          <tr><th scope="row">{s.address}</th><td><span data-ip-value="ip"></span></td><td></td></tr>
          <tr><th scope="row">{s.netmask}</th><td><span data-ip-value="netmask"></span></td><td></td></tr>
          <tr><th scope="row">{s.wildcard}</th><td><span data-ip-value="wildcard"></span></td><td></td></tr>
          <tr>
            <th scope="row">{s.network}</th>
            <td>
              <span data-ip-value="network"></span><span class="ip-dim" data-ip-value="prefix"></span>
            </td>
            <td class="ip-copy-cell">
              <button type="button" class="ds-icon-btn ip-copy" data-ip-copy="network" aria-label={`${s.copy}: ${s.network}`} title={`${s.copy}: ${s.network}`} set:html={copyIcon} />
            </td>
          </tr>
          <tr>
            <th scope="row">{s.broadcast}</th>
            <td><span data-ip-value="broadcast"></span></td>
            <td class="ip-copy-cell">
              <button type="button" class="ds-icon-btn ip-copy" data-ip-copy="broadcast" aria-label={`${s.copy}: ${s.broadcast}`} title={`${s.copy}: ${s.broadcast}`} set:html={copyIcon} />
            </td>
          </tr>
          <tr><th scope="row">{s.hostMin}</th><td><span data-ip-value="hostMin"></span></td><td></td></tr>
          <tr><th scope="row">{s.hostMax}</th><td><span data-ip-value="hostMax"></span></td><td></td></tr>
          <tr>
            <th scope="row">{s.hosts}</th>
            <td>
              <strong data-ip-value="usableHosts"></strong>
              <span class="ip-dim ip-total">({s.total}: <span data-ip-value="totalHosts"></span>)</span>
            </td>
            <td></td>
          </tr>
          <tr>
            <th scope="row">{s.classLabel}</th>
            <td>
              <span data-ip-value="class"></span>
              <span class="ds-badge" data-ip-scope></span>
            </td>
            <td></td>
          </tr>
        </tbody>
      </table>

      <table class="ip-table" data-ip-v6 hidden>
        <tbody>
          <tr><th scope="row">{s.address}</th><td><span data-ip-value="v6ip"></span></td><td></td></tr>
          <tr><th scope="row">{s.expanded}</th><td><span data-ip-value="v6expanded"></span></td><td></td></tr>
          <tr>
            <th scope="row">{s.network}</th>
            <td><span data-ip-value="v6network"></span><span class="ip-dim" data-ip-value="v6prefix"></span></td>
            <td class="ip-copy-cell">
              <button type="button" class="ds-icon-btn ip-copy" data-ip-copy="v6network" aria-label={`${s.copy}: ${s.network}`} title={`${s.copy}: ${s.network}`} set:html={copyIcon} />
            </td>
          </tr>
          <tr><th scope="row">{s.netmask}</th><td><span data-ip-value="v6netmask"></span></td><td></td></tr>
          <tr><th scope="row">{s.firstAddress}</th><td><span data-ip-value="v6first"></span></td><td></td></tr>
          <tr>
            <th scope="row">{s.lastAddress}</th>
            <td><span data-ip-value="v6last"></span></td>
            <td class="ip-copy-cell">
              <button type="button" class="ds-icon-btn ip-copy" data-ip-copy="v6last" aria-label={`${s.copy}: ${s.lastAddress}`} title={`${s.copy}: ${s.lastAddress}`} set:html={copyIcon} />
            </td>
          </tr>
          <tr>
            <th scope="row">{s.addresses}</th>
            <td>
              <strong data-ip-value="v6count"></strong>
              <span class="ip-dim ip-total">(2<sup data-ip-value="v6pow"></sup>)</span>
            </td>
            <td></td>
          </tr>
          <tr>
            <th scope="row">{s.typeLabel}</th>
            <td><span class="ds-badge" data-ip-scope-v6></span></td>
            <td></td>
          </tr>
        </tbody>
      </table>

      <div class="ip-binary" data-ip-binary>
        <div class="ds-label">{s.binary}</div>
        <dl class="ip-binary-list">
          <dt>{s.address}</dt>
          <dd data-ip-value="ipBinary"></dd>
          <dt>{s.netmask}</dt>
          <dd data-ip-value="maskBinary"></dd>
        </dl>
      </div>

      <div class="ip-split ds-stack" data-ip-split>
        <h2 class="ds-card-title" id="ip-split-title">{s.splitTitle}</h2>
        <Field label={s.splitPrefixLabel} for="ip-split-prefix" hint={s.splitPrefixHint} hintProps={{ "data-ip-split-hint": "" }}>
          <div class="ds-input-group ip-split-row">
            <input
              id="ip-split-prefix"
              type="text"
              class="ds-field mono ip-split-input"
              data-ip-split-prefix
              inputmode="numeric"
              autocomplete="off"
              spellcheck="false"
              aria-describedby="ip-split-prefix-hint ip-split-error"
            />
            <button type="button" class="ds-btn" data-ip-split-run>{s.split}</button>
          </div>
        </Field>
        <StatusMessage kind="error" id="ip-split-error" data-ip-split-error />
        <div class="ds-stack ip-split-out" data-ip-split-out hidden>
          <div class="ip-split-summary">
            <ul class="ip-split-facts" data-ip-split-summary></ul>
            <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-ip-split-copy>{s.splitCopyList}</button>
          </div>
          <p class="ds-hint" data-ip-split-truncated hidden></p>
          <div class="ip-split-scroll">
            <table class="ip-split-table">
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">{s.splitColSubnet}</th>
                  <th scope="col" data-ip-split-range-head></th>
                  <th scope="col" data-ip-split-bcast-head>{s.broadcast}</th>
                </tr>
              </thead>
              <tbody data-ip-split-rows></tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<script is:inline type="application/json" data-ip-strings set:html={stringsJson} />
<script>
  import "@/tools/ip-subnet-calculator.client.ts";
</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .ip-grid { --ds-tool-grid-cols: minmax(0, 1fr) minmax(0, 1.2fr); align-items: start; }

  .ip-table { width: 100%; border-collapse: collapse; font-family: var(--mdt-font-mono); font-size: var(--mdt-fs-meta); }
  .ip-table th {
    text-align: left;
    font-family: var(--mdt-font-sans);
    font-weight: 600;
    color: var(--mdt-text-muted);
    width: 9rem;
    padding: 0.45rem 0.75rem 0.45rem 0;
    vertical-align: middle;
  }
  .ip-table td { padding: 0.45rem 0; overflow-wrap: anywhere; vertical-align: middle; }
  .ip-table tr + tr :is(th, td) { border-top: 1px solid var(--mdt-border); }
  .ip-dim { color: var(--mdt-text-muted); }
  .ip-total { font-size: var(--mdt-fs-label); margin-left: 0.35rem; }
  .ip-copy-cell { text-align: right; width: 2.5rem; }
  .ip-copy { width: 30px; height: 30px; }
  .ip-table .ds-badge { margin-left: 0.4rem; vertical-align: middle; }
  .ip-table [data-ip-scope-v6] { margin-left: 0; }

  .ip-binary {
    margin-top: 1rem;
    padding: 0.8rem 1rem;
    border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface-inset);
    overflow-x: auto;
  }
  .ip-binary-list {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.3rem 1rem;
    margin: 0;
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-label);
  }
  .ip-binary-list dt { color: var(--mdt-text-muted); }
  .ip-binary-list dd { margin: 0; white-space: nowrap; }
  .ip-split { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--mdt-border); }
  .ip-split-input { max-width: 8rem; }
  .ip-split-summary { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .ip-split-facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; font-size: var(--mdt-fs-meta); }
  .ip-split-facts :global(strong) { font-family: var(--mdt-font-mono); }
  .ip-split-scroll { max-height: 24rem; overflow: auto; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm); }
  .ip-split-table { width: 100%; border-collapse: collapse; font-family: var(--mdt-font-mono); font-size: var(--mdt-fs-label); }
  .ip-split-table th {
    position: sticky;
    top: 0;
    background: var(--mdt-surface-inset);
    font-family: var(--mdt-font-sans);
    font-weight: 600;
    color: var(--mdt-text-muted);
    text-align: left;
  }
  .ip-split-table :is(th, td) { padding: 0.35rem 0.6rem; overflow-wrap: anywhere; vertical-align: top; }
  .ip-split-table :global(tr + tr td) { border-top: 1px solid var(--mdt-border); }
  .ip-split-table :global(td:first-child), .ip-split-table th:first-child { color: var(--mdt-text-muted); width: 1%; white-space: nowrap; }
  @media (max-width: 420px) {
    .ip-table th { width: 6.5rem; }
    .ip-binary-list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
