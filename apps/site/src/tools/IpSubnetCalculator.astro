---
/**
 * IP Subnet Calculator tool (ipcalc WASM domain). Accepts CIDR
 * (192.168.1.1/24) or "IP mask" (192.168.1.1 255.255.255.0) input and renders
 * the full legacy results table: address/netmask/wildcard, network + prefix,
 * broadcast, host range, usable/total hosts, class + private/public badge, and
 * the binary IP/mask view. Calculate on button click or Enter; example buttons
 * fill + run; copy buttons on network/broadcast with transient feedback.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/ip-subnet-calculator";
const s = {
  lang,
  inputLabel: t(lang, ns, "InputLabel"),
  calculate: t(lang, ns, "Calculate"),
  address: t(lang, ns, "Address"),
  netmask: t(lang, ns, "Netmask"),
  wildcard: t(lang, ns, "Wildcard"),
  network: t(lang, ns, "Network"),
  broadcast: t(lang, ns, "Broadcast"),
  hostMin: t(lang, ns, "HostMin"),
  hostMax: t(lang, ns, "HostMax"),
  hosts: t(lang, ns, "Hosts"),
  total: t(lang, ns, "Total"),
  classLabel: t(lang, ns, "Class"),
  privateLabel: t(lang, ns, "Private"),
  publicLabel: t(lang, ns, "Public"),
  binary: t(lang, ns, "Binary"),
  examples: t(lang, ns, "Examples"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, ns, "Copied"),
  copyFailed: t(lang, ns, "CopyFailed"),
  errorLoad: t(lang, ns, "Error_LoadFailed"),
  errorInvalidFormat: t(lang, ns, "Error_InvalidFormat"),
};
const stringsJson = JSON.stringify(s);
const copyIcon =
  '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>';
---

<div class="ip-tool" data-ip-tool>
  <div class="ds-tool-grid ip-grid">
    <section class="ds-card ds-stack">
      <Field label={s.inputLabel} for="ip-cidr-input">
        <div class="ds-input-group">
          <input
            id="ip-cidr-input"
            type="text"
            class="ds-field mono"
            data-ip-input
            placeholder="192.168.1.1/24"
            autocomplete="off"
            spellcheck="false"
            autocapitalize="off"
            aria-describedby="ip-error"
          />
          <button type="button" class="ds-btn ds-btn-primary" data-ip-calculate>{s.calculate}</button>
        </div>
      </Field>
      <StatusMessage kind="error" id="ip-error" data-ip-error />
      <div class="ds-field-group">
        <span class="ds-label" id="ip-examples-label">{s.examples}</span>
        <div class="ds-chip-list" role="group" aria-labelledby="ip-examples-label">
          {["192.168.0.1/24", "10.0.0.0/8", "172.16.0.1 255.240.0.0", "10.0.0.1/31"].map((ex) => (
            <button type="button" class="ds-chip-btn" data-ip-example={ex}>{ex}</button>
          ))}
        </div>
      </div>
    </section>

    <section class="ds-card ip-results" data-ip-results aria-live="polite" hidden>
      <table class="ip-table">
        <tbody>
          <tr><th scope="row">{s.address}</th><td><span data-ip-value="ip"></span></td><td></td></tr>
          <tr><th scope="row">{s.netmask}</th><td><span data-ip-value="netmask"></span></td><td></td></tr>
          <tr><th scope="row">{s.wildcard}</th><td><span data-ip-value="wildcard"></span></td><td></td></tr>
          <tr>
            <th scope="row">{s.network}</th>
            <td>
              <span data-ip-value="network"></span><span class="ip-dim" data-ip-value="prefix"></span>
            </td>
            <td class="ip-copy-cell">
              <button type="button" class="ds-icon-btn ip-copy" data-ip-copy="network" aria-label={`${s.copy}: ${s.network}`} title={`${s.copy}: ${s.network}`} set:html={copyIcon} />
            </td>
          </tr>
          <tr>
            <th scope="row">{s.broadcast}</th>
            <td><span data-ip-value="broadcast"></span></td>
            <td class="ip-copy-cell">
              <button type="button" class="ds-icon-btn ip-copy" data-ip-copy="broadcast" aria-label={`${s.copy}: ${s.broadcast}`} title={`${s.copy}: ${s.broadcast}`} set:html={copyIcon} />
            </td>
          </tr>
          <tr><th scope="row">{s.hostMin}</th><td><span data-ip-value="hostMin"></span></td><td></td></tr>
          <tr><th scope="row">{s.hostMax}</th><td><span data-ip-value="hostMax"></span></td><td></td></tr>
          <tr>
            <th scope="row">{s.hosts}</th>
            <td>
              <strong data-ip-value="usableHosts"></strong>
              <span class="ip-dim ip-total">({s.total}: <span data-ip-value="totalHosts"></span>)</span>
            </td>
            <td></td>
          </tr>
          <tr>
            <th scope="row">{s.classLabel}</th>
            <td>
              <span data-ip-value="class"></span>
              <span class="ds-badge ds-badge-warning" data-ip-badge="private" hidden>{s.privateLabel}</span>
              <span class="ds-badge ds-badge-success" data-ip-badge="public" hidden>{s.publicLabel}</span>
            </td>
            <td></td>
          </tr>
        </tbody>
      </table>

      <div class="ip-binary">
        <div class="ds-label">{s.binary}</div>
        <dl class="ip-binary-list">
          <dt>{s.address}</dt>
          <dd data-ip-value="ipBinary"></dd>
          <dt>{s.netmask}</dt>
          <dd data-ip-value="maskBinary"></dd>
        </dl>
      </div>
    </section>
  </div>
</div>

<script is:inline type="application/json" data-ip-strings set:html={stringsJson} />
<script>
  import "@/tools/ip-subnet-calculator.client.ts";
</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .ip-grid { --ds-tool-grid-cols: minmax(0, 1fr) minmax(0, 1.2fr); align-items: start; }

  .ip-table { width: 100%; border-collapse: collapse; font-family: var(--mdt-font-mono); font-size: var(--mdt-fs-meta); }
  .ip-table th {
    text-align: left;
    font-family: var(--mdt-font-sans);
    font-weight: 600;
    color: var(--mdt-text-muted);
    width: 9rem;
    padding: 0.45rem 0.75rem 0.45rem 0;
    vertical-align: middle;
  }
  .ip-table td { padding: 0.45rem 0; overflow-wrap: anywhere; vertical-align: middle; }
  .ip-table tr + tr :is(th, td) { border-top: 1px solid var(--mdt-border); }
  .ip-dim { color: var(--mdt-text-muted); }
  .ip-total { font-size: var(--mdt-fs-label); margin-left: 0.35rem; }
  .ip-copy-cell { text-align: right; width: 2.5rem; }
  .ip-copy { width: 30px; height: 30px; }
  .ip-table .ds-badge { margin-left: 0.4rem; vertical-align: middle; }

  .ip-binary {
    margin-top: 1rem;
    padding: 0.8rem 1rem;
    border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface-inset);
    overflow-x: auto;
  }
  .ip-binary-list {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.3rem 1rem;
    margin: 0;
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-label);
  }
  .ip-binary-list dt { color: var(--mdt-text-muted); }
  .ip-binary-list dd { margin: 0; white-space: nowrap; }
  @media (max-width: 420px) {
    .ip-table th { width: 6.5rem; }
    .ip-binary-list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
