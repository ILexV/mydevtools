---
/**
 * JSON Beautifier (structured-data domain). CodeMirror 6 editor (npm,
 * loaded on demand; shared theme in `styles/codemirror.css`) with format
 * (indent 2/4/tab, sort keys, compact/minify — `json-format.ts`), open/save
 * .json file, drag & drop onto the editor, copy/clear. Pure JS — no WASM.
 * PRIVACY: legacy localStorage input persistence intentionally dropped; only
 * the formatting settings persist. Errors: exact-position editor diagnostic
 * (underline, line tint, gutter) + localized message with "Go to error".
 */
import { t } from "@/i18n/messages";
import { diagnosticStrings, editorPhrases } from "@/tools/editor-phrases";
import type { LocaleCode } from "@/registry/locales";
import CopyButton from "@/components/tool/CopyButton.astro";
import EmptyState from "@/components/tool/EmptyState.astro";
import Field from "@/components/tool/Field.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import "@/styles/codemirror.css";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/json-beautifier";

const s = {
  open: t(lang, "common", "Common_Open"),
  save: t(lang, "common", "Common_Download"),
  format: t(lang, ns, "FormatButton"),
  clear: t(lang, ns, "ClearButton"),
  copy: t(lang, ns, "CopyButton"),
  indentLabel: t(lang, ns, "IndentSizeLabel"),
  indent2: t(lang, ns, "Indent2Spaces"),
  indent4: t(lang, ns, "Indent4Spaces"),
  indentTab: t(lang, ns, "IndentTab"),
  sortKeys: t(lang, ns, "SortKeys"),
  compact: t(lang, ns, "CompactMode"),
  inputLabel: t(lang, ns, "InputLabel"),
  keyboardHint: t(lang, ns, "EditorKeyboardHint"),
  emptyHint: t(lang, ns, "EmptyHint"),
  loadExample: t(lang, "common", "Common_LoadExample"),
  copied: t(lang, "common", "Common_Copied"),
  copyFailed: t(lang, "common", "Common_CopyFailed"),
};

const stringsJson = JSON.stringify({
  errorInvalidJson: t(lang, ns, "ErrorInvalidJson"),
  copied: s.copied,
  copyFailed: s.copyFailed,
  inputLabel: s.inputLabel,
  phrases: editorPhrases(lang),
  diag: diagnosticStrings(lang),
});
---

<div class="ds-workbench ds-workbench-single" data-json-tool>
  <ToolPanel title={s.inputLabel}>
    <Fragment slot="actions">
      <label class="ds-btn ds-btn-small ds-btn-ghost ds-file-btn">
        <input type="file" accept=".json,application/json" data-json-file />
        {s.open}
      </label>
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-json-save disabled>{s.save}</button>
      <CopyButton ghost label={s.copy} copiedLabel={s.copied} failedLabel={s.copyFailed} data-json-copy disabled />
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-json-clear>{s.clear}</button>
    </Fragment>

    <div class="ds-editor is-empty" data-json-editor-host>
      <div class="mdt-cm" data-json-editor role="group" aria-label={s.inputLabel}></div>
      <EmptyState
        hint={s.emptyHint}
        hintId="json-editor-empty"
        exampleLabel={s.loadExample}
        buttonProps={{ "data-json-example": true }}
      />
    </div>
    <p class="ds-hint" id="json-editor-hint">{s.keyboardHint}</p>

    <div class="ds-settings">
      <Field label={s.indentLabel} for="json-indent">
        <select id="json-indent" class="ds-field-select" data-json-indent>
          <option value="2">{s.indent2}</option>
          <option value="4" selected>{s.indent4}</option>
          <option value="tab">{s.indentTab}</option>
        </select>
      </Field>
      <div class="ds-check-group json-checks">
        <label class="ds-check-row"><input type="checkbox" class="ds-check" data-json-sort /> {s.sortKeys}</label>
        <label class="ds-check-row"><input type="checkbox" class="ds-check" data-json-compact /> {s.compact}</label>
      </div>
    </div>

    <div class="ds-action-row">
      <button type="button" class="ds-btn ds-btn-primary" data-json-format>{s.format}</button>
    </div>

    <!-- Parse-error panel (codemirror-kit setDiagnostic): no live role — errors are announced once on Format. -->
    <StatusMessage kind="error" role="none" class="mdt-diag" id="json-editor-error" data-json-error />
  </ToolPanel>
</div>

<script is:inline type="application/json" data-json-strings set:html={stringsJson} />
<script>import "@/tools/json-beautifier.client.ts";</script>

<style>
  /* Layout-only: checkboxes sit level with the indent select. */
  .json-checks { align-self: end; display: flex; flex-direction: column; gap: 0.35rem; }
</style>
