---
/**
 * JSON to TypeScript Converter (structured-data domain). Pure-JS type
 * inference (`json-to-typescript.ts`) + dual CodeMirror 6 editors (editable
 * JSON input, read-only TS output; shared theme `styles/codemirror.css`).
 * Live conversion (debounced); options: root name, export keyword, optional
 * fields (?), type alias. Actions: convert/copy/download/clear.
 */
import { t } from "@/i18n/messages";
import { diagnosticStrings, editorPhrases } from "@/tools/editor-phrases";
import type { LocaleCode } from "@/registry/locales";
import CopyButton from "@/components/tool/CopyButton.astro";
import EmptyState from "@/components/tool/EmptyState.astro";
import Field from "@/components/tool/Field.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import "@/styles/codemirror.css";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/json-to-typescript";
const s = {
  inputLabel: t(lang, ns, "InputLabel"),
  emptyHint: t(lang, ns, "EmptyHint"),
  loadExample: t(lang, "common", "Common_LoadExample"),
  outputLabel: t(lang, ns, "OutputLabel"),
  outputPlaceholder: t(lang, ns, "OutputPlaceholder"),
  convertButton: t(lang, ns, "ConvertButton"),
  copyButton: t(lang, ns, "CopyButton"),
  downloadButton: t(lang, ns, "DownloadButton"),
  clearButton: t(lang, ns, "ClearButton"),
  copied: t(lang, "common", "Common_Copied"),
  copyFailed: t(lang, "common", "Common_CopyFailed"),
  errorInvalidJson: t(lang, ns, "ErrorInvalidJson"),
  rootInterfaceNameLabel: t(lang, ns, "RootInterfaceNameLabel"),
  rootInterfaceNamePlaceholder: t(lang, ns, "RootInterfaceNamePlaceholder"),
  exportKeyword: t(lang, ns, "ExportKeyword"),
  optionalFields: t(lang, ns, "OptionalFields"),
  useTypeAlias: t(lang, ns, "UseTypeAlias"),
  keyboardHint: t(lang, ns, "EditorKeyboardHint"),
};
const stringsJson = JSON.stringify({
  errorInvalidJson: s.errorInvalidJson,
  copied: s.copied,
  copyFailed: s.copyFailed,
  inputLabel: s.inputLabel,
  outputLabel: s.outputLabel,
  phrases: editorPhrases(lang),
  diag: diagnosticStrings(lang),
});
---

<div class="ds-workbench" data-jts-tool>
  <ToolPanel title={s.inputLabel}>
    <Fragment slot="actions">
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-jts-clear>{s.clearButton}</button>
    </Fragment>
    <div class="ds-editor is-empty" data-jts-input-host>
      <div class="mdt-cm" data-jts-input role="group" aria-label={s.inputLabel}></div>
      <EmptyState
        hint={s.emptyHint}
        hintId="jts-input-empty"
        exampleLabel={s.loadExample}
        buttonProps={{ "data-jts-example": true }}
      />
    </div>
    <p class="ds-hint" id="jts-editor-hint">{s.keyboardHint}</p>

    <div class="ds-settings">
      <Field label={s.rootInterfaceNameLabel} for="jts-root-name">
        <input
          id="jts-root-name"
          type="text"
          class="ds-field mono"
          data-jts-root-name
          placeholder={s.rootInterfaceNamePlaceholder}
          value="Root"
          maxlength="64"
          spellcheck="false"
          autocomplete="off"
        />
      </Field>
      <div class="ds-check-group jts-checks">
        <label class="ds-check-row"><input type="checkbox" class="ds-check" data-jts-export /> {s.exportKeyword}</label>
        <label class="ds-check-row"><input type="checkbox" class="ds-check" data-jts-optional checked /> {s.optionalFields}</label>
        <label class="ds-check-row"><input type="checkbox" class="ds-check" data-jts-use-type /> {s.useTypeAlias}</label>
      </div>
    </div>

    <div class="ds-action-row">
      <button type="button" class="ds-btn ds-btn-primary" data-jts-convert>{s.convertButton}</button>
    </div>

    <!-- Parse-error panel (codemirror-kit setDiagnostic): no live role — live checks stay quiet, Convert announces. -->
    <StatusMessage kind="error" role="none" class="mdt-diag" id="jts-editor-error" data-jts-error />
  </ToolPanel>

  <OutputPanel panel label={s.outputLabel} emptyHint={s.outputPlaceholder} data-jts-output-panel>
    <Fragment slot="actions">
      <CopyButton ghost label={s.copyButton} copiedLabel={s.copied} failedLabel={s.copyFailed} data-jts-copy disabled />
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-jts-download disabled>{s.downloadButton}</button>
    </Fragment>
    <div class="mdt-cm ds-when-filled" data-jts-output role="group" aria-label={s.outputLabel}></div>
  </OutputPanel>
</div>

<script is:inline type="application/json" data-jts-strings set:html={stringsJson} />
<script>import "@/tools/json-to-typescript.client.ts";</script>

<style>
  /* Layout-only: checkboxes as a column next to the root-name field. */
  .jts-checks { display: flex; flex-direction: column; gap: 0.35rem; }
</style>
