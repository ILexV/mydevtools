---
/**
 * JSON to TypeScript Converter (structured-data domain). Pure-JS type
 * inference (`json-to-typescript.ts`) + dual CodeMirror 6 editors (editable
 * JSON input, read-only TS output; shared theme `styles/codemirror.css`).
 * Live conversion (debounced); options: root name, export keyword, optional
 * fields (?), type alias. Actions: convert/copy/download/clear.
 */
import { t } from "@/i18n/messages";
import { editorPhrases } from "@/tools/editor-phrases";
import type { LocaleCode } from "@/registry/locales";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import "@/styles/codemirror.css";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/json-to-typescript";
const s = {
  inputLabel: t(lang, ns, "InputLabel"),
  inputPlaceholder: t(lang, ns, "InputPlaceholder"),
  outputLabel: t(lang, ns, "OutputLabel"),
  outputPlaceholder: t(lang, ns, "OutputPlaceholder"),
  convertButton: t(lang, ns, "ConvertButton"),
  copyButton: t(lang, ns, "CopyButton"),
  downloadButton: t(lang, ns, "DownloadButton"),
  clearButton: t(lang, ns, "ClearButton"),
  copied: t(lang, ns, "Copied"),
  errorInvalidJson: t(lang, ns, "ErrorInvalidJson"),
  rootInterfaceNameLabel: t(lang, ns, "RootInterfaceNameLabel"),
  rootInterfaceNamePlaceholder: t(lang, ns, "RootInterfaceNamePlaceholder"),
  exportKeyword: t(lang, ns, "ExportKeyword"),
  optionalFields: t(lang, ns, "OptionalFields"),
  useTypeAlias: t(lang, ns, "UseTypeAlias"),
  keyboardHint: t(lang, ns, "EditorKeyboardHint"),
};
const stringsJson = JSON.stringify({
  errorInvalidJson: s.errorInvalidJson,
  copied: s.copied,
  inputLabel: s.inputLabel,
  outputLabel: s.outputLabel,
  phrases: editorPhrases(lang),
});
---

<div class="ds-stack" data-jts-tool>
  <div class="ds-card cm-toolbar">
    <div class="cm-options">
      <label class="cm-inline-field">
        <span class="ds-label">{s.rootInterfaceNameLabel}</span>
        <input
          type="text"
          class="ds-field mono jts-root-name"
          data-jts-root-name
          placeholder={s.rootInterfaceNamePlaceholder}
          value="Root"
          maxlength="64"
          spellcheck="false"
          autocomplete="off"
        />
      </label>
      <label class="ds-check-row"><input type="checkbox" class="ds-check" data-jts-export /> {s.exportKeyword}</label>
      <label class="ds-check-row"><input type="checkbox" class="ds-check" data-jts-optional checked /> {s.optionalFields}</label>
      <label class="ds-check-row"><input type="checkbox" class="ds-check" data-jts-use-type /> {s.useTypeAlias}</label>
    </div>
    <div class="ds-actions">
      <button type="button" class="ds-btn ds-btn-primary" data-jts-convert>{s.convertButton}</button>
      <button type="button" class="ds-btn" data-jts-copy>{s.copyButton}</button>
      <button type="button" class="ds-btn" data-jts-download>{s.downloadButton}</button>
      <button type="button" class="ds-btn ds-btn-danger" data-jts-clear>{s.clearButton}</button>
    </div>
  </div>

  <StatusMessage kind="error" data-jts-error />

  <div class="ds-tool-grid">
    <div class="ds-field-group">
      <span class="ds-label" id="jts-input-label">{s.inputLabel}</span>
      <div class="mdt-cm jts-editor" data-jts-input role="group" aria-labelledby="jts-input-label"></div>
    </div>
    <div class="ds-field-group">
      <span class="ds-label" id="jts-output-label">{s.outputLabel}</span>
      <div class="mdt-cm jts-editor" data-jts-output role="group" aria-labelledby="jts-output-label"></div>
    </div>
  </div>
  <p class="ds-hint" id="jts-editor-hint">{s.keyboardHint}</p>
</div>

<script is:inline type="application/json" data-jts-strings set:html={stringsJson} />
<script>import "@/tools/json-to-typescript.client.ts";</script>

<style>
  .cm-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
  }
  .cm-options { display: flex; flex-wrap: wrap; gap: 0.6rem 1.1rem; align-items: center; min-width: 0; }
  .cm-inline-field { display: flex; align-items: center; gap: 0.5rem; }
  .cm-inline-field .ds-label { margin-bottom: 0; }
  .jts-root-name { width: 9rem; }
  .jts-editor { --mdt-cm-height: min(700px, 75vh); }
</style>
