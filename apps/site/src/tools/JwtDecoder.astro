---
/**
 * JWT Decoder. Paste a token → live-decodes header and payload as pretty JSON
 * in TS, keeping the token's claim order (`decodeJwt`); signature check runs in
 * the cryptography WASM. Also shows the algorithm badge and the exp/nbf/iat
 * time claims (expired / not-yet-valid flagged), and verifies the signature
 * against an optional secret or RSA public key (alg from the header:
 * HS256/384/512, RS256/384/512). `alg: none` is reported as unsigned, never
 * as verified. Helpers in `jwt.ts`.
 * Workbench: token panel (empty state + "Load example" demo token) and the
 * signature panel (alg as panel meta) | decoded header/payload panel.
 */
import { t } from "@/i18n/messages";
import { localizedPath } from "@/lib/url";
import type { LocaleCode } from "@/registry/locales";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import EmptyState from "@/components/tool/EmptyState.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/jwt-decoder";
const s = {
  tokenLabel: t(lang, ns, "TokenLabel"),
  decodedHeaderLabel: t(lang, ns, "DecodedHeaderLabel"),
  decodedPayloadLabel: t(lang, ns, "DecodedPayloadLabel"),
  signatureLabel: t(lang, ns, "SignatureLabel"),
  secretLabel: t(lang, ns, "SecretLabel"),
  secretPlaceholder: t(lang, ns, "SecretPlaceholder"),
  linkToEncoder: t(lang, ns, "LinkToEncoder"),
  clear: t(lang, ns, "Clear"),
  emptyHint: t(lang, ns, "EmptyHint"),
  decodedLabel: t(lang, ns, "DecodedLabel"),
  outputEmpty: t(lang, ns, "OutputEmpty"),
  loadExample: t(lang, "common", "Common_LoadExample"),
};
const stringsJson = JSON.stringify({
  signatureVerified: t(lang, ns, "SignatureVerified"),
  signatureInvalid: t(lang, ns, "SignatureInvalid"),
  invalidToken: t(lang, ns, "InvalidToken"),
  enterSecret: t(lang, ns, "EnterSecret"),
  unsignedToken: t(lang, ns, "UnsignedToken"),
  unsupportedAlgorithm: t(lang, ns, "UnsupportedAlgorithm"),
  claimExpired: t(lang, ns, "ClaimExpired"),
  claimExpiresAt: t(lang, ns, "ClaimExpiresAt"),
  claimNotBefore: t(lang, ns, "ClaimNotBefore"),
  claimValidFrom: t(lang, ns, "ClaimValidFrom"),
  claimIssuedAt: t(lang, ns, "ClaimIssuedAt"),
});
const encoderUrl = localizedPath(lang, "jwt-encoder");
---

<div class="ds-stack" data-jwtd-tool>
  <p class="ds-hint jwt-link-note"><a href={encoderUrl}>{s.linkToEncoder}</a></p>

  <div class="ds-workbench">
    <div class="ds-stack">
      <ToolPanel title={s.tokenLabel} for="jwtd-encoded">
        <Fragment slot="actions">
          <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-jwtd-clear>{s.clear}</button>
        </Fragment>
        <div class="ds-editor is-empty" data-jwtd-input-host>
          <textarea
            id="jwtd-encoded"
            class="ds-field-textarea mono jwtd-token"
            data-jwtd-encoded
            rows="5"
            spellcheck="false"
            autocomplete="off"
            aria-describedby="jwtd-empty jwtd-error"
          ></textarea>
          <EmptyState
            hint={s.emptyHint}
            hintId="jwtd-empty"
            exampleLabel={s.loadExample}
            buttonProps={{ "data-jwtd-example": true }}
          />
        </div>
        <StatusMessage kind="error" id="jwtd-error" class="jwtd-error" data-jwtd-error />
      </ToolPanel>

      <ToolPanel title={s.signatureLabel} meta="" metaProps={{ "data-jwtd-alg": true }}>
        <div class="ds-field-group">
          <label class="ds-label" for="jwtd-secret">{s.secretLabel}</label>
          <textarea id="jwtd-secret" class="ds-field-textarea mono" data-jwtd-secret rows="3" placeholder={s.secretPlaceholder} spellcheck="false" autocomplete="off"></textarea>
        </div>
        <p class="ds-alert jwtd-status" data-jwtd-status role="status" aria-live="polite" hidden></p>
      </ToolPanel>
    </div>

    <OutputPanel panel label={s.decodedLabel} emptyHint={s.outputEmpty} data-jwtd-output>
      <div class="ds-field-group ds-when-filled">
        <label class="ds-label" for="jwtd-header">{s.decodedHeaderLabel}</label>
        <textarea id="jwtd-header" class="ds-field-textarea mono" data-jwtd-header rows="5" readonly spellcheck="false"></textarea>
      </div>
      <div class="ds-field-group ds-when-filled">
        <label class="ds-label" for="jwtd-payload">{s.decodedPayloadLabel}</label>
        <textarea id="jwtd-payload" class="ds-field-textarea mono" data-jwtd-payload rows="10" readonly spellcheck="false"></textarea>
        <ul class="jwtd-claims" data-jwtd-claims aria-live="polite" hidden></ul>
      </div>
    </OutputPanel>
  </div>
</div>

<script is:inline type="application/json" data-jwtd-strings set:html={stringsJson} />
<script>import "@/tools/jwt-decoder.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .jwt-link-note { margin: 0; }
  .jwt-link-note a { color: var(--mdt-cat); font-weight: 600; }
  .jwtd-token { word-break: break-all; }
  .ds-editor > .jwtd-token { min-height: 12rem; }
  .jwtd-error { overflow-wrap: anywhere; }
  .jwtd-status { display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-weight: 700; }
  /* Neutral prompt ("enter a secret") uses the shared ds-alert-neutral tone. */
  .jwtd-status.ds-alert-neutral { font-weight: 500; }
  .jwtd-status :global(svg) { width: 1.25rem; height: 1.25rem; flex-shrink: 0; }
  .jwtd-claims { list-style: none; margin: 0.6rem 0 0; padding: 0; display: grid; gap: 0.25rem; }
  .jwtd-claims :global(li) { display: flex; gap: 0.5rem; align-items: baseline; flex-wrap: wrap; }
  .jwtd-claims :global(code) { font-family: var(--mdt-font-mono); font-size: var(--mdt-fs-label); color: var(--mdt-text-muted); min-width: 2rem; }
</style>
