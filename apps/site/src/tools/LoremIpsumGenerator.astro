---
/**
 * Lorem Ipsum Generator tool (pure JS). Generates placeholder text by
 * paragraphs / sentences / words with plain / HTML / markdown output, an
 * optional canonical "Lorem ipsum…" opening, and live word/character stats.
 * Workbench: options panel (settings → Generate) | output with Copy/Download
 * in its header. Text is generated on load, so the output is never empty.
 */
import { t, pluralVariants } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import CopyButton from "@/components/tool/CopyButton.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import { MAX_COUNT } from "@/tools/lorem-ipsum";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/lorem-ipsum-generator";
const s = {
  lang,
  generateTypeLabel: t(lang, ns, "GenerateTypeLabel"),
  paragraphs: t(lang, ns, "Paragraphs"),
  sentences: t(lang, ns, "Sentences"),
  words: t(lang, ns, "Words"),
  countLabel: t(lang, ns, "CountLabel"),
  startWithClassic: t(lang, ns, "StartWithClassic"),
  wrapParagraphs: t(lang, ns, "WrapParagraphs"),
  generateButton: t(lang, ns, "GenerateButton"),
  outputLabel: t(lang, ns, "OutputLabel"),
  copyButton: t(lang, ns, "CopyButton"),
  downloadButton: t(lang, ns, "DownloadButton"),
  copied: t(lang, "common", "Common_Copied"),
  settingsLabel: t(lang, ns, "SettingsLabel"),
  copyFailed: t(lang, ns, "CopyFailed"),
  formatLabel: t(lang, ns, "FormatLabel"),
  formatPlain: t(lang, ns, "Format_Plain"),
  formatHtml: t(lang, ns, "Format_Html"),
  formatMarkdown: t(lang, ns, "Format_Markdown"),
  characters: t(lang, ns, "Characters"),
  wordsStat: t(lang, ns, "WordsStat"),
  // wordsStat_one/_few/_many, characters_one/… — Intl.PluralRules variants per locale.
  ...pluralVariants(lang, ns),
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-workbench" data-lorem-tool>
  <ToolPanel title={s.settingsLabel}>
    <div class="ds-settings ds-settings-flat">
      <Field label={s.generateTypeLabel} for="li-type">
        <select id="li-type" class="ds-field-select" data-li-type>
          <option value="paragraphs">{s.paragraphs}</option>
          <option value="sentences">{s.sentences}</option>
          <option value="words">{s.words}</option>
        </select>
      </Field>
      <Field label={s.countLabel} for="li-count" hint={`1–${MAX_COUNT}`}>
        <input id="li-count" type="number" class="ds-field mono" min="1" max={MAX_COUNT} step="1" value="5" inputmode="numeric" data-li-count />
      </Field>
      <Field label={s.formatLabel} for="li-format">
        <select id="li-format" class="ds-field-select" data-li-format>
          <option value="plain">{s.formatPlain}</option>
          <option value="html">{s.formatHtml}</option>
          <option value="markdown">{s.formatMarkdown}</option>
        </select>
      </Field>
    </div>

    <div class="li-toggles">
      <label class="ds-check-row">
        <input type="checkbox" class="ds-check" data-li-classic />
        <span>{s.startWithClassic}</span>
      </label>
      <label class="ds-check-row">
        <input type="checkbox" class="ds-check" data-li-wrap checked />
        <span>{s.wrapParagraphs}</span>
      </label>
    </div>

    <div class="ds-action-row">
      <button type="button" class="ds-btn ds-btn-primary" data-li-generate>{s.generateButton}</button>
    </div>
    <StatusMessage kind="error" data-li-error />
  </ToolPanel>

  <OutputPanel panel label={s.outputLabel} for="li-output">
    <Fragment slot="actions">
      <CopyButton ghost label={s.copyButton} copiedLabel={s.copied} data-li-copy />
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-li-download>{s.downloadButton}</button>
    </Fragment>
    <textarea id="li-output" class="ds-field-textarea li-output" data-li-output rows="14" readonly></textarea>
    <p class="ds-status li-stats" role="status">
      <span><b data-li-words>0</b> <span data-li-words-label>{s.wordsStat}</span></span>
      <span><b data-li-chars>0</b> <span data-li-chars-label>{s.characters}</span></span>
    </p>
  </OutputPanel>
</div>

<script is:inline type="application/json" data-lorem-strings set:html={stringsJson} />
<script>import "@/tools/lorem-ipsum-generator.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .li-toggles { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .li-output { min-height: 16rem; }
  .li-stats { display: flex; flex-wrap: wrap; gap: 1.25rem; margin: 0; }
  .li-stats b { font-family: var(--mdt-font-mono); color: var(--mdt-text); margin-right: 0.25rem; }
</style>
