---
/**
 * Lorem Ipsum Generator tool (pure JS). Generates placeholder text by
 * paragraphs / sentences / words with plain / HTML / markdown output, an
 * optional canonical "Lorem ipsum…" opening, and live word/character stats.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/lorem-ipsum-generator";
const s = {
  generateTypeLabel: t(lang, ns, "GenerateTypeLabel"),
  paragraphs: t(lang, ns, "Paragraphs"),
  sentences: t(lang, ns, "Sentences"),
  words: t(lang, ns, "Words"),
  countLabel: t(lang, ns, "CountLabel"),
  startWithClassic: t(lang, ns, "StartWithClassic"),
  wrapParagraphs: t(lang, ns, "WrapParagraphs"),
  generateButton: t(lang, ns, "GenerateButton"),
  outputLabel: t(lang, ns, "OutputLabel"),
  copyButton: t(lang, ns, "CopyButton"),
  downloadButton: t(lang, ns, "DownloadButton"),
  copied: t(lang, ns, "Copied"),
};
const stringsJson = JSON.stringify(s);
---

<div class="li-tool" data-lorem-tool>
  <div class="li-controls">
    <label class="field">
      <span>{s.generateTypeLabel}</span>
      <select data-li-type>
        <option value="paragraphs">{s.paragraphs}</option>
        <option value="sentences">{s.sentences}</option>
        <option value="words">{s.words}</option>
      </select>
    </label>
    <label class="field">
      <span>{s.countLabel}</span>
      <input type="number" min="1" max="1000" value="5" data-li-count />
    </label>
    <label class="field format-field">
      <select data-li-format>
        <option value="plain">Plain</option>
        <option value="html">HTML</option>
        <option value="markdown">Markdown</option>
      </select>
    </label>
  </div>

  <div class="li-toggles">
    <label class="check">
      <input type="checkbox" data-li-classic />
      <span>{s.startWithClassic}</span>
    </label>
    <label class="check">
      <input type="checkbox" data-li-wrap checked />
      <span>{s.wrapParagraphs}</span>
    </label>
  </div>

  <button type="button" class="primary-btn" data-li-generate>{s.generateButton}</button>

  <label class="output-label" for="li-output">{s.outputLabel}</label>
  <textarea id="li-output" data-li-output rows="14" readonly></textarea>

  <div class="li-stats">
    <span class="stat"><b data-li-words>0</b> {s.words}</span>
    <span class="stat"><b data-li-chars>0</b> chars</span>
  </div>

  <div class="li-actions">
    <button type="button" class="ghost-btn" data-li-copy>{s.copyButton}</button>
    <button type="button" class="ghost-btn" data-li-download>{s.downloadButton}</button>
  </div>
</div>

<script is:inline type="application/json" data-lorem-strings set:html={stringsJson} />
<script>import "@/tools/lorem-ipsum-generator.client.ts";</script>

<style>
  .li-controls { display: flex; flex-wrap: wrap; gap: 0.9rem; align-items: flex-end; }
  .field { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.85rem; color: var(--mdt-text-muted); }
  .field select,
  .field input { padding: 0.5rem 0.6rem; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm); background: var(--mdt-surface-raised); color: var(--mdt-text); font-size: 0.9rem; min-width: 8rem; }
  .field select:focus,
  .field input:focus { outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px; }
  .format-field span { display: none; }
  .li-toggles { display: flex; flex-wrap: wrap; gap: 1.2rem; margin: 0.9rem 0; }
  .check { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.9rem; color: var(--mdt-text); cursor: pointer; }
  .check input { width: 1.05rem; height: 1.05rem; accent-color: var(--mdt-accent); cursor: pointer; }
  .primary-btn { padding: 0.55rem 1.2rem; border-radius: var(--mdt-radius-sm); border: 1px solid var(--mdt-accent); background: var(--mdt-accent); color: var(--mdt-accent-contrast); cursor: pointer; font-size: 0.9rem; font-weight: 600; }
  .primary-btn:hover { opacity: 0.92; }
  .primary-btn:focus-visible { outline: 2px solid var(--mdt-focus-ring); outline-offset: 2px; }
  .output-label { display: block; margin: 1rem 0 0.4rem; font-size: 0.85rem; color: var(--mdt-text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .li-tool textarea { width: 100%; resize: vertical; padding: 0.75rem; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius); background: var(--mdt-surface-raised); color: var(--mdt-text); font-family: var(--mdt-font-mono); font-size: 0.9rem; }
  .li-tool textarea:focus { outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px; }
  .li-stats { display: flex; gap: 1.2rem; margin: 0.6rem 0; }
  .stat { font-size: 0.85rem; color: var(--mdt-text-muted); }
  .stat b { font-family: var(--mdt-font-mono); font-size: 1rem; color: var(--mdt-text); margin-right: 0.25rem; }
  .li-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.4rem; }
  .ghost-btn { padding: 0.5rem 0.9rem; border-radius: var(--mdt-radius-sm); border: 1px solid var(--mdt-border); background: var(--mdt-surface-raised); color: var(--mdt-text); cursor: pointer; font-size: 0.85rem; }
  .ghost-btn:hover { border-color: var(--mdt-accent); }
  .ghost-btn:focus-visible { outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px; }
</style>
