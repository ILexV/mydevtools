---
/**
 * Markdown Preview (pure JS). Split view: editor textarea left, live-rendered
 * HTML right (marked, loaded on demand from the vendored build). Toolbar with
 * formatting inserts, sync-scroll toggle, clear. Actions: copy HTML, copy
 * markdown, download standalone .html. No sanitization beyond marked — legacy
 * parity.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/markdown-preview";
const s = {
  editorLabel: t(lang, ns, "EditorLabel"),
  editorPlaceholder: t(lang, ns, "EditorPlaceholder"),
  previewLabel: t(lang, ns, "PreviewLabel"),
  bold: t(lang, ns, "Bold"),
  italic: t(lang, ns, "Italic"),
  heading: t(lang, ns, "Heading"),
  link: t(lang, ns, "Link"),
  image: t(lang, ns, "Image"),
  code: t(lang, ns, "Code"),
  list: t(lang, ns, "List"),
  clear: t(lang, ns, "Clear"),
  syncScroll: t(lang, ns, "SyncScroll"),
  copyHtml: t(lang, ns, "CopyHTML"),
  copyMarkdown: t(lang, ns, "CopyMarkdown"),
  download: t(lang, ns, "Download"),
  copied: t(lang, ns, "Copied"),
  copyFailed: t(lang, ns, "CopyFailed"),
  renderError: t(lang, ns, "RenderError"),
  markedLoadFailed: t(lang, ns, "MarkedLoadFailed"),
};
const stringsJson = JSON.stringify({
  copied: s.copied,
  copyFailed: s.copyFailed,
  renderError: s.renderError,
  markedLoadFailed: s.markedLoadFailed,
});
---

<div class="md-tool" data-md-tool>
  <!-- Toolbar -->
  <div class="md-toolbar">
    <div class="md-toolbar-groups">
      <div class="md-btn-group" role="group">
        <button type="button" class="md-tool-btn" data-md-insert="bold" title={s.bold} aria-label={s.bold}>
          <strong>B</strong>
        </button>
        <button type="button" class="md-tool-btn" data-md-insert="italic" title={s.italic} aria-label={s.italic}>
          <em>I</em>
        </button>
        <button type="button" class="md-tool-btn" data-md-insert="heading" title={s.heading} aria-label={s.heading}>
          <strong>H</strong>
        </button>
      </div>
      <div class="md-btn-group" role="group">
        <button type="button" class="md-tool-btn" data-md-insert="link" title={s.link} aria-label={s.link}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
          </svg>
        </button>
        <button type="button" class="md-tool-btn" data-md-insert="image" title={s.image} aria-label={s.image}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="m21 15-5-5L5 21" />
          </svg>
        </button>
      </div>
      <div class="md-btn-group" role="group">
        <button type="button" class="md-tool-btn" data-md-insert="code" title={s.code} aria-label={s.code}>
          <span class="md-glyph-mono">&lt;/&gt;</span>
        </button>
        <button type="button" class="md-tool-btn" data-md-insert="list" title={s.list} aria-label={s.list}>
          <span class="md-glyph-list">≡</span>
        </button>
      </div>
    </div>
    <label class="md-sync-toggle">
      <span>{s.syncScroll}</span>
      <input type="checkbox" data-md-sync-scroll checked />
    </label>
    <button type="button" class="md-clear-btn" data-md-clear>{s.clear}</button>
  </div>

  <!-- Split View -->
  <div class="md-grid">
    <div class="md-pane">
      <label class="md-pane-label" for="md-preview-input">{s.editorLabel}</label>
      <textarea
        id="md-preview-input"
        data-md-input
        placeholder={s.editorPlaceholder}
        spellcheck="false"></textarea>
    </div>
    <div class="md-pane">
      <span class="md-pane-label">{s.previewLabel}</span>
      <div class="md-preview" data-md-output></div>
    </div>
  </div>

  <!-- Actions -->
  <div class="md-actions">
    <button type="button" class="ghost-btn" data-md-copy-html>{s.copyHtml}</button>
    <button type="button" class="ghost-btn" data-md-copy-md>{s.copyMarkdown}</button>
    <button type="button" class="primary-btn" data-md-download>{s.download}</button>
  </div>

  <div class="md-error" data-md-error hidden></div>
</div>

<script is:inline type="application/json" data-md-strings set:html={stringsJson} />
<script>import "@/tools/markdown-preview.client.ts";</script>

<style>
  .md-tool { display: flex; flex-direction: column; gap: 1rem; }

  /* Toolbar */
  .md-toolbar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 0.5rem; padding: 0.5rem;
    border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius);
    background: var(--mdt-surface-muted);
  }
  .md-toolbar-groups { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .md-btn-group { display: flex; }
  .md-btn-group .md-tool-btn { border-radius: 0; margin-left: -1px; }
  .md-btn-group .md-tool-btn:first-child { border-radius: var(--mdt-radius-sm) 0 0 var(--mdt-radius-sm); margin-left: 0; }
  .md-btn-group .md-tool-btn:last-child { border-radius: 0 var(--mdt-radius-sm) var(--mdt-radius-sm) 0; }
  .md-tool-btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 2rem; height: 2rem; padding: 0 0.4rem;
    border: 1px solid var(--mdt-border); background: var(--mdt-surface-raised);
    color: var(--mdt-text); cursor: pointer; font-size: 0.95rem;
  }
  .md-tool-btn:hover { border-color: var(--mdt-accent); color: var(--mdt-accent); position: relative; }
  .md-tool-btn:focus-visible { outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px; }
  .md-tool-btn svg { width: 1rem; height: 1rem; }
  .md-glyph-mono { font-family: var(--mdt-font-mono); font-size: 0.78rem; }
  .md-glyph-list { font-size: 1.1rem; line-height: 1; }
  .md-sync-toggle {
    display: flex; align-items: center; gap: 0.4rem; cursor: pointer;
    padding: 0.3rem 0.6rem; font-size: 0.78rem; font-weight: 600;
    border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface-raised); color: var(--mdt-text);
  }
  .md-sync-toggle:hover { background: var(--mdt-surface-muted); }
  .md-sync-toggle input { accent-color: var(--mdt-accent); cursor: pointer; }
  .md-clear-btn {
    padding: 0.35rem 0.85rem; border-radius: var(--mdt-radius-sm); font-size: 0.85rem;
    border: 1px solid var(--mdt-danger); background: var(--mdt-surface-raised);
    color: var(--mdt-danger); cursor: pointer;
  }
  .md-clear-btn:hover { background: color-mix(in srgb, var(--mdt-danger) 10%, transparent); }
  .md-clear-btn:focus-visible { outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px; }

  /* Split view — legacy: 600px fixed height, 1 col mobile / 2 cols ≥768px */
  .md-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; height: 600px; }
  @media (min-width: 768px) { .md-grid { grid-template-columns: 1fr 1fr; } }
  .md-pane { display: flex; flex-direction: column; min-height: 0; }
  .md-pane-label {
    display: block; font-size: 0.88rem; font-weight: 700;
    color: var(--mdt-text); margin-bottom: 0.35rem;
  }
  .md-pane textarea {
    flex: 1; min-height: 0; width: 100%; resize: none;
    padding: 1rem; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius);
    background: var(--mdt-surface-raised); color: var(--mdt-text);
    font-family: var(--mdt-font-mono); font-size: 0.95rem; line-height: 1.5;
  }
  .md-pane textarea:focus { outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px; }
  .md-preview {
    flex: 1; min-height: 0; width: 100%; overflow-y: auto;
    padding: 1.25rem; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius);
    background: var(--mdt-surface-raised); color: var(--mdt-text);
    font-size: 0.92rem; line-height: 1.6;
  }
  .md-preview :global(.md-lib-error) { color: var(--mdt-danger); }

  /* Rendered markdown essentials (runtime innerHTML → global selectors) */
  .md-preview :global(h1), .md-preview :global(h2), .md-preview :global(h3),
  .md-preview :global(h4), .md-preview :global(h5), .md-preview :global(h6) {
    margin: 1.1em 0 0.5em; line-height: 1.3;
  }
  .md-preview :global(h1):first-child, .md-preview :global(h2):first-child,
  .md-preview :global(h3):first-child, .md-preview :global(p):first-child,
  .md-preview :global(ul):first-child, .md-preview :global(ol):first-child,
  .md-preview :global(pre):first-child, .md-preview :global(blockquote):first-child {
    margin-top: 0;
  }
  .md-preview :global(h1) { font-size: 1.6em; }
  .md-preview :global(h2) { font-size: 1.35em; }
  .md-preview :global(h3) { font-size: 1.15em; }
  .md-preview :global(p) { margin: 0.6em 0; }
  .md-preview :global(a) { color: var(--mdt-accent); }
  .md-preview :global(ul), .md-preview :global(ol) { margin: 0.6em 0; padding-left: 1.6em; }
  .md-preview :global(code) {
    background: var(--mdt-surface-muted); padding: 0.15em 0.35em;
    border-radius: var(--mdt-radius-sm); font-family: var(--mdt-font-mono); font-size: 0.88em;
  }
  .md-preview :global(pre) {
    background: var(--mdt-surface-muted); padding: 0.9rem; border-radius: var(--mdt-radius-sm);
    overflow-x: auto; margin: 0.8em 0;
  }
  .md-preview :global(pre code) { background: none; padding: 0; }
  .md-preview :global(table) { border-collapse: collapse; width: 100%; margin: 0.8em 0; }
  .md-preview :global(th), .md-preview :global(td) {
    border: 1px solid var(--mdt-border); padding: 0.45rem 0.6rem; text-align: left;
  }
  .md-preview :global(th) { background: var(--mdt-surface-muted); }
  .md-preview :global(blockquote) {
    border-left: 4px solid var(--mdt-border); padding-left: 1rem;
    margin: 0.8em 0 0.8em 0; color: var(--mdt-text-muted);
  }
  .md-preview :global(img) { max-width: 100%; }
  .md-preview :global(hr) { border: none; border-top: 1px solid var(--mdt-border); margin: 1.2em 0; }

  /* Actions */
  .md-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: flex-end; }
  .primary-btn, .ghost-btn {
    padding: 0.55rem 1.1rem; border-radius: var(--mdt-radius); font-weight: 600;
    font-size: 0.88rem; cursor: pointer; border: 1px solid transparent;
  }
  .primary-btn { background: var(--mdt-accent); color: var(--mdt-accent-contrast); }
  .primary-btn:hover { filter: brightness(1.05); }
  .ghost-btn { background: var(--mdt-surface-raised); border-color: var(--mdt-border); color: var(--mdt-text); }
  .ghost-btn:hover { border-color: var(--mdt-accent); }
  .primary-btn:focus-visible, .ghost-btn:focus-visible {
    outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px;
  }

  .md-error {
    padding: 0.7rem 0.9rem; border: 1px solid var(--mdt-danger);
    border-radius: var(--mdt-radius-sm); color: var(--mdt-danger);
    background: color-mix(in srgb, var(--mdt-danger) 8%, transparent);
    font-size: 0.88rem;
  }
  .md-error[hidden] { display: none; }
</style>
