---
/**
 * Markdown Preview (pure JS). Workbench split view: editor panel left
 * (Copy Markdown / Clear in its header, formatting inserts + sync-scroll toggle,
 * empty state with a localized "Load example"), live-rendered HTML panel right
 * (marked, loaded on demand; Copy HTML / Download in its header; compact
 * placeholder while the editor is empty). Output is sanitized before insertion.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import EmptyState from "@/components/tool/EmptyState.astro";
import CopyButton from "@/components/tool/CopyButton.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/markdown-preview";
const s = {
  editorLabel: t(lang, ns, "EditorLabel"),
  previewLabel: t(lang, ns, "PreviewLabel"),
  bold: t(lang, ns, "Bold"),
  italic: t(lang, ns, "Italic"),
  heading: t(lang, ns, "Heading"),
  link: t(lang, ns, "Link"),
  image: t(lang, ns, "Image"),
  code: t(lang, ns, "Code"),
  list: t(lang, ns, "List"),
  clear: t(lang, ns, "Clear"),
  syncScroll: t(lang, ns, "SyncScroll"),
  copyHtml: t(lang, ns, "CopyHTML"),
  copyMarkdown: t(lang, ns, "CopyMarkdown"),
  download: t(lang, ns, "Download"),
  copied: t(lang, "common", "Common_Copied"),
  loadExample: t(lang, "common", "Common_LoadExample"),
  emptyHint: t(lang, ns, "EmptyHint"),
  previewEmpty: t(lang, ns, "PreviewEmpty"),
  example: t(lang, ns, "ExampleMarkdown"),
  copyFailed: t(lang, ns, "CopyFailed"),
  renderError: t(lang, ns, "RenderError"),
  markedLoadFailed: t(lang, ns, "MarkedLoadFailed"),
  toolbarLabel: t(lang, ns, "ToolbarLabel"),
};
const stringsJson = JSON.stringify({
  copied: s.copied,
  copyFailed: s.copyFailed,
  renderError: s.renderError,
  markedLoadFailed: s.markedLoadFailed,
  example: s.example,
});
---

<div class="ds-stack" data-md-tool>
  <div class="ds-workbench ds-workbench-stretch md-workbench">
    <ToolPanel title={s.editorLabel} for="md-preview-input">
      <Fragment slot="actions">
        <CopyButton ghost label={s.copyMarkdown} copiedLabel={s.copied} data-md-copy-md disabled />
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-md-clear>{s.clear}</button>
      </Fragment>
      <div class="md-toolbar">
    <div class="md-toolbar-groups" role="group" aria-label={s.toolbarLabel}>
      <div class="md-btn-group">
        <button type="button" class="ds-icon-btn" data-md-insert="bold" title={s.bold} aria-label={s.bold}>
          <strong aria-hidden="true">B</strong>
        </button>
        <button type="button" class="ds-icon-btn" data-md-insert="italic" title={s.italic} aria-label={s.italic}>
          <em aria-hidden="true">I</em>
        </button>
        <button type="button" class="ds-icon-btn" data-md-insert="heading" title={s.heading} aria-label={s.heading}>
          <strong aria-hidden="true">H</strong>
        </button>
      </div>
      <div class="md-btn-group">
        <button type="button" class="ds-icon-btn" data-md-insert="link" title={s.link} aria-label={s.link}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
          </svg>
        </button>
        <button type="button" class="ds-icon-btn" data-md-insert="image" title={s.image} aria-label={s.image}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="m21 15-5-5L5 21" />
          </svg>
        </button>
      </div>
      <div class="md-btn-group">
        <button type="button" class="ds-icon-btn" data-md-insert="code" title={s.code} aria-label={s.code}>
          <span class="md-glyph-mono" aria-hidden="true">&lt;/&gt;</span>
        </button>
        <button type="button" class="ds-icon-btn" data-md-insert="list" title={s.list} aria-label={s.list}>
          <span class="md-glyph-list" aria-hidden="true">≡</span>
        </button>
      </div>
    </div>
        <label class="ds-check-row md-sync">
          <input type="checkbox" class="ds-check" data-md-sync-scroll checked />
          <span>{s.syncScroll}</span>
        </label>
      </div>
      <div class="ds-editor is-empty md-editor" data-md-input-host>
        <textarea
          id="md-preview-input"
          class="ds-field-textarea mono md-input"
          data-md-input
          aria-describedby="md-input-empty"
          spellcheck="false"></textarea>
        <EmptyState hint={s.emptyHint} hintId="md-input-empty" exampleLabel={s.loadExample} buttonProps={{ "data-md-example": true }} />
      </div>
    </ToolPanel>

    <OutputPanel panel label={s.previewLabel} emptyHint={s.previewEmpty} data-md-output-panel>
      <Fragment slot="actions">
        <CopyButton ghost label={s.copyHtml} copiedLabel={s.copied} data-md-copy-html disabled />
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-md-download disabled>{s.download}</button>
      </Fragment>
      <div class="md-preview ds-when-filled" data-md-output role="region" aria-label={s.previewLabel} tabindex="0"></div>
    </OutputPanel>
  </div>

  <StatusMessage kind="error" data-md-error />
</div>

<script is:inline type="application/json" data-md-strings set:html={stringsJson} />
<script>import "@/tools/markdown-preview.client.ts";</script>

<style>
  /* Layout + rendered-markdown typography; controls come from tool-ui.css (ds-*). */
  .md-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; }
  .md-toolbar-groups { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .md-btn-group { display: flex; gap: 0.25rem; }
  .md-sync { margin-left: auto; }
  .md-glyph-mono { font-family: var(--mdt-font-mono); font-size: 0.78rem; }
  .md-glyph-list { font-size: 1.1rem; line-height: 1; }

  /* Fixed equal pane heights keep the proportional sync scroll meaningful. */
  .md-input { height: 34rem; resize: none; }
  .md-preview {
    height: 34rem; width: 100%; overflow-y: auto; overflow-wrap: anywhere;
    padding: 1rem 1.25rem; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface-raised); color: var(--mdt-text);
    font-size: 0.92rem; line-height: 1.6;
  }
  @media (max-width: 899px) {
    .md-input, .md-preview { height: 22rem; }
  }
  /* Side by side, the empty preview placeholder fills the stretched panel. */
  .md-workbench > :global(.ds-output.is-empty > .ds-empty-state) { flex: 1; }
  .md-preview :global(.md-lib-error) { color: var(--mdt-danger); }

  /* Rendered markdown essentials (runtime innerHTML → global selectors) */
  /* Headings are demoted in the DOM (h1→h2 …) for the page outline; md-hN
     carries the source level so the visual scale stays markdown-like. */
  .md-preview :global(:is(.md-h1, .md-h2, .md-h3, .md-h4, .md-h5, .md-h6)) {
    margin: 1.1em 0 0.5em; line-height: 1.3; font-weight: 700;
  }
  .md-preview :global(:is(.md-h1, .md-h2, .md-h3, .md-h4, .md-h5, .md-h6, p, ul, ol, pre, blockquote):first-child) {
    margin-top: 0;
  }
  .md-preview :global(.md-h1) { font-size: 1.6em; }
  .md-preview :global(.md-h2) { font-size: 1.35em; }
  .md-preview :global(.md-h3) { font-size: 1.15em; }
  .md-preview :global(.md-h4) { font-size: 1em; }
  .md-preview :global(.md-h5) { font-size: 0.92em; }
  .md-preview :global(.md-h6) { font-size: 0.85em; color: var(--mdt-text-muted); }
  .md-preview :global(p) { margin: 0.6em 0; }
  .md-preview :global(a) { color: var(--mdt-accent); }
  .md-preview :global(ul), .md-preview :global(ol) { margin: 0.6em 0; padding-left: 1.6em; }
  .md-preview :global(code) {
    background: var(--mdt-surface-muted); padding: 0.15em 0.35em;
    border-radius: var(--mdt-radius-sm); font-family: var(--mdt-font-mono); font-size: 0.88em;
  }
  .md-preview :global(pre) {
    background: var(--mdt-surface-muted); padding: 0.9rem; border-radius: var(--mdt-radius-sm);
    overflow-x: auto; margin: 0.8em 0; overflow-wrap: normal;
  }
  .md-preview :global(pre code) { background: none; padding: 0; }
  .md-preview :global(table) { border-collapse: collapse; width: 100%; margin: 0.8em 0; display: block; overflow-x: auto; }
  .md-preview :global(th), .md-preview :global(td) {
    border: 1px solid var(--mdt-border); padding: 0.45rem 0.6rem; text-align: left;
  }
  .md-preview :global(th) { background: var(--mdt-surface-muted); }
  .md-preview :global(blockquote) {
    border-left: 4px solid var(--mdt-border); padding-left: 1rem;
    margin: 0.8em 0 0.8em 0; color: var(--mdt-text-muted);
  }
  .md-preview :global(img) { max-width: 100%; height: auto; }
  .md-preview :global(input[type="checkbox"]) { margin-right: 0.4em; accent-color: var(--mdt-cat); }
  .md-preview :global(li:has(> input[type="checkbox"])) { list-style: none; margin-left: -1.2em; }
  .md-preview :global(kbd) {
    font-family: var(--mdt-font-mono); font-size: 0.85em; padding: 0.1em 0.4em;
    border: 1px solid var(--mdt-border); border-bottom-width: 2px; border-radius: var(--mdt-radius-xs);
  }
  .md-preview :global(hr) { border: none; border-top: 1px solid var(--mdt-border); margin: 1.2em 0; }

</style>
