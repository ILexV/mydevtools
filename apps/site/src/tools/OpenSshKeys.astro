---
/**
 * OpenSSH Keys (cryptography WASM domain). Generate (ed25519 / ecdsa-p256 /
 * ecdsa-p384 / rsa with bits), import (OpenSSH public/private, SPKI PEM,
 * PKCS#8 PEM) and convert between formats. Passphrase field is shared by all
 * actions per legacy parity; generation runs in a Web Worker with progress +
 * Cancel. Warnings from WASM render raw; well-known
 * passphrase errors are localized.
 * Workbench: generate panel (settings → Generate) over the import panel
 * (Open in its header; the editor is also a key-file drop target) | public
 * and private key panels with Copy/Download in their headers.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import EmptyState from "@/components/tool/EmptyState.astro";
import CopyButton from "@/components/tool/CopyButton.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import Progress from "@/components/tool/Progress.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/openssh-keys";
const s = {
  generateSectionTitle: t(lang, ns, "GenerateSectionTitle"),
  algorithmLabel: t(lang, ns, "AlgorithmLabel"),
  keySizeLabel: t(lang, ns, "KeySizeLabel"),
  passphraseLabel: t(lang, ns, "PassphraseLabel"),
  generateButton: t(lang, ns, "GenerateButton"),
  importSectionTitle: t(lang, ns, "ImportSectionTitle"),
  importLabel: t(lang, ns, "ImportLabel"),
  importFileLabel: t(lang, ns, "ImportFileLabel"),
  importFileHint: t(lang, ns, "ImportFileHint"),
  importButton: t(lang, ns, "ImportButton"),
  convertButton: t(lang, ns, "ConvertButton"),
  publicKeyLabel: t(lang, ns, "PublicKeyLabel"),
  privateKeyLabel: t(lang, ns, "PrivateKeyLabel"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, "common", "Common_Copied"),
  copyFailed: t(lang, "common", "Common_CopyFailed"),
  open: t(lang, "common", "Common_Open"),
  importEmpty: t(lang, ns, "ImportEmpty"),
  publicEmpty: t(lang, ns, "PublicEmpty"),
  privateEmpty: t(lang, ns, "PrivateEmpty"),
  download: t(lang, ns, "Download"),
  warningsTitle: t(lang, ns, "WarningsTitle"),
  commentLabel: t(lang, ns, "CommentLabel"),
  errorUnsupportedFormat: t(lang, ns, "ErrorUnsupportedFormat"),
  errorPassphraseRequired: t(lang, ns, "ErrorPassphraseRequired"),
  errorWrongPassphrase: t(lang, ns, "ErrorWrongPassphrase"),
  keySizeDefault: t(lang, ns, "KeySizeDefault"),
  passphraseWhitespaceHint: t(lang, ns, "PassphraseWhitespaceHint"),
  noteTrimmedPassphrase: t(lang, ns, "NoteTrimmedPassphrase"),
  generatingTitle: t(lang, ns, "GeneratingTitle"),
  generationCanceled: t(lang, ns, "GenerationCanceled"),
  cancel: t(lang, ns, "Cancel"),
  error: t(lang, "common", "Common_Error"),
};
const clientStrings = {
  copy: s.copy,
  copied: s.copied,
  copyFailed: s.copyFailed,
  warningsTitle: s.warningsTitle,
  error: s.error,
  unsupportedFormat: s.errorUnsupportedFormat,
  errorPassphraseRequired: s.errorPassphraseRequired,
  errorWrongPassphrase: s.errorWrongPassphrase,
  algorithmLabel: s.algorithmLabel,
  commentLabel: s.commentLabel,
  noteTrimmedPassphrase: s.noteTrimmedPassphrase,
  generationCanceled: s.generationCanceled,
  preparing: t(lang, "common", "Common_Preparing"),
};
const stringsJson = JSON.stringify(clientStrings);
---

<div class="ds-workbench" data-ssh-tool>
  <div class="ds-stack">
    <ToolPanel title={s.generateSectionTitle}>
      <div class="ds-settings ds-settings-flat ssh-gen">
        <Field label={s.algorithmLabel} for="ssh-algorithm">
          <select id="ssh-algorithm" class="ds-field-select" data-ssh-algorithm>
            <option value="ed25519" selected>Ed25519 (Recommended)</option>
            <option value="ecdsa-p256">ECDSA P-256</option>
            <option value="ecdsa-p384">ECDSA P-384</option>
            <option value="rsa-3072">RSA 3072</option>
            <option value="rsa-4096">RSA 4096</option>
          </select>
        </Field>
        <Field label={s.keySizeLabel} for="ssh-keysize">
          <select id="ssh-keysize" class="ds-field-select" data-ssh-keysize disabled>
            <option value="default">{s.keySizeDefault}</option>
            <option value="3072">3072</option>
            <option value="4096">4096</option>
          </select>
        </Field>
        <Field label={s.passphraseLabel} for="ssh-passphrase" class="ds-settings-wide">
          <input
            id="ssh-passphrase"
            class="ds-field"
            data-ssh-passphrase
            type="password"
            autocomplete="new-password"
            spellcheck="false"
          />
          <p class="ds-hint" data-ssh-passphrase-ws aria-live="polite" hidden>{s.passphraseWhitespaceHint}</p>
        </Field>
      </div>
      <div class="ds-action-row">
        <button type="button" class="ds-btn ds-btn-primary" data-ssh-generate>{s.generateButton}</button>
      </div>
      <Progress
        indeterminate
        data-ssh-progress
        title={s.generatingTitle}
        cancelLabel={s.cancel}
        cancelProps={{ "data-ssh-cancel": true }}
        labelProps={{ "data-ssh-progress-label": true }}
      />
    </ToolPanel>

    <ToolPanel title={s.importSectionTitle} meta="" metaProps={{ "data-ssh-importfilename": true, "aria-live": "polite" }}>
      <Fragment slot="actions">
        <label class="ds-btn ds-btn-small ds-btn-ghost ds-file-btn">
          <input type="file" accept=".pub,.pem,.key,.txt,text/plain" data-ssh-importfile aria-label={s.importFileLabel} aria-describedby="ssh-import-hint" />{s.open}
        </label>
      </Fragment>
      <div class="ds-field-group">
        <label class="ds-label" for="ssh-import-text">{s.importLabel}</label>
        <div class="ds-editor is-empty ssh-import-host" data-ssh-dropzone>
          <textarea
            id="ssh-import-text"
            class="ds-field-textarea mono ssh-import"
            data-ssh-import-text
            rows="6"
            spellcheck="false"
            autocomplete="off"
            aria-describedby="ssh-import-empty ssh-import-hint ssh-import-error"></textarea>
          <EmptyState hint={s.importEmpty} hintId="ssh-import-empty" />
        </div>
        <p class="ds-hint" id="ssh-import-hint">{s.importFileHint}</p>
      </div>
      <div class="ds-action-row">
        <button type="button" class="ds-btn ds-btn-primary" data-ssh-import-btn>{s.importButton}</button>
        <button type="button" class="ds-btn" data-ssh-convert>{s.convertButton}</button>
      </div>
      <!-- Import/convert/file errors stay in this card, not next to the generated keys. -->
      <StatusMessage kind="error" id="ssh-import-error" data-ssh-import-error />
    </ToolPanel>
  </div>

  <div class="ds-stack">
    <StatusMessage kind="error" data-ssh-error />
    <StatusMessage kind="info" data-ssh-note />
    <StatusMessage kind="info" class="mono" data-ssh-info />
    <StatusMessage kind="warning" data-ssh-warnings />

    <OutputPanel panel label={s.publicKeyLabel} for="ssh-public" emptyHint={s.publicEmpty} data-ssh-public-panel>
      <Fragment slot="actions">
        <CopyButton ghost label={s.copy} copiedLabel={s.copied} aria-label={`${s.copy}: ${s.publicKeyLabel}`} data-ssh-public-copy disabled />
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-ssh-public-download aria-label={`${s.download}: ${s.publicKeyLabel}`} disabled>{s.download}</button>
      </Fragment>
      <textarea id="ssh-public" class="ds-field-textarea mono ssh-out ds-when-filled" data-ssh-public rows="5" readonly spellcheck="false"></textarea>
    </OutputPanel>
    <OutputPanel panel label={s.privateKeyLabel} for="ssh-private" emptyHint={s.privateEmpty} data-ssh-private-panel>
      <Fragment slot="actions">
        <CopyButton ghost label={s.copy} copiedLabel={s.copied} aria-label={`${s.copy}: ${s.privateKeyLabel}`} data-ssh-private-copy disabled />
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-ssh-private-download aria-label={`${s.download}: ${s.privateKeyLabel}`} disabled>{s.download}</button>
      </Fragment>
      <textarea id="ssh-private" class="ds-field-textarea mono ssh-out ds-when-filled" data-ssh-private rows="10" readonly spellcheck="false"></textarea>
    </OutputPanel>
  </div>
</div>

<script is:inline type="application/json" data-ssh-strings set:html={stringsJson} />
<script>import "@/tools/openssh-keys.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .ssh-gen {
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
  }
  .ds-editor > .ssh-import {
    min-height: 10rem;
  }
  /* The import editor doubles as a key-file drop target. */
  .ssh-import-host.is-dragover > .ssh-import {
    border-color: var(--mdt-cat);
    background: color-mix(in srgb, var(--mdt-cat) 6%, var(--mdt-surface-inset));
  }
  /* Keys are long unbroken base64 tokens: wrap anywhere, never overflow. */
  .ssh-out {
    overflow-wrap: anywhere;
    word-break: break-all;
  }
</style>
