---
/**
 * Password Generator (password WASM domain). Length slider (4-128),
 * charset toggles (uppercase/lowercase/numbers/special + custom symbols),
 * settings persisted to localStorage, auto-generate on load, history of
 * the last 10 passwords with per-item copy and clear. Legacy parity.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/password-generator";
const s = {
  resultLabel: t(lang, ns, "ResultLabel"),
  copy: t(lang, ns, "CopyButton"),
  copied: t(lang, ns, "Copied"),
  generate: t(lang, ns, "GenerateButton"),
  optionsLabel: t(lang, ns, "OptionsLabel"),
  lengthLabel: t(lang, ns, "LengthLabel"),
  uppercaseLabel: t(lang, ns, "UppercaseLabel"),
  lowercaseLabel: t(lang, ns, "LowercaseLabel"),
  numbersLabel: t(lang, ns, "NumbersLabel"),
  specialLabel: t(lang, ns, "SpecialLabel"),
  customSpecialLabel: t(lang, ns, "CustomSpecialLabel"),
  historyLabel: t(lang, ns, "HistoryLabel"),
  clearHistory: t(lang, ns, "ClearHistory"),
  historyEmpty: t(lang, ns, "HistoryEmpty"),
  errorNoCharset: t(lang, ns, "ErrorNoCharset"),
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-stack" data-pw-tool>
  <section class="ds-card pw-result-card">
    <label class="ds-label pw-result-label" for="pw-result">{s.resultLabel}</label>
    <div class="pw-result-row">
      <input
        id="pw-result"
        class="ds-field mono pw-result-input"
        data-pw-result
        type="text"
        readonly
        spellcheck="false"
        autocomplete="off"
        placeholder="…"
        aria-describedby="pw-error"
      />
      <button type="button" class="ds-btn" data-pw-copy>{s.copy}</button>
    </div>
    <button type="button" class="ds-btn ds-btn-primary ds-btn-block pw-generate" data-pw-generate>{s.generate}</button>
    <StatusMessage kind="error" id="pw-error" class="pw-error" data-pw-error />
  </section>

  <div class="ds-tool-grid">
    <section class="ds-card ds-stack">
      <div class="ds-card-head"><h2 class="ds-card-title">{s.optionsLabel}</h2></div>
      <div class="ds-field-group">
        <div class="ds-label-row">
          <label class="ds-label" for="pw-length">{s.lengthLabel}</label>
          <output class="ds-label-aside" for="pw-length" data-pw-length-val>16</output>
        </div>
        <input id="pw-length" class="pw-range" data-pw-length type="range" min="4" max="128" value="16" step="1" />
        <div class="pw-length-scale" aria-hidden="true"><span>4</span><span>64</span><span>128</span></div>
      </div>
      <div class="pw-toggles">
        <label class="ds-check-row"><input type="checkbox" class="ds-check" data-pw-uppercase checked /> {s.uppercaseLabel}</label>
        <label class="ds-check-row"><input type="checkbox" class="ds-check" data-pw-lowercase checked /> {s.lowercaseLabel}</label>
        <label class="ds-check-row"><input type="checkbox" class="ds-check" data-pw-numbers checked /> {s.numbersLabel}</label>
        <label class="ds-check-row"><input type="checkbox" class="ds-check" data-pw-special checked /> {s.specialLabel}</label>
      </div>
      <Field label={s.customSpecialLabel} for="pw-special-chars">
        <input
          id="pw-special-chars"
          class="ds-field mono"
          data-pw-special-chars
          type="text"
          spellcheck="false"
          autocomplete="off"
          placeholder="!@#$%^&amp;*()_+-=[]{}|;:,.&lt;&gt;?"
        />
      </Field>
    </section>

    <section class="ds-card pw-history">
      <div class="ds-card-head">
        <h2 class="ds-card-title">{s.historyLabel}</h2>
        <div class="ds-actions">
          <button type="button" class="ds-btn ds-btn-small ds-btn-ghost ds-btn-danger" data-pw-clear-history>{s.clearHistory}</button>
        </div>
      </div>
      <div class="ds-result-list" data-pw-history-list></div>
      <p class="ds-empty" data-pw-history-empty>{s.historyEmpty}</p>
    </section>
  </div>
</div>

<script is:inline type="application/json" data-pw-strings set:html={stringsJson} />
<script>import "@/tools/password-generator.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .pw-result-label {
    text-align: center;
  }
  .pw-result-row {
    display: flex;
    gap: 0.6rem;
    min-width: 0;
  }
  .pw-result-input {
    flex: 1;
    min-width: 0;
    font-size: 1.05rem;
    text-align: center;
    letter-spacing: 0.04em;
  }
  .pw-generate {
    margin-top: 0.9rem;
  }
  .pw-error {
    margin-top: 0.75rem;
  }
  .pw-range {
    width: 100%;
    accent-color: var(--mdt-cat);
  }
  .pw-length-scale {
    display: flex;
    justify-content: space-between;
    padding: 0 0.4rem;
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-micro);
    color: var(--mdt-text-faint);
  }
  .pw-toggles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(10rem, 100%), 1fr));
    gap: 0.4rem 0.9rem;
  }
  .pw-history :global(.ds-result-list:empty) {
    display: none;
  }
</style>
