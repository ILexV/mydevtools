---
/**
 * Password Generator (password WASM domain). Length slider (4-128),
 * charset toggles (uppercase/lowercase/numbers/special + custom symbols),
 * settings persisted to localStorage, auto-generate on load, history of
 * the last 10 passwords with per-item copy and clear. Legacy parity.
 * Workbench: options (→ Generate) | result headline (password + Copy) over
 * the history panel, which shows an empty state until the first password.
 * Under the password: entropy meter (bits + weak/fair/strong/very strong)
 * computed from the settings the password was generated with.
 */
import { t, pluralVariants } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import CopyButton from "@/components/tool/CopyButton.astro";
import EmptyState from "@/components/tool/EmptyState.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/password-generator";
const s = {
  resultLabel: t(lang, ns, "ResultLabel"),
  copy: t(lang, ns, "CopyButton"),
  copied: t(lang, "common", "Common_Copied"),
  copyFailed: t(lang, "common", "Common_CopyFailed"),
  generate: t(lang, ns, "GenerateButton"),
  optionsLabel: t(lang, ns, "OptionsLabel"),
  lengthLabel: t(lang, ns, "LengthLabel"),
  uppercaseLabel: t(lang, ns, "UppercaseLabel"),
  lowercaseLabel: t(lang, ns, "LowercaseLabel"),
  numbersLabel: t(lang, ns, "NumbersLabel"),
  specialLabel: t(lang, ns, "SpecialLabel"),
  customSpecialLabel: t(lang, ns, "CustomSpecialLabel"),
  historyLabel: t(lang, ns, "HistoryLabel"),
  clearHistory: t(lang, ns, "ClearHistory"),
  historyEmpty: t(lang, ns, "HistoryEmpty"),
  errorNoCharset: t(lang, ns, "ErrorNoCharset"),
  preparing: t(lang, "common", "Common_Preparing"),
  strengthLabel: t(lang, ns, "StrengthLabel"),
  entropyBits: t(lang, ns, "EntropyBits"),
  ...pluralVariants(lang, ns),
  strengthLevels: [
    t(lang, ns, "StrengthWeak"),
    t(lang, ns, "StrengthFair"),
    t(lang, ns, "StrengthStrong"),
    t(lang, ns, "StrengthVeryStrong"),
  ],
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-workbench" data-pw-tool>
  <ToolPanel title={s.optionsLabel}>
    <div class="ds-field-group">
      <div class="ds-label-row">
        <label class="ds-label" for="pw-length">{s.lengthLabel}</label>
        <output class="ds-label-aside" for="pw-length" data-pw-length-val>16</output>
      </div>
      <input id="pw-length" class="pw-range" data-pw-length type="range" min="4" max="128" value="16" step="1" />
      <div class="pw-length-scale" aria-hidden="true"><span>4</span><span>64</span><span>128</span></div>
    </div>
    <div class="pw-toggles">
      <label class="ds-check-row"><input type="checkbox" class="ds-check" data-pw-uppercase checked /> {s.uppercaseLabel}</label>
      <label class="ds-check-row"><input type="checkbox" class="ds-check" data-pw-lowercase checked /> {s.lowercaseLabel}</label>
      <label class="ds-check-row"><input type="checkbox" class="ds-check" data-pw-numbers checked /> {s.numbersLabel}</label>
      <label class="ds-check-row"><input type="checkbox" class="ds-check" data-pw-special checked /> {s.specialLabel}</label>
    </div>
    <Field label={s.customSpecialLabel} for="pw-special-chars">
      <input
        id="pw-special-chars"
        class="ds-field mono"
        data-pw-special-chars
        type="text"
        spellcheck="false"
        autocomplete="off"
        placeholder="!@#$%^&amp;*()_+-=[]{}|;:,.&lt;&gt;?"
      />
    </Field>
    <div class="ds-action-row">
      <button type="button" class="ds-btn ds-btn-primary" data-pw-generate>{s.generate}</button>
    </div>
    <StatusMessage kind="error" id="pw-error" data-pw-error />
  </ToolPanel>

  <div class="ds-stack">
    <ToolPanel title={s.resultLabel} as="h2" data-pw-result-panel>
      <div class="ds-result-headline">
        <output class="ds-result-headline-value pw-result" data-pw-result aria-describedby="pw-error" aria-live="off"></output>
        <CopyButton label={s.copy} copiedLabel={s.copied} failedLabel={s.copyFailed} data-pw-copy />
        <div class="ds-result-headline-meta pw-strength" data-pw-strength hidden>
          <span
            class="ds-meter pw-meter"
            role="meter"
            aria-label={s.strengthLabel}
            aria-valuemin="0"
            aria-valuemax="128"
            data-pw-meter
          ><i></i></span>
          <span class="pw-strength-text"><strong data-pw-strength-level></strong> · <span class="mono" data-pw-entropy></span></span>
        </div>
      </div>
    </ToolPanel>

    <ToolPanel title={s.historyLabel} empty data-pw-history>
      <Fragment slot="actions">
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-pw-clear-history hidden>{s.clearHistory}</button>
      </Fragment>
      <EmptyState hint={s.historyEmpty} />
      <div class="ds-result-list ds-when-filled" data-pw-history-list></div>
    </ToolPanel>
  </div>
</div>

<script is:inline type="application/json" data-pw-strings set:html={stringsJson} />
<script>import "@/tools/password-generator.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  /* Passwords contain punctuation the browser treats as break points, so a wrap
     looked like a space ("^0CV? / J}K…"). Break anywhere (uniform, long lengths)
     and use a smaller size on phones so the default 16 characters fit one line. */
  .pw-result {
    min-height: 1.15em;
    letter-spacing: 0.02em;
    word-break: break-all;
  }
  @media (max-width: 480px) {
    .pw-result { font-size: 1.2rem; letter-spacing: 0; }
  }
  .pw-strength {
    align-items: center;
  }
  .pw-meter {
    flex: 1 1 8rem;
    max-width: 16rem;
  }
  .pw-strength-text strong {
    font-weight: 600;
    color: var(--mdt-text);
  }
  .pw-range {
    width: 100%;
    accent-color: var(--mdt-cat);
  }
  .pw-length-scale {
    display: flex;
    justify-content: space-between;
    padding: 0 0.4rem;
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-micro);
    color: var(--mdt-text-faint);
  }
  .pw-toggles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(12.5rem, 100%), 1fr));
    gap: 0.4rem 0.9rem;
  }
</style>
