---
/**
 * Password Generator (password WASM domain). Length slider (4-128),
 * charset toggles (uppercase/lowercase/numbers/special + custom symbols),
 * settings persisted to localStorage, auto-generate on load, history of
 * the last 10 passwords with per-item copy and clear. Legacy parity.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/password-generator";
const s = {
  resultLabel: t(lang, ns, "ResultLabel"),
  copy: t(lang, ns, "CopyButton"),
  copied: t(lang, ns, "Copied"),
  generate: t(lang, ns, "GenerateButton"),
  optionsLabel: t(lang, ns, "OptionsLabel"),
  lengthLabel: t(lang, ns, "LengthLabel"),
  uppercaseLabel: t(lang, ns, "UppercaseLabel"),
  lowercaseLabel: t(lang, ns, "LowercaseLabel"),
  numbersLabel: t(lang, ns, "NumbersLabel"),
  specialLabel: t(lang, ns, "SpecialLabel"),
  customSpecialLabel: t(lang, ns, "CustomSpecialLabel"),
  historyLabel: t(lang, ns, "HistoryLabel"),
  clearHistory: t(lang, ns, "ClearHistory"),
  historyEmpty: t(lang, ns, "HistoryEmpty"),
  errorNoCharset: t(lang, ns, "ErrorNoCharset"),
};
const stringsJson = JSON.stringify(s);
---

<div class="pw-tool" data-pw-tool>
  <section class="pw-result-card">
    <label class="field-label pw-result-label" for="pw-result">{s.resultLabel}</label>
    <div class="pw-result-row">
      <input id="pw-result" data-pw-result type="text" readonly placeholder="…" />
      <button type="button" class="primary-btn" data-pw-copy>{s.copy}</button>
    </div>
    <button type="button" class="generate-btn" data-pw-generate>{s.generate}</button>
  </section>

  <div class="pw-grid">
    <section class="pw-card">
      <h3 class="pw-card-title">{s.optionsLabel}</h3>
      <div class="pw-length">
        <div class="pw-length-head">
          <label class="field-label" for="pw-length">{s.lengthLabel}</label>
          <span class="pw-length-val" data-pw-length-val>16</span>
        </div>
        <input id="pw-length" data-pw-length type="range" min="4" max="128" value="16" step="1" />
        <div class="pw-length-scale"><span>4</span><span>64</span><span>128</span></div>
      </div>
      <div class="pw-toggles">
        <label class="check"><input type="checkbox" data-pw-uppercase checked /> {s.uppercaseLabel}</label>
        <label class="check"><input type="checkbox" data-pw-lowercase checked /> {s.lowercaseLabel}</label>
        <label class="check"><input type="checkbox" data-pw-numbers checked /> {s.numbersLabel}</label>
        <label class="check"><input type="checkbox" data-pw-special checked /> {s.specialLabel}</label>
      </div>
      <div class="pw-custom">
        <label class="field-label" for="pw-special-chars">{s.customSpecialLabel}</label>
        <input id="pw-special-chars" data-pw-special-chars type="text" placeholder="!@#$%^&amp;*()_+-=[]{}|;:,.&lt;&gt;?" />
      </div>
    </section>

    <section class="pw-card">
      <div class="pw-history-head">
        <h3 class="pw-card-title">{s.historyLabel}</h3>
        <button type="button" class="link-btn pw-clear" data-pw-clear-history>{s.clearHistory}</button>
      </div>
      <ul class="pw-history-list" data-pw-history-list></ul>
      <p class="pw-history-empty" data-pw-history-empty>{s.historyEmpty}</p>
    </section>
  </div>
</div>

<script is:inline type="application/json" data-pw-strings set:html={stringsJson} />
<script>import "@/tools/password-generator.client.ts";</script>

<style>
  .pw-tool { display: flex; flex-direction: column; gap: 1.25rem; }
  .field-label { display: block; font-size: 0.8rem; font-weight: 600; color: var(--mdt-text-muted); margin-bottom: 0.35rem; }
  .pw-result-card, .pw-card { border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius); background: var(--mdt-surface-raised); padding: 1rem; }
  .pw-result-label { text-align: center; font-size: 0.95rem; }
  .pw-result-row { display: flex; gap: 0.6rem; }
  .pw-result-row input { flex: 1; min-width: 0; padding: 0.7rem; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm); background: var(--mdt-surface-muted); color: var(--mdt-text); font-family: var(--mdt-font-mono); font-size: 1.05rem; text-align: center; letter-spacing: 0.04em; }
  .pw-result-row input:focus { outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px; }
  .primary-btn, .generate-btn { border: 1px solid transparent; border-radius: var(--mdt-radius); font-weight: 600; cursor: pointer; }
  .primary-btn { padding: 0.6rem 1.1rem; background: var(--mdt-accent); color: var(--mdt-accent-contrast); white-space: nowrap; }
  .primary-btn:hover { filter: brightness(1.05); }
  .generate-btn { width: 100%; margin-top: 0.9rem; padding: 0.75rem 1.1rem; background: var(--mdt-accent); color: var(--mdt-accent-contrast); font-size: 1rem; }
  .generate-btn:hover { filter: brightness(1.05); }
  .pw-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 900px) { .pw-grid { grid-template-columns: 1fr 1fr; } }
  .pw-card-title { font-size: 0.95rem; margin: 0 0 0.9rem; }
  .pw-length-head { display: flex; justify-content: space-between; align-items: baseline; }
  .pw-length-val { font-family: var(--mdt-font-mono); font-size: 0.85rem; font-weight: 700; padding: 0.1rem 0.55rem; border: 1px solid var(--mdt-border); border-radius: 999px; background: var(--mdt-surface-muted); }
  .pw-length input[type="range"] { width: 100%; accent-color: var(--mdt-accent); }
  .pw-length-scale { display: flex; justify-content: space-between; font-size: 0.72rem; color: var(--mdt-text-muted); padding: 0 0.4rem; }
  .pw-toggles { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.4rem 0.9rem; margin-top: 0.9rem; padding-top: 0.9rem; border-top: 1px solid var(--mdt-border); }
  .check { display: flex; align-items: center; gap: 0.45rem; font-size: 0.85rem; cursor: pointer; }
  .check input { accent-color: var(--mdt-accent); }
  .pw-custom { margin-top: 0.9rem; }
  .pw-custom input { width: 100%; padding: 0.5rem 0.6rem; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm); background: var(--mdt-surface-muted); color: var(--mdt-text); font-family: var(--mdt-font-mono); font-size: 0.85rem; }
  .pw-custom input:focus { outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px; }
  .pw-history-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.9rem; }
  .pw-history-head .pw-card-title { margin: 0; }
  .link-btn { background: none; border: none; color: var(--mdt-accent); cursor: pointer; font-size: 0.8rem; }
  .link-btn.pw-clear { color: var(--mdt-danger); }
  .pw-history-list { list-style: none; margin: 0; padding: 0; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm); overflow: hidden; }
  .pw-history-list:empty { display: none; }
  .pw-history-list li { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; padding: 0.45rem 0.7rem; }
  .pw-history-list li:nth-child(even) { background: var(--mdt-surface-muted); }
  .pw-history-pass { font-family: var(--mdt-font-mono); font-size: 0.85rem; word-break: break-all; }
  .pw-history-copy { flex: none; display: inline-flex; align-items: center; background: none; border: none; color: var(--mdt-text-muted); cursor: pointer; padding: 0.2rem; border-radius: var(--mdt-radius-sm); }
  .pw-history-copy:hover { color: var(--mdt-accent); }
  .pw-history-empty { margin: 0; padding: 0.9rem; text-align: center; font-size: 0.82rem; color: var(--mdt-text-muted); border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm); }
</style>
