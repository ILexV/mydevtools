---
/**
 * PDF Compressor (pdf WASM domain). Upload/drag-drop one or more PDFs
 * (legacy parity: files accumulate in a list), compress them all with
 * `compressPdf`, then download each result as `compressed_<name>.pdf`
 * (legacy parity). Per-row original → compressed size with a "Saved N%"
 * badge (shown even when negative — legacy parity). Non-PDF files are
 * rejected with a localized message; corrupted / password-protected PDFs
 * get a per-row error badge and a localized message, the batch continues.
 * UI: tool UI kit (FileDrop + ds-file-list rows built by the controller,
 * Progress with cancel that aborts the current file in the pdf worker,
 * StatusMessage).
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import FileDrop from "@/components/tool/FileDrop.astro";
import Progress from "@/components/tool/Progress.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/pdf-compressor";
const s = {
  dropZone: t(lang, ns, "DropZoneTitle"),
  dropSubtitle: t(lang, "common", "Common_FileDropSubtitle"),
  chooseFile: t(lang, "common", "Common_FileChooseButton"),
  filesToProcess: t(lang, ns, "FilesToProcess"),
  tableOriginalSize: t(lang, ns, "TableOriginalSize"),
  tableCompressedSize: t(lang, ns, "TableCompressedSize"),
  statusReady: t(lang, ns, "StatusReady"),
  savedPercent: t(lang, ns, "SavedPercent"),
  compress: t(lang, ns, "CompressButton"),
  processing: t(lang, ns, "ProcessingText"),
  cancel: t(lang, ns, "Cancel"),
  download: t(lang, ns, "DownloadButton"),
  removeFile: t(lang, ns, "RemoveFile"),
  errorNotPdf: t(lang, ns, "ErrorNotPdf"),
  errorInvalidPdf: t(lang, ns, "ErrorInvalidPdf"),
  errorEncrypted: t(lang, ns, "ErrorEncrypted"),
  error: t(lang, "common", "Common_Error"),
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-stack pdfc-tool" data-pdfc-tool>
  <FileDrop
    title={s.dropZone}
    sub={s.dropSubtitle}
    buttonLabel={s.chooseFile}
    accept=".pdf,application/pdf"
    multiple
    data-pdfc-dropzone
    inputProps={{ "data-pdfc-file": true }}
  />

  <ToolPanel title={s.filesToProcess} data-pdfc-list hidden>
    <ul class="ds-file-list" data-pdfc-items></ul>
    <div class="ds-action-row">
      <button type="button" class="ds-btn ds-btn-primary" data-pdfc-compress>
        <span data-pdfc-compress-label>{s.compress}</span>
      </button>
    </div>
  </ToolPanel>

  <Progress
    title={s.processing}
    cancelLabel={s.cancel}
    data-pdfc-progress
    cancelProps={{ "data-pdfc-cancel": true }}
    barProps={{ "data-pdfc-progress-bar": true }}
    fillProps={{ "data-pdfc-progress-fill": true }}
    labelProps={{ "data-pdfc-progress-label": true }}
  />

  <StatusMessage kind="error" class="pdf-errors" data-pdfc-error />
</div>

<script is:inline type="application/json" data-pdfc-strings set:html={stringsJson} />
<script>import "@/tools/pdf-compressor.client.ts";</script>

<style>
  .pdfc-tool { max-width: 48rem; margin: 0 auto; }
  .pdfc-tool :global(.pdf-errors) { white-space: pre-line; }
  .pdfc-tool :global(.pdf-meta-value) { white-space: nowrap; }
</style>
