---
/**
 * PDF Merger (pdf WASM domain). Upload/drag-drop multiple PDFs — files are
 * appended in selection order (merge order = list order; no dedup — legacy
 * parity) and can be reordered with move up/down buttons, removed
 * individually or cleared. Merge runs via `mergePdfs` once ≥2 files are
 * selected; on success the merge button hides (legacy parity), rows get a
 * success badge, and the result offers the merged size plus a `merged.pdf`
 * download (legacy filename). Non-PDF picks are rejected with a localized
 * message; a corrupted / password-protected input is named in a localized
 * error and marked in the list. While merging, an indeterminate Progress
 * with elapsed seconds and Cancel (terminates the pdf worker) is shown; a
 * cancelled merge leaves the list intact with an info note.
 * UI: tool UI kit (FileDrop, ds-file-list rows built by the controller,
 * Progress, StatusMessage).
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import FileDrop from "@/components/tool/FileDrop.astro";
import Progress from "@/components/tool/Progress.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import Icon from "@/components/Icon.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/pdf-merger";
const s = {
  dropZone: t(lang, ns, "DropZoneTitle"),
  dropSubtitle: t(lang, "common", "Common_FileDropSubtitle"),
  chooseFiles: t(lang, ns, "ChooseFiles"),
  addFiles: t(lang, ns, "AddFiles"),
  clearAll: t(lang, ns, "ClearAll"),
  colSize: t(lang, ns, "ColSize"),
  statusReady: t(lang, ns, "StatusReady"),
  removeFile: t(lang, ns, "RemoveFile"),
  moveUp: t(lang, ns, "MoveUp"),
  moveDown: t(lang, ns, "MoveDown"),
  merge: t(lang, ns, "MergeButton"),
  merging: t(lang, ns, "Merging"),
  cancel: t(lang, ns, "Cancel"),
  mergeCanceled: t(lang, ns, "MergeCanceled"),
  success: t(lang, ns, "Success"),
  resultLabel: t(lang, ns, "ResultLabel"),
  resultName: "merged.pdf",
  minFilesHint: t(lang, ns, "MinFilesHint"),
  filesTitle: t(lang, ns, "FilesTitle"),
  download: t(lang, ns, "DownloadButton"),
  errorNotPdf: t(lang, ns, "ErrorNotPdf"),
  errorInvalidPdf: t(lang, ns, "ErrorInvalidPdf"),
  errorEncrypted: t(lang, ns, "ErrorEncrypted"),
  errorMerge: t(lang, ns, "ErrorMerge"),
  error: t(lang, "common", "Common_Error"),
  preparing: t(lang, "common", "Common_Preparing"),
  processingFailed: t(lang, "common", "Common_ProcessingFailed"),
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-stack pdfm-tool" data-pdfm-tool>
  <FileDrop
    title={s.dropZone}
    sub={s.dropSubtitle}
    buttonLabel={s.chooseFiles}
    accept=".pdf,application/pdf"
    multiple
    data-pdfm-dropzone
    inputProps={{ "data-pdfm-file": true }}
  />

  <ToolPanel title={s.filesTitle} data-pdfm-list hidden>
    <Fragment slot="actions">
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-pdfm-add>{s.addFiles}</button>
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-pdfm-clear>{s.clearAll}</button>
    </Fragment>
    <ol class="ds-file-list" data-pdfm-items></ol>
    <div class="ds-action-row">
      <button type="button" class="ds-btn ds-btn-primary" data-pdfm-merge disabled aria-describedby="pdfm-hint">
        <span data-pdfm-merge-label>{s.merge}</span>
      </button>
      <p class="ds-action-row-aside" id="pdfm-hint" data-pdfm-hint>{s.minFilesHint}</p>
    </div>
  </ToolPanel>

  <Progress
    indeterminate
    title={s.merging}
    cancelLabel={s.cancel}
    data-pdfm-progress
    cancelProps={{ "data-pdfm-cancel": true }}
    labelProps={{ "data-pdfm-progress-label": true }}
  />

  <ToolPanel title={s.resultLabel} data-pdfm-result hidden>
    <div class="ds-result-headline">
      <span class="ds-result-headline-label mono">{s.resultName}</span>
      <strong class="ds-result-headline-value" data-pdfm-result-size></strong>
      <button type="button" class="ds-btn ds-btn-primary" data-pdfm-download>
        <Icon name="download" size={16} />
        {s.download}
      </button>
      <p class="ds-result-headline-meta"><span class="ds-status is-success" role="status">{s.success}</span></p>
    </div>
  </ToolPanel>

  <StatusMessage kind="error" data-pdfm-error />
  <StatusMessage kind="info" data-pdfm-note />
</div>

<script is:inline type="application/json" data-pdfm-strings set:html={stringsJson} />
<script>import "@/tools/pdf-merger.client.ts";</script>

<style>
  .pdfm-tool { max-width: 48rem; margin: 0 auto; }
  .pdfm-tool :global(.pdf-meta-value) { white-space: nowrap; }
</style>
