---
/**
 * QR Code Generator (qrcode WASM domain). Content + colors (picker ↔ hex
 * text sync), style (square/dots/rounded), error-correction level, size,
 * optional logo (drop zone with preview + clear). Generate button produces a
 * PNG preview (blob URL) with PNG download; SVG download only for square
 * style without logo (legacy parity). No live regenerate — legacy generates
 * on button click only.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import FileDrop from "@/components/tool/FileDrop.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/qr-code-generator";
const s = {
  contentLabel: t(lang, ns, "ContentLabel"),
  contentPlaceholder: t(lang, ns, "ContentPlaceholder"),
  colorsSection: t(lang, ns, "ColorsSection"),
  foregroundColor: t(lang, ns, "ForegroundColor"),
  backgroundColor: t(lang, ns, "BackgroundColor"),
  optionsSection: t(lang, ns, "OptionsSection"),
  styleLabel: t(lang, ns, "StyleLabel"),
  styleSquare: t(lang, ns, "StyleSquare"),
  styleDots: t(lang, ns, "StyleDots"),
  styleRounded: t(lang, ns, "StyleRounded"),
  errorCorrectionLabel: t(lang, ns, "ErrorCorrectionLabel"),
  sizeLabel: t(lang, ns, "SizeLabel"),
  logoSection: t(lang, ns, "LogoSection"),
  logoHint: t(lang, ns, "LogoHint"),
  logoDropText: t(lang, ns, "LogoDropText"),
  chooseFile: t(lang, "common", "Common_FileChooseButton"),
  logoRemove: t(lang, ns, "LogoRemove"),
  generate: t(lang, ns, "Generate"),
  generating: t(lang, ns, "Generating"),
  previewSection: t(lang, ns, "PreviewSection"),
  previewPlaceholder: t(lang, ns, "PreviewPlaceholder"),
  errorEmptyContent: t(lang, ns, "ErrorEmptyContent"),
  errorInvalidImage: t(lang, ns, "ErrorInvalidImage"),
  errorGenerateFailed: t(lang, ns, "ErrorGenerateFailed"),
  errorTooLong: t(lang, ns, "ErrorTooLong"),
  errorInvalidColor: t(lang, ns, "ErrorInvalidColor"),
};
const stringsJson = JSON.stringify(s);
const qrIcon = [
  "M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z",
  "M6.75 6.75h.75v.75h-.75v-.75ZM6.75 16.5h.75v.75h-.75v-.75ZM16.5 6.75h.75v.75h-.75v-.75ZM13.5 13.5h.75v.75h-.75v-.75ZM13.5 19.5h.75v.75h-.75v-.75ZM19.5 13.5h.75v.75h-.75v-.75ZM19.5 19.5h.75v.75h-.75v-.75ZM16.5 16.5h.75v.75h-.75v-.75Z",
];
const downloadIcon = "M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4";
---

<div class="ds-tool-grid qrg-grid" data-qrg-tool>
  <div class="ds-stack">
    <section class="ds-card">
      <Field label={s.contentLabel} for="qrg-content">
        <textarea
          id="qrg-content"
          class="ds-field-textarea mono qrg-content"
          data-qrg-content
          rows="3"
          placeholder={s.contentPlaceholder}
        ></textarea>
      </Field>
    </section>

    <section class="ds-card">
      <div class="ds-card-head"><h3 class="ds-card-title">{s.colorsSection}</h3></div>
      <div class="ds-settings ds-settings-flat">
        <Field label={s.foregroundColor} for="qrg-fg-text" hintProps={{ "data-qrg-fg-hint": true, class: "ds-hint ds-hint-error", hidden: true }}>
          <div class="ds-input-group">
            <input type="color" class="ds-color-well" data-qrg-fg value="#000000" aria-label={s.foregroundColor} />
            <input type="text" id="qrg-fg-text" class="ds-field mono qrg-hex" data-qrg-fg-text value="#000000" maxlength="7" spellcheck="false" autocomplete="off" />
          </div>
        </Field>
        <Field label={s.backgroundColor} for="qrg-bg-text" hintProps={{ "data-qrg-bg-hint": true, class: "ds-hint ds-hint-error", hidden: true }}>
          <div class="ds-input-group">
            <input type="color" class="ds-color-well" data-qrg-bg value="#FFFFFF" aria-label={s.backgroundColor} />
            <input type="text" id="qrg-bg-text" class="ds-field mono qrg-hex" data-qrg-bg-text value="#FFFFFF" maxlength="7" spellcheck="false" autocomplete="off" />
          </div>
        </Field>
      </div>
    </section>

    <section class="ds-card ds-stack">
      <div class="ds-card-head qrg-card-head"><h3 class="ds-card-title">{s.optionsSection}</h3></div>
      <Field label={s.styleLabel}>
        <div class="seg" role="group" aria-label={s.styleLabel}>
          <button type="button" aria-pressed="true" data-qrg-style data-style="square">{s.styleSquare}</button>
          <button type="button" aria-pressed="false" data-qrg-style data-style="dots">{s.styleDots}</button>
          <button type="button" aria-pressed="false" data-qrg-style data-style="rounded">{s.styleRounded}</button>
        </div>
      </Field>
      <div class="ds-settings ds-settings-flat">
        <Field label={s.errorCorrectionLabel} for="qrg-ec">
          <select id="qrg-ec" class="ds-field-select" data-qrg-ec>
            <option value="L">L - 7%</option>
            <option value="M" selected>M - 15%</option>
            <option value="Q">Q - 25%</option>
            <option value="H">H - 30%</option>
          </select>
        </Field>
        <Field label={s.sizeLabel} for="qrg-size">
          <select id="qrg-size" class="ds-field-select" data-qrg-size>
            <option value="256">256 × 256</option>
            <option value="512" selected>512 × 512</option>
            <option value="1024">1024 × 1024</option>
            <option value="2048">2048 × 2048</option>
          </select>
        </Field>
      </div>
    </section>

    <section class="ds-card">
      <div class="ds-card-head"><h3 class="ds-card-title">{s.logoSection}</h3></div>
      <FileDrop
        changeLabel={t(lang, "common", "Common_FileChangeButton")}
        title={s.logoDropText}
        buttonLabel={s.chooseFile}
        sub={s.logoHint}
        accept="image/png,image/jpeg,image/webp"
        data-qrg-logodrop
        inputProps={{ "data-qrg-logo": true, "aria-label": s.logoSection }}
      >
        <div class="qrg-logo-selected" data-qrg-logo-selected hidden>
          <img class="qrg-logo-preview" data-qrg-logo-preview alt={s.logoSection} />
          <button type="button" class="ds-btn ds-btn-small ds-btn-danger" data-qrg-logo-clear>{s.logoRemove}</button>
        </div>
      </FileDrop>
    </section>

    <button type="button" class="ds-btn ds-btn-primary ds-btn-block qrg-generate" data-qrg-generate>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="20" height="20" aria-hidden="true">
        {qrIcon.map((d) => <path stroke-linecap="round" stroke-linejoin="round" d={d} />)}
      </svg>
      <span data-qrg-generate-label>{s.generate}</span>
    </button>
    <StatusMessage kind="error" data-qrg-error />
  </div>

  <section class="ds-card qrg-preview-section" aria-labelledby="qrg-preview-title">
    <div class="ds-card-head"><h3 class="ds-card-title" id="qrg-preview-title">{s.previewSection}</h3></div>
    <div class="qrg-preview-box" data-qrg-preview-box aria-live="polite">
      <span class="ds-empty" data-qrg-placeholder>{s.previewPlaceholder}</span>
      <img class="qrg-preview-img" data-qrg-preview alt="QR Code" hidden />
      <div class="qrg-loading" data-qrg-loading hidden>
        <span class="ds-spinner qrg-spinner" aria-hidden="true"></span>
      </div>
    </div>
    <div class="ds-actions qrg-downloads">
      <a class="ds-btn ds-btn-primary" data-qrg-download-png hidden>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={downloadIcon}></path></svg>
        PNG
      </a>
      <a class="ds-btn" data-qrg-download-svg hidden>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={downloadIcon}></path></svg>
        SVG
      </a>
    </div>
  </section>
</div>

<script is:inline type="application/json" data-qrg-strings set:html={stringsJson} />
<script>import "@/tools/qr-code-generator.client.ts";</script>

<style>
  .qrg-grid { --ds-tool-grid-cols: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
  .qrg-card-head { margin-bottom: 0; }
  .qrg-content { min-height: 5rem; }
  .qrg-hex { text-transform: uppercase; }
  .qrg-logo-selected { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }
  .qrg-logo-preview {
    max-width: 10rem;
    max-height: 7rem;
    object-fit: contain;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-sm);
  }
  .qrg-preview-section { text-align: center; }
  @media (min-width: 900px) { .qrg-preview-section { position: sticky; top: 1rem; } }
  .qrg-preview-box {
    position: relative;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    margin-bottom: 1rem;
    border: 1.5px dashed var(--mdt-border);
    border-radius: var(--mdt-radius);
    background: var(--mdt-surface-muted);
    overflow: hidden;
  }
  .qrg-preview-img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: var(--mdt-radius-sm); }
  .qrg-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--mdt-surface-raised) 70%, transparent);
  }
  .qrg-spinner { width: 2.5rem; height: 2.5rem; border-width: 3px; }
  .qrg-downloads { justify-content: center; }
</style>
