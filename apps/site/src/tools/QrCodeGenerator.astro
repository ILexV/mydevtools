---
/**
 * QR Code Generator (qrcode WASM domain). Content + colors (picker ↔ hex
 * text sync), style (square/dots/rounded), error-correction level, size,
 * optional logo (drop zone with preview + clear). Generate button produces a
 * PNG preview (blob URL) with PNG download; SVG download only for square
 * style without logo (legacy parity). No live regenerate — legacy generates
 * on button click only.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/qr-code-generator";
const s = {
  contentLabel: t(lang, ns, "ContentLabel"),
  contentPlaceholder: t(lang, ns, "ContentPlaceholder"),
  colorsSection: t(lang, ns, "ColorsSection"),
  foregroundColor: t(lang, ns, "ForegroundColor"),
  backgroundColor: t(lang, ns, "BackgroundColor"),
  optionsSection: t(lang, ns, "OptionsSection"),
  styleLabel: t(lang, ns, "StyleLabel"),
  styleSquare: t(lang, ns, "StyleSquare"),
  styleDots: t(lang, ns, "StyleDots"),
  styleRounded: t(lang, ns, "StyleRounded"),
  errorCorrectionLabel: t(lang, ns, "ErrorCorrectionLabel"),
  sizeLabel: t(lang, ns, "SizeLabel"),
  logoSection: t(lang, ns, "LogoSection"),
  logoHint: t(lang, ns, "LogoHint"),
  logoDropText: t(lang, ns, "LogoDropText"),
  chooseFile: t(lang, "common", "Common_FileChooseButton"),
  changeFile: t(lang, "common", "Common_FileChangeButton"),
  clearFile: t(lang, "common", "Common_ClearFile"),
  generate: t(lang, ns, "Generate"),
  generating: t(lang, ns, "Generating"),
  previewSection: t(lang, ns, "PreviewSection"),
  previewPlaceholder: t(lang, ns, "PreviewPlaceholder"),
  errorEmptyContent: t(lang, ns, "ErrorEmptyContent"),
  errorInvalidImage: t(lang, ns, "ErrorInvalidImage"),
  errorGenerateFailed: t(lang, ns, "ErrorGenerateFailed"),
};
const stringsJson = JSON.stringify(s);
---

<div class="qrg-tool" data-qrg-tool>
  <p class="qrg-error" data-qrg-error role="alert" hidden></p>

  <div class="qrg-grid">
    <div class="qrg-settings">
      <section class="qrg-section">
        <label class="field-label" for="qrg-content">{s.contentLabel}</label>
        <textarea id="qrg-content" data-qrg-content rows="3" placeholder={s.contentPlaceholder}></textarea>
      </section>

      <section class="qrg-section">
        <h3 class="qrg-heading">{s.colorsSection}</h3>
        <div class="qrg-color-grid">
          <div>
            <span class="field-label">{s.foregroundColor}</span>
            <div class="qrg-color-row">
              <input type="color" data-qrg-fg value="#000000" aria-label={s.foregroundColor} />
              <input type="text" data-qrg-fg-text value="#000000" maxlength="7" spellcheck="false" aria-label={s.foregroundColor} />
            </div>
          </div>
          <div>
            <span class="field-label">{s.backgroundColor}</span>
            <div class="qrg-color-row">
              <input type="color" data-qrg-bg value="#FFFFFF" aria-label={s.backgroundColor} />
              <input type="text" data-qrg-bg-text value="#FFFFFF" maxlength="7" spellcheck="false" aria-label={s.backgroundColor} />
            </div>
          </div>
        </div>
      </section>

      <section class="qrg-section">
        <h3 class="qrg-heading">{s.optionsSection}</h3>
        <span class="field-label">{s.styleLabel}</span>
        <div class="qrg-style-group" role="group" aria-label={s.styleLabel}>
          <button type="button" class="ghost-btn qrg-style-btn qrg-active" data-qrg-style data-style="square">{s.styleSquare}</button>
          <button type="button" class="ghost-btn qrg-style-btn" data-qrg-style data-style="dots">{s.styleDots}</button>
          <button type="button" class="ghost-btn qrg-style-btn" data-qrg-style data-style="rounded">{s.styleRounded}</button>
        </div>
        <div class="qrg-options-grid">
          <label class="setting">
            <span class="field-label">{s.errorCorrectionLabel}</span>
            <select data-qrg-ec>
              <option value="L">L - 7%</option>
              <option value="M" selected>M - 15%</option>
              <option value="Q">Q - 25%</option>
              <option value="H">H - 30%</option>
            </select>
          </label>
          <label class="setting">
            <span class="field-label">{s.sizeLabel}</span>
            <select data-qrg-size>
              <option value="256">256 × 256</option>
              <option value="512" selected>512 × 512</option>
              <option value="1024">1024 × 1024</option>
              <option value="2048">2048 × 2048</option>
            </select>
          </label>
        </div>
      </section>

      <section class="qrg-section">
        <h3 class="qrg-heading">{s.logoSection}</h3>
        <div class="qrg-drop" data-qrg-logodrop>
          <input type="file" accept="image/png,image/jpeg,image/webp" data-qrg-logo hidden />
          <button type="button" class="qrg-clear" data-qrg-logo-clear aria-label={s.clearFile} title={s.clearFile} hidden>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>

          <div class="qrg-drop-empty" data-qrg-logo-empty>
            <svg class="qrg-drop-icon" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <p class="qrg-drop-text">{s.logoDropText}</p>
            <button type="button" class="primary-btn" data-qrg-logo-choose>{s.chooseFile}</button>
          </div>

          <div class="qrg-drop-selected" data-qrg-logo-selected hidden>
            <img class="qrg-logo-preview" data-qrg-logo-preview alt={s.logoSection} />
            <button type="button" class="primary-btn" data-qrg-logo-change>{s.changeFile}</button>
          </div>
        </div>
        <p class="file-hint">{s.logoHint}</p>
      </section>

      <button type="button" class="primary-btn qrg-generate" data-qrg-generate>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="20" height="20" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 6.75h.75v.75h-.75v-.75ZM6.75 16.5h.75v.75h-.75v-.75ZM16.5 6.75h.75v.75h-.75v-.75ZM13.5 13.5h.75v.75h-.75v-.75ZM13.5 19.5h.75v.75h-.75v-.75ZM19.5 13.5h.75v.75h-.75v-.75ZM19.5 19.5h.75v.75h-.75v-.75ZM16.5 16.5h.75v.75h-.75v-.75Z" />
        </svg>
        <span data-qrg-generate-label>{s.generate}</span>
      </button>
    </div>

    <section class="qrg-section qrg-preview-section">
      <h3 class="qrg-heading qrg-preview-heading">{s.previewSection}</h3>
      <div class="qrg-preview-box" data-qrg-preview-box>
        <span class="qrg-placeholder" data-qrg-placeholder>{s.previewPlaceholder}</span>
        <img class="qrg-preview-img" data-qrg-preview alt="QR Code" hidden />
        <div class="qrg-loading" data-qrg-loading hidden>
          <span class="qrg-spinner" aria-hidden="true"></span>
        </div>
      </div>
      <div class="qrg-downloads">
        <a class="qrg-download-png" data-qrg-download-png hidden>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          PNG
        </a>
        <a class="qrg-download-svg" data-qrg-download-svg hidden>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          SVG
        </a>
      </div>
    </section>
  </div>
</div>

<script is:inline type="application/json" data-qrg-strings set:html={stringsJson} />
<script>import "@/tools/qr-code-generator.client.ts";</script>

<style>
  .qrg-tool { max-width: 64rem; margin: 0 auto; }
  .qrg-error { margin-bottom: 1rem; padding: 0.7rem 0.9rem; border: 1px solid var(--mdt-danger); border-radius: var(--mdt-radius-sm); color: var(--mdt-danger); background: color-mix(in srgb, var(--mdt-danger) 8%, transparent); font-size: 0.88rem; }
  .qrg-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; align-items: start; }
  @media (min-width: 1024px) { .qrg-grid { grid-template-columns: 1fr 1fr; } }
  .qrg-settings { display: flex; flex-direction: column; gap: 1rem; }
  .qrg-section { padding: 1rem 1.25rem; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius); background: var(--mdt-surface-raised); }
  .qrg-heading { margin: 0 0 0.8rem; font-size: 0.95rem; font-weight: 700; }
  .field-label { display: block; font-size: 0.78rem; font-weight: 600; color: var(--mdt-text-muted); margin-bottom: 0.35rem; }
  textarea { width: 100%; resize: vertical; padding: 0.7rem; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius); background: var(--mdt-surface-raised); color: var(--mdt-text); font-family: var(--mdt-font-mono); font-size: 0.95rem; }
  textarea:focus { outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px; }
  .qrg-color-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .qrg-color-row { display: flex; align-items: center; gap: 0.5rem; }
  .qrg-color-row input[type="color"] { width: 3rem; height: 2.6rem; flex-shrink: 0; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm); cursor: pointer; padding: 0; background: none; }
  .qrg-color-row input[type="text"] { width: 100%; padding: 0.5rem 0.6rem; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm); background: var(--mdt-surface-raised); color: var(--mdt-text); font-family: var(--mdt-font-mono); font-size: 0.85rem; text-transform: uppercase; }
  .qrg-style-group { display: flex; gap: 0.4rem; margin-bottom: 0.9rem; }
  .qrg-style-btn { flex: 1; padding: 0.45rem 0.5rem; font-size: 0.85rem; }
  .qrg-style-btn.qrg-active { background: var(--mdt-accent); border-color: var(--mdt-accent); color: var(--mdt-accent-contrast); }
  .qrg-options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .setting select { width: 100%; padding: 0.45rem 0.5rem; border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm); background: var(--mdt-surface-raised); color: var(--mdt-text); }
  .file-hint { font-size: 0.78rem; color: var(--mdt-text-muted); margin: 0.5rem 0 0; }
  .qrg-drop {
    position: relative;
    border: 2px dashed var(--mdt-border);
    border-radius: var(--mdt-radius);
    padding: 1.5rem 1rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .qrg-drop:hover { border-color: var(--mdt-accent); }
  .qrg-drop.qrg-dragover { border-color: var(--mdt-accent); background: color-mix(in srgb, var(--mdt-accent) 8%, transparent); }
  .qrg-clear {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--mdt-text-muted);
    cursor: pointer;
  }
  .qrg-clear:hover { color: var(--mdt-danger); background: var(--mdt-surface-muted); }
  .qrg-drop-empty, .qrg-drop-selected { display: flex; flex-direction: column; align-items: center; gap: 0.7rem; }
  .qrg-drop-icon { width: 2.5rem; height: 2.5rem; color: var(--mdt-text-muted); }
  .qrg-drop-text { font-size: 0.95rem; font-weight: 500; margin: 0; }
  .qrg-logo-preview { max-width: 12rem; max-height: 8rem; object-fit: contain; border-radius: var(--mdt-radius-sm); box-shadow: 0 1px 4px rgb(0 0 0 / 0.15); }
  .primary-btn, .ghost-btn { padding: 0.55rem 1rem; border-radius: var(--mdt-radius); font-weight: 600; cursor: pointer; border: 1px solid transparent; }
  .primary-btn { background: var(--mdt-accent); color: var(--mdt-accent-contrast); }
  .primary-btn:hover { filter: brightness(1.05); }
  .primary-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .ghost-btn { background: var(--mdt-surface-raised); border-color: var(--mdt-border); color: var(--mdt-text); }
  .ghost-btn:hover { border-color: var(--mdt-accent); }
  .qrg-generate { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; padding: 0.8rem 1.25rem; font-size: 1rem; }
  .qrg-preview-section { text-align: center; }
  @media (min-width: 1024px) { .qrg-preview-section { position: sticky; top: 1rem; } }
  .qrg-preview-heading { text-align: center; }
  .qrg-preview-box {
    position: relative;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    margin-bottom: 1rem;
    border: 2px dashed var(--mdt-border);
    border-radius: var(--mdt-radius);
    background: var(--mdt-surface-muted);
    overflow: hidden;
  }
  .qrg-placeholder { font-size: 0.85rem; color: var(--mdt-text-muted); }
  .qrg-preview-img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: var(--mdt-radius-sm); box-shadow: 0 1px 4px rgb(0 0 0 / 0.15); }
  .qrg-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--mdt-surface-raised) 70%, transparent);
  }
  .qrg-spinner {
    width: 2.5rem;
    height: 2.5rem;
    border: 3px solid var(--mdt-border);
    border-top-color: var(--mdt-accent);
    border-radius: 999px;
    animation: qrg-spin 0.8s linear infinite;
  }
  @keyframes qrg-spin { to { transform: rotate(360deg); } }
  .qrg-downloads { display: flex; gap: 0.75rem; justify-content: center; }
  .qrg-download-png, .qrg-download-svg {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 7.5rem;
    justify-content: center;
    padding: 0.55rem 1rem;
    border-radius: var(--mdt-radius);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
  }
  .qrg-download-png { background: var(--mdt-success); color: var(--mdt-accent-contrast); }
  .qrg-download-png:hover { filter: brightness(1.05); }
  .qrg-download-svg { background: var(--mdt-surface-raised); border-color: var(--mdt-border); color: var(--mdt-text); }
  .qrg-download-svg:hover { border-color: var(--mdt-accent); }
</style>
