---
/**
 * QR Code Scanner (qrcode WASM domain). Upload/drag-drop an image, decode via
 * `qrDecode` (Web Worker), show the decoded text with copy; URL results get an open-link
 * action. Image preview + file info + clear per legacy FileDropZone parity.
 * Live camera scanning (`qr-camera.ts`): "Scan with camera" opens the rear
 * camera with a framing overlay and an optional camera switcher; frames are
 * decoded in the same worker. The button is hidden when getUserMedia is
 * missing in a secure context (an insecure page shows a localized error).
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import FileDrop from "@/components/tool/FileDrop.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import CopyButton from "@/components/tool/CopyButton.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/qr-scanner";
const s = {
  dropZone: t(lang, ns, "DropZone"),
  chooseFile: t(lang, "common", "Common_FileChooseButton"),
  loading: t(lang, "common", "Common_Loading"),
  clearFile: t(lang, "common", "Common_ClearFile"),
  resultLabel: t(lang, ns, "ResultLabel"),
  copy: t(lang, "common", "Common_Copy"),
  copied: t(lang, "common", "Common_Copied"),
  openLink: t(lang, ns, "OpenLink"),
  previewAlt: t(lang, ns, "PreviewAlt"),
  errorNotImage: t(lang, ns, "ErrorNotImage"),
  errorNoQr: t(lang, ns, "ErrorNoQr"),
  errorReading: t(lang, ns, "ErrorReading"),
  errorUnsupportedImage: t(lang, ns, "ErrorUnsupportedImage"),
  errorCopy: t(lang, ns, "ErrorCopy"),
  scanCamera: t(lang, ns, "ScanCamera"),
  scanAgain: t(lang, ns, "ScanAgain"),
  stopCamera: t(lang, ns, "StopCamera"),
  cameraSelect: t(lang, ns, "CameraSelect"),
  cameraHint: t(lang, ns, "CameraHint"),
  cameraPreview: t(lang, ns, "CameraPreview"),
  errorCameraDenied: t(lang, ns, "ErrorCameraDenied"),
  errorCameraNotFound: t(lang, ns, "ErrorCameraNotFound"),
  errorCameraInUse: t(lang, ns, "ErrorCameraInUse"),
  errorCameraInsecure: t(lang, ns, "ErrorCameraInsecure"),
  errorCameraGeneric: t(lang, ns, "ErrorCameraGeneric"),
};
const cameraIcon = "M3 8.5A2.5 2.5 0 015.5 6h1.6l1.2-1.8A1.5 1.5 0 019.55 3.5h4.9a1.5 1.5 0 011.25.7L16.9 6h1.6A2.5 2.5 0 0121 8.5v9a2.5 2.5 0 01-2.5 2.5h-13A2.5 2.5 0 013 17.5v-9zM12 16.5a3.75 3.75 0 100-7.5 3.75 3.75 0 000 7.5z";
const stringsJson = JSON.stringify(s);
---

<div class="ds-stack qrs-tool" data-qrs-tool>
  <FileDrop
    changeLabel={t(lang, "common", "Common_FileChangeButton")}
    title={s.dropZone}
    buttonLabel={s.chooseFile}
    sub="PNG · JPEG · WebP"
    accept="image/*"
    data-qrs-dropzone
    inputProps={{ "data-qrs-file": true, "aria-label": s.dropZone }}
  >
    <div class="qrs-selected" data-qrs-selected hidden>
      <img class="qrs-preview" data-qrs-preview alt={s.previewAlt} />
      <div class="qrs-fileinfo">
        <span class="qrs-filename" data-qrs-filename></span>
        <span class="ds-file-item-meta" data-qrs-filesize></span>
      </div>
      <button type="button" class="ds-btn-link" data-qrs-clear>{s.clearFile}</button>
    </div>
  </FileDrop>

  <div class="ds-actions qrs-camera-actions" data-qrs-camera-actions hidden>
    <button type="button" class="ds-btn" data-qrs-camera-start>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={cameraIcon} /></svg>
      <span data-qrs-camera-start-label>{s.scanCamera}</span>
    </button>
  </div>

  <section class="ds-card ds-stack qrs-camera" data-qrs-camera aria-label={s.cameraPreview} hidden>
    <div class="qrs-video-wrap">
      <video class="qrs-video" data-qrs-video playsinline muted aria-label={s.cameraPreview}></video>
      <div class="qrs-frame" aria-hidden="true"></div>
    </div>
    <p class="qrs-camera-hint" role="status">{s.cameraHint}</p>
    <div class="qrs-camera-controls">
      <label class="qrs-camera-select" data-qrs-camera-select-wrap hidden>
        <span class="qrs-camera-select-label">{s.cameraSelect}</span>
        <select class="ds-field-select" data-qrs-camera-select></select>
      </label>
      <button type="button" class="ds-btn" data-qrs-camera-stop>{s.stopCamera}</button>
    </div>
  </section>

  <p class="qrs-busy" data-qrs-busy role="status" hidden>
    <span class="ds-spinner" aria-hidden="true"></span>
    <span>{s.loading}</span>
  </p>

  <StatusMessage kind="error" data-qrs-error />

  <OutputPanel panel label={s.resultLabel} for="qrs-output" data-qrs-result aria-live="polite" hidden>
    <Fragment slot="actions">
      <a class="ds-btn ds-btn-small ds-btn-ghost" href="#" data-qrs-linkwrap data-qrs-openlink target="_blank" rel="noopener noreferrer" hidden>
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        {s.openLink}
      </a>
      <CopyButton ghost label={s.copy} copiedLabel={s.copied} data-qrs-copy />
    </Fragment>
    <textarea id="qrs-output" class="ds-field-textarea mono qrs-output" data-qrs-output rows="4" readonly></textarea>
  </OutputPanel>
</div>

<script is:inline type="application/json" data-qrs-strings set:html={stringsJson} />
<script>import "@/tools/qr-code-scanner.client.ts";</script>

<style>
  .qrs-tool { max-width: 48rem; margin: 0 auto; }
  .qrs-selected { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; min-width: 0; max-width: 100%; }
  .qrs-preview {
    max-width: min(16rem, 100%);
    max-height: 12rem;
    object-fit: contain;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-sm);
  }
  .qrs-fileinfo { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; max-width: 100%; }
  .qrs-filename { font-weight: 500; overflow-wrap: anywhere; }
  .qrs-busy { display: flex; align-items: center; gap: 0.5rem; font-size: var(--mdt-fs-meta); color: var(--mdt-text-muted); }
  .qrs-output { min-height: 6rem; }
  .qrs-camera-actions { justify-content: center; }
  .qrs-video-wrap {
    position: relative;
    overflow: hidden;
    border-radius: var(--mdt-radius-sm);
    background: #000;
    aspect-ratio: 4 / 3;
    max-height: 60vh;
  }
  .qrs-video { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Framing guide: a centered square with the rest dimmed. */
  .qrs-frame {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(60%, 60vh);
    aspect-ratio: 1;
    border: 3px solid rgb(255 255 255 / 0.9);
    border-radius: 0.75rem;
    box-shadow: 0 0 0 100vmax rgb(0 0 0 / 0.35);
    pointer-events: none;
  }
  .qrs-camera-hint { font-size: var(--mdt-fs-meta); color: var(--mdt-text-muted); margin: 0; }
  .qrs-camera-controls { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 0.75rem; }
  .qrs-camera-select { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; flex: 1 1 12rem; }
  .qrs-camera-select-label { font-size: var(--mdt-fs-meta); font-weight: 500; }
</style>
