---
/**
 * QR Code Scanner (qrcode WASM domain). Upload/drag-drop an image, decode via
 * `qrDecode`, show the decoded text with copy; URL results get an open-link
 * action. Image preview + file info + clear per legacy FileDropZone parity.
 * Upload only (legacy parity: no live camera / getUserMedia).
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import FileDrop from "@/components/tool/FileDrop.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/qr-scanner";
const s = {
  dropZone: t(lang, ns, "DropZone"),
  chooseFile: t(lang, "common", "Common_FileChooseButton"),
  loading: t(lang, "common", "Common_Loading"),
  clearFile: t(lang, "common", "Common_ClearFile"),
  resultLabel: t(lang, ns, "ResultLabel"),
  copy: t(lang, "common", "Common_Copy"),
  copied: t(lang, ns, "Copied"),
  openLink: t(lang, ns, "OpenLink"),
  previewAlt: t(lang, ns, "PreviewAlt"),
  errorNotImage: t(lang, ns, "ErrorNotImage"),
  errorNoQr: t(lang, ns, "ErrorNoQr"),
  errorReading: t(lang, ns, "ErrorReading"),
  errorUnsupportedImage: t(lang, ns, "ErrorUnsupportedImage"),
  errorCopy: t(lang, ns, "ErrorCopy"),
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-stack qrs-tool" data-qrs-tool>
  <FileDrop
    changeLabel={t(lang, "common", "Common_FileChangeButton")}
    title={s.dropZone}
    buttonLabel={s.chooseFile}
    sub="PNG · JPEG · WebP"
    accept="image/*"
    data-qrs-dropzone
    inputProps={{ "data-qrs-file": true, "aria-label": s.dropZone }}
  >
    <div class="qrs-selected" data-qrs-selected hidden>
      <img class="qrs-preview" data-qrs-preview alt={s.previewAlt} />
      <div class="qrs-fileinfo">
        <span class="qrs-filename" data-qrs-filename></span>
        <span class="ds-file-item-meta" data-qrs-filesize></span>
      </div>
      <button type="button" class="ds-btn-link" data-qrs-clear>{s.clearFile}</button>
    </div>
  </FileDrop>

  <p class="qrs-busy" data-qrs-busy role="status" hidden>
    <span class="ds-spinner" aria-hidden="true"></span>
    <span>{s.loading}</span>
  </p>

  <StatusMessage kind="error" data-qrs-error />

  <OutputPanel label={s.resultLabel} for="qrs-output" data-qrs-result hidden>
    <Fragment slot="actions">
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-qrs-copy>{s.copy}</button>
    </Fragment>
    <textarea id="qrs-output" class="ds-field-textarea mono" data-qrs-output rows="5" readonly></textarea>
    <div class="ds-actions" data-qrs-linkwrap hidden>
      <a class="ds-btn ds-btn-primary" data-qrs-openlink target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        {s.openLink}
      </a>
    </div>
  </OutputPanel>
</div>

<script is:inline type="application/json" data-qrs-strings set:html={stringsJson} />
<script>import "@/tools/qr-code-scanner.client.ts";</script>

<style>
  .qrs-tool { max-width: 48rem; margin: 0 auto; }
  .qrs-selected { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; min-width: 0; max-width: 100%; }
  .qrs-preview {
    max-width: min(16rem, 100%);
    max-height: 12rem;
    object-fit: contain;
    border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-sm);
  }
  .qrs-fileinfo { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; max-width: 100%; }
  .qrs-filename { font-weight: 500; overflow-wrap: anywhere; }
  .qrs-busy { display: flex; align-items: center; gap: 0.5rem; font-size: var(--mdt-fs-meta); color: var(--mdt-text-muted); }
  .qrs-tool :global([data-qrs-linkwrap]) { margin-top: 0.75rem; }
</style>
