---
/**
 * Regex Tester (WASM, Rust regex engine). Pattern + flags + test string with
 * live match highlighting (backdrop layer under a transparent textarea;
 * capture groups in recurring spectrum colours with a toggle legend),
 * match list with expandable per-group details, quick examples, and saved patterns in
 * localStorage. Live testing on input (150ms debounce, legacy parity).
 * Workbench: pattern panel (Save/Cheat sheet in its header → pattern → flags
 * → test string with empty state + "Load example") | matches panel (count as
 * headline), then saved patterns | examples. All logic in
 * `regex-tester.client.ts`.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import EmptyState from "@/components/tool/EmptyState.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/regex-tester";

const patternLabel = t(lang, ns, "PatternLabel");
const textLabel = t(lang, ns, "TextLabel");
const matchesLabel = t(lang, ns, "MatchesLabel");
const flagsLabel = t(lang, ns, "FlagsLabel");
const savePatternLabel = t(lang, ns, "SavePatternButton");
const cheatSheetLabel = t(lang, ns, "CheatSheetButton");
const cheatSheetTitle = t(lang, ns, "CheatSheetTitle");
const savedTitle = t(lang, ns, "SavedPatternsTitle");
const examplesTitle = t(lang, ns, "ExamplesTitle");
const tableName = t(lang, ns, "TableName");
const tablePattern = t(lang, ns, "TablePattern");
const tableActions = t(lang, ns, "TableActions");
const noSaved = t(lang, ns, "NoSavedPatterns");
const dialogTitle = t(lang, ns, "SaveDialogTitle");
const dialogText = t(lang, ns, "SaveDialogText");
const dialogSave = t(lang, ns, "SaveDialogSave");
const dialogCancel = t(lang, ns, "SaveDialogCancel");
const loadExample = t(lang, "common", "Common_LoadExample");
const emptyHint = t(lang, ns, "EmptyHint");
const outputEmpty = t(lang, ns, "OutputEmpty");
const matchCountLabel = t(lang, ns, "MatchCountLabel");
const groupsLegendLabel = t(lang, ns, "GroupsLegendLabel");

const flags = [
  { value: "g", label: t(lang, ns, "FlagGlobal"), checked: true },
  { value: "i", label: t(lang, ns, "FlagCaseInsensitive"), checked: false },
  { value: "m", label: t(lang, ns, "FlagMultiline"), checked: false },
  { value: "s", label: t(lang, ns, "FlagDotAll"), checked: false },
];

const cheatTokens: Array<[string, string]> = [
  [".", t(lang, ns, "CheatAnyChar")],
  ["\\d", t(lang, ns, "CheatDigit")],
  ["\\w", t(lang, ns, "CheatWordChar")],
  ["\\s", t(lang, ns, "CheatWhitespace")],
  ["^", t(lang, ns, "CheatStart")],
  ["$", t(lang, ns, "CheatEnd")],
  ["*", t(lang, ns, "CheatZeroOrMore")],
  ["+", t(lang, ns, "CheatOneOrMore")],
  ["?", t(lang, ns, "CheatZeroOrOne")],
];

const stringsJson = JSON.stringify({
  noMatches: t(lang, ns, "NoMatches"),
  loadButton: t(lang, ns, "LoadButton"),
  deleteButton: t(lang, ns, "DeleteButton"),
  deleteConfirm: t(lang, ns, "DeleteConfirm"),
  matchNumber: t(lang, ns, "MatchNumber"),
  moreMatches: t(lang, ns, "MoreMatches"),
  engineError: t(lang, ns, "EngineError"),
  storageError: t(lang, ns, "StorageError"),
  preparing: t(lang, "common", "Common_Preparing"),
  wholeMatch: t(lang, ns, "GroupWholeMatch"),
  notMatched: t(lang, ns, "GroupNotMatched"),
  emptyString: t(lang, ns, "GroupEmptyString"),
  groupsSummary: t(lang, ns, "GroupsSummary"),
  captureLimit: t(lang, ns, "CaptureLimitNotice"),
  announceMatches: t(lang, ns, "AnnounceMatches"),
});
---

<div class="ds-stack rx-tool" data-rx-tool>
  <div class="ds-workbench">
    <ToolPanel title={patternLabel} for="rx-pattern-input">
      <Fragment slot="actions">
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-rx-save-open>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 3.478-.397m7.5 0v0H12" /></svg>
          {savePatternLabel}
        </button>
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-rx-cheatsheet-toggle aria-expanded="false" aria-controls="rx-cheatsheet">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" /></svg>
          {cheatSheetLabel}
        </button>
      </Fragment>

      <div class="rx-cheatsheet" id="rx-cheatsheet" data-rx-cheatsheet hidden>
        <h3 class="ds-label rx-cheatsheet-title">{cheatSheetTitle}</h3>
        <dl class="rx-cheatsheet-grid">
          {cheatTokens.map(([token, desc]) => (
            <>
              <dt><code>{token}</code></dt>
              <dd>{desc}</dd>
            </>
          ))}
        </dl>
      </div>

      <div class="rx-pattern-row">
        <span class="rx-delimiter" aria-hidden="true">/</span>
        <input
          type="text"
          id="rx-pattern-input"
          class="rx-pattern-input"
          data-rx-pattern
          placeholder={t(lang, ns, "PatternPlaceholder")}
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          aria-describedby="rx-error"
        />
        <span class="rx-delimiter" aria-hidden="true">/</span>
      </div>

      <fieldset class="ds-check-group rx-flags">
        <legend class="ds-label">{flagsLabel}</legend>
        <div class="rx-flag-list">
          {flags.map((f) => (
            <label class="ds-check-row rx-flag">
              <input type="checkbox" class="ds-check" data-rx-flag value={f.value} checked={f.checked} />
              <span><code>{f.value}</code> {f.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="ds-field-group">
        <label class="ds-label" for="rx-text-input">{textLabel}</label>
        <div class="rx-textwrap ds-editor is-empty" data-rx-text-host>
          <div class="rx-backdrop" data-rx-backdrop aria-hidden="true"></div>
          <textarea
            id="rx-text-input"
            class="rx-text"
            data-rx-text
            aria-describedby="rx-text-empty"
            spellcheck="false"
          ></textarea>
          <EmptyState
            hint={emptyHint}
            hintId="rx-text-empty"
            exampleLabel={loadExample}
            buttonProps={{ "data-rx-example": true }}
          />
        </div>
      </div>
    </ToolPanel>

    <ToolPanel title={matchesLabel} empty data-rx-matches>
      <p class="ds-alert ds-alert-error rx-error" id="rx-error" data-rx-error role="alert" hidden></p>
      <EmptyState hint={outputEmpty} />
      <div class="ds-result-headline ds-when-filled">
        <span class="ds-result-headline-label" id="rx-count-label">{matchCountLabel}</span>
        <output class="ds-result-headline-value" data-rx-count aria-labelledby="rx-count-label"></output>
      </div>
      <div class="rx-legend ds-when-filled" data-rx-legend role="group" aria-labelledby="rx-legend-label" hidden>
        <span class="ds-label" id="rx-legend-label">{groupsLegendLabel}</span>
        <div class="ds-chip-list" data-rx-legend-list></div>
      </div>
      <div class="rx-results ds-when-filled" data-rx-results></div>
    </ToolPanel>
  </div>

  <div class="ds-workbench rx-tables">
    <ToolPanel title={savedTitle} empty data-rx-saved>
      <EmptyState hint={noSaved} />
      <div class="rx-table-wrap ds-when-filled">
        <table class="rx-table">
          <thead>
            <tr><th scope="col">{tableName}</th><th scope="col">{tablePattern}</th><th scope="col" class="rx-actions-col">{tableActions}</th></tr>
          </thead>
          <tbody data-rx-saved-body></tbody>
        </table>
      </div>
    </ToolPanel>

    <ToolPanel title={examplesTitle}>
      <div class="rx-table-wrap">
        <table class="rx-table">
          <thead>
            <tr><th scope="col">{tableName}</th><th scope="col">{tablePattern}</th><th scope="col" class="rx-actions-col">{tableActions}</th></tr>
          </thead>
          <tbody data-rx-examples-body></tbody>
        </table>
      </div>
    </ToolPanel>
  </div>

  <dialog class="ds-dialog rx-dialog" data-rx-dialog aria-labelledby="rx-dialog-title">
    <form method="dialog" class="ds-stack" data-rx-save-form>
      <h2 class="rx-dialog-title" id="rx-dialog-title">{dialogTitle}</h2>
      <div class="ds-field-group">
        <label class="ds-label" for="rx-save-name">{dialogText}</label>
        <input
          type="text"
          id="rx-save-name"
          class="ds-field"
          data-rx-save-name
          placeholder={t(lang, ns, "SaveDialogPlaceholder")}
          autocomplete="off"
          required
        />
      </div>
      <div class="ds-actions ds-actions-end">
        <button type="button" class="ds-btn" data-rx-save-cancel>{dialogCancel}</button>
        <button type="submit" class="ds-btn ds-btn-primary" data-rx-save-confirm>{dialogSave}</button>
      </div>
    </form>
  </dialog>
</div>

<script is:inline type="application/json" data-rx-strings set:html={stringsJson} />
<script>import "@/tools/regex-tester.client.ts";</script>

<style is:global>
  /* Runtime DOM (highlight marks, legend, group rows) — global, scoped under
     the tool root. Six recurring capture colours reuse the category hues
     (violet, blue, cyan, teal, amber, rose); each is AA on panels, so it
     doubles as ink for labels, while fills are light tints that keep the
     textarea's own text readable in both themes. */
  .rx-tool {
    --rx-cap-0: var(--mdt-cat-encoding);
    --rx-cap-1: var(--mdt-cat-structured-data);
    --rx-cap-2: var(--mdt-cat-converters);
    --rx-cap-3: var(--mdt-cat-generators);
    --rx-cap-4: var(--mdt-cat-hashing);
    --rx-cap-5: var(--mdt-cat-images);
    --rx-fill: 22%;
    --rx-fill-sel: 40%;
    --rx-fill-dim: 9%;
  }
  :root[data-theme="dark"] .rx-tool { --rx-fill: 30%; --rx-fill-sel: 48%; --rx-fill-dim: 12%; }
  .rx-tool .rx-c0 { --rx-c: var(--rx-cap-0); }
  .rx-tool .rx-c1 { --rx-c: var(--rx-cap-1); }
  .rx-tool .rx-c2 { --rx-c: var(--rx-cap-2); }
  .rx-tool .rx-c3 { --rx-c: var(--rx-cap-3); }
  .rx-tool .rx-c4 { --rx-c: var(--rx-cap-4); }
  .rx-tool .rx-c5 { --rx-c: var(--rx-cap-5); }
  /* Enclosing (outer) group of a nested capture: 2px underline in its colour. */
  .rx-tool .rx-u0 { --rx-ul: inset 0 -2px 0 var(--rx-cap-0); }
  .rx-tool .rx-u1 { --rx-ul: inset 0 -2px 0 var(--rx-cap-1); }
  .rx-tool .rx-u2 { --rx-ul: inset 0 -2px 0 var(--rx-cap-2); }
  .rx-tool .rx-u3 { --rx-ul: inset 0 -2px 0 var(--rx-cap-3); }
  .rx-tool .rx-u4 { --rx-ul: inset 0 -2px 0 var(--rx-cap-4); }
  .rx-tool .rx-u5 { --rx-ul: inset 0 -2px 0 var(--rx-cap-5); }

  /* Whole match: subdued neutral shading + hairline, so captures stand out. */
  .rx-tool .rx-backdrop mark.rx-mark {
    color: transparent; border-radius: 2px;
    background: color-mix(in srgb, var(--mdt-text) 8%, transparent);
    box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--mdt-text) 35%, transparent);
  }
  .rx-tool .rx-backdrop mark.rx-cap {
    border-radius: 0;
    background: color-mix(in srgb, var(--rx-c) var(--rx-fill), transparent);
    box-shadow: var(--rx-ul, none);
  }
  .rx-tool .rx-backdrop mark.rx-cap.is-dim { background: color-mix(in srgb, var(--rx-c) var(--rx-fill-dim), transparent); }
  /* Selected group: stronger fill plus an outline — emphasis is not colour-only. */
  .rx-tool .rx-backdrop mark.rx-cap.is-sel {
    background: color-mix(in srgb, var(--rx-c) var(--rx-fill-sel), transparent);
    outline: 1.5px solid var(--rx-c); outline-offset: 0;
  }

  /* Legend: "1", "2 · name" toggle chips with a colour swatch; 44px targets. */
  .rx-tool .rx-legend { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 0.75rem; }
  .rx-tool .rx-legend .ds-label { margin-bottom: 0; }
  .rx-tool .rx-legend-item {
    display: inline-flex; align-items: center; gap: 0.45rem;
    min-height: 2.75rem; min-width: 2.75rem; justify-content: center;
    max-width: 100%; overflow-wrap: anywhere; text-align: start;
  }
  .rx-tool .rx-legend-item[aria-pressed="true"] {
    color: var(--mdt-text); font-weight: 700;
    border-color: var(--rx-c); box-shadow: inset 0 0 0 1px var(--rx-c);
    background: color-mix(in srgb, var(--rx-c) 14%, transparent);
  }
  .rx-tool .rx-swatch {
    flex: none; width: 0.8rem; height: 0.8rem; border-radius: 3px;
    background: color-mix(in srgb, var(--rx-c) var(--rx-fill-sel), transparent);
    box-shadow: inset 0 0 0 1.5px var(--rx-c);
  }

  /* Per-match group details: label | value or state | range. */
  .rx-tool .rx-groups { margin-top: 0.4rem; }
  .rx-tool .rx-groups-toggle {
    cursor: pointer; min-height: 2.75rem; display: flex; align-items: center; gap: 0.4rem;
    font-family: var(--mdt-font-sans); font-size: var(--mdt-fs-label); font-weight: 600;
    color: var(--mdt-text-muted); border-radius: var(--mdt-radius-xs);
  }
  .rx-tool .rx-groups-toggle { list-style: none; }
  .rx-tool .rx-groups-toggle::-webkit-details-marker { display: none; }
  .rx-tool .rx-groups-toggle::before {
    content: ""; width: 0.4rem; height: 0.4rem; margin: 0 0.15rem 0 0.1rem;
    border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
    transform: rotate(-45deg); transition: transform var(--mdt-dur-micro);
  }
  .rx-tool .rx-groups[open] > .rx-groups-toggle::before { transform: rotate(45deg); }
  @media (prefers-reduced-motion: reduce) { .rx-tool .rx-groups-toggle::before { transition: none; } }
  .rx-tool .rx-groups-toggle:hover { color: var(--mdt-text); }
  .rx-tool .rx-groups-body { display: flex; flex-direction: column; gap: 0.15rem; }
  .rx-tool .rx-group {
    display: grid; grid-template-columns: minmax(5.5rem, auto) minmax(0, 1fr) auto;
    gap: 0.5rem; align-items: baseline;
    padding: 0.3rem 0.5rem; border-radius: var(--mdt-radius-xs);
    border-left: 3px solid transparent;
  }
  .rx-tool .rx-group.rx-g0 { border-left-color: color-mix(in srgb, var(--mdt-text) 30%, transparent); }
  .rx-tool .rx-group[data-rx-group-row] { border-left-color: color-mix(in srgb, var(--rx-c) 60%, transparent); }
  .rx-tool .rx-group-name {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-weight: 600; color: var(--mdt-text-muted); overflow-wrap: anywhere;
  }
  .rx-tool .rx-group-text { overflow-wrap: anywhere; white-space: pre-wrap; min-width: 0; color: var(--mdt-text); }
  .rx-tool .rx-group-state { font-style: italic; color: var(--mdt-text-faint); font-family: var(--mdt-font-sans); }
  .rx-tool .rx-group-pos { color: var(--mdt-text-faint); white-space: nowrap; }
  .rx-tool .rx-group.is-sel {
    background: color-mix(in srgb, var(--rx-c) 12%, transparent);
    border-left-color: var(--rx-c); box-shadow: inset 3px 0 0 var(--rx-c);
  }
  .rx-tool .rx-group.is-sel .rx-group-name { color: var(--mdt-text); font-weight: 700; }
  @media (max-width: 30rem) {
    .rx-tool .rx-group { grid-template-columns: minmax(0, 1fr) auto; }
    .rx-tool .rx-group-name { grid-column: 1 / -1; }
  }
  @media (forced-colors: active) {
    .rx-tool .rx-legend-item[aria-pressed="true"] { outline: 3px solid Highlight; }
    .rx-tool .rx-group.is-sel { outline: 2px solid Highlight; }
  }
</style>

<style>
  /* Layout + regex-specific visuals (pattern delimiters, highlight backdrop,
     match list, tables). Buttons/fields/alerts come from tool-ui.css (ds-*). */

  .rx-cheatsheet {
    border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface-inset); padding: 0.75rem 0.9rem;
  }
  .rx-cheatsheet-title { margin: 0 0 0.5rem; }
  .rx-cheatsheet-grid {
    display: grid; grid-template-columns: auto 1fr; gap: 0.2rem 0.9rem;
    margin: 0; font-size: var(--mdt-fs-meta);
  }
  .rx-cheatsheet-grid dd { margin: 0; color: var(--mdt-text-muted); }
  .rx-cheatsheet-grid code { font-family: var(--mdt-font-mono); font-weight: 700; color: var(--mdt-cat); }

  /* Pattern input framed by /…/ delimiters; focus ring mirrors .ds-field:focus. */
  .rx-pattern-row {
    display: flex; align-items: stretch; min-width: 0;
    border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface-inset); overflow: hidden;
    transition: border-color var(--mdt-dur-micro), box-shadow var(--mdt-dur-micro);
  }
  .rx-pattern-row:focus-within {
    border-color: color-mix(in srgb, var(--mdt-cat) 60%, var(--mdt-border));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--mdt-cat) 15%, transparent);
  }
  .rx-pattern-row:has([aria-invalid="true"]) { border-color: var(--mdt-danger); }
  .rx-delimiter {
    display: flex; align-items: center; padding: 0 0.75rem;
    font-family: var(--mdt-font-mono); font-size: 1.05rem;
    background: var(--mdt-surface-muted); color: var(--mdt-text-muted);
    user-select: none;
  }
  .rx-pattern-input {
    flex: 1; min-width: 0; border: 0; background: transparent;
    padding: 0.6rem 0.75rem; color: var(--mdt-text);
    font-family: var(--mdt-font-mono); font-size: 1rem;
  }
  .rx-pattern-input:focus { outline: none; }
  .rx-pattern-input::placeholder { color: var(--mdt-text-faint); }

  .rx-flag-list { display: flex; flex-wrap: wrap; gap: 0.35rem 1.1rem; }
  .rx-flag code { font-family: var(--mdt-font-mono); font-weight: 700; color: var(--mdt-cat); }

  /* Highlight backdrop under a transparent textarea: both layers must share
     box metrics exactly so <mark> spans line up with the typed text. */
  .rx-textwrap { position: relative; height: 16rem; resize: vertical; overflow: hidden; min-height: 6rem; }
  .rx-backdrop, .rx-text {
    position: absolute; inset: 0; margin: 0; padding: 10px 13px;
    border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm);
    font-family: var(--mdt-font-mono); font-size: 0.9rem; line-height: 1.5;
    letter-spacing: normal; white-space: pre-wrap; overflow-wrap: anywhere; word-break: normal;
    overflow: auto; scrollbar-gutter: stable;
  }
  .rx-backdrop { color: transparent; background: var(--mdt-surface-inset); pointer-events: none; }
  .rx-text {
    width: 100%; height: 100%;
    background: transparent; color: var(--mdt-text); resize: none;
    transition: border-color var(--mdt-dur-micro), box-shadow var(--mdt-dur-micro);
  }
  .rx-text:focus {
    outline: none;
    border-color: color-mix(in srgb, var(--mdt-cat) 60%, var(--mdt-border));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--mdt-cat) 15%, transparent);
  }
  .rx-text::placeholder { color: var(--mdt-text-faint); }

  /* High Contrast: the UA paints the textarea with an opaque Canvas background,
     which hid the highlight backdrop. Opt both layers out of forced colors with
     system colors only, and draw matches as a Highlight outline + underline
     (no fill) so the textarea's CanvasText stays readable over them. */
  @media (forced-colors: active) {
    .rx-pattern-row:focus-within, .rx-text:focus { outline: 2px solid Highlight; outline-offset: 1px; }
    .rx-backdrop { forced-color-adjust: none; background: Canvas; border-color: CanvasText; }
    .rx-text {
      forced-color-adjust: none; background: transparent;
      color: CanvasText; caret-color: CanvasText; border-color: CanvasText;
    }
    .rx-text::placeholder { color: GrayText; }
    /* The wrapper clips the outline above, so the focus cue is the border itself. */
    .rx-text:focus { border-color: Highlight; box-shadow: inset 0 0 0 1px Highlight; }
    .rx-backdrop :global(mark.rx-mark) {
      forced-color-adjust: none; background: transparent; color: transparent;
      box-shadow: none; border-radius: 0;
      outline: 2px solid Highlight; outline-offset: 0;
      text-decoration: underline 3px Highlight; text-underline-offset: 2px;
    }
    /* Selected capture group: thicker outline (shape, not colour). */
    .rx-backdrop :global(mark.rx-mark.is-sel) { outline-width: 4px; }
  }

  .rx-error { overflow-wrap: anywhere; white-space: pre-wrap; font-family: var(--mdt-font-mono); }

  /* Match list (runtime DOM → :global): rows split by hairlines, no nested boxes. */
  .rx-results { display: flex; flex-direction: column; min-width: 0; }
  .rx-results :global(.rx-match) {
    padding: 0.6rem 0;
    font-family: var(--mdt-font-mono); font-size: var(--mdt-fs-meta);
  }
  .rx-results :global(.rx-match + .rx-match) { border-top: 1px solid var(--mdt-border); }
  .rx-results :global(.rx-match:first-child) { padding-top: 0; }
  .rx-results :global(.rx-match-head) {
    display: flex; justify-content: space-between; gap: 0.5rem;
    font-weight: 600; margin-bottom: 0.3rem; color: var(--mdt-cat);
  }
  .rx-results :global(.rx-pos) { font-weight: 400; color: var(--mdt-text-faint); white-space: nowrap; }
  .rx-results :global(.rx-match-text) {
    background: var(--mdt-surface-inset);
    border-radius: var(--mdt-radius-xs); padding: 0.35rem 0.5rem;
    white-space: pre-wrap; overflow-wrap: anywhere; color: var(--mdt-text);
  }
  .rx-results :global(.rx-more) { padding-top: 0.5rem; text-align: center; font-size: var(--mdt-fs-label); color: var(--mdt-text-muted); }

