---
/**
 * Regex Tester (WASM, Rust regex engine). Pattern + flags + test string with
 * live match highlighting (backdrop layer under a transparent textarea),
 * match list with capture groups, quick examples, and saved patterns in
 * localStorage. Live testing on input (150ms debounce, legacy parity).
 * All logic in `regex-tester.client.ts`.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/regex-tester";

const patternLabel = t(lang, ns, "PatternLabel");
const textLabel = t(lang, ns, "TextLabel");
const matchesLabel = t(lang, ns, "MatchesLabel");
const flagsLabel = t(lang, ns, "FlagsLabel");
const savePatternLabel = t(lang, ns, "SavePatternButton");
const cheatSheetLabel = t(lang, ns, "CheatSheetButton");
const cheatSheetTitle = t(lang, ns, "CheatSheetTitle");
const savedTitle = t(lang, ns, "SavedPatternsTitle");
const examplesTitle = t(lang, ns, "ExamplesTitle");
const tableName = t(lang, ns, "TableName");
const tablePattern = t(lang, ns, "TablePattern");
const tableActions = t(lang, ns, "TableActions");
const noSaved = t(lang, ns, "NoSavedPatterns");
const dialogTitle = t(lang, ns, "SaveDialogTitle");
const dialogText = t(lang, ns, "SaveDialogText");
const dialogSave = t(lang, ns, "SaveDialogSave");
const dialogCancel = t(lang, ns, "SaveDialogCancel");

const flags = [
  { value: "g", label: t(lang, ns, "FlagGlobal"), checked: true },
  { value: "i", label: t(lang, ns, "FlagCaseInsensitive"), checked: false },
  { value: "m", label: t(lang, ns, "FlagMultiline"), checked: false },
  { value: "s", label: t(lang, ns, "FlagDotAll"), checked: false },
  { value: "u", label: t(lang, ns, "FlagUnicode"), checked: true },
];

const cheatTokens: Array<[string, string]> = [
  [".", t(lang, ns, "CheatAnyChar")],
  ["\\d", t(lang, ns, "CheatDigit")],
  ["\\w", t(lang, ns, "CheatWordChar")],
  ["\\s", t(lang, ns, "CheatWhitespace")],
  ["^", t(lang, ns, "CheatStart")],
  ["$", t(lang, ns, "CheatEnd")],
  ["*", t(lang, ns, "CheatZeroOrMore")],
  ["+", t(lang, ns, "CheatOneOrMore")],
  ["?", t(lang, ns, "CheatZeroOrOne")],
];

const stringsJson = JSON.stringify({
  noMatches: t(lang, ns, "NoMatches"),
  loadButton: t(lang, ns, "LoadButton"),
  deleteButton: t(lang, ns, "DeleteButton"),
  deleteConfirm: t(lang, ns, "DeleteConfirm"),
  matchNumber: t(lang, ns, "MatchNumber"),
  groupLabel: t(lang, ns, "GroupLabel"),
  moreMatches: t(lang, ns, "MoreMatches"),
});
---

<div class="rx-tool" data-rx-tool>
  <div class="rx-field">
    <div class="rx-label-row">
      <label class="rx-label" for="rx-pattern-input">{patternLabel}</label>
      <div class="rx-label-actions">
        <button type="button" class="rx-ghost-btn" data-rx-save-open>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="rx-icon" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 3.478-.397m7.5 0v0H12" />
          </svg>
          {savePatternLabel}
        </button>
        <button type="button" class="rx-ghost-btn" data-rx-cheatsheet-toggle aria-expanded="false">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="rx-icon" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
          </svg>
          {cheatSheetLabel}
        </button>
      </div>
    </div>

    <div class="rx-cheatsheet" data-rx-cheatsheet hidden>
      <h3 class="rx-cheatsheet-title">{cheatSheetTitle}</h3>
      <div class="rx-cheatsheet-grid">
        {cheatTokens.map(([token, desc]) => (
          <>
            <code>{token}</code>
            <span>{desc}</span>
          </>
        ))}
      </div>
    </div>

    <div class="rx-pattern-row">
      <span class="rx-delimiter" aria-hidden="true">/</span>
      <input
        type="text"
        id="rx-pattern-input"
        data-rx-pattern
        placeholder={t(lang, ns, "PatternPlaceholder")}
        autocomplete="off"
        spellcheck="false"
      />
      <span class="rx-delimiter" aria-hidden="true">/</span>
    </div>

    <fieldset class="rx-flags">
      <legend class="rx-visually-hidden">{flagsLabel}</legend>
      {flags.map((f) => (
        <label class="rx-flag">
          <input type="checkbox" data-rx-flag value={f.value} checked={f.checked} />
          <span>{f.value} ({f.label})</span>
        </label>
      ))}
    </fieldset>
  </div>

  <div class="rx-field">
    <label class="rx-label" for="rx-text-input">{textLabel}</label>
    <div class="rx-textwrap">
      <div class="rx-backdrop" data-rx-backdrop aria-hidden="true"></div>
      <textarea
        id="rx-text-input"
        data-rx-text
        placeholder={t(lang, ns, "TextPlaceholder")}
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="rx-results-head">
    <h3 class="rx-section-title">
      {matchesLabel}
      <span class="rx-count" data-rx-count>0</span>
    </h3>
  </div>
  <div class="rx-results" data-rx-results></div>

  <div class="rx-tables">
    <section class="rx-panel">
      <h3 class="rx-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="rx-icon" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 3.478-.397m7.5 0v0H12" />
        </svg>
        {savedTitle}
      </h3>
      <div class="rx-table-wrap">
        <table class="rx-table">
          <thead>
            <tr><th>{tableName}</th><th>{tablePattern}</th><th class="rx-actions-col">{tableActions}</th></tr>
          </thead>
          <tbody data-rx-saved-body></tbody>
        </table>
      </div>
      <p class="rx-empty" data-rx-saved-empty hidden>{noSaved}</p>
    </section>

    <section class="rx-panel">
      <h3 class="rx-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="rx-icon" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
        </svg>
        {examplesTitle}
      </h3>
      <div class="rx-table-wrap">
        <table class="rx-table">
          <thead>
            <tr><th>{tableName}</th><th>{tablePattern}</th><th class="rx-actions-col">{tableActions}</th></tr>
          </thead>
          <tbody data-rx-examples-body></tbody>
        </table>
      </div>
    </section>
  </div>

  <dialog class="rx-dialog" data-rx-dialog>
    <h3 class="rx-dialog-title">{dialogTitle}</h3>
    <p class="rx-dialog-text">{dialogText}</p>
    <input
      type="text"
      class="rx-dialog-input"
      data-rx-save-name
      placeholder={t(lang, ns, "SaveDialogPlaceholder")}
    />
    <div class="rx-dialog-actions">
      <button type="button" class="rx-ghost-btn" data-rx-save-cancel>{dialogCancel}</button>
      <button type="button" class="rx-primary-btn" data-rx-save-confirm>{dialogSave}</button>
    </div>
  </dialog>
</div>

<script is:inline type="application/json" data-rx-strings set:html={stringsJson} />
<script>import "@/tools/regex-tester.client.ts";</script>

<style>
  .rx-tool { display: flex; flex-direction: column; gap: 1.25rem; }
  .rx-field { display: flex; flex-direction: column; gap: 0.5rem; }
  .rx-label-row { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; }
  .rx-label { font-weight: 600; font-size: 0.95rem; color: var(--mdt-text); }
  .rx-label-actions { display: flex; gap: 0.5rem; }
  .rx-icon { width: 1rem; height: 1rem; flex: none; }
  .rx-visually-hidden {
    position: absolute; width: 1px; height: 1px; margin: -1px;
    clip: rect(0 0 0 0); overflow: hidden; white-space: nowrap;
  }

  .rx-ghost-btn, .rx-primary-btn {
    display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.35rem 0.7rem; border-radius: var(--mdt-radius-sm);
    border: 1px solid var(--mdt-border); background: var(--mdt-surface-raised);
    color: var(--mdt-text); cursor: pointer; font-size: 0.8rem;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .rx-ghost-btn:hover { border-color: var(--mdt-accent); }
  .rx-ghost-btn:focus-visible, .rx-primary-btn:focus-visible {
    outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px;
  }
  .rx-primary-btn { background: var(--mdt-accent); border-color: var(--mdt-accent); color: var(--mdt-accent-contrast); }
  .rx-primary-btn:hover { filter: brightness(1.08); }
  .rx-icon-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.75rem; height: 1.75rem; padding: 0;
    border: 1px solid transparent; border-radius: var(--mdt-radius-sm);
    background: transparent; color: var(--mdt-text-muted); cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .rx-icon-btn:hover { color: var(--mdt-accent); border-color: var(--mdt-accent); }
  .rx-icon-btn.rx-danger:hover { color: var(--mdt-danger); border-color: var(--mdt-danger); }
  .rx-icon-btn:focus-visible { outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px; }

  .rx-cheatsheet {
    border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius);
    background: var(--mdt-surface-raised); padding: 0.75rem; font-size: 0.8rem;
  }
  .rx-cheatsheet-title {
    margin: 0 0 0.5rem; font-size: 0.8rem; font-weight: 700;
    border-bottom: 1px solid var(--mdt-border); padding-bottom: 0.35rem;
  }
  .rx-cheatsheet-grid { display: grid; grid-template-columns: auto 1fr; gap: 0.2rem 0.75rem; }
  .rx-cheatsheet-grid code {
    font-family: var(--mdt-font-mono); font-weight: 700; color: var(--mdt-accent);
  }
  .rx-cheatsheet-grid span { color: var(--mdt-text-muted); }

  .rx-pattern-row {
    display: flex; align-items: stretch;
    border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius);
    background: var(--mdt-surface-raised); overflow: hidden;
  }
  .rx-pattern-row:focus-within { outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px; }
  .rx-delimiter {
    display: flex; align-items: center; padding: 0 0.75rem;
    font-family: var(--mdt-font-mono); font-size: 1.05rem;
    background: var(--mdt-surface-muted); color: var(--mdt-text-muted);
    user-select: none;
  }
  .rx-pattern-row input {
    flex: 1; min-width: 0; border: none; background: transparent;
    padding: 0.6rem 0.75rem; color: var(--mdt-text);
    font-family: var(--mdt-font-mono); font-size: 1.05rem;
  }
  .rx-pattern-row input:focus { outline: none; }

  .rx-flags { display: flex; flex-wrap: wrap; gap: 0.5rem; border: none; margin: 0; padding: 0; }
  .rx-flag {
    display: inline-flex; align-items: center; gap: 0.4rem;
    border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm);
    padding: 0.3rem 0.7rem; cursor: pointer; font-size: 0.75rem;
    font-family: var(--mdt-font-mono); font-weight: 700; color: var(--mdt-text);
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .rx-flag:hover { background: var(--mdt-surface-muted); border-color: var(--mdt-accent); }
  .rx-flag input { accent-color: var(--mdt-accent); margin: 0; }

  .rx-textwrap { position: relative; height: 200px; }
  .rx-backdrop, .rx-textwrap textarea {
    position: absolute; inset: 0; margin: 0; padding: 0.75rem;
    border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius);
    font-family: var(--mdt-font-mono); font-size: 0.95rem; line-height: 1.5;
    white-space: pre-wrap; word-break: break-all; overflow: auto;
  }
  .rx-backdrop {
    color: transparent; background: var(--mdt-surface-raised); pointer-events: none;
  }
  .rx-textwrap textarea {
    background: transparent; color: var(--mdt-text); resize: none;
  }
  .rx-textwrap textarea:focus { outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px; }
  .rx-backdrop :global(mark.rx-mark) {
    background: color-mix(in srgb, var(--mdt-warning) 40%, transparent);
    color: transparent; border-radius: 2px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--mdt-warning) 40%, transparent);
  }

  .rx-results-head { margin-bottom: -0.5rem; }
  .rx-section-title {
    display: flex; align-items: center; gap: 0.5rem;
    margin: 0; font-size: 0.95rem; font-weight: 700; color: var(--mdt-text);
  }
  .rx-count {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 1.6rem; padding: 0.1rem 0.5rem; border-radius: 999px;
    background: var(--mdt-accent); color: var(--mdt-accent-contrast);
    font-size: 0.8rem; font-weight: 700;
  }
  .rx-results { display: flex; flex-direction: column; gap: 0.5rem; overflow-x: auto; }
  .rx-empty { margin: 0; color: var(--mdt-text-muted); font-style: italic; font-size: 0.85rem; }
  .rx-error {
    margin: 0; padding: 0.6rem 0.75rem; font-size: 0.85rem;
    border: 1px solid var(--mdt-danger); border-radius: var(--mdt-radius-sm);
    color: var(--mdt-danger); background: color-mix(in srgb, var(--mdt-danger) 8%, transparent);
    word-break: break-all;
  }

  .rx-results :global(.rx-match) {
    border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm);
    padding: 0.6rem 0.75rem; background: var(--mdt-surface-muted);
    font-family: var(--mdt-font-mono); font-size: 0.85rem;
    transition: background 0.15s ease;
  }
  .rx-results :global(.rx-match:hover) { background: var(--mdt-surface-raised); }
  .rx-results :global(.rx-match-head) {
    display: flex; justify-content: space-between; gap: 0.5rem;
    font-weight: 700; margin-bottom: 0.25rem; opacity: 0.75;
  }
  .rx-results :global(.rx-match-head .rx-pos) { font-weight: 400; opacity: 0.7; }
  .rx-results :global(.rx-match-text) {
    background: var(--mdt-surface-raised); border: 1px solid var(--mdt-border);
    border-radius: var(--mdt-radius-sm); padding: 0.4rem 0.5rem;
    word-break: break-all; margin-bottom: 0.25rem;
  }
  .rx-results :global(.rx-group) {
    display: flex; gap: 0.5rem; align-items: baseline;
    margin-left: 1rem; margin-top: 0.25rem; padding-left: 0.5rem;
    border-left: 2px solid color-mix(in srgb, var(--mdt-accent) 30%, transparent);
    font-size: 0.75rem;
  }
  .rx-results :global(.rx-group-name) { font-weight: 600; color: var(--mdt-accent); }
  .rx-results :global(.rx-group-text) {
    background: var(--mdt-surface-muted); border-radius: var(--mdt-radius-sm);
    padding: 0.1rem 0.35rem; word-break: break-all;
  }
  .rx-results :global(.rx-group-pos) { margin-left: auto; opacity: 0.5; white-space: nowrap; }
  .rx-results :global(.rx-more) {
    text-align: center; font-size: 0.75rem; color: var(--mdt-text-muted); margin-top: 0.25rem;
  }

  .rx-tables { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 900px) { .rx-tables { grid-template-columns: 1fr 1fr; } }
  .rx-panel { display: flex; flex-direction: column; gap: 0.75rem; }
  .rx-table-wrap { overflow-x: auto; }
  .rx-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
  .rx-table th {
    text-align: left; padding: 0.35rem 0.5rem; color: var(--mdt-text-muted);
    border-bottom: 1px solid var(--mdt-border); font-weight: 600;
  }
  .rx-table td { padding: 0.35rem 0.5rem; border-bottom: 1px solid var(--mdt-border); vertical-align: middle; }
  .rx-table tbody tr:nth-child(even) { background: var(--mdt-surface-muted); }
  .rx-actions-col { width: 5rem; }
  .rx-table :global(.rx-cell-name) { font-weight: 700; font-size: 0.75rem; }
  .rx-table :global(.rx-cell-pattern) {
    display: block; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    font-family: var(--mdt-font-mono); font-size: 0.65rem;
    background: var(--mdt-surface-muted); border-radius: var(--mdt-radius-sm);
    padding: 0.2rem 0.35rem; opacity: 0.75;
  }
  .rx-table :global(.rx-cell-actions) { display: flex; gap: 0.25rem; }

  .rx-dialog {
    border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius);
    background: var(--mdt-surface-raised); color: var(--mdt-text);
    padding: 1.25rem; max-width: 24rem; width: calc(100% - 2rem);
  }
  .rx-dialog::backdrop { background: rgb(0 0 0 / 0.45); }
  .rx-dialog-title { margin: 0 0 0.5rem; font-size: 1rem; font-weight: 700; }
  .rx-dialog-text { margin: 0 0 0.75rem; font-size: 0.85rem; color: var(--mdt-text-muted); }
  .rx-dialog-input {
    width: 100%; box-sizing: border-box; padding: 0.5rem 0.75rem;
    border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface); color: var(--mdt-text); font-size: 0.9rem;
  }
  .rx-dialog-input:focus { outline: 2px solid var(--mdt-focus-ring); outline-offset: 1px; }
  .rx-dialog-actions { display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1rem; }
</style>
