---
/**
 * Text Case Converter tool (pure JS). Applies a case transform in-place to the
 * textarea: sentence, lower, upper, title, alternating, inverse, camel, snake,
 * kebab. Actions: clear, copy. Transforms live in `text-case.ts`.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/text-case-converter";
const s = {
  inputLabel: t(lang, ns, "InputLabel"),
  inputPlaceholder: t(lang, ns, "InputPlaceholder"),
  convertLabel: t(lang, ns, "ConvertLabel"),
  clear: t(lang, ns, "ClearButton"),
  copy: t(lang, ns, "CopyButton"),
  copied: t(lang, ns, "Copied"),
  copyFailed: t(lang, ns, "CopyFailed"),
};
const cases = [
  ["sentence", t(lang, ns, "SentenceCase")],
  ["lower", t(lang, ns, "LowerCase")],
  ["upper", t(lang, ns, "UpperCase")],
  ["title", t(lang, ns, "TitleCase")],
  ["alternating", t(lang, ns, "AlternatingCase")],
  ["inverse", t(lang, ns, "InverseCase")],
  ["camel", t(lang, ns, "CamelCase")],
  ["snake", t(lang, ns, "SnakeCase")],
  ["kebab", t(lang, ns, "KebabCase")],
] as const;
const stringsJson = JSON.stringify({ copied: s.copied, copyFailed: s.copyFailed });
---

<section class="ds-card ds-stack" data-tcc-tool>
  <div class="ds-output-head">
    <label class="ds-label" for="tcc-input">{s.inputLabel}</label>
    <div class="ds-actions">
      <button type="button" class="ds-btn ds-btn-small" data-tcc-copy>{s.copy}</button>
      <button type="button" class="ds-btn ds-btn-small ds-btn-danger" data-tcc-clear>{s.clear}</button>
    </div>
  </div>

  <textarea
    id="tcc-input"
    class="ds-field-textarea mono tcc-textarea"
    data-tcc-textarea
    rows="12"
    placeholder={s.inputPlaceholder}
    spellcheck="false"
  ></textarea>

  <div class="tcc-grid" role="group" aria-label={s.convertLabel}>
    {cases.map(([value, label]) => (
      <button type="button" class="ds-btn" data-tcc-case={value} aria-controls="tcc-input">{label}</button>
    ))}
  </div>

  <StatusMessage kind="error" data-tcc-error />
</section>

<script is:inline type="application/json" data-tcc-strings set:html={stringsJson} />
<script>import "@/tools/text-case-converter.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .tcc-textarea { min-height: 14rem; }
  .tcc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
  @media (min-width: 560px) { .tcc-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .tcc-grid > :global(.ds-btn) { justify-content: center; min-width: 0; white-space: normal; }
</style>
