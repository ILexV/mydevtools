---
/**
 * Text Diff Viewer. Two inputs (paste text or load a file per side), a unified
 * diff built with vendored jsdiff and rendered by vendored diff2html-ui (both
 * loaded on demand by the client). View modes: side-by-side (default) /
 * line-by-line. Actions: compare, clear. Large diffs are capped via
 * diffMaxChanges / diffMaxLineLength (legacy parity). A headline above the
 * diff counts added/removed lines ("+12 −4").
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import EmptyState from "@/components/tool/EmptyState.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/text-diff-viewer";

const originalLabel = t(lang, ns, "OriginalLabel");
const modifiedLabel = t(lang, ns, "ModifiedLabel");
// Legacy strings start with a folder emoji; keep it out of the accessible name.
const stripIcon = (v: string) => v.replace(/^[^\p{L}\p{N}]+/u, "");
const chooseOriginal = stripIcon(t(lang, ns, "ChooseOriginalFile"));
const chooseModified = stripIcon(t(lang, ns, "ChooseModifiedFile"));
const viewModeLabel = t(lang, ns, "ViewModeLabel");
const chooseFile = t(lang, "common", "Common_FileChooseButton");
const lineByLine = t(lang, ns, "LineByLine");
const sideBySide = t(lang, ns, "SideBySide");
const loadExample = t(lang, "common", "Common_LoadExample");
const outputLabel = t(lang, "common", "Common_Output");

const stringsJson = JSON.stringify({
  loading: t(lang, "common", "Common_Loading"),
  errorEmpty: t(lang, ns, "ErrorMessage"),
  errorLibLoad: t(lang, ns, "LibraryLoadError"),
  noDifferences: t(lang, ns, "NoDifferences"),
  fileReadError: t(lang, ns, "FileReadError"),
  diffTooBig: t(lang, ns, "DiffTooBig"),
  exampleOriginal: t(lang, ns, "ExampleOriginal"),
  exampleModified: t(lang, ns, "ExampleModified"),
  linesAdded: t(lang, ns, "LinesAdded"),
  linesRemoved: t(lang, ns, "LinesRemoved"),
});
const uploadIcon = `<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" /></svg>`;
const sides = [
  { key: "original", label: originalLabel, choose: chooseOriginal, hint: t(lang, ns, "OriginalEmptyHint") },
  { key: "modified", label: modifiedLabel, choose: chooseModified, hint: t(lang, ns, "ModifiedEmptyHint") },
] as const;
---

<div class="ds-workbench" data-diff-tool>
  {sides.map((side) => (
    <ToolPanel title={side.label} for={`diff-${side.key}`}>
      <Fragment slot="actions">
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-diff-load={side.key} title={side.choose} aria-label={side.choose}>
          <Fragment set:html={uploadIcon} />
          {chooseFile}
        </button>
        <input type="file" class="visually-hidden" data-diff-file={side.key} tabindex="-1" aria-hidden="true" />
      </Fragment>
      <div class="ds-editor is-empty" data-diff-host={side.key}>
        <textarea
          id={`diff-${side.key}`}
          class="ds-field-textarea mono diff-textarea"
          data-diff-text={side.key}
          rows="14"
          spellcheck="false"
          aria-describedby={`diff-${side.key}-empty`}
        ></textarea>
        <EmptyState
          hint={side.hint}
          hintId={`diff-${side.key}-empty`}
          exampleLabel={loadExample}
          buttonProps={{ "data-diff-example": true }}
        />
      </div>
    </ToolPanel>
  ))}

  <div class="ds-workbench-wide diff-bar">
    <div class="ds-action-row">
      <button type="button" class="ds-btn ds-btn-primary" data-diff-compare>{t(lang, ns, "CompareButton")}</button>
      <button type="button" class="ds-btn" data-diff-clear>{t(lang, ns, "ClearButton")}</button>
    </div>
    <fieldset class="ds-check-group diff-modes">
      <legend class="visually-hidden">{viewModeLabel}</legend>
      <label class="ds-check-row">
        <input type="radio" class="ds-radio" name="diff-view-mode" value="line-by-line" data-diff-mode />
        <span>{lineByLine}</span>
      </label>
      <label class="ds-check-row">
        <input type="radio" class="ds-radio" name="diff-view-mode" value="side-by-side" data-diff-mode checked />
        <span>{sideBySide}</span>
      </label>
    </fieldset>
  </div>

  <OutputPanel panel class="ds-workbench-wide" label={outputLabel} emptyHint={t(lang, ns, "OutputEmpty")} data-diff-output-panel>
    <StatusMessage kind="info" data-diff-status />
    <StatusMessage kind="error" data-diff-error />
    <div class="ds-result-headline" data-diff-summary hidden>
      <span class="ds-result-headline-label">{t(lang, ns, "ChangesLabel")}</span>
      <span class="ds-result-headline-value diff-counts">
        <span class="diff-count-add" data-diff-added></span>
        <span class="diff-count-del" data-diff-removed></span>
      </span>
    </div>
    <div class="diff-output" data-diff-output hidden></div>
  </OutputPanel>
</div>

<script is:inline type="application/json" data-diff-strings set:html={stringsJson} />
<script>import "@/tools/text-diff-viewer.client.ts";</script>

<style>
  /* Layout + diff2html theming only; shared visuals come from tool-ui.css (ds-*). */
  .diff-textarea { min-height: 14rem; }
  .diff-bar {
    display: flex; flex-wrap: wrap; align-items: center;
    justify-content: space-between; gap: 0.75rem;
  }
  .diff-modes {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1rem;
    padding: 0.4rem 0.85rem; border-radius: var(--mdt-radius-sm);
    background: var(--mdt-surface-inset); border: 1px solid var(--mdt-border);
  }

  /* Headline "+12 −4": added in success, removed in danger colour. */
  .diff-counts { display: inline-flex; flex-wrap: wrap; gap: 0 0.9rem; }
  .diff-count-add { color: var(--mdt-success); }
  .diff-count-del { color: var(--mdt-danger); }

  .diff-output {
    border: 1px solid var(--mdt-border); border-radius: var(--mdt-radius);
    background: var(--mdt-surface); color: var(--mdt-text);
    overflow-x: auto; max-width: 100%;
    font-size: 0.82rem;
  }

  /* diff2html runtime DOM → :global under the scoped container. */
  .diff-output :global(.d2h-wrapper) { min-width: 0; }
  .diff-output :global(.d2h-file-wrapper) { margin-bottom: 0; border: 0; border-radius: 0; }
  .diff-output :global(.d2h-file-header) { font-family: var(--mdt-font-mono); }
  /* diff2html chrome that doesn't apply to two pasted texts (and is English-only):
     the RENAMED tag (sides are named Original/Modified) and the "Viewed" toggle. */
  .diff-output :global(.d2h-file-header .d2h-tag),
  .diff-output :global(.d2h-file-collapse) { display: none !important; /* beats diff2html-ui inline style */ }
  .diff-output :global(.d2h-code-line),
  .diff-output :global(.d2h-code-side-line),
  .diff-output :global(.d2h-code-linenumber),
  .diff-output :global(.d2h-code-side-linenumber) {
    font-family: var(--mdt-font-mono);
  }
</style>
