---
/**
 * Unit Converter tool (pure JS). Length / Weight / Temperature / Volume
 * conversion. Live convert on input or select change, swap from↔to, copy
 * result, formula note, quick-conversion chips, and a common-conversions
 * sidebar. All math lives in `units.ts`; unit names are localized here.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import { allUnitIds } from "@/tools/units";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/unit-converter";
const unitNames = Object.fromEntries(allUnitIds().map((id) => [id, t(lang, ns, `Unit_${id}`)]));
const s = {
  lang,
  categoryLabel: t(lang, ns, "CategoryLabel"),
  fromLabel: t(lang, ns, "FromLabel"),
  toLabel: t(lang, ns, "ToLabel"),
  valueLabel: t(lang, ns, "ValueLabel"),
  swap: t(lang, ns, "Swap"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, ns, "Copied"),
  copyFailed: t(lang, ns, "CopyFailed"),
  belowAbsoluteZero: t(lang, ns, "Warning_BelowAbsoluteZero"),
  quickConversions: t(lang, ns, "QuickConversions"),
  commonConversions: t(lang, ns, "CommonConversions"),
  formula: t(lang, ns, "Formula"),
  unitNames,
};
const stringsJson = JSON.stringify(s);
const categories = [
  { value: "length", label: t(lang, ns, "Category_Length") },
  { value: "weight", label: t(lang, ns, "Category_Weight") },
  { value: "temperature", label: t(lang, ns, "Category_Temperature") },
  { value: "volume", label: t(lang, ns, "Category_Volume") },
] as const;
---

<div class="unit-tool" data-unit-tool>
  <div class="ds-tool-grid unit-grid">
    <div class="ds-stack">
      <section class="ds-card ds-stack">
        <Field label={s.categoryLabel} for="unit-category">
          <select id="unit-category" class="ds-field-select" data-unit-category>
            {categories.map((c) => <option value={c.value}>{c.label}</option>)}
          </select>
        </Field>

        <div class="convert-row">
          <div class="ds-stack convert-side">
            <Field label={s.fromLabel} for="unit-from">
              <select id="unit-from" class="ds-field-select" data-unit-from></select>
            </Field>
            <input
              type="number"
              class="ds-field mono"
              data-unit-from-value
              value="1"
              step="any"
              placeholder="0"
              inputmode="decimal"
              aria-label={`${s.valueLabel} (${s.fromLabel})`}
            />
          </div>

          <div class="swap-wrap">
            <button type="button" class="ds-icon-btn" data-unit-swap title={s.swap} aria-label={s.swap}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
              </svg>
            </button>
          </div>

          <div class="ds-stack convert-side">
            <Field label={s.toLabel} for="unit-to">
              <select id="unit-to" class="ds-field-select" data-unit-to></select>
            </Field>
            <div class="to-wrap">
              <input
                type="text"
                class="ds-field mono"
                data-unit-to-value
                readonly
                aria-label={`${s.valueLabel} (${s.toLabel})`}
              />
              <button type="button" class="ds-icon-btn" data-unit-copy title={s.copy} aria-label={s.copy}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <p class="ds-status is-warning" data-unit-warning role="status" hidden></p>
        <StatusMessage kind="error" data-unit-error />

        <div class="ds-field-group">
          <span class="ds-label" id="unit-quick-label">{s.quickConversions}</span>
          <div class="ds-chip-list" data-unit-quick role="group" aria-labelledby="unit-quick-label"></div>
        </div>
      </section>

      <section class="ds-card" aria-labelledby="unit-formula-title">
        <div class="ds-card-head"><h2 class="ds-card-title" id="unit-formula-title">{s.formula}</h2></div>
        <div class="ds-code-block" data-unit-formula aria-live="polite"></div>
      </section>
    </div>

    <aside class="ds-card" aria-labelledby="unit-common-title">
      <div class="ds-card-head"><h2 class="ds-card-title" id="unit-common-title">{s.commonConversions}</h2></div>
      <div class="common-list" data-unit-common></div>
    </aside>
  </div>
</div>

<script is:inline type="application/json" data-unit-strings set:html={stringsJson} />
<script>import "@/tools/unit-converter.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .unit-grid { --ds-tool-grid-cols: minmax(0, 2fr) minmax(0, 1fr); align-items: start; }

  .convert-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.9rem; align-items: end; }
  @media (min-width: 640px) { .convert-row { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); } }
  .convert-side { gap: 0.5rem; }
  .swap-wrap { display: flex; justify-content: center; padding-bottom: 0.2rem; }

  .to-wrap { display: flex; gap: 0.4rem; align-items: center; }
  .to-wrap > input { flex: 1; min-width: 0; }

  .common-list { display: grid; gap: 0.5rem; }
  /* Common rows are built by the controller as .ds-btn; left-aligned mono text. */
  .common-list :global(.ds-btn) {
    justify-content: flex-start;
    width: 100%;
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-meta);
    text-align: left;
    white-space: normal;
    overflow-wrap: anywhere;
  }
</style>
