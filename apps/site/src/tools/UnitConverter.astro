---
/**
 * Unit Converter tool (pure JS). Length / Weight / Temperature / Volume
 * conversion as a workbench: From panel (category, value, unit, swap) |
 * To panel (unit, headline result + formula, copy, quick-conversion chips),
 * then a common-conversions panel. Live convert on input or select change. All math lives in `units.ts`; unit names are localized here.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import CopyButton from "@/components/tool/CopyButton.astro";
import { allUnitIds } from "@/tools/units";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/unit-converter";
const unitNames = Object.fromEntries(allUnitIds().map((id) => [id, t(lang, ns, `Unit_${id}`)]));
const s = {
  lang,
  categoryLabel: t(lang, ns, "CategoryLabel"),
  fromLabel: t(lang, ns, "FromLabel"),
  toLabel: t(lang, ns, "ToLabel"),
  valueLabel: t(lang, ns, "ValueLabel"),
  swap: t(lang, ns, "Swap"),
  copy: t(lang, ns, "Copy"),
  unitLabel: t(lang, ns, "UnitLabel"),
  copied: t(lang, "common", "Common_Copied"),
  copyFailed: t(lang, ns, "CopyFailed"),
  belowAbsoluteZero: t(lang, ns, "Warning_BelowAbsoluteZero"),
  quickConversions: t(lang, ns, "QuickConversions"),
  commonConversions: t(lang, ns, "CommonConversions"),
  formula: t(lang, ns, "Formula"),
  unitNames,
};
const stringsJson = JSON.stringify(s);
const categories = [
  { value: "length", label: t(lang, ns, "Category_Length") },
  { value: "weight", label: t(lang, ns, "Category_Weight") },
  { value: "temperature", label: t(lang, ns, "Category_Temperature") },
  { value: "volume", label: t(lang, ns, "Category_Volume") },
] as const;
---

<div class="ds-stack unit-tool" data-unit-tool>
  <div class="ds-workbench">
    <ToolPanel title={s.fromLabel}>
      <Fragment slot="actions">
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-unit-swap title={s.swap}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
          {s.swap}
        </button>
      </Fragment>
      <Field label={s.categoryLabel} for="unit-category">
        <select id="unit-category" class="ds-field-select" data-unit-category>
          {categories.map((c) => <option value={c.value}>{c.label}</option>)}
        </select>
      </Field>
      <div class="unit-pair">
        <Field label={s.valueLabel} for="unit-from-value">
          <input
            id="unit-from-value"
            type="number"
            class="ds-field mono"
            data-unit-from-value
            value="1"
            step="any"
            placeholder="0"
            inputmode="decimal"
          />
        </Field>
        <Field label={s.unitLabel} for="unit-from">
          <select id="unit-from" class="ds-field-select" data-unit-from></select>
        </Field>
      </div>
      <p class="ds-status is-warning" data-unit-warning role="status" hidden></p>
    </ToolPanel>

    <ToolPanel title={s.toLabel}>
      <Fragment slot="actions">
        <CopyButton ghost label={s.copy} copiedLabel={s.copied} data-unit-copy />
      </Fragment>
      <Field label={s.unitLabel} for="unit-to">
        <select id="unit-to" class="ds-field-select" data-unit-to></select>
      </Field>
      <div class="ds-result-headline">
        <span class="ds-result-headline-label" id="unit-result-label" data-unit-result-label>{s.valueLabel}</span>
        <output class="ds-result-headline-value" data-unit-to-value aria-labelledby="unit-result-label"></output>
        <p class="ds-result-headline-meta unit-formula">
          <span>{s.formula}:</span>
          <span class="mono" data-unit-formula aria-live="polite"></span>
        </p>
      </div>
      <StatusMessage kind="error" data-unit-error />
      <div class="ds-field-group">
        <span class="ds-label" id="unit-quick-label">{s.quickConversions}</span>
        <div class="ds-chip-list" data-unit-quick role="group" aria-labelledby="unit-quick-label"></div>
      </div>
    </ToolPanel>
  </div>

  <ToolPanel title={s.commonConversions}>
    <div class="common-list" data-unit-common></div>
  </ToolPanel>
</div>

<script is:inline type="application/json" data-unit-strings set:html={stringsJson} />
<script>import "@/tools/unit-converter.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .unit-pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.75rem; }
  @media (max-width: 30rem) { .unit-pair { grid-template-columns: minmax(0, 1fr); } }
  .unit-formula { display: block; margin: 0.4rem 0 0; overflow-wrap: anywhere; }
  .unit-formula > .mono { margin-left: 0.35rem; color: var(--mdt-text); }

  .common-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.5rem;
  }
  /* Common rows are built by the controller as .ds-btn; left-aligned mono text. */
  .common-list :global(.ds-btn) {
    justify-content: flex-start;
    width: 100%;
    font-family: var(--mdt-font-mono);
    font-size: var(--mdt-fs-meta);
    text-align: left;
    white-space: normal;
    overflow-wrap: anywhere;
  }
</style>
