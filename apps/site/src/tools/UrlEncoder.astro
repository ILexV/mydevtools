---
/**
 * URL Encoder / Decoder tool on the shared tool UI kit (`ds-*`,
 * docs/qa/tool-ui-kit.md). Percent-encoding with selectable mode
 * (component / uri / form) and text charset. Text-only (no file input,
 * no download — legacy parity). Behavior lives in `url-encoder.client.ts`,
 * which calls the main-thread `encoding-client` (one-shot WASM ops).
 *
 * Locale strings for the tool namespace are embedded as a JSON island.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}

const { lang } = Astro.props as Props;
const ns = "tools/url-encoder";

const strings = {
  inputLabel: t(lang, ns, "InputLabel"),
  inputPlaceholder: t(lang, ns, "InputPlaceholder"),
  outputLabel: t(lang, ns, "OutputLabel"),
  modeLabel: t(lang, ns, "ModeLabel"),
  modeComponent: t(lang, ns, "Mode_Component"),
  modeUri: t(lang, ns, "Mode_Uri"),
  modeForm: t(lang, ns, "Mode_Form"),
  charsetLabel: t(lang, ns, "CharsetLabel"),
  encode: t(lang, ns, "ActionEncode"),
  decode: t(lang, ns, "ActionDecode"),
  swap: t(lang, ns, "ActionSwap"),
  clear: t(lang, ns, "ActionClear"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, ns, "Copied"),
  statsOutput: t(lang, ns, "StatsOutput"),
  errNotRepresentable: t(lang, ns, "Error_NotRepresentable"),
  errNotText: t(lang, ns, "Error_NotText"),
  errInvalidPercent: t(lang, ns, "Error_InvalidPercent"),
  errCopyFailed: t(lang, ns, "Error_CopyFailed"),
  error: t(lang, "common", "Common_Error"),
};
const stringsJson = JSON.stringify(strings);
---

<div class="ds-stack" data-url-tool>
  <div class="ds-tool-grid">
    <section class="ds-card ds-stack">
      <Field label={strings.inputLabel} for="url-textarea">
        <textarea
          id="url-textarea"
          class="ds-field-textarea mono"
          data-url-input
          rows="8"
          spellcheck="false"
          placeholder={strings.inputPlaceholder}
        ></textarea>
      </Field>

      <div class="ds-settings">
        <Field label={strings.modeLabel} for="url-mode">
          <select id="url-mode" class="ds-field-select" data-url-mode>
            <option value="component">{strings.modeComponent}</option>
            <option value="uri">{strings.modeUri}</option>
            <option value="form">{strings.modeForm}</option>
          </select>
        </Field>
        <Field label={strings.charsetLabel} for="url-charset">
          <select id="url-charset" class="ds-field-select" data-url-charset>
            <option value="utf-8">UTF-8</option>
            <option value="utf-16le">UTF-16LE</option>
            <option value="utf-16be">UTF-16BE</option>
            <option value="latin1">ISO-8859-1 (Latin-1)</option>
          </select>
        </Field>
      </div>
    </section>

    <section class="ds-card ds-stack">
      <OutputPanel label={strings.outputLabel} for="url-output-textarea">
        <Fragment slot="actions">
          <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-url-copy>{strings.copy}</button>
        </Fragment>
        <textarea
          id="url-output-textarea"
          class="ds-field-textarea mono url-output"
          data-url-output
          rows="12"
          spellcheck="false"
          readonly
        ></textarea>
        <p class="ds-hint" data-url-stats aria-live="polite"></p>
      </OutputPanel>
    </section>
  </div>

  <div class="ds-actions">
    <button type="button" class="ds-btn ds-btn-primary" data-url-encode>{strings.encode}</button>
    <button type="button" class="ds-btn" data-url-decode>{strings.decode}</button>
    <button type="button" class="ds-btn" data-url-swap>{strings.swap}</button>
    <button type="button" class="ds-btn" data-url-clear>{strings.clear}</button>
  </div>

  <StatusMessage kind="error" data-url-error />
</div>

<script is:inline type="application/json" data-url-strings set:html={stringsJson} />
<script>
  import "@/tools/url-encoder.client.ts";
</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .url-output {
    word-break: break-all;
  }
</style>
