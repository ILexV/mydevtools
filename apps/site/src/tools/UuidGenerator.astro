---
/**
 * UUID Generator tool (pure JS, Web Crypto). v4/v7, format, case, batch ≤100,
 * per-row copy, copy-all, download .txt, clear. Strings via JSON island.
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/uuid-generator";
const s = {
  versionLabel: t(lang, ns, "VersionLabel"),
  v4: t(lang, ns, "Version4"),
  v7: t(lang, ns, "Version7"),
  formatLabel: t(lang, ns, "FormatLabel"),
  fHyphenated: t(lang, ns, "FormatHyphenated"),
  fPlain: t(lang, ns, "FormatPlain"),
  fBraces: t(lang, ns, "FormatBraces"),
  fUrn: t(lang, ns, "FormatUrn"),
  caseLabel: t(lang, ns, "CaseLabel"),
  cUpper: t(lang, ns, "CaseUpper"),
  cLower: t(lang, ns, "CaseLower"),
  countLabel: t(lang, ns, "CountLabel"),
  generate: t(lang, ns, "Generate"),
  copyAll: t(lang, ns, "CopyAll"),
  download: t(lang, ns, "Download"),
  clear: t(lang, ns, "Clear"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, ns, "Copied"),
  copyFailed: t(lang, ns, "CopyFailed"),
  outputLabel: t(lang, ns, "OutputLabel"),
  outputPlaceholder: t(lang, ns, "OutputPlaceholder"),
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-stack uuid-tool" data-uuid-tool>
  <section class="ds-card ds-stack">
    <div class="ds-settings ds-settings-flat uuid-settings">
      {[
        { name: "uuid-version", legend: s.versionLabel, opts: [["v4", s.v4], ["v7", s.v7]] },
        { name: "uuid-format", legend: s.formatLabel, opts: [["hyphenated", s.fHyphenated], ["plain", s.fPlain], ["braces", s.fBraces], ["urn", s.fUrn]] },
        { name: "uuid-case", legend: s.caseLabel, opts: [["lower", s.cLower], ["upper", s.cUpper]] },
      ].map((g) => (
        <fieldset class="ds-check-group">
          <legend class="ds-label">{g.legend}</legend>
          {g.opts.map(([value, label], i) => (
            <label class="ds-check-row">
              <input type="radio" class="ds-radio" name={g.name} value={value} checked={i === 0} />
              <span>{label}</span>
            </label>
          ))}
        </fieldset>
      ))}
      <div class="ds-field-group">
        <label class="ds-label" for="uuid-count">{s.countLabel}: <span class="uuid-count-val" data-uuid-count-val>1</span></label>
        <input id="uuid-count" type="range" class="uuid-range" min="1" max="100" value="1" data-uuid-count />
      </div>
    </div>
    <div class="ds-actions">
      <button type="button" class="ds-btn ds-btn-primary" data-uuid-generate>{s.generate}</button>
      <button type="button" class="ds-btn" data-uuid-copyall hidden>{s.copyAll}</button>
      <button type="button" class="ds-btn" data-uuid-download hidden>{s.download}</button>
      <button type="button" class="ds-btn ds-btn-danger" data-uuid-clear hidden>{s.clear}</button>
    </div>
    <StatusMessage kind="error" data-uuid-error />
  </section>

  <OutputPanel label={s.outputLabel} class="ds-card">
    <p class="ds-empty" data-uuid-empty>{s.outputPlaceholder}</p>
    <ol class="ds-result-list uuid-list" data-uuid-list aria-live="polite" hidden></ol>
  </OutputPanel>
</div>

<script is:inline type="application/json" data-uuid-strings set:html={stringsJson} />
<script>import "@/tools/uuid-generator.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .uuid-settings { grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
  .uuid-count-val { font-family: var(--mdt-font-mono); color: var(--mdt-cat); }
  .uuid-range { width: 100%; accent-color: var(--mdt-cat); }
  .uuid-list { margin: 0; padding: 0; list-style: none; max-height: 32rem; overflow: auto; }
</style>
