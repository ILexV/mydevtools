---
/**
 * Word Counter tool (pure JS). Live stats: words, chars w/ & w/o spaces,
 * lines, paragraphs, sentences, reading & speaking time. Updates on input.
 * Counting rules live in `word-stats.ts` (graphemes, CJK word segmentation).
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import CopyButton from "@/components/tool/CopyButton.astro";
import EmptyState from "@/components/tool/EmptyState.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/word-counter";
const s = {
  inputLabel: t(lang, ns, "InputLabel"),
  inputPlaceholder: t(lang, ns, "InputPlaceholder"),
  clear: t(lang, ns, "ClearButton"),
  copy: t(lang, ns, "CopyButton"),
  paste: t(lang, ns, "PasteButton"),
  copied: t(lang, "common", "Common_Copied"),
  copyFailed: t(lang, ns, "CopyFailed"),
  copyFailedShort: t(lang, "common", "Common_CopyFailed"),
  loadExample: t(lang, "common", "Common_LoadExample"),
  pasteFailed: t(lang, ns, "PasteFailed"),
  statistics: t(lang, ns, "Statistics"),
  words: t(lang, ns, "Words"),
  wordsDesc: t(lang, ns, "WordsDesc"),
  charsSpaces: t(lang, ns, "CharactersWithSpaces"),
  charsNoSpaces: t(lang, ns, "CharactersWithoutSpaces"),
  lines: t(lang, ns, "Lines"),
  paragraphs: t(lang, ns, "Paragraphs"),
  sentences: t(lang, ns, "Sentences"),
  estimatedTime: t(lang, ns, "EstimatedTime"),
  readingTime: t(lang, ns, "ReadingTime"),
  speakingTime: t(lang, ns, "SpeakingTime"),
  minutes: t(lang, ns, "Minutes"),
};
const stringsJson = JSON.stringify({
  copied: s.copied,
  copyFailed: s.copyFailed,
  copyFailedShort: s.copyFailedShort,
  pasteFailed: s.pasteFailed,
  minutes: s.minutes,
  example: t(lang, ns, "ExampleText"),
});
---

<div class="ds-workbench wc-grid" data-wc-tool>
  <ToolPanel title={s.inputLabel} for="wc-input">
    <Fragment slot="actions">
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-wc-paste>{s.paste}</button>
      <CopyButton ghost label={s.copy} copiedLabel={s.copied} failedLabel={s.copyFailedShort} data-wc-copy />
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-wc-clear>{s.clear}</button>
    </Fragment>
    <div class="ds-editor is-empty" data-wc-input-host>
      <textarea
        id="wc-input"
        class="ds-field-textarea"
        data-wc-textarea
        rows="14"
        aria-describedby="wc-input-empty"
      ></textarea>
      <EmptyState
        hint={s.inputPlaceholder}
        hintId="wc-input-empty"
        exampleLabel={s.loadExample}
        buttonProps={{ "data-wc-example": true }}
      />
    </div>
    <StatusMessage kind="error" data-wc-error />
  </ToolPanel>

  <ToolPanel title={s.statistics} class="wc-stats">
    <div class="ds-result-headline">
      <span class="ds-result-headline-label">{s.words}</span>
      <output class="ds-result-headline-value" data-wc-words>0</output>
      <p class="ds-result-headline-meta">{s.wordsDesc}</p>
    </div>
    <dl class="ds-result-list wc-list">
      <div class="ds-result-row ds-result-row-info"><dt class="ds-result-key">{s.charsSpaces}</dt><dd class="ds-result-value" data-wc-chars-spaces>0</dd></div>
      <div class="ds-result-row ds-result-row-info"><dt class="ds-result-key">{s.charsNoSpaces}</dt><dd class="ds-result-value" data-wc-chars-nospaces>0</dd></div>
      <div class="ds-result-row ds-result-row-info"><dt class="ds-result-key">{s.lines}</dt><dd class="ds-result-value" data-wc-lines>0</dd></div>
      <div class="ds-result-row ds-result-row-info"><dt class="ds-result-key">{s.paragraphs}</dt><dd class="ds-result-value" data-wc-paragraphs>0</dd></div>
      <div class="ds-result-row ds-result-row-info"><dt class="ds-result-key">{s.sentences}</dt><dd class="ds-result-value" data-wc-sentences>0</dd></div>
      <div class="ds-result-row ds-result-row-info"><dt class="ds-result-key">{s.readingTime}</dt><dd class="ds-result-value" data-wc-reading>0 {s.minutes}</dd></div>
      <div class="ds-result-row ds-result-row-info"><dt class="ds-result-key">{s.speakingTime}</dt><dd class="ds-result-value" data-wc-speaking>0 {s.minutes}</dd></div>
    </dl>
  </ToolPanel>
</div>

<script is:inline type="application/json" data-wc-strings set:html={stringsJson} />
<script>import "@/tools/word-counter.client.ts";</script>

<style>
  /* Layout-only: wider text column; stat values right-aligned like a ledger. */
  .wc-grid { --ds-workbench-cols: minmax(0, 1.6fr) minmax(0, 1fr); }
  .wc-list dd { margin: 0; text-align: right; }
</style>
