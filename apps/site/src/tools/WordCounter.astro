---
/**
 * Word Counter tool (pure JS). Live stats: words, chars w/ & w/o spaces,
 * lines, paragraphs, sentences, reading & speaking time. Updates on input.
 * Counting rules live in `word-stats.ts` (graphemes, CJK word segmentation).
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/word-counter";
const s = {
  inputLabel: t(lang, ns, "InputLabel"),
  inputPlaceholder: t(lang, ns, "InputPlaceholder"),
  clear: t(lang, ns, "ClearButton"),
  copy: t(lang, ns, "CopyButton"),
  paste: t(lang, ns, "PasteButton"),
  copied: t(lang, ns, "Copied"),
  copyFailed: t(lang, ns, "CopyFailed"),
  pasteFailed: t(lang, ns, "PasteFailed"),
  statistics: t(lang, ns, "Statistics"),
  words: t(lang, ns, "Words"),
  wordsDesc: t(lang, ns, "WordsDesc"),
  charsSpaces: t(lang, ns, "CharactersWithSpaces"),
  charsNoSpaces: t(lang, ns, "CharactersWithoutSpaces"),
  lines: t(lang, ns, "Lines"),
  paragraphs: t(lang, ns, "Paragraphs"),
  sentences: t(lang, ns, "Sentences"),
  estimatedTime: t(lang, ns, "EstimatedTime"),
  readingTime: t(lang, ns, "ReadingTime"),
  speakingTime: t(lang, ns, "SpeakingTime"),
  minutes: t(lang, ns, "Minutes"),
};
const stringsJson = JSON.stringify({
  copied: s.copied,
  copyFailed: s.copyFailed,
  pasteFailed: s.pasteFailed,
  minutes: s.minutes,
});
---

<div class="ds-tool-grid wc-grid" data-wc-tool>
  <section class="ds-card ds-stack">
    <Field label={s.inputLabel} for="wc-input">
      <textarea
        id="wc-input"
        class="ds-field-textarea wc-textarea"
        data-wc-textarea
        rows="14"
        placeholder={s.inputPlaceholder}
      ></textarea>
    </Field>
    <div class="ds-actions">
      <button type="button" class="ds-btn" data-wc-paste>{s.paste}</button>
      <button type="button" class="ds-btn" data-wc-copy>{s.copy}</button>
      <button type="button" class="ds-btn ds-btn-danger" data-wc-clear>{s.clear}</button>
    </div>
    <StatusMessage kind="error" data-wc-error />
  </section>

  <aside class="ds-card wc-stats" aria-labelledby="wc-stats-title">
    <div class="ds-card-head">
      <h2 class="ds-card-title" id="wc-stats-title">{s.statistics}</h2>
    </div>
    <dl class="wc-list">
      <div class="wc-item wc-item-main">
        <dt>{s.words}</dt><dd data-wc-words>0</dd>
        <p class="ds-hint wc-desc">{s.wordsDesc}</p>
      </div>
      <div class="wc-item"><dt>{s.charsSpaces}</dt><dd data-wc-chars-spaces>0</dd></div>
      <div class="wc-item"><dt>{s.charsNoSpaces}</dt><dd data-wc-chars-nospaces>0</dd></div>
      <div class="wc-item"><dt>{s.lines}</dt><dd data-wc-lines>0</dd></div>
      <div class="wc-item"><dt>{s.paragraphs}</dt><dd data-wc-paragraphs>0</dd></div>
      <div class="wc-item"><dt>{s.sentences}</dt><dd data-wc-sentences>0</dd></div>
      <div class="wc-item"><dt>{s.readingTime}</dt><dd data-wc-reading>0 {s.minutes}</dd></div>
      <div class="wc-item"><dt>{s.speakingTime}</dt><dd data-wc-speaking>0 {s.minutes}</dd></div>
    </dl>
  </aside>
</div>

<script is:inline type="application/json" data-wc-strings set:html={stringsJson} />
<script>import "@/tools/word-counter.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .wc-grid { --ds-tool-grid-cols: minmax(0, 1.6fr) minmax(0, 1fr); align-items: start; }
  .wc-textarea { min-height: 16rem; }
  .wc-list { display: grid; gap: 0.15rem; margin: 0; }
  .wc-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--mdt-border);
  }
  .wc-item:last-child { border-bottom: 0; }
  .wc-item dt { font-size: var(--mdt-fs-meta); color: var(--mdt-text-muted); min-width: 0; overflow-wrap: anywhere; }
  .wc-item dd {
    margin: 0;
    font-family: var(--mdt-font-mono);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--mdt-text);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .wc-item-main dd { font-size: 1.5rem; color: var(--mdt-cat); }
  .wc-desc { grid-column: 1 / -1; margin: 0; }
</style>
