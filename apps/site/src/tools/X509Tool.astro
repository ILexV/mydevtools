---
/**
 * X.509 certificate tool (cryptography WASM domain). Self-signed certificate /
 * CSR generation (subject DN or bare CN, Subject Alternative Names — DNS /
 * IP / e-mail, key algorithm, validity days — legacy ignored the DN attributes
 * and the days field and had no SAN input), PEM or Base64-DER parsing of
 * certificates and PKCS#10 CSRs to a pretty JSON summary, validity / CSR
 * signature warnings, copy/download.
 * Workbench: generate panel (subject, SAN, algorithm, validity → Generate
 * certificate / CSR) over the parse panel (empty state; "Load example"
 * generates a throwaway example.com certificate) | output panel.
 * Behavior lives in `x509.client.ts` (crypto-client helpers, main-thread WASM).
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import Field from "@/components/tool/Field.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import EmptyState from "@/components/tool/EmptyState.astro";
import CopyButton from "@/components/tool/CopyButton.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/x509";
const s = {
  selfSignedSectionTitle: t(lang, ns, "SelfSignedSectionTitle"),
  subjectLabel: t(lang, ns, "SubjectLabel"),
  subjectHint: t(lang, ns, "SubjectHint"),
  sanLabel: t(lang, ns, "SanLabel"),
  sanHint: t(lang, ns, "SanHint"),
  errorInvalidSan: t(lang, ns, "ErrorInvalidSan"),
  warningNoSan: t(lang, ns, "WarningNoSan"),
  validityDaysLabel: t(lang, ns, "ValidityDaysLabel"),
  generateSelfSigned: t(lang, ns, "GenerateSelfSigned"),
  generateCsr: t(lang, ns, "GenerateCsr"),
  parseSectionTitle: t(lang, ns, "ParseSectionTitle"),
  parseLabel: t(lang, ns, "ParseLabel"),
  parseButton: t(lang, ns, "ParseButton"),
  outputLabel: t(lang, ns, "OutputLabel"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, "common", "Common_Copied"),
  copyFailed: t(lang, "common", "Common_CopyFailed"),
  loadExample: t(lang, "common", "Common_LoadExample"),
  parseEmpty: t(lang, ns, "ParseEmpty"),
  outputEmpty: t(lang, ns, "OutputEmpty"),
  download: t(lang, ns, "Download"),
  warningsTitle: t(lang, ns, "WarningsTitle"),
  invalidFormat: t(lang, ns, "InvalidFormat"),
  algorithmLabel: t(lang, ns, "AlgorithmLabel"),
  errorValidityDays: t(lang, ns, "ErrorValidityDays"),
  errorInvalidSubject: t(lang, ns, "ErrorInvalidSubject"),
  warningCsrSignature: t(lang, ns, "WarningCsrSignature"),
  error: t(lang, "common", "Common_Error"),
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-workbench" data-x509-tool>
  <div class="ds-stack">
    <ToolPanel title={s.selfSignedSectionTitle}>
      <div class="ds-settings ds-settings-flat x509-gen">
        <Field label={s.subjectLabel} for="x509-subject" hint={s.subjectHint} class="ds-settings-wide">
          <input
            id="x509-subject"
            type="text"
            class="ds-field mono"
            data-x509-subject
            spellcheck="false"
            autocomplete="off"
            aria-describedby="x509-subject-hint"
            placeholder="CN=example.com,O=My Org,C=US"
          />
        </Field>
        <Field label={s.sanLabel} for="x509-san" hint={s.sanHint} class="ds-settings-wide">
          <textarea
            id="x509-san"
            class="ds-field-textarea mono"
            data-x509-san
            rows="3"
            spellcheck="false"
            autocomplete="off"
            autocapitalize="off"
            aria-describedby="x509-san-hint"
            placeholder={"example.com\nwww.example.com\n192.168.1.10"}></textarea>
        </Field>
        <Field label={s.algorithmLabel} for="x509-algorithm">
          <select id="x509-algorithm" class="ds-field-select" data-x509-algorithm>
            <option value="1" selected>Ed25519</option>
            <option value="2">ECDSA P-256</option>
            <option value="3">ECDSA P-384</option>
          </select>
        </Field>
        <Field label={s.validityDaysLabel} for="x509-validity">
          <input id="x509-validity" type="number" class="ds-field" min="1" max="36500" step="1" value="365" inputmode="numeric" data-x509-validity />
        </Field>
      </div>
      <div class="ds-action-row">
        <button type="button" class="ds-btn ds-btn-primary" data-x509-generate-selfsigned>{s.generateSelfSigned}</button>
        <button type="button" class="ds-btn" data-x509-generate-csr>{s.generateCsr}</button>
      </div>
    </ToolPanel>

    <ToolPanel title={s.parseSectionTitle}>
      <Field label={s.parseLabel} for="x509-parse-input">
        <div class="ds-editor is-empty" data-x509-parse-host>
          <textarea
            id="x509-parse-input"
            class="ds-field-textarea mono x509-parse"
            data-x509-parse-input
            rows="6"
            spellcheck="false"
            autocomplete="off"
            aria-describedby="x509-parse-empty"></textarea>
          <EmptyState
            hint={s.parseEmpty}
            hintId="x509-parse-empty"
            exampleLabel={s.loadExample}
            buttonProps={{ "data-x509-example": true }}
          />
        </div>
      </Field>
      <div class="ds-action-row">
        <button type="button" class="ds-btn ds-btn-primary" data-x509-parse>{s.parseButton}</button>
      </div>
    </ToolPanel>
  </div>

  <OutputPanel panel label={s.outputLabel} for="x509-output" emptyHint={s.outputEmpty} data-x509-output-panel>
    <Fragment slot="actions">
      <CopyButton ghost label={s.copy} copiedLabel={s.copied} failedLabel={s.copyFailed} data-x509-copy disabled />
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-x509-download disabled>{s.download}</button>
    </Fragment>
    <StatusMessage kind="error" data-x509-error />
    <StatusMessage kind="warning" data-x509-warnings />
    <textarea id="x509-output" class="ds-field-textarea mono x509-out ds-when-filled" data-x509-output rows="16" readonly spellcheck="false"></textarea>
  </OutputPanel>
</div>

<script is:inline type="application/json" data-x509-strings set:html={stringsJson} />
<script>import "@/tools/x509.client.ts";</script>

<style>
  /* Layout-only: shared visuals come from styles/tool-ui.css (ds-*). */
  .ds-editor > .x509-parse {
    min-height: 11rem;
  }
  .x509-out {
    min-height: 20rem;
    overflow-wrap: anywhere;
    word-break: break-all;
  }
</style>
