---
/**
 * XML Beautifier (structured data, pure JS). Single CodeMirror 6 editor
 * (`@codemirror/lang-xml`; shared theme in `styles/codemirror.css`), format (2/4/tab indent), compact mode (minify),
 * open/save .xml files, drag & drop onto the editor, copy, clear. Formatting
 * is DOMParser + the pure serializer in `xml-format.ts`. Input is NEVER
 * persisted (legacy localStorage input persistence dropped for privacy).
 */
import { t } from "@/i18n/messages";
import { diagnosticStrings, editorPhrases } from "@/tools/editor-phrases";
import type { LocaleCode } from "@/registry/locales";
import CopyButton from "@/components/tool/CopyButton.astro";
import EmptyState from "@/components/tool/EmptyState.astro";
import Field from "@/components/tool/Field.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import "@/styles/codemirror.css";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/xml-beautifier";
const s = {
  openButton: t(lang, ns, "OpenButton"),
  saveButton: t(lang, ns, "SaveButton"),
  indentSizeLabel: t(lang, ns, "IndentSizeLabel"),
  indent2Spaces: t(lang, ns, "Indent2Spaces"),
  indent4Spaces: t(lang, ns, "Indent4Spaces"),
  indentTab: t(lang, ns, "IndentTab"),
  compactMode: t(lang, ns, "CompactMode"),
  formatButton: t(lang, ns, "FormatButton"),
  copyButton: t(lang, ns, "CopyButton"),
  clearButton: t(lang, ns, "ClearButton"),
  inputLabel: t(lang, ns, "InputLabel"),
  keyboardHint: t(lang, ns, "EditorKeyboardHint"),
  emptyHint: t(lang, ns, "EmptyHint"),
  loadExample: t(lang, "common", "Common_LoadExample"),
  copied: t(lang, "common", "Common_Copied"),
  copyFailed: t(lang, "common", "Common_CopyFailed"),
};
const stringsJson = JSON.stringify({
  copied: s.copied,
  copyFailed: s.copyFailed,
  errorInvalidXml: t(lang, ns, "ErrorInvalidXml"),
  inputLabel: s.inputLabel,
  phrases: editorPhrases(lang),
  diag: diagnosticStrings(lang),
});
---

<div class="ds-workbench ds-workbench-single" data-xml-tool>
  <ToolPanel title={s.inputLabel}>
    <Fragment slot="actions">
      <label class="ds-btn ds-btn-small ds-btn-ghost ds-file-btn">
        <input type="file" accept=".xml,application/xml,text/xml" data-xml-file />
        {s.openButton}
      </label>
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-xml-save>{s.saveButton}</button>
      <CopyButton ghost label={s.copyButton} copiedLabel={s.copied} failedLabel={s.copyFailed} data-xml-copy />
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-xml-clear>{s.clearButton}</button>
    </Fragment>

    <div class="ds-editor is-empty" data-xml-editor-host>
      <div class="mdt-cm" data-xml-editor role="group" aria-label={s.inputLabel}></div>
      <EmptyState
        hint={s.emptyHint}
        hintId="xml-editor-empty"
        exampleLabel={s.loadExample}
        buttonProps={{ "data-xml-example": true }}
      />
    </div>
    <p class="ds-hint" id="xml-editor-hint">{s.keyboardHint}</p>

    <div class="ds-settings">
      <Field label={s.indentSizeLabel} for="xml-indent">
        <select id="xml-indent" class="ds-field-select" data-xml-indent>
          <option value="2">{s.indent2Spaces}</option>
          <option value="4" selected>{s.indent4Spaces}</option>
          <option value="tab">{s.indentTab}</option>
        </select>
      </Field>
      <div class="ds-check-group xml-checks">
        <label class="ds-check-row"><input type="checkbox" class="ds-check" data-xml-compact /> {s.compactMode}</label>
      </div>
    </div>

    <div class="ds-action-row">
      <button type="button" class="ds-btn ds-btn-primary" data-xml-format>{s.formatButton}</button>
    </div>

    <!-- Parse-error panel (codemirror-kit setDiagnostic): no live role — errors are announced once on Format. -->
    <StatusMessage kind="error" role="none" class="mdt-diag" id="xml-editor-error" data-xml-error />
  </ToolPanel>
</div>

<script is:inline type="application/json" data-xml-strings set:html={stringsJson} />
<script>import "@/tools/xml-beautifier.client.ts";</script>

<style>
  /* Layout-only: the checkbox sits level with the indent select. */
  .xml-checks { align-self: end; padding-bottom: 0.55rem; }
</style>
