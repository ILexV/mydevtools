---
/**
 * XML Beautifier (structured data, pure JS). Single CodeMirror editor with a
 * custom 'simplexml' mode (ported verbatim from legacy; shared theme in
 * `styles/codemirror.css`), format (2/4/tab indent), compact mode (minify),
 * open/save .xml files, drag & drop onto the editor, copy, clear. Formatting
 * is DOMParser + the pure serializer in `xml-format.ts`. Input is NEVER
 * persisted (legacy localStorage input persistence dropped for privacy).
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import "@/styles/codemirror.css";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/xml-beautifier";
const s = {
  openButton: t(lang, ns, "OpenButton"),
  saveButton: t(lang, ns, "SaveButton"),
  indentSizeLabel: t(lang, ns, "IndentSizeLabel"),
  indent2Spaces: t(lang, ns, "Indent2Spaces"),
  indent4Spaces: t(lang, ns, "Indent4Spaces"),
  indentTab: t(lang, ns, "IndentTab"),
  compactMode: t(lang, ns, "CompactMode"),
  formatButton: t(lang, ns, "FormatButton"),
  copyButton: t(lang, ns, "CopyButton"),
  clearButton: t(lang, ns, "ClearButton"),
  inputLabel: t(lang, ns, "InputLabel"),
  keyboardHint: t(lang, ns, "EditorKeyboardHint"),
};
const stringsJson = JSON.stringify({
  copied: t(lang, ns, "Copied"),
  errorInvalidXml: t(lang, ns, "ErrorInvalidXml"),
  inputLabel: s.inputLabel,
});
---

<div class="ds-stack" data-xml-tool>
  <div class="ds-card cm-toolbar">
    <div class="cm-options">
      <label class="ds-btn ds-file-btn">
        <input type="file" accept=".xml,application/xml,text/xml" data-xml-file />
        {s.openButton}
      </label>
      <button type="button" class="ds-btn" data-xml-save>{s.saveButton}</button>
      <label class="cm-inline-field">
        <span class="ds-label">{s.indentSizeLabel}</span>
        <select class="ds-field-select" data-xml-indent>
          <option value="2">{s.indent2Spaces}</option>
          <option value="4" selected>{s.indent4Spaces}</option>
          <option value="tab">{s.indentTab}</option>
        </select>
      </label>
      <label class="ds-check-row"><input type="checkbox" class="ds-check" data-xml-compact /> {s.compactMode}</label>
    </div>
    <div class="ds-actions">
      <button type="button" class="ds-btn ds-btn-primary" data-xml-format>{s.formatButton}</button>
      <button type="button" class="ds-btn" data-xml-copy>{s.copyButton}</button>
      <button type="button" class="ds-btn ds-btn-danger" data-xml-clear>{s.clearButton}</button>
    </div>
  </div>

  <StatusMessage kind="error" data-xml-error />

  <div class="ds-field-group">
    <span class="ds-label" id="xml-editor-label">{s.inputLabel}</span>
    <div class="mdt-cm" data-xml-editor role="group" aria-labelledby="xml-editor-label"></div>
    <p class="ds-hint" id="xml-editor-hint">{s.keyboardHint}</p>
  </div>
</div>

<script is:inline type="application/json" data-xml-strings set:html={stringsJson} />
<script>import "@/tools/xml-beautifier.client.ts";</script>

<style>
  .cm-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
  }
  .cm-options { display: flex; flex-wrap: wrap; gap: 0.6rem 1.1rem; align-items: center; min-width: 0; }
  .cm-inline-field { display: flex; align-items: center; gap: 0.5rem; }
  .cm-inline-field .ds-label { margin-bottom: 0; }
  .cm-inline-field .ds-field-select { width: auto; }
</style>
