---
/**
 * YAML Beautifier/Validator (structured-data WASM domain). Two CodeMirror 5
 * editors from the legacy vendored build (mode:'yaml' kept verbatim — no yaml
 * mode file was ever vendored, CodeMirror no-ops to plain text; parity) with
 * the shared theme in `styles/codemirror.css`. Format/validate via the
 * structured-data WASM client; all in-browser. Errors: localized "invalid"
 * label + parser detail (line/column).
 */
import { t } from "@/i18n/messages";
import type { LocaleCode } from "@/registry/locales";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import "@/styles/codemirror.css";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/yaml-beautifier-validator";
const s = {
  inputLabel: t(lang, ns, "InputLabel"),
  format: t(lang, ns, "Format"),
  validate: t(lang, ns, "Validate"),
  clear: t(lang, ns, "Clear"),
  outputLabel: t(lang, ns, "OutputLabel"),
  valid: t(lang, ns, "Valid"),
  invalid: t(lang, ns, "Invalid"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, ns, "Copied"),
  paste: t(lang, ns, "Paste"),
  keyboardHint: t(lang, ns, "EditorKeyboardHint"),
};
const stringsJson = JSON.stringify(s);
---

<div class="ds-stack" data-yaml-tool>
  <div class="ds-actions">
    <button type="button" class="ds-btn ds-btn-primary" data-yaml-format>{s.format}</button>
    <button type="button" class="ds-btn" data-yaml-validate>{s.validate}</button>
    <button type="button" class="ds-btn ds-btn-danger" data-yaml-clear>{s.clear}</button>
  </div>

  <StatusMessage kind="error" data-yaml-error />

  <div class="ds-tool-grid">
    <OutputPanel label={s.inputLabel}>
      <Fragment slot="actions">
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-yaml-paste>{s.paste}</button>
      </Fragment>
      <div class="mdt-cm" data-yaml-input role="group" aria-label={s.inputLabel}></div>
    </OutputPanel>

    <OutputPanel label={s.outputLabel}>
      <Fragment slot="actions">
        <span class="ds-badge" data-yaml-status role="status" hidden></span>
        <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-yaml-copy>{s.copy}</button>
      </Fragment>
      <div class="mdt-cm" data-yaml-output role="group" aria-label={s.outputLabel}></div>
    </OutputPanel>
  </div>
  <p class="ds-hint" id="yaml-editor-hint">{s.keyboardHint}</p>
</div>

<script is:inline type="application/json" data-yaml-strings set:html={stringsJson} />
<script>import "@/tools/yaml-beautifier-validator.client.ts";</script>
