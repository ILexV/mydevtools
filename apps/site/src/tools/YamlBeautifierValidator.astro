---
/**
 * YAML Beautifier/Validator (structured-data WASM domain). Two CodeMirror 6
 * editors (`@codemirror/lang-yaml` highlight + folding) with the shared theme in `styles/codemirror.css`. Format/validate via the
 * structured-data WASM client; all in-browser. Errors: localized "invalid"
 * label + parser detail (line/column).
 */
import { t } from "@/i18n/messages";
import { diagnosticStrings, editorPhrases } from "@/tools/editor-phrases";
import type { LocaleCode } from "@/registry/locales";
import CopyButton from "@/components/tool/CopyButton.astro";
import EmptyState from "@/components/tool/EmptyState.astro";
import OutputPanel from "@/components/tool/OutputPanel.astro";
import StatusMessage from "@/components/tool/StatusMessage.astro";
import ToolPanel from "@/components/tool/ToolPanel.astro";
import "@/styles/codemirror.css";

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props as Props;
const ns = "tools/yaml-beautifier-validator";
const s = {
  inputLabel: t(lang, ns, "InputLabel"),
  format: t(lang, ns, "Format"),
  validate: t(lang, ns, "Validate"),
  clear: t(lang, ns, "Clear"),
  outputLabel: t(lang, ns, "OutputLabel"),
  valid: t(lang, ns, "Valid"),
  invalid: t(lang, ns, "Invalid"),
  copy: t(lang, ns, "Copy"),
  copied: t(lang, "common", "Common_Copied"),
  copyFailed: t(lang, "common", "Common_CopyFailed"),
  preparing: t(lang, "common", "Common_Preparing"),
  emptyHint: t(lang, ns, "EmptyHint"),
  outputEmpty: t(lang, ns, "OutputEmpty"),
  loadExample: t(lang, "common", "Common_LoadExample"),
  paste: t(lang, ns, "Paste"),
  keyboardHint: t(lang, ns, "EditorKeyboardHint"),
};
const stringsJson = JSON.stringify({ ...s, phrases: editorPhrases(lang), diag: diagnosticStrings(lang) });
---

<div class="ds-workbench" data-yaml-tool>
  <ToolPanel title={s.inputLabel}>
    <Fragment slot="actions">
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-yaml-paste>{s.paste}</button>
      <button type="button" class="ds-btn ds-btn-small ds-btn-ghost" data-yaml-clear>{s.clear}</button>
    </Fragment>
    <div class="ds-editor is-empty" data-yaml-input-host>
      <div class="mdt-cm" data-yaml-input role="group" aria-label={s.inputLabel}></div>
      <EmptyState
        hint={s.emptyHint}
        hintId="yaml-input-empty"
        exampleLabel={s.loadExample}
        buttonProps={{ "data-yaml-example": true }}
      />
    </div>
    <p class="ds-hint" id="yaml-editor-hint">{s.keyboardHint}</p>

    <div class="ds-action-row">
      <button type="button" class="ds-btn ds-btn-primary" data-yaml-format>{s.format}</button>
      <button type="button" class="ds-btn" data-yaml-validate>{s.validate}</button>
    </div>

    <!-- Parse-error panel (codemirror-kit setDiagnostic): no live role — errors are announced once on Format/Validate. -->
    <StatusMessage kind="error" role="none" class="mdt-diag" id="yaml-editor-error" data-yaml-error />
  </ToolPanel>

  <OutputPanel panel label={s.outputLabel} emptyHint={s.outputEmpty} data-yaml-output-panel>
    <Fragment slot="actions">
      <span class="ds-badge" data-yaml-status role="status" hidden></span>
      <CopyButton ghost label={s.copy} copiedLabel={s.copied} failedLabel={s.copyFailed} data-yaml-copy disabled />
    </Fragment>
    <div class="mdt-cm ds-when-filled" data-yaml-output role="group" aria-label={s.outputLabel}></div>
  </OutputPanel>
</div>

<script is:inline type="application/json" data-yaml-strings set:html={stringsJson} />
<script>import "@/tools/yaml-beautifier-validator.client.ts";</script>
