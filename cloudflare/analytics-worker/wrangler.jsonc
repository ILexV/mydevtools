{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mydevtools-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "tsconfig": "./tsconfig.json",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mydevtools.app/api/analytics/*",
      "zone_name": "mydevtools.app"
    }
  ],
  "vars": {
    "ALLOWED_BROWSER_ORIGIN": "https://mydevtools.app",
    "ANALYTICS_ACCOUNT_ID": "5aeb7e01c612a208baf33ac1c646a048",
    "ANALYTICS_ACCESS_AUD": "501209543f28462cdc5be6fc927c2bded0f5774b905a461fdad50907c1713cab",
    "ANALYTICS_REPORT_DATASET": "mydevtools_tool_usage"
  },
  "analytics_engine_datasets": [
    {
      "binding": "TOOL_ANALYTICS",
      "dataset": "mydevtools_tool_usage"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ANALYTICS_HISTORY",
      "id": "3ce32431331041839c4f1f8d681bcb69"
    }
  ],
  "triggers": {
    "crons": ["15 0 * * *"]
  },
  "observability": {
    "enabled": false,
    "issues": {
      "enabled": false
    },
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false
    },
    "traces": {
      "enabled": false,
      "persist": false
    }
  },
  "logpush": false,
  "send_metrics": false,
  "dependencies_instrumentation": {
    "enabled": false
  },
  "minify": true,
  "env": {
    "staging": {
      "name": "mydevtools-analytics-staging",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "vars": {
        "ALLOWED_BROWSER_ORIGIN": "self",
        "ANALYTICS_ACCOUNT_ID": "5aeb7e01c612a208baf33ac1c646a048",
        "ANALYTICS_REPORT_DATASET": "mydevtools_tool_usage_staging"
      },
      "analytics_engine_datasets": [
        {
          "binding": "TOOL_ANALYTICS",
          "dataset": "mydevtools_tool_usage_staging"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "ANALYTICS_HISTORY",
          "id": "2a05d867ce7e4c48ad26efa29021cef0"
        }
      ],
      "triggers": {
        "crons": []
      }
    }
  }
}
