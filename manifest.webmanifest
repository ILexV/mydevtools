{"name":"MyDevTools","short_name":"MyDevTools","description":"Free developer tools for JSON, Base64, hashes, JWT, regex, images, PDF and more. Everything runs locally in your browser, and your data is never uploaded.","lang":"en","start_url":"/?source=pwa","scope":"/","display":"standalone","orientation":"any","background_color":"#f6f7fb","theme_color":"#6a5af9","categories":["developer","utilities","productivity"],"icons":[{"src":"/icons/icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"/icons/icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"/icons/icon-512-maskable.png","sizes":"512x512","type":"image/png","purpose":"maskable"}],"shortcuts":[{"name":"Desktop","url":"/launch/"},{"name":"English","url":"/en/"},{"name":"Русский","url":"/ru/"},{"name":"Español","url":"/es/"},{"name":"Deutsch","url":"/de/"}],"file_handlers":[{"action":"/launch/","accept":{"application/pdf":[".pdf"],"image/png":[".png",".jpg",".jpeg",".webp",".gif",".bmp",".tif",".tiff",".ico",".tga",".avif"],"application/json":[".json"],"application/x-ndjson":[".jsonl",".ndjson"],"text/csv":[".csv",".tsv"],"application/vnd.apache.parquet":[".parquet"],"application/vnd.sqlite3":[".sqlite",".sqlite3",".db",".db3",".s3db",".sl3"],"application/xml":[".xml"],"text/x-log":[".log",".clef"],"text/plain":[".txt"],"application/zip":[".zip",".tar",".gz",".tgz",".bz2",".xz",".zst",".7z"],"application/x-pem-file":[".pub",".pem",".key"],"application/x-mdt-aead":[".aead"]}}]}