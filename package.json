{
  "name": "mydevtools-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "cloudflare/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:site": "npm run build -w @mydevtools/site",
    "build:wasm": "pwsh wasm/build.ps1 -Configuration Release -WasmOutRoot apps/site/src/generated/wasm",
    "bench:hash": "node apps/site/scripts/benchmark-hash.mjs",
    "preview:site": "npm run preview -w @mydevtools/site",
    "check:site": "npm run check -w @mydevtools/site",
    "validate:i18n": "npm run validate:i18n -w @mydevtools/site",
    "build:pages": "npm run validate:i18n && npm run build:wasm && npm run build:site && npm run test:smoke -w @mydevtools/site",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "test:smoke": "npm run test:smoke -w @mydevtools/site",
    "check:analytics": "npm run check -w @mydevtools/analytics-worker",
    "test:analytics": "npm test -w @mydevtools/analytics-worker",
    "build:analytics": "npm run build -w @mydevtools/analytics-worker",
    "test:visual": "npm run build:site && playwright test -c e2e/playwright.config.ts",
    "test:crossbrowser": "npm run build:site && playwright test -c e2e/playwright.config.ts cross-browser",
    "test:visual:update": "npm run build:site && playwright test -c e2e/playwright.config.ts --update-snapshots",
    "ui-kit:build": "npm run build -w @mydevtools/ui-kit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.3.0",
    "vscode-langservers-extracted": "^4.10.0"
  }
}
